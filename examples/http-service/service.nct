see ./index.nct

use std/http.{IncomingRequest, Limits, OutgoingResponse, Responder, ResponseHead, Server, ServerConnection}
use std/net
use std/net.{IpAddress, Ipv4Address, SocketAddress, TcpStream}
use std/task
use std/task.{TaskGroup, Timeout}
use std/time.Duration
use std/vec.Vec

const CONNECTION_LIMIT: usize = 2

const REQUEST_COUNT: usize = 3

const LARGE_BODY_BYTES: usize = 32768

const TRANSFER_BYTES: usize = 1024

func loopback(): SocketAddress {
    return SocketAddress.new(IpAddress.from_ipv4(Ipv4Address.loopback()), 0)
}

func byte_buffer(length: usize): Vec<u8> {
    var output: Vec<u8> = Vec.with_capacity(length)
    while output.len() < length { output.push(u8.truncate(0)) }
    return move output
}

func append_bytes(output: &+Vec<u8>, bytes: &[u8]): void {
    var offset: usize = 0
    while offset < bytes.len() {
        output.push(bytes[offset])
        offset += 1
    }
    return
}

async func stream_large_response(
    responder: Responder,
    timeout: Duration,
): ServerConnection?! {
    let head = ResponseHead.ok()
    var writer = await responder.begin_chunked_with_timeout(move head, timeout)?
    var chunk = byte_buffer(TRANSFER_BYTES)
    var offset: usize = 0
    while offset < chunk.len() {
        chunk[offset] = u8.truncate(120)
        offset += 1
    }
    var written: usize = 0
    while written < LARGE_BODY_BYTES {
        await writer.write_with_timeout(&chunk, timeout)?
        written += chunk.len()
    }
    return await writer.finish_with_timeout(timeout)?
}

async func read_large_request(
    request: &+IncomingRequest,
    timeout: Duration,
): bool {
    var scratch = byte_buffer(TRANSFER_BYTES)
    var received: usize = 0
    loop {
        let count = await request.read_with_timeout(&+scratch, timeout)
        catch _ { return false }
        if count == 0 { return received == LARGE_BODY_BYTES }
        received += count
    }
}

async func handle_connection(connection: ServerConnection, timeout: Duration): bool {
    var owner = move connection
    var completed_large = false
    loop {
        var request = await owner.read_request_with_timeout(timeout) catch failure {
            return !completed_large
            && (failure.has_code("std.http.invalid_syntax")
                || failure.has_code("std.http.timed_out"))
        }
        if request.target() == "/large" && !completed_large {
            if !await read_large_request(&+request, timeout) { return false }
            let responder = await request.finish_body_with_timeout(timeout)
            catch _ { return false }
            let next = await stream_large_response(move responder, timeout)
            catch _ { return false }
            owner = move next otherwise { return false }
            completed_large = true
        } else if request.target() == "/close" && completed_large {
            var responder = await request.finish_body_with_timeout(timeout)
            catch _ { return false }
            responder.close_after_response()
            var response = OutgoingResponse.ok()
            response.set_text_body("done")
            let next = await responder.respond_with_timeout(move response, timeout)
            catch _ { return false }
            let unexpected = move next otherwise { return true }
            unexpected.close()
            return false
        } else {
            request.close()
            return false
        }
    }
}

async func drain_handlers(
    handlers: TaskGroup<bool>,
): (usize, usize)! {
    var owner = move handlers
    var succeeded: usize = 0
    var failed: usize = 0
    while !owner.is_empty() {
        if await observe_handler(&+owner)? {
            succeeded += 1
        } else {
            failed += 1
        }
    }
    return (succeeded, failed)
}

async func drain_handlers_before(
    handlers: TaskGroup<bool>,
    deadline: Duration,
): (usize, usize)! {
    match await task.with_timeout(drain_handlers(move handlers), deadline) {
        Timeout.completed(result) { return move result? }
        Timeout.elapsed {
            return error.new(
                "http-service.shutdown_timed_out",
                "handler drain exceeded the shutdown deadline",
            )
        }
    }
}

async func observe_handler(
    handlers: &+TaskGroup<bool>,
): bool! {
    let completed = await handlers.next() otherwise {
        return error.new("http-service.group", "non-empty handler group produced no result")
    }
    return completed
}

async func serve_bounded(
    server: Server,
    request_timeout: Duration,
    shutdown_deadline: Duration,
): (usize, usize)! {
    var owner = move server
    var handlers: TaskGroup<bool> = TaskGroup.empty()
    var accepted: usize = 0
    var succeeded: usize = 0
    var failed: usize = 0
    while accepted < REQUEST_COUNT {
        if handlers.len() == CONNECTION_LIMIT {
            if await observe_handler(&+handlers)? {
                succeeded += 1
            } else {
                failed += 1
            }
        }
        let connection = await owner.accept_with_timeout(shutdown_deadline)?
        handlers.add(handle_connection(move connection, request_timeout))
        accepted += 1
    }
    owner.close()
    let drained = await drain_handlers_before(move handlers, shutdown_deadline)?
    return (succeeded + drained.0, failed + drained.1)
}

async func read_until_eof(
    stream: &+TcpStream,
    timeout: Duration,
): usize! {
    var scratch = byte_buffer(TRANSFER_BYTES)
    var received: usize = 0
    loop {
        let count = await stream.read_with_timeout(&+scratch, timeout)?
        if count == 0 { return received }
        received += count
    }
}

async func large_reused_exchange(address: SocketAddress, timeout: Duration): bool {
    var stream = await net.connect_tcp_with_timeout(address, timeout) catch _ { return false }
    var request: Vec<u8> = Vec.with_capacity(LARGE_BODY_BYTES + 256)
    append_bytes(
        &+request,
        "POST /large HTTP/1.1\r\nHost: localhost\r\nContent-Length: 32768\r\n\r\n".bytes(),
    )
    let body_start = request.len()
    while request.len() - body_start < LARGE_BODY_BYTES {
        request.push(u8.truncate(97))
    }
    append_bytes(
        &+request,
        "GET /close HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n".bytes(),
    )
    await stream.write_with_timeout(&request, timeout) catch _ { return false }
    let received = await read_until_eof(&+stream, timeout) catch _ { return false }
    return received > LARGE_BODY_BYTES
}

async func malformed_exchange(address: SocketAddress, timeout: Duration): bool {
    var stream = await net.connect_tcp_with_timeout(address, timeout) catch _ { return false }
    await stream.write_with_timeout(
        "GET /bad HTTP/1.1\r\nHost: localhost\r\nConnection: close,\r\n\r\n".bytes(),
        timeout,
    ) catch _ { return false }
    let received = await read_until_eof(&+stream, timeout) catch _ { return false }
    return received == 0
}

async func timed_out_exchange(address: SocketAddress, timeout: Duration): bool {
    var stream = await net.connect_tcp_with_timeout(address, timeout) catch _ { return false }
    let received = await read_until_eof(&+stream, timeout) catch _ { return false }
    return received == 0
}

async func run_clients(address: SocketAddress, timeout: Duration): usize! {
    var requests: TaskGroup<bool> = TaskGroup.empty()
    requests.add(large_reused_exchange(address, timeout))
    requests.add(malformed_exchange(address, timeout))
    requests.add(timed_out_exchange(address, timeout))
    var passed: usize = 0
    while !requests.is_empty() {
        let result = await requests.next() otherwise {
            return error.new("http-service.group", "non-empty client group produced no result")
        }
        if result { passed += 1 }
    }
    return passed
}

async func run_service_example(): i32! {
    let limits = Limits.new(1024, 8192, 32, 4, 1024, 128, 65536)?
    let request_timeout = Duration.from_seconds(1)
    let operation_timeout = Duration.from_seconds(3)
    let server = await Server.bind_with_limits(loopback(), limits)?
    let address = server.local_address()?
    let completed = await task.join(
        serve_bounded(move server, request_timeout, operation_timeout),
        run_clients(address, operation_timeout),
    )
    let service = move completed.0?
    let clients = move completed.1?
    if service.0 != 3 || service.1 != 0 || clients != 3 {
        return error.new("http-service.result", "bounded service outcomes changed")
    }
    return 0
}
