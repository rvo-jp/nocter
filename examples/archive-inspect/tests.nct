see ./index.nct

use std/io.BlockingReader
use std/vec.Vec

struct FragmentedSource {
    bytes: Vec<u8>
    next: usize
}

instance FragmentedSource {
    blocking method &+self.read_blocking(output: &+[u8]): usize! {
        if output.len() == 0 || self.next == self.bytes.len() { return 0 }
        output[0] = self.bytes[self.next]
        self.next += 1
        return 1
    }
}

