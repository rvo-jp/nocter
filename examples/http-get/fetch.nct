use std/http.{Client, Request}
use std/io.{BlockingReader, BlockingWriter}
use std/io
use std/process
use std/time.Duration
use std/url.Url

blocking func run(): i32 {
    let source = process.arg(1) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    } otherwise {
        report_usage() catch _ { return 2 }
        return 2
    }
    fetch(source) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    return 0
}

blocking func fetch(source: &str): void! {
    let url = Url.parse(source)?
    let request = Request.get(move url)?
    let client = Client.new()
    var response = client.send_with_timeout_blocking(move request, Duration.from_seconds(5))?
    let status = response.status().code().to_string()
    let body = response.read_to_end_blocking()?
    var output = io.stdout()
    output.write_text_blocking("HTTP ")?
    output.write_text_blocking(&status)?
    output.write_text_blocking("\n")?
    output.write_blocking(&body)?
    return
}

blocking func report_usage(): void! {
    var output = io.stderr()
    output.write_text_blocking("usage: http-get URL\n")?
    return
}

blocking func report_failure(failure: &error): void! {
    var output = io.stderr()
    output.write_text_blocking("http-get: ")?
    output.write_text_blocking(failure.code())?
    output.write_text_blocking(": ")?
    output.write_text_blocking(failure.message())?
    output.write_text_blocking("\n")?
    return
}
