#package: {
    name: "text-report",
    version: "0.1.0",
}

#executable: {
    name: "text-report",
}

use ./report.Report
use ./report as report_module
use std/io.{File, Reader}
use std/io
use std/path.Utf8Path
use std/process
use std/string.String

func main(): i32! {
    let requested: &str = process.arg(1)? otherwise {
        io.print("usage: text-report PATH NEEDLE\n")?
        return 2
    }
    let needle: &str = process.arg(2)? otherwise {
        io.print("usage: text-report PATH NEEDLE\n")?
        return 2
    }
    let path = Utf8Path.new(requested)?
    var file = File.open(&path)?
    let text = file.read_to_string()?
    let report = report_module.analyze(&text, needle)
    print_report(&report)?
    return 0
}

func print_report(report: &Report): void! {
    let lines = report.lines().to_string()
    let matching = report.matching().to_string()
    let output = String.concat(
        "lines: ",
        &lines,
        "\nmatching: ",
        &matching,
        "\n",
    )
    io.print(&output)?
    return
}
