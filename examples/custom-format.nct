use std/fmt.Format

use std/io.print

struct Point {
    x: i32,
    y: i32,
}

conform Format for Point {
    method &self.format_into(output: &+String): void {
        output.push_str("(")
        self.x.format_into(output)
        output.push_str(", ")
        self.y.format_into(output)
        output.push_str(")")
        return
    }
}

func main(): i32! {
    let point = Point { x: 3, y: 4 }
    let message = "point = ${point}\n"
    print(((&message) as &str))?
    return 0
}
