use std/fs
use std/io.Writer
use std/io
use std/json
use std/path.Utf8Path
use std/process

blocking func run(): i32 {
    if process.arg_count() != 2 {
        report_usage() catch _ { return 2 }
        return 2
    }
    let requested = process.arg(1) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    } otherwise {
        report_usage() catch _ { return 2 }
        return 2
    }
    let path = Utf8Path.new(requested) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    let source = fs.read_to_string(&path) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    let value = json.parse(&source) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    var output = io.stdout()
    json.write(&+output, &value) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    output.write_text_blocking("\n") catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    return 0
}

blocking func report_usage(): void! {
    var output = io.stderr()
    output.write_text_blocking("usage: json-normalize PATH\n")?
    return
}

blocking func report_failure(failure: &error): void! {
    var output = io.stderr()
    output.write_text_blocking("json-normalize: ")?
    output.write_text_blocking(failure.code())?
    output.write_text_blocking(": ")?
    output.write_text_blocking(failure.message())?
    output.write_text_blocking("\n")?
    return
}
