use std/fs

use std/io.Writer

use std/io

use std/json

use std/path.Utf8Path

use std/process

func run(): i32 {
    if process.arg_count() != 2 {
        report_usage() catch _ { return 2 }
        return 2
    }
    let requested = process.arg(1) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    } otherwise {
        report_usage() catch _ { return 2 }
        return 2
    }
    let path = Utf8Path.new(requested) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    let source = fs.read_to_string(&path) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    let value = json.parse(&source) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    var output = io.stdout()
    json.write(&+output, &value) catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    output.write_text("\n") catch failure {
        report_failure(&failure) catch _ { return 2 }
        return 2
    }
    return 0
}

func report_usage(): void! {
    var output = io.stderr()
    output.write_text("usage: json-normalize PATH\n")?
    return
}

func report_failure(failure: &error): void! {
    var output = io.stderr()
    output.write_text("json-normalize: ")?
    output.write_text(failure.code())?
    output.write_text(": ")?
    output.write_text(failure.message())?
    output.write_text("\n")?
    return
}
