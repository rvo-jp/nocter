#package: {
    name: "file-summary",
    version: "0.1.0",
}

#executable: {
    name: "file-summary",
}

use std/fs
use std/io
use std/path.Utf8Path
use std/process

see ./summary.nct

func main(): i32! {
    let requested: &str = process.arg(1)? otherwise {
        io.print("usage: file-summary PATH\n")?
        return 2
    }
    let path = Utf8Path.new(requested)?
    let text = fs.read_to_string(&path)?
    let lines = count_lines(&text)
    let result = lines.to_string()
    io.print(&result)?
    io.print("\n")?
    return 0
}
