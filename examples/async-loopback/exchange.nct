see ./index.nct

use std/net
use std/net.{IpAddress, Ipv4Address, SocketAddress, TcpListener}
use std/string.String
use std/task
use std/task.Timeout
use std/time.Duration
use std/vec.Vec

func loopback(): SocketAddress {
    return SocketAddress.new(IpAddress.from_ipv4(Ipv4Address.loopback()), 0)
}

async func run(): i32! {
    let timeout = Duration.from_seconds(1)
    var listener = await net.bind_tcp(loopback())?
    let listening_address = listener.local_address()?
    let connection = await task.join(
        net.connect_tcp_with_timeout(listening_address, timeout),
        listener.accept_with_timeout(timeout),
    )
    let client_result = move connection.0
    let accepted_result = move connection.1
    var client = move client_result?
    let accepted = move accepted_result?
    var server = move accepted.0

    var bytes: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let transfer = task.join(
        client.write_with_timeout("ping".bytes(), timeout),
        task.with_timeout(server.read(&+bytes), timeout),
    )
    let transferred = await transfer
    let write_result = move transferred.0
    move write_result?
    let read_result = match move transferred.1 {
        Timeout.completed(result) { move result }
        Timeout.elapsed {
            return error.new("async-loopback.timeout", "server read exceeded the example timeout")
        }
    }
    let count = move read_result?
    if count != 4 {
        return error.new("async-loopback.length", "TCP changed the message length")
    }
    let text = String.from_utf8(&bytes)?
    if text != "ping" {
        return error.new("async-loopback.body", "TCP changed the message bytes")
    }

    var reply: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let response = await task.join(
        server.write_with_timeout("pong".bytes(), timeout),
        client.read_with_timeout(&+reply, timeout),
    )
    let response_write = move response.0
    let response_read = move response.1
    move response_write?
    let reply_count = move response_read?
    if reply_count != 4 {
        return error.new("async-loopback.reply_length", "TCP changed the reply length")
    }
    let reply_text = String.from_utf8(&reply)?
    if reply_text != "pong" {
        return error.new("async-loopback.reply_body", "TCP changed the reply bytes")
    }
    return 0
}
