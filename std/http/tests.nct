use /hash.HashState
use /session.SessionId
use /vec.Vec

async func discard_route_test_request(
    _state: &usize,
    request: IncomingRequest,
    _route: RouteMatch,
): ServerConnection?! from _state | request | _route {
    request.close()
    return none
}

func byte_buffer(size: usize): Vec<u8> {
    var output: Vec<u8> = Vec.with_capacity(size)
    while output.len() < size { output.push(0) }
    return move output
}

noalloc func bytes_equal(left: &[u8], right: &[u8]): bool {
    if left.len() != right.len() { return false }
    var offset: usize = 0
    while offset < left.len() {
        if left[offset] != right[offset] { return false }
        offset += 1
    }
    return true
}

func decode_single_head_fragment(
    text: &str,
    request_method: &Method,
    limits: Limits,
): ResponseHeadAttempt {
    var decoder = response_head_decoder(limits)
    append_response_head_input_range(&+decoder, text.bytes(), 0, text.len()) catch failure {
        return ResponseHeadAttempt.failed(move failure)
    }
    return advance_response_head(move decoder, request_method)
}

func decode_single_request_head_fragment(text: &str, limits: Limits): RequestHeadAttempt {
    var decoder = request_head_decoder(limits)
    append_request_head_input_range(&+decoder, text.bytes(), 0, text.len()) catch failure {
        return RequestHeadAttempt.failed(move failure)
    }
    return advance_request_head(move decoder)
}

func expect_head_failure(
    text: &str,
    request_method: &Method,
    limits: Limits,
    code: &str,
): void! {
    let attempt = decode_single_head_fragment(text, request_method, limits)
    match move attempt {
        ResponseHeadAttempt.failed(failure) {
            if failure.has_code(code) { return }
            return error.new("std.http.test", "response failed with the wrong stable code")
        }
        _ { return error.new("std.http.test", "invalid response head was accepted") }
    }
}

test validated_message_values_preserve_only_intended_identity {
    let request_method = Method.parse("CUSTOM")?
    if request_method.text() != "CUSTOM" { return error.new("std.http.test", "method changed") }
    let _bad_method = Method.parse("BAD METHOD") catch failure {
        if !failure.has_code("std.http.invalid_method") {
            return error.new("std.http.test", "method failure changed")
        }
        let name = HeaderName.parse("Content-TYPE")?
        let value = HeaderValue.from_text("\t text/plain \t")?
        if name.text() != "content-type" || !bytes_equal(value.bytes(), "text/plain".bytes()) {
            return error.new("std.http.test", "header canonicalization changed")
        }
        let same_name = HeaderName.parse("CONTENT-TYPE")?
        var first_hash = HashState.fresh()
        var second_hash = first_hash.restart()
        name.hash_into(&+first_hash)
        same_name.hash_into(&+second_hash)
        if first_hash.finish() != second_hash.finish() {
            return error.new("std.http.test", "equal header names produced different hashes")
        }
        var headers = Headers.empty()
        headers.append(Header.new(move name, move value))
        headers.append(Header.new(
            HeaderName.parse("content-type")?,
            HeaderValue.from_text("application/json")?,
        ))
        if headers.len() != 2 {
            return error.new("std.http.test", "ordered duplicate fields were combined")
        }
        let first = headers.first("CONTENT-TYPE") otherwise {
            return error.new("std.http.test", "case-insensitive lookup missed a field")
        }
        if bytes_equal(first.bytes(), "text/plain".bytes()) { return }
        return error.new("std.http.test", "first field lookup changed order")
    }
    return error.new("std.http.test", "invalid method was accepted")
}

test request_head_encoding_selects_one_fixed_body_length {
    var request = RequestHead.new(Method.post(), "/submit?q=1")?
    request.append_header(Header.new(
        HeaderName.parse("Host")?,
        HeaderValue.from_text("example.test")?,
    ))
    let encoded = encode_request_head(&request, 4, Limits.standard())?
    let expected = "POST /submit?q=1 HTTP/1.1\r\nhost: example.test\r\ncontent-length: 4\r\n\r\n"
    if !bytes_equal(&encoded, expected.bytes()) {
        return error.new("std.http.test", "request head encoding changed")
    }
    request.append_header(Header.new(
        HeaderName.parse("Content-Length")?,
        HeaderValue.from_text("4")?,
    ))
    let _ambiguous = encode_request_head(&request, 4, Limits.standard()) catch failure {
        if failure.has_code("std.http.ambiguous_framing") { return }
        return error.new("std.http.test", "request framing failure changed")
    }
    return error.new("std.http.test", "caller-controlled request framing was accepted")
}

test request_head_decoding_selects_one_bounded_body_framing {
    let input = "POST /submit?q=1 HTTP/1.1\r\nHost: example.test\r\nContent-Length: 4\r\nX-Test: yes\r\n\r\nbody"
    let attempt = decode_single_request_head_fragment(input, Limits.standard())
    match move attempt {
        RequestHeadAttempt.ready(parsed) {
            if parsed.head.request_method().text() != "POST"
                || parsed.head.target().text() != "/submit?q=1"
                || parsed.head.headers().len() != 3
                || parsed.consumed != input.len() - 4 {
                return error.new("std.http.test", "decoded request head changed")
            }
            match parsed.decoder.state {
                BodyState.fixed(length) {
                    if length == 4 { return }
                }
                _ {}
            }
            return error.new("std.http.test", "request body framing changed")
        }
        _ { return error.new("std.http.test", "valid request head was rejected") }
    }
}

test request_head_decoding_requires_one_host_and_rejects_ambiguous_framing {
    let missing = decode_single_request_head_fragment(
        "GET / HTTP/1.1\r\n\r\n",
        Limits.standard(),
    )
    match move missing {
        RequestHeadAttempt.failed(failure) {
            if !failure.has_code("std.http.invalid_host") {
                return error.new("std.http.test", "missing Host failure changed")
            }
        }
        _ { return error.new("std.http.test", "missing Host was accepted") }
    }
    let duplicate = decode_single_request_head_fragment(
        "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\n\r\n",
        Limits.standard(),
    )
    match move duplicate {
        RequestHeadAttempt.failed(failure) {
            if !failure.has_code("std.http.invalid_host") {
                return error.new("std.http.test", "duplicate Host failure changed")
            }
        }
        _ { return error.new("std.http.test", "duplicate Host was accepted") }
    }
    let ambiguous = decode_single_request_head_fragment(
        "POST / HTTP/1.1\r\nHost: one\r\nContent-Length: 1\r\nTransfer-Encoding: chunked\r\n\r\n",
        Limits.standard(),
    )
    match move ambiguous {
        RequestHeadAttempt.failed(failure) {
            if failure.has_code("std.http.ambiguous_framing") { return }
            return error.new("std.http.test", "request framing failure changed")
        }
        _ { return error.new("std.http.test", "ambiguous request framing was accepted") }
    }
}

test request_head_decoder_accepts_every_single_fragment_boundary {
    let input = "POST /fragment HTTP/1.1\r\nHost: example.test\r\nContent-Length: 0\r\nX-Test: yes\r\n\r\n"
    let bytes = input.bytes()
    var split: usize = 0
    while split < bytes.len() {
        var decoder = request_head_decoder(Limits.standard())
        append_request_head_input_range(&+decoder, bytes, 0, split)?
        let partial = advance_request_head(move decoder)
        var suspended = match move partial {
            RequestHeadAttempt.incomplete(value) { move value }
            _ { return error.new("std.http.test", "incomplete request fragment was accepted early") }
        }
        append_request_head_input_range(&+suspended, bytes, split, bytes.len())?
        let complete = advance_request_head(move suspended)
        match move complete {
            RequestHeadAttempt.ready(parsed) {
                if parsed.consumed != bytes.len() || parsed.head.headers().len() != 3 {
                    return error.new("std.http.test", "request fragment boundary changed output")
                }
            }
            _ { return error.new("std.http.test", "fragmented request head was rejected") }
        }
        split += 1
    }
    return
}

test http_1_1_connections_are_reusable_by_default {
    var decoder = request_head_decoder(Limits.standard())
    let input = "GET /one HTTP/1.1\r\nHost: example.test\r\n\r\n"
    append_request_head_input_range(&+decoder, input.bytes(), 0, input.len())?
    match advance_request_head(move decoder) {
        RequestHeadAttempt.ready(parsed) {
            match parsed.disposition {
                ConnectionDisposition.reuse { return }
                ConnectionDisposition.close {}
            }
        }
        _ {}
    }
    return error.new("std.http.test", "HTTP/1.1 default connection policy changed")
}

test connection_tokens_select_close_across_comma_separated_values {
    var decoder = request_head_decoder(Limits.standard())
    let input = "GET /two HTTP/1.1\r\nHost: example.test\r\nConnection: keep-alive, Close\r\n\r\n"
    append_request_head_input_range(&+decoder, input.bytes(), 0, input.len())?
    match advance_request_head(move decoder) {
        RequestHeadAttempt.ready(parsed) {
            match parsed.disposition {
                ConnectionDisposition.close { return }
                ConnectionDisposition.reuse {}
            }
        }
        _ {}
    }
    return error.new("std.http.test", "Connection close token was not selected")
}

test connection_policy_validates_tokens_after_close {
    var decoder = request_head_decoder(Limits.standard())
    let input = "GET /bad HTTP/1.1\r\nHost: example.test\r\nConnection: close,\r\n\r\n"
    append_request_head_input_range(&+decoder, input.bytes(), 0, input.len())?
    match advance_request_head(move decoder) {
        RequestHeadAttempt.failed(failure) {
            if failure.has_code("std.http.invalid_syntax") { return }
        }
        _ {}
    }
    return error.new("std.http.test", "malformed trailing Connection token was accepted")
}

test connection_policy_rejects_empty_tokens_between_options {
    let _close = connection_value_requests_close("close,,keep-alive".bytes())
        catch failure {
            if failure.has_code("std.http.invalid_syntax") { return }
            return error.new("std.http.test", "empty Connection token failure changed")
        }
    return error.new("std.http.test", "empty Connection token was accepted")
}

test consumed_connection_input_is_normalized_before_the_next_head {
    var pending: Vec<u8> = Vec [
        u8.truncate(65),
        u8.truncate(66),
        u8.truncate(67),
    ]
    let input = ConnectionInput {
        pending: move pending,
        pending_start: 3,
        transport_scratch: byte_buffer(1),
    }
    let prepared = request_head_decoder_from_connection_input(Limits.standard(), move input)
    if prepared.0.input.len() == 0
        && prepared.0.state.field_block.head_start == 0 {
        return
    }
    return error.new("std.http.test", "consumed connection input retained its old prefix")
}

test unread_connection_input_is_compacted_into_the_reusable_buffer {
    var pending: Vec<u8> = Vec [
        u8.truncate(65),
        u8.truncate(66),
        u8.truncate(67),
        u8.truncate(68),
    ]
    let input = ConnectionInput {
        pending: move pending,
        pending_start: 2,
        transport_scratch: byte_buffer(4),
    }
    let prepared = request_head_decoder_from_connection_input(Limits.standard(), move input)
    if prepared.0.input.len() == 2
        && prepared.0.input[0] == 67
        && prepared.0.input[1] == 68
        && prepared.0.state.field_block.head_start == 0
        && prepared.1.len() == HTTP_BUFFER_BYTES {
        return
    }
    return error.new("std.http.test", "unread connection input was not compacted")
}

test reusable_server_response_omits_connection_close {
    let head = ResponseHead.ok()
    let plan = plan_server_response(
        &head,
        ResponseFraming.fixed(0),
        ConnectionDisposition.reuse,
        Limits.standard(),
    )?
    let expected = "HTTP/1.1 200 \r\ncontent-length: 0\r\n\r\n"
    if bytes_equal(&plan.head, expected.bytes()) { return }
    return error.new("std.http.test", "reusable response emitted a close policy")
}

test server_response_encoding_owns_connection_and_length_fields {
    var head = ResponseHead.ok()
    head.append_header_text("X-Test", "yes")?
    let plan = plan_server_response(
        &head,
        ResponseFraming.fixed(4),
        ConnectionDisposition.close,
        Limits.standard(),
    )?
    let expected = "HTTP/1.1 200 \r\nx-test: yes\r\ncontent-length: 4\r\nconnection: close\r\n\r\n"
    if !bytes_equal(&plan.head, expected.bytes()) {
        return error.new("std.http.test", "server response encoding changed")
    }
    head.append_header_text("Connection", "keep-alive")?
    let _reserved = plan_server_response(
        &head,
        ResponseFraming.fixed(4),
        ConnectionDisposition.close,
        Limits.standard(),
    ) catch failure {
        if failure.has_code("std.http.reserved_header") { return }
        return error.new("std.http.test", "server reserved-field failure changed")
    }
    return error.new("std.http.test", "caller-controlled server connection policy was accepted")
}

test server_response_rejects_body_for_bodyless_status {
    let head = ResponseHead.new(Status.new(204)?)?
    let _encoded = plan_server_response(
        &head,
        ResponseFraming.fixed(1),
        ConnectionDisposition.close,
        Limits.standard(),
    ) catch failure {
        if failure.has_code("std.http.invalid_response_body") { return }
        return error.new("std.http.test", "bodyless response failure changed")
    }
    return error.new("std.http.test", "bodyless status accepted a response body")
}

test server_response_plan_freezes_chunked_framing_once {
    var head = ResponseHead.ok()
    head.append_header_text("X-Stream", "yes")?
    let plan = plan_server_response(
        &head,
        ResponseFraming.chunked,
        ConnectionDisposition.close,
        Limits.standard(),
    )?
    let expected = "HTTP/1.1 200 \r\nx-stream: yes\r\ntransfer-encoding: chunked\r\nconnection: close\r\n\r\n"
    if !bytes_equal(&plan.head, expected.bytes()) {
        return error.new("std.http.test", "chunked response plan changed")
    }
    match plan.state {
        ResponseOutputState.chunked(written) {
            if written == 0 { return }
        }
        _ {}
    }
    return error.new("std.http.test", "chunked response state changed")
}

test response_output_state_rejects_overflow_and_premature_finish {
    let remaining = plan_fixed_response_fragment(4, 3)?
    if remaining != 1 {
        return error.new("std.http.test", "fixed response remainder changed")
    }
    let _overflow = plan_fixed_response_fragment(remaining, 2) catch failure {
        if !failure.has_code("std.http.response_body_overflow") {
            return error.new("std.http.test", "response overflow failure changed")
        }
        validate_fixed_response_finish(remaining) catch finish_failure {
            if finish_failure.has_code("std.http.incomplete_response_body") { return }
            return error.new("std.http.test", "premature response finish failure changed")
        }
        return error.new("std.http.test", "incomplete fixed response finished")
    }
    return error.new("std.http.test", "fixed response accepted excess bytes")
}

test request_targets_and_generated_fields_obey_their_exact_limits {
    let _target = RequestHead.new(Method.get(), "/bad%escape") catch failure {
        if !failure.has_code("std.http.invalid_target") {
            return error.new("std.http.test", "request-target failure changed")
        }
        let _backslash = RequestHead.new(Method.get(), "/bad\\path") catch target_failure {
            if !target_failure.has_code("std.http.invalid_target") {
                return error.new("std.http.test", "request-target character failure changed")
            }
            let tight = Limits.new(32, 32, 1, 16, 17, 8, 100)?
            let empty = RequestHead.new(Method.get(), "/")?
            let _head = encode_request_head(&empty, 10, tight) catch limit_failure {
                if limit_failure.has_code("std.http.syntax_limit") { return }
                return error.new("std.http.test", "generated field limit failure changed")
            }
            return error.new("std.http.test", "generated field exceeded its declared limit")
        }
        return error.new("std.http.test", "backslash request target was accepted")
    }
    return error.new("std.http.test", "malformed percent escape was accepted")
}

test request_targets_split_once_and_decode_query_values {
    let target = RequestTarget.parse("/users/alice%20smith?tag=one+two&empty=&encoded=%E2%9C%93")?
    if target.text() != "/users/alice%20smith?tag=one+two&empty=&encoded=%E2%9C%93"
        || target.path() != "/users/alice%20smith"
        || target.path_segment_count() != 2
        || (target.path_segment(0) otherwise { return error.new("std.http.test", "path segment was lost") })
            != "users"
        || (target.path_segment(1) otherwise { return error.new("std.http.test", "path segment was lost") })
            != "alice%20smith"
        || (target.query() otherwise { return error.new("std.http.test", "query was lost") })
            != "tag=one+two&empty=&encoded=%E2%9C%93" {
        return error.new("std.http.test", "request-target projection changed")
    }

    var pairs = target.query_pairs()
    let first = pairs.next() otherwise {
        return error.new("std.http.test", "first query parameter was lost")
    }
    if first.name() != "tag" || first.value() != "one+two" {
        return error.new("std.http.test", "first query parameter changed")
    }

    let second = pairs.next() otherwise {
        return error.new("std.http.test", "second query parameter was lost")
    }
    if second.name() != "empty" || second.value() != "" {
        return error.new("std.http.test", "empty query value changed")
    }

    let third = pairs.next() otherwise {
        return error.new("std.http.test", "third query parameter was lost")
    }
    if third.name() != "encoded" || third.value() != "✓" {
        return error.new("std.http.test", "percent-decoded query value changed")
    }
    let retained = third.to_owned()
    let _extra = pairs.next() otherwise {
        if retained.name() != "encoded" || retained.value() != "✓" {
            return error.new("std.http.test", "explicitly owned query parameter changed")
        }
        return
    }
    return error.new("std.http.test", "query iterator did not stop")
}

test request_target_query_iteration_distinguishes_absence_and_rejects_invalid_utf8_early {
    let target = RequestTarget.parse("/plain")?
    var no_pairs = target.query_pairs()
    let _unexpected = no_pairs.next() otherwise {
        let _malformed = RequestTarget.parse("/?value=%FF") catch failure {
            if failure.has_code("std.http.invalid_target_encoding") { return }
            return error.new("std.http.test", "malformed query used the wrong error")
        }
        return error.new("std.http.test", "invalid UTF-8 query was accepted")
    }
    return error.new("std.http.test", "query-less target yielded a parameter")
}

test application_data_limits_reject_zero_dimensions {
    let _items = ApplicationLimits.new(0, 1, 1) catch item_failure {
        if !item_failure.has_code("std.http.invalid_application_limits") {
            return error.new("std.http.test", "application item limit failure changed")
        }
        let _value = ApplicationLimits.new(1, 0, 1) catch value_failure {
            if !value_failure.has_code("std.http.invalid_application_limits") {
                return error.new("std.http.test", "application value limit failure changed")
            }
            let _aggregate = ApplicationLimits.new(1, 1, 0) catch aggregate_failure {
                if aggregate_failure.has_code("std.http.invalid_application_limits") { return }
                return error.new("std.http.test", "application aggregate limit failure changed")
            }
            return error.new("std.http.test", "zero application aggregate limit was accepted")
        }
        return error.new("std.http.test", "zero application value limit was accepted")
    }
    return error.new("std.http.test", "zero application item limit was accepted")
}

test forms_decode_strictly_and_preserve_duplicate_source_order {
    let form = Form.parse("name=Alice+Smith&tag=one&tag=%E2%9C%93&&empty")?
    if form.len() != 4 || form.count("tag") != 2 {
        return error.new("std.http.test", "form pair retention changed")
    }
    let name = form.first("name") otherwise {
        return error.new("std.http.test", "form name was lost")
    }
    let first_tag = form.first("tag") otherwise {
        return error.new("std.http.test", "form tag was lost")
    }
    let second_tag = form.at(2) otherwise {
        return error.new("std.http.test", "second form tag was lost")
    }
    let empty = form.first("empty") otherwise {
        return error.new("std.http.test", "empty form value was lost")
    }
    if name != "Alice Smith"
        || first_tag != "one"
        || second_tag.name() != "tag"
        || second_tag.value() != "✓"
        || empty != "" {
        return error.new("std.http.test", "form decoding changed")
    }
    return
}

test forms_reject_malformed_encoding_before_construction {
    let _escape = Form.parse("name=%2") catch escape_failure {
        if !escape_failure.has_code("std.http.invalid_form") {
            return error.new("std.http.test", "malformed form escape failure changed")
        }
        let _utf8 = Form.parse("name=%FF") catch utf8_failure {
            if utf8_failure.has_code("std.http.invalid_form") { return }
            return error.new("std.http.test", "malformed form UTF-8 failure changed")
        }
        return error.new("std.http.test", "malformed form UTF-8 was accepted")
    }
    return error.new("std.http.test", "malformed form escape was accepted")
}

test forms_apply_item_value_and_aggregate_limits_before_growth {
    let item_limits = ApplicationLimits.new(1, 8, 16)?
    let _items = Form.parse_with_limits("a=1&b=2", item_limits) catch item_failure {
        if !item_failure.has_code("std.http.application_item_limit") {
            return error.new("std.http.test", "form item limit failure changed")
        }
        let value_limits = ApplicationLimits.new(2, 3, 16)?
        let _value = Form.parse_with_limits("name=value", value_limits) catch value_failure {
            if !value_failure.has_code("std.http.application_value_limit") {
                return error.new("std.http.test", "form value limit failure changed")
            }
            let aggregate_limits = ApplicationLimits.new(2, 8, 3)?
            let _aggregate = Form.parse_with_limits("a=1&&b=2", aggregate_limits) catch aggregate_failure {
                if aggregate_failure.has_code("std.http.application_value_limit") { return }
                return error.new("std.http.test", "form aggregate limit failure changed")
            }
            return error.new("std.http.test", "form aggregate limit was ignored")
        }
        return error.new("std.http.test", "form value limit was ignored")
    }
    return error.new("std.http.test", "form item limit was ignored")
}

test media_types_have_one_canonical_bounded_representation {
    let media = MediaType.parse("Text/HTML; Charset=\"utf-8\"; boundary=simple")?
    let charset = media.parameter("CHARSET") otherwise {
        return error.new("std.http.test", "media charset was lost")
    }
    let boundary = media.parameter("boundary") otherwise {
        return error.new("std.http.test", "media boundary was lost")
    }
    if !media.matches("TEXT", "html")
        || media.type_name() != "text"
        || media.subtype() != "html"
        || media.parameter_count() != 2
        || charset != "utf-8"
        || boundary != "simple" {
        return error.new("std.http.test", "media type canonicalization changed")
    }
    return
}

test media_types_reject_ambiguous_or_unbounded_parameters {
    let _duplicate = MediaType.parse("text/plain; A=one; a=two") catch duplicate_failure {
        if !duplicate_failure.has_code("std.http.invalid_media_type") {
            return error.new("std.http.test", "duplicate media parameter failure changed")
        }
        let limits = ApplicationLimits.new(1, 3, 32)?
        let _large = MediaType.parse_with_limits("text/plain; name=value", limits) catch limit_failure {
            if limit_failure.has_code("std.http.application_value_limit") { return }
            return error.new("std.http.test", "media parameter limit failure changed")
        }
        return error.new("std.http.test", "media parameter value limit was ignored")
    }
    return error.new("std.http.test", "duplicate media parameter was accepted")
}

test media_types_reject_malformed_quoted_values_and_bound_base_identity {
    let _quoted = MediaType.parse("text/plain; note=\"unfinished") catch quoted_failure {
        if !quoted_failure.has_code("std.http.invalid_media_type") {
            return error.new("std.http.test", "quoted media failure changed")
        }
        let aggregate_limits = ApplicationLimits.new(2, 8, 8)?
        let _aggregate = MediaType.parse_with_limits("text/plain", aggregate_limits) catch limit_failure {
            if limit_failure.has_code("std.http.application_value_limit") { return }
            return error.new("std.http.test", "base media limit failure changed")
        }
        return error.new("std.http.test", "base media aggregate limit was ignored")
    }
    return error.new("std.http.test", "unterminated media parameter was accepted")
}

test cookies_preserve_validated_pairs_and_duplicate_source_order {
    let cookies = Cookies.parse("session=abc; theme=\"dark\"; session=def")?
    if cookies.len() != 3 || cookies.count("session") != 2 {
        return error.new("std.http.test", "cookie pair retention changed")
    }
    let session = cookies.first("session") otherwise {
        return error.new("std.http.test", "session cookie was lost")
    }
    let theme = cookies.at(1) otherwise {
        return error.new("std.http.test", "theme cookie was lost")
    }
    let rendered = theme.render()
    if session != "abc"
        || theme.name() != "theme"
        || theme.value() != "dark"
        || rendered != "theme=dark" {
        return error.new("std.http.test", "cookie parsing or rendering changed")
    }
    return
}

test cookies_reject_invalid_syntax_and_apply_finite_limits {
    let _syntax = Cookies.parse("bad name=value") catch syntax_failure {
        if !syntax_failure.has_code("std.http.invalid_cookie") {
            return error.new("std.http.test", "invalid cookie failure changed")
        }
        let item_limits = ApplicationLimits.new(1, 8, 16)?
        let _items = Cookies.parse_with_limits("a=1; b=2", item_limits) catch item_failure {
            if !item_failure.has_code("std.http.application_item_limit") {
                return error.new("std.http.test", "cookie item limit failure changed")
            }
            let value_limits = ApplicationLimits.new(2, 2, 16)?
            let _value = Cookies.parse_with_limits("name=value", value_limits) catch value_failure {
                if value_failure.has_code("std.http.application_value_limit") { return }
                return error.new("std.http.test", "cookie value limit failure changed")
            }
            return error.new("std.http.test", "cookie value limit was ignored")
        }
        return error.new("std.http.test", "cookie item limit was ignored")
    }
    return error.new("std.http.test", "invalid cookie name was accepted")
}

test cookies_reject_forbidden_octets_trailing_pairs_and_aggregate_growth {
    let _octet = Cookies.parse("name=a,b") catch octet_failure {
        if !octet_failure.has_code("std.http.invalid_cookie") {
            return error.new("std.http.test", "cookie-octet failure changed")
        }
        let _trailing = Cookies.parse("name=value;") catch trailing_failure {
            if !trailing_failure.has_code("std.http.invalid_cookie") {
                return error.new("std.http.test", "trailing cookie pair failure changed")
            }
            let aggregate_limits = ApplicationLimits.new(2, 8, 2)?
            let _aggregate = Cookies.parse_with_limits("a=12", aggregate_limits) catch limit_failure {
                if limit_failure.has_code("std.http.application_value_limit") { return }
                return error.new("std.http.test", "cookie aggregate limit failure changed")
            }
            return error.new("std.http.test", "cookie aggregate limit was ignored")
        }
        return error.new("std.http.test", "trailing empty cookie pair was accepted")
    }
    return error.new("std.http.test", "forbidden cookie octet was accepted")
}

test session_cookie_transport_is_canonical_and_explicitly_reveals_identity {
    let policy = SessionCookie.new("session", "/app", true)?
    let identifier = SessionId.from_bytes([0; 32])
    let header = policy.set_header(&identifier)?
    if header.name().text() != "set-cookie"
        || !bytes_equal(
            header.value().bytes(),
            "session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; Path=/app; HttpOnly; SameSite=Lax; Secure".bytes(),
        ) {
        return error.new("std.http.test", "session Set-Cookie policy changed")
    }
    let cookies = Cookies.parse("session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")?
    let parsed = policy.read(&cookies)? otherwise {
        return error.new("std.http.test", "session cookie was not found")
    }
    if parsed != identifier { return error.new("std.http.test", "session identity changed") }
    return
}

test session_cookie_transport_rejects_ambiguity_and_clears_with_matching_policy {
    let policy = SessionCookie.new("session", "/", false)?
    let duplicates = Cookies.parse(
        "session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA; session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
    )?
    let _ambiguous = policy.read(&duplicates) catch failure {
        if !failure.has_code("std.http.invalid_session_cookie") {
            return error.new("std.http.test", "session ambiguity failure changed")
        }
        let cleared = policy.clear_header()?
        if bytes_equal(
            cleared.value().bytes(),
            "session=; Path=/; Max-Age=0; HttpOnly; SameSite=Lax".bytes(),
        ) { return }
        return error.new("std.http.test", "session clearing policy changed")
    }
    return error.new("std.http.test", "ambiguous session cookie was accepted")
}

test session_cookie_transport_rejects_duplicate_cookie_fields {
    let policy = SessionCookie.new("session", "/", false)?
    var headers = Headers.empty()
    headers.append(Header.new(
        HeaderName.parse("cookie")?,
        HeaderValue.from_text("session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")?,
    ))
    headers.append(Header.new(
        HeaderName.parse("Cookie")?,
        HeaderValue.from_text("session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")?,
    ))
    let _value = policy.read_headers(&headers) catch failure {
        if failure.has_code("std.http.invalid_session_cookie") { return }
        return error.new("std.http.test", "duplicate cookie field failure changed")
    }
    return error.new("std.http.test", "duplicate Cookie fields were accepted")
}

test session_cookie_policy_requires_a_token_name_and_ascii_absolute_path {
    let _name = SessionCookie.new("not a token", "/", false) catch name_failure {
        if !name_failure.has_code("std.http.invalid_session_cookie") {
            return error.new("std.http.test", "session name failure changed")
        }
        let _relative = SessionCookie.new("session", "relative", false) catch path_failure {
            if !path_failure.has_code("std.http.invalid_session_cookie") {
                return error.new("std.http.test", "relative session path failure changed")
            }
            let _unicode = SessionCookie.new("session", "/é", false) catch unicode_failure {
                if unicode_failure.has_code("std.http.invalid_session_cookie") { return }
                return error.new("std.http.test", "non-ASCII session path failure changed")
            }
            return error.new("std.http.test", "non-ASCII session path was accepted")
        }
        return error.new("std.http.test", "relative session path was accepted")
    }
    return error.new("std.http.test", "invalid session name was accepted")
}

test session_cookie_transport_reads_one_complete_request_field_set {
    let policy = SessionCookie.new("session", "/", false)?
    var headers = Headers.empty()
    headers.append(Header.new(
        HeaderName.parse("cookie")?,
        HeaderValue.from_text("session=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA")?,
    ))
    let parsed = policy.read_headers(&headers)? otherwise {
        return error.new("std.http.test", "session field was not found")
    }
    let expected = SessionId.from_bytes([0; 32])
    if parsed != expected { return error.new("std.http.test", "session field identity changed") }
    return
}

test route_patterns_select_named_parameters_without_rescanning_the_target {
    let pattern = parse_route_pattern("/users/:id/files/:name")?
    let target = RequestTarget.parse("/users/alice/files/report%20one?download=1")?
    if !route_pattern_matches(&pattern, &target) {
        return error.new("std.http.test", "matching route pattern was rejected")
    }
    let matched = match_route_pattern(&pattern, &target)?
    if matched.len() != 2
        || (matched.parameter("id") otherwise { return error.new("std.http.test", "id parameter was lost") }) != "alice"
        || (matched.parameter("name") otherwise { return error.new("std.http.test", "name parameter was lost") }) != "report one" {
        return error.new("std.http.test", "route parameters changed")
    }
    return
}

test route_patterns_reject_invalid_and_equal_precedence_overlaps {
    let _invalid = parse_route_pattern("/users/:id/:id") catch failure {
        if !failure.has_code("std.http.invalid_route_pattern") {
            return error.new("std.http.test", "invalid route pattern failure changed")
        }
        var router: Router<usize> = Router<usize>.new(7)
        let first: Handler<usize> = (state, request, route) {
            discard_route_test_request(state, move request, move route)
        }
        router.get("/users/:id", move first)?
        let second: Handler<usize> = (state, request, route) {
            discard_route_test_request(state, move request, move route)
        }
        router.get("/users/:name", move second) catch overlap_failure {
            if overlap_failure.has_code("std.http.ambiguous_route") {
                let state = router.into_state()
                if state == 7 { return }
            }
            return error.new("std.http.test", "ambiguous route failure changed")
        }
        return error.new("std.http.test", "ambiguous route was accepted")
    }
    return error.new("std.http.test", "duplicate route parameter was accepted")
}

test literal_routes_may_overlap_parameters_at_higher_precedence {
    let parameter = parse_route_pattern("/users/:id")?
    let exact = parse_route_pattern("/users/me")?
    let target = RequestTarget.parse("/users/me")?
    if !route_patterns_overlap(&parameter, &exact)
        || parameter.literal_count >= exact.literal_count
        || !route_pattern_matches(&parameter, &target)
        || !route_pattern_matches(&exact, &target) {
        return error.new("std.http.test", "route precedence changed")
    }
    return
}

test application_response_constructors_attach_one_canonical_content_type {
    if Status.ok().code() != 200 {
        return error.new("std.http.test", "standard OK status changed")
    }
    let plain = OutgoingResponse.text(Status.not_found(), "missing")?
    let plain_type = plain.headers().first("content-type") otherwise {
        return error.new("std.http.test", "plain response lost its content type")
    }
    if plain.status().code() != 404
        || plain_type.bytes() != "text/plain; charset=utf-8".bytes()
        || plain.body() != "missing".bytes() {
        return error.new("std.http.test", "plain response construction changed")
    }

    let json = OutgoingResponse.json(Status.internal_server_error(), "{\"error\":true}")?
    let json_type = json.headers().first("content-type") otherwise {
        return error.new("std.http.test", "JSON response lost its content type")
    }
    if json.status().code() != 500
        || json_type.bytes() != "application/json; charset=utf-8".bytes()
        || json.body() != "{\"error\":true}".bytes() {
        return error.new("std.http.test", "JSON response construction changed")
    }
    return
}

test response_head_selects_fixed_length_once_and_preserves_fields {
    let request_method = Method.get()
    let input = "HTTP/1.1 200 OK\r\nContent-Length: 5, 5\r\nX-Test: one\r\nX-Test: two\r\n\r\nhelloextra"
    let attempt = decode_single_head_fragment(input, &request_method, Limits.standard())
    match move attempt {
        ResponseHeadAttempt.ready(parsed) {
            if parsed.head.status().code() != 200 || parsed.head.headers().len() != 3 {
                return error.new("std.http.test", "response head values changed")
            }
            match parsed.decoder.state {
                BodyState.fixed(length) {
                    if length == 5 && parsed.consumed == input.len() - 10 { return }
                }
                _ {}
            }
            return error.new("std.http.test", "fixed framing was not selected")
        }
        _ { return error.new("std.http.test", "valid fixed response was rejected") }
    }
}

test response_head_rejects_ambiguous_and_unsupported_framing {
    let request_method = Method.get()
    let limits = Limits.standard()
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\n",
        &request_method,
        limits,
        "std.http.ambiguous_framing",
    )?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 4\r\n\r\n",
        &request_method,
        limits,
        "std.http.ambiguous_framing",
    )?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: gzip, chunked\r\n\r\n",
        &request_method,
        limits,
        "std.http.unsupported_transfer_coding",
    )?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nContent-Length: 18446744073709551616\r\n\r\n",
        &request_method,
        limits,
        "std.http.ambiguous_framing",
    )?
    return
}

test bodyless_and_informational_responses_leave_following_bytes_unconsumed {
    let head_method = Method.head()
    let head_attempt = decode_single_head_fragment(
        "HTTP/1.1 200 OK\r\nContent-Length: 99\r\n\r\nbody",
        &head_method,
        Limits.standard(),
    )
    match move head_attempt {
        ResponseHeadAttempt.ready(parsed) {
            match parsed.decoder.state {
                BodyState.bodyless {}
                _ { return error.new("std.http.test", "HEAD response gained a body") }
            }
        }
        _ { return error.new("std.http.test", "HEAD response was rejected") }
    }

    let request_method = Method.get()
    let sequence = "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 204 No Content\r\n\r\n"
    let first = decode_single_head_fragment(sequence, &request_method, Limits.standard())
    match move first {
        ResponseHeadAttempt.informational(status, decoder) {
            if !status.is_informational() || decoder.state.field_block.head_start != 25 {
                return error.new("std.http.test", "informational response boundary changed")
            }
            return
        }
        _ { return error.new("std.http.test", "informational response was rejected") }
    }
}

test partial_head_and_close_delimited_body_have_explicit_completion {
    let request_method = Method.get()
    let partial = decode_single_head_fragment(
        "HTTP/1.1 200 OK\r\nContent-Len",
        &request_method,
        Limits.standard(),
    )
    match move partial {
        ResponseHeadAttempt.incomplete(_) {}
        _ { return error.new("std.http.test", "partial head was not retained") }
    }
    let complete = decode_single_head_fragment(
        "HTTP/1.1 200 OK\r\n\r\nabc",
        &request_method,
        Limits.standard(),
    )
    let parsed = match move complete {
        ResponseHeadAttempt.ready(value) { move value }
        _ { return error.new("std.http.test", "close-delimited head was rejected") }
    }
    match parsed.decoder.state {
        BodyState.close_delimited {}
        _ { return error.new("std.http.test", "close framing was not selected") }
    }
    var decoder = move parsed.decoder
    var output = byte_buffer(3)
    let progress = decode_body(&+decoder, "abc".bytes(), 0, &+output, true)?
    if progress.consumed == 3 && progress.written == 3 && progress.complete
        && bytes_equal(&output, "abc".bytes()) {
        return
    }
    return error.new("std.http.test", "close-delimited completion changed")
}

test response_head_decoder_retains_completed_work_across_partial_input {
    let request_method = Method.get()
    let prefix = "HTTP/1.1 200 OK\r\nX-One: first\r\nX-Two"
    var initial = response_head_decoder(Limits.standard())
    append_response_head_input_range(&+initial, prefix.bytes(), 0, prefix.len())?
    let partial = advance_response_head(move initial, &request_method)
    var decoder = match move partial {
        ResponseHeadAttempt.incomplete(value) {
            if value.state.field_block.fields.headers.len() != 1
                || value.state.field_block.scan_offset != prefix.len() {
                return error.new("std.http.test", "incremental head state lost its cursor")
            }
            move value
        }
        _ { return error.new("std.http.test", "partial response head did not suspend") }
    }
    let suffix = ": second\r\n\r\nbody"
    append_response_head_input_range(&+decoder, suffix.bytes(), 0, suffix.len())?
    let complete = advance_response_head(move decoder, &request_method)
    match move complete {
        ResponseHeadAttempt.ready(parsed) {
            if parsed.head.headers().len() == 2 { return }
            return error.new("std.http.test", "incremental head fields changed")
        }
        _ { return error.new("std.http.test", "completed incremental head was rejected") }
    }
}

test response_head_decoder_accepts_every_single_fragment_boundary {
    let request_method = Method.get()
    let input = "HTTP/1.1 200 OK\r\nX-One: first\r\nContent-Length: 0\r\n\r\n"
    let bytes = input.bytes()
    var split: usize = 0
    while split < bytes.len() {
        var decoder = response_head_decoder(Limits.standard())
        append_response_head_input_range(&+decoder, bytes, 0, split)?
        let partial = advance_response_head(move decoder, &request_method)
        var suspended = match move partial {
            ResponseHeadAttempt.incomplete(value) { move value }
            _ { return error.new("std.http.test", "incomplete fragment was accepted early") }
        }
        append_response_head_input_range(&+suspended, bytes, split, bytes.len())?
        let complete = advance_response_head(move suspended, &request_method)
        match move complete {
            ResponseHeadAttempt.ready(parsed) {
                if parsed.consumed != bytes.len() || parsed.head.headers().len() != 2 {
                    return error.new("std.http.test", "fragment boundary changed head output")
                }
            }
            _ { return error.new("std.http.test", "fragmented response head was rejected") }
        }
        split += 1
    }
    return
}

test informational_response_sequences_obey_their_aggregate_limit {
    let request_method = Method.get()
    let limits = Limits.new(64, 256, 8, 1, 64, 16, 64)?
    let input = "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 102 Processing\r\n\r\nHTTP/1.1 200 OK\r\n\r\n"
    let first = decode_single_head_fragment(input, &request_method, limits)
    let decoder = match move first {
        ResponseHeadAttempt.informational(_, value) { move value }
        _ { return error.new("std.http.test", "first informational response was rejected") }
    }
    let second = advance_response_head(move decoder, &request_method)
    match move second {
        ResponseHeadAttempt.failed(failure) {
            if failure.has_code("std.http.syntax_limit") { return }
            return error.new("std.http.test", "informational limit failure changed")
        }
        _ { return error.new("std.http.test", "informational response limit was ignored") }
    }
}

test chunked_body_decodes_partial_data_and_validates_trailers {
    var decoder = body_decoder(BodyFraming.chunked, Limits.standard())
    var output = byte_buffer(9)
    let partial = decode_body(&+decoder, "4\r".bytes(), 0, &+output, false)?
    if partial.consumed != 0 || partial.written != 0 || partial.complete {
        return error.new("std.http.test", "partial chunk line was consumed")
    }
    let input = "4\r\nWiki\r\n5;name=value\r\npedia\r\n0\r\nX-End: yes\r\n\r\n"
    let progress = decode_body(&+decoder, input.bytes(), 0, &+output, false)?
    if !progress.complete || progress.consumed != input.len() || progress.written != 9
        || !bytes_equal(&output, "Wikipedia".bytes()) {
        return error.new("std.http.test", "chunked framing changed")
    }
    var forbidden = body_decoder(BodyFraming.chunked, Limits.standard())
    let _trailer = decode_body(
        &+forbidden,
        "0\r\nContent-Length: 1\r\n\r\n".bytes(),
        0,
        &+output,
        false,
    ) catch failure {
        if !failure.has_code("std.http.ambiguous_framing") {
            return error.new("std.http.test", "forbidden trailer failure changed")
        }
        var malformed = body_decoder(BodyFraming.chunked, Limits.standard())
        let _extension = decode_body(
            &+malformed,
            "1;=bad\r\nx\r\n0\r\n\r\n".bytes(),
            0,
            &+output,
            false,
        ) catch extension_failure {
            if extension_failure.has_code("std.http.invalid_syntax") { return }
            return error.new("std.http.test", "chunk-extension failure changed")
        }
        return error.new("std.http.test", "malformed chunk extension was accepted")
    }
    return error.new("std.http.test", "framing field was accepted in trailers")
}

test chunk_extension_quoted_pairs_share_the_http_quoted_character_contract {
    var accepted = body_decoder(BodyFraming.chunked, Limits.standard())
    var output = byte_buffer(1)
    let progress = decode_body(
        &+accepted,
        "1;note=\"a\\\t b\"\r\nx\r\n0\r\n\r\n".bytes(),
        0,
        &+output,
        false,
    )?
    if !progress.complete || output[0] != 120 {
        return error.new("std.http.test", "valid quoted chunk extension was rejected")
    }

    var rejected = body_decoder(BodyFraming.chunked, Limits.standard())
    let _invalid = decode_body(
        &+rejected,
        "1;note=\"\\\0\"\r\nx\r\n0\r\n\r\n".bytes(),
        0,
        &+output,
        false,
    ) catch failure {
        if failure.has_code("std.http.invalid_syntax") { return }
        return error.new("std.http.test", "quoted control failure changed")
    }
    return error.new("std.http.test", "escaped chunk-extension control was accepted")
}

test premature_eof_and_limits_fail_before_unbounded_growth {
    var fixed = body_decoder(BodyFraming.fixed(4), Limits.standard())
    var output = byte_buffer(4)
    let _short = decode_body(&+fixed, "abc".bytes(), 0, &+output, true) catch failure {
        if !failure.has_code("std.http.premature_eof") {
            return error.new("std.http.test", "premature EOF failure changed")
        }
        let limits = Limits.new(32, 128, 4, 16, 64, 16, 3)?
        let request_method = Method.get()
        expect_head_failure(
            "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n",
            &request_method,
            limits,
            "std.http.body_limit",
        )?
        var chunked = body_decoder(BodyFraming.chunked, limits)
        let _large = decode_body(&+chunked, "4\r\ntest\r\n0\r\n\r\n".bytes(), 0, &+output, false) catch chunk_failure {
            if chunk_failure.has_code("std.http.body_limit") { return }
            return error.new("std.http.test", "chunk body limit failure changed")
        }
        return error.new("std.http.test", "oversized chunk was accepted")
    }
    return error.new("std.http.test", "premature fixed body was accepted")
}

test body_decoders_never_consume_or_write_beyond_the_selected_boundary {
    var fixed = body_decoder(BodyFraming.fixed(3), Limits.standard())
    var fixed_output = byte_buffer(8)
    let fixed_progress = decode_body(&+fixed, "abcNEXT".bytes(), 0, &+fixed_output, false)?
    if fixed_progress.consumed != 3 || fixed_progress.written != 3 || !fixed_progress.complete {
        return error.new("std.http.test", "fixed decoder crossed its selected boundary")
    }

    let limits = Limits.new(32, 128, 4, 16, 64, 16, 3)?
    var close = body_decoder(BodyFraming.close_delimited, limits)
    var close_output = byte_buffer(8)
    let _overflow = decode_body(&+close, "four".bytes(), 0, &+close_output, true) catch failure {
        if failure.has_code("std.http.body_limit") && close_output[0] == 0 { return }
        return error.new("std.http.test", "close body limit wrote before rejecting input")
    }
    return error.new("std.http.test", "oversized close-delimited body was accepted")
}

test malformed_lines_and_obs_fold_are_rejected_without_reinterpretation {
    let request_method = Method.get()
    let limits = Limits.standard()
    expect_head_failure(
        "HTTP/1.1 200 OK\nContent-Length: 0\n\n",
        &request_method,
        limits,
        "std.http.invalid_syntax",
    )?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nX-Test: first\r\n second\r\n\r\n",
        &request_method,
        limits,
        "std.http.invalid_syntax",
    )?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nBad Name: value\r\n\r\n",
        &request_method,
        limits,
        "std.http.invalid_header_name",
    )?
    let aggregate = Limits.new(64, 24, 8, 16, 64, 16, 64)?
    expect_head_failure(
        "HTTP/1.1 200 OK\r\nX-Unfinished: data",
        &request_method,
        aggregate,
        "std.http.syntax_limit",
    )?
    return
}
