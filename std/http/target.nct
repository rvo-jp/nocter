//! Parsed request-target boundaries and decoded query iteration.

see ./errors.nct
see ./index.nct
see ./storage.nct

use /scan.TextCursor
use /internal/safety
use /internal/utf8
use /str as text_module
use /string.String
use /vec.Vec

noalloc func request_target_query_start(text: &str): usize {
    var offset: usize = 0
    while offset < text.len() {
        if text[offset] == 63 { return offset + 1 }
        offset += 1
    }
    return text.len() + 1
}

noalloc func valid_request_target(target: &str): bool {
    let bytes = target.bytes()
    return valid_request_target_range(bytes, 0, bytes.len())
}

noalloc func valid_request_target_range(bytes: &[u8], start: usize, end: usize): bool {
    if start >= end || end > bytes.len() || bytes[start] != 47 { return false }
    var offset = start
    while offset < end {
        let value = bytes[offset]
        if value == 37 {
            if offset + 2 >= end { return false }
            let high = bytes[offset + 1]
            let low = bytes[offset + 2]
            let high_hex = (high >= 48 && high <= 57)
                || (high >= 65 && high <= 70)
                || (high >= 97 && high <= 102)
            let low_hex = (low >= 48 && low <= 57)
                || (low >= 65 && low <= 70)
                || (low >= 97 && low <= 102)
            if !high_hex || !low_hex { return false }
            offset += 3
        } else {
            let alpha = (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
            let digit = value >= 48 && value <= 57
            let unreserved = alpha || digit || value == 45 || value == 46 || value == 95 || value == 126
            let sub_delimiter = value == 33
                || value == 36
                || value == 38
                || value == 39
                || value == 40
                || value == 41
                || value == 42
                || value == 43
                || value == 44
                || value == 59
                || value == 61
            let path_or_query = value == 47 || value == 58 || value == 64 || value == 63
            if !unreserved && !sub_delimiter && !path_or_query { return false }
            offset += 1
        }
    }
    return true
}

func request_target_path_segments(text: &str, path_end: usize): Vec<RequestTargetSegment> {
    var segments: Vec<RequestTargetSegment> = Vec.empty()
    if path_end == 1 { return move segments }
    var start: usize = 1
    loop {
        var end = start
        while end < path_end && text[end] != 47 { end += 1 }
        segments.push(RequestTargetSegment { start: start, end: end })
        if end == path_end { return move segments }
        start = end + 1
    }
}

func request_target_from_validated(text: String): RequestTarget {
    let view: &str = &text
    let query_start = request_target_query_start(view)
    let path_end = if query_start <= view.len() { query_start - 1 } else { view.len() }
    let path_segments = request_target_path_segments(view, path_end)
    return RequestTarget {
        text_value: move text,
        query_start: query_start,
        path_segments: move path_segments,
    }
}

noalloc func hex_value(value: u8): u8? {
    if value >= 48 && value <= 57 { return value - 48 }
    if value >= 65 && value <= 70 { return value - 65 + 10 }
    if value >= 97 && value <= 102 { return value - 97 + 10 }
    return none
}

func decode_target_component(encoded: &str): String! {
    var bytes: Vec<u8> = Vec.with_capacity(encoded.len())
    let cursor = TextCursor.new(encoded)
    var offset: usize = 0
    while offset < encoded.len() {
        let step = decoded_query_byte(&cursor, offset, encoded.len())?
        bytes.push(step.value)
        offset = step.next_offset
    }
    let byte_view: &[u8] = &bytes
    let decoded = String.from_utf8(byte_view) catch _ { return invalid_target_encoding() }
    return move decoded
}

copy struct DecodedQueryByte {
    value: u8
    next_offset: usize
}

noalloc func decoded_query_byte(
    cursor: &TextCursor,
    offset: usize,
    end: usize,
): DecodedQueryByte! {
    let source = cursor.byte_at(offset) otherwise { return invalid_target() }
    if source != 37 {
        return DecodedQueryByte { value: source, next_offset: offset + 1 }
    }
    if offset + 2 >= end { return invalid_target() }
    let high_source = cursor.byte_at(offset + 1) otherwise { return invalid_target() }
    let low_source = cursor.byte_at(offset + 2) otherwise { return invalid_target() }
    let high = hex_value(high_source) otherwise { return invalid_target() }
    let low = hex_value(low_source) otherwise { return invalid_target() }
    return DecodedQueryByte {
        value: high * 16 + low,
        next_offset: offset + 3,
    }
}

noalloc func query_item_separator(
    cursor: &TextCursor,
    start: usize,
    end: usize,
): usize! {
    var offset = start
    while offset < end {
        let byte = cursor.byte_at(offset) otherwise { return invalid_target() }
        if byte == 61 { return offset - start }
        offset += 1
    }
    return end - start
}

noalloc func query_component_is_encoded(
    cursor: &TextCursor,
    start: usize,
    end: usize,
): bool! {
    var offset = start
    while offset < end {
        let byte = cursor.byte_at(offset) otherwise { return invalid_target() }
        if byte == 37 { return true }
        offset += 1
    }
    return false
}

func validate_decoded_query_component(
    cursor: &TextCursor,
    start: usize,
    end: usize,
): void! {
    if !query_component_is_encoded(cursor, start, end)? { return }
    var validator = utf8.StreamingValidator.new()
    var offset = start
    while offset < end {
        let step = decoded_query_byte(cursor, offset, end)?
        if !validator.push(step.value) { return invalid_target_encoding() }
        offset = step.next_offset
    }
    if !validator.is_complete() { return invalid_target_encoding() }
    return
}

func validate_decoded_query(text: &str): void! {
    let query_start = request_target_query_start(text)
    if query_start >= text.len() { return }

    let cursor = TextCursor.new(text)
    var item_start = query_start
    loop {
        var item_end = item_start
        while item_end < text.len() {
            let byte = cursor.byte_at(item_end) otherwise { return invalid_target() }
            if byte == 38 { break }
            item_end += 1
        }
        let separator = query_item_separator(&cursor, item_start, item_end)?
        let name_end = item_start + separator
        let value_start = if name_end < item_end { name_end + 1 } else { name_end }
        validate_decoded_query_component(&cursor, item_start, name_end)?
        validate_decoded_query_component(&cursor, value_start, item_end)?
        if item_end == text.len() { return }
        item_start = item_end + 1
    }
}

construct RequestTarget {
    func parse(text: &str): Self! {
        if !valid_request_target(text) { return invalid_target() }
        validate_decoded_query(text)?
        return request_target_from_validated(String.copy(text))
    }
}

instance RequestTarget {
    noalloc method &self.text(): &str from self {
        return &self.text_value as &str
    }

    noalloc method &self.path(): &str from self {
        let text: &str = &self.text_value
        if self.query_start > text.len() { return text }
        return text.get_range(0, self.query_start - 1) otherwise { return text }
    }

    noalloc method &self.query(): &str? from self {
        let text: &str = &self.text_value
        if self.query_start > text.len() { return none }
        return text.get_range(self.query_start, text.len())?
    }

    noalloc method &self.path_segment_count(): usize {
        return self.path_segments.len()
    }

    noalloc method &self.path_segment(index: usize): &str? from self {
        if index >= self.path_segments.len() { return none }
        let segment = self.path_segments[index]
        return self.text().get_range(segment.start, segment.end)?
    }

    noalloc method &self.query_pairs(): QueryIter from self {
        let query: &str = self.query() otherwise {
            return QueryIter {
                cursor: TextCursor.new(""),
                name_scratch: Vec.empty(),
                value_scratch: Vec.empty(),
                finished: true,
            }
        }
        return QueryIter {
            cursor: TextCursor.new(query),
            name_scratch: Vec.empty(),
            value_scratch: Vec.empty(),
            finished: query.len() == 0,
        }
    }
}

instance QueryParameter {
    noalloc method &self.name(): &str from self {
        return self.name_value
    }

    noalloc method &self.value(): &str from self {
        return self.value_value
    }

    method &self.to_owned(): OwnedQueryParameter {
        return OwnedQueryParameter {
            name_value: String.copy(self.name_value),
            value_value: String.copy(self.value_value),
        }
    }
}

instance OwnedQueryParameter {
    noalloc method &self.name(): &str from self {
        return &self.name_value as &str
    }

    noalloc method &self.value(): &str from self {
        return &self.value_value as &str
    }
}

instance QueryIter {
    method &+self.next(): QueryParameter? from self {
        if self.finished { return none }
        let item_start = self.cursor.offset()
        let item_window = self.cursor.take_until("&") catch _ {
            return safety.invariant_abort()
        }
        let item_end = item_start + item_window.len()
        let _ = move item_window
        self.finished = self.cursor.offset() == item_end

        let separator = query_item_separator(&self.cursor, item_start, item_end) catch _ {
            return safety.invariant_abort()
        }
        let name_start = item_start
        let name_end = item_start + separator
        let value_start = if name_end < item_end { name_end + 1 } else { name_end }
        let name_encoded = query_component_is_encoded(&self.cursor, name_start, name_end) catch _ {
            return safety.invariant_abort()
        }
        let value_encoded = query_component_is_encoded(&self.cursor, value_start, item_end) catch _ {
            return safety.invariant_abort()
        }

        if name_encoded {
            self.name_scratch.clear()
            var offset = name_start
            while offset < name_end {
                let step = decoded_query_byte(&self.cursor, offset, name_end) catch _ {
                    return safety.invariant_abort()
                }
                self.name_scratch.push(step.value)
                offset = step.next_offset
            }
        }
        if value_encoded {
            self.value_scratch.clear()
            var offset = value_start
            while offset < item_end {
                let step = decoded_query_byte(&self.cursor, offset, item_end) catch _ {
                    return safety.invariant_abort()
                }
                self.value_scratch.push(step.value)
                offset = step.next_offset
            }
        }

        let decoded_name: &str = if name_encoded {
            let bytes: &[u8] = &self.name_scratch
            text_module.from_utf8(bytes) catch _ { return safety.invariant_abort() }
        } else {
            self.cursor.get_range(name_start, name_end) otherwise {
                return safety.invariant_abort()
            }
        }
        let decoded_value: &str = if value_encoded {
            let bytes: &[u8] = &self.value_scratch
            text_module.from_utf8(bytes) catch _ { return safety.invariant_abort() }
        } else {
            self.cursor.get_range(value_start, item_end) otherwise {
                return safety.invariant_abort()
            }
        }
        return QueryParameter {
            name_value: decoded_name,
            value_value: decoded_value,
        }
    }
}
