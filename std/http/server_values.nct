//! Server request projections and response value construction.

see ./errors.nct
see ./index.nct
see ./server_storage.nct
see ./storage.nct

use /vec.Vec

instance IncomingRequest {
    noalloc method &self.request_method(): &Method from self {
        return self.head_value.request_method()
    }

    noalloc method &self.target(): &RequestTarget from self {
        return self.head_value.target()
    }

    noalloc method &self.headers(): &Headers from self {
        return self.head_value.headers()
    }
}

construct OutgoingResponse {
    noalloc func new(status: Status): Self! {
        return OutgoingResponse {
            head_value: ResponseHead.new(status)?,
            body_value: Vec.empty(),
        }
    }

    noalloc func ok(): Self {
        return OutgoingResponse {
            head_value: ResponseHead.ok(),
            body_value: Vec.empty(),
        }
    }
}

instance OutgoingResponse {
    noalloc method &self.status(): Status {
        return self.head_value.status()
    }

    noalloc method &self.headers(): &Headers from self {
        return self.head_value.headers()
    }

    noalloc method &self.body(): &[u8] from self {
        let body: &[u8] = &self.body_value
        return body
    }

    method &+self.append_header(header: Header): void {
        self.head_value.append_header(move header)
        return
    }

    method &+self.append_header_text(name: &str, value: &str): void! {
        self.head_value.append_header_text(name, value)?
        return
    }

    method &+self.set_body(body: Vec<u8>): void {
        self.body_value = move body
        return
    }

    method &+self.set_text_body(text: &str): void {
        self.set_body(Vec.from_slice(text.bytes()))
        return
    }
}
