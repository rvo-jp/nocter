//! Sole owned representations for deterministic HTTP routing.

see ./index.nct

use /string.String
use /vec.Vec

enum RoutePatternSegment {
    exact(value: String)
    parameter(name: String)
}

struct RoutePattern {
    segments: Vec<RoutePatternSegment>
    literal_count: usize
}

struct Route<State> {
    request_method: Method
    pattern: RoutePattern
    handler: Handler<State>
}

struct RouteParameter {
    name_value: String
    value_value: String
}

struct RouteMatch {
    parameters: Vec<RouteParameter>
}

struct Router<State> {
    state_value: State
    routes: Vec<Route<State>>
}
