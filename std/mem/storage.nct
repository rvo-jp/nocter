//! Allocator, layout, and raw-buffer representations.

see ./index.nct

use /internal/ptr

noalloc primitive func current_allocator_state(): usize

noalloc primitive func current_allocator_kind(): usize

noalloc primitive func allocation_failure_error(): error

const PAGE_ALLOCATOR_KIND: usize = 0

const REGION_ALLOCATOR_KIND: usize = 1

const UNBOUND_ALLOCATOR_KIND: usize = 2

copy struct Layout {
    size: usize
    align: usize
}

struct RawBuffer {
    ptr: *u8
    len: usize
    align: usize
    allocator_state: usize
    allocator_kind: usize
}

struct Allocator {
    state: usize
    kind: usize
}

struct AllocationContext {
    state: usize
    kind: usize
}

struct TryAllocator {
    state: usize
    kind: usize
}

noalloc func current_allocator(): Allocator {
    return Allocator {
        state: current_allocator_state(),
        kind: current_allocator_kind(),
    }
}

noalloc func current_try_allocator(): TryAllocator {
    return TryAllocator {
        state: current_allocator_state(),
        kind: current_allocator_kind(),
    }
}

noalloc func page_allocator(): Allocator {
    return Allocator { state: 0, kind: PAGE_ALLOCATOR_KIND }
}

noalloc func page_try_allocator(): TryAllocator {
    return TryAllocator { state: 0, kind: PAGE_ALLOCATOR_KIND }
}

noalloc func empty_unbound_buffer(align: usize): RawBuffer {
    // An unbound empty sentinel owns no storage and therefore
    // carries no allocator origin. The first growth operation binds it to the
    // allocator selected at that operation.
    return RawBuffer {
        ptr: ptr.from_addr(1),
        len: 0,
        align: align,
        allocator_state: 0,
        allocator_kind: UNBOUND_ALLOCATOR_KIND,
    }
}

noalloc func take_raw_buffer(buffer: &+RawBuffer): RawBuffer {
    let result = RawBuffer {
        ptr: buffer.ptr,
        len: buffer.len,
        align: buffer.align,
        allocator_state: buffer.allocator_state,
        allocator_kind: buffer.allocator_kind,
    }
    buffer.ptr = ptr.from_addr(1)
    buffer.len = 0
    buffer.align = 1
    buffer.allocator_state = 0
    buffer.allocator_kind = UNBOUND_ALLOCATOR_KIND
    return move result
}

noalloc func allocator_kind_is_page(kind: usize): bool {
    return kind == PAGE_ALLOCATOR_KIND
}

noalloc func allocator_kind_is_region(kind: usize): bool {
    return kind == REGION_ALLOCATOR_KIND
}

noalloc func allocator_kind_is_unbound(kind: usize): bool {
    return kind == UNBOUND_ALLOCATOR_KIND
}
