//! Darwin termination observation over the process-owned target adapter.

see ./index.nct

use /internal/os/darwin
use /internal/os/darwin.TerminationObservationAttempt
use /internal/task

#target: "arm64-darwin"
async func termination_requested(): TerminationSignal! {
    let descriptor = darwin.process_termination_descriptor()
    if descriptor.errno != 0 {
        return error.new(
            "std.service.termination_unavailable",
            "process termination observation could not be initialized",
        )
    }
    loop {
        match darwin.try_observe_process_termination() {
            TerminationObservationAttempt.ready(signal) {
                if signal == 2 { return TerminationSignal.interrupt }
                if signal == 15 { return TerminationSignal.terminate }
                return error.new(
                    "std.service.termination_invalid",
                    "the process termination source returned an invalid signal",
                )
            }
            TerminationObservationAttempt.pending {
                await task.wait_descriptor_ready(descriptor.value, false)
            }
            TerminationObservationAttempt.interrupted {}
            TerminationObservationAttempt.failed(_) {
                return error.new(
                    "std.service.termination_failed",
                    "the process termination source could not be observed",
                )
            }
            TerminationObservationAttempt.malformed {
                return error.new(
                    "std.service.termination_invalid",
                    "the process termination source returned malformed progress",
                )
            }
        }
    }
}
