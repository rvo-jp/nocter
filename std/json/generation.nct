//! String and BlockingWriter drivers over one effect-neutral compact JSON encoder.

see ./index.nct
see ./encoder.nct
see ./generation_failure.nct

use /internal/mem
use /io.BlockingWriter
use /mem.TryAllocator
use /mem as mem_module
use /string.String

const OUTPUT_CHUNK_CAPACITY: usize = 4096

func stringify(value: &Value): String {
    var allocator = mem_module.current_try_allocator()
    var output: String = String.try_with_capacity(&+allocator, 0) catch _ {
        return mem.allocation_abort()
    }
    let construction = try_encoder(&+allocator, value)
    var encoder = match move construction {
        EncoderConstruction.success(created) { move created }
        EncoderConstruction.allocation(_) { return mem.allocation_abort() }
    }
    loop {
        match encoder.advance() {
            EncodingStep.chunk {
                let chunk = encoder.chunk()
                output.try_push_utf8(chunk) catch _ {
                    return mem.allocation_abort()
                }
            }
            EncodingStep.complete { return move output }
            EncodingStep.allocation(_) { return mem.allocation_abort() }
        }
    }
}

func try_stringify(
    allocator: &+TryAllocator,
    value: &Value,
): String! from allocator {
    var output: String = String.try_with_capacity(allocator, 0)?
    let construction = try_encoder(allocator, value)
    var encoder = match move construction {
        EncoderConstruction.success(created) { move created }
        EncoderConstruction.allocation(failure) { return move failure }
    }
    loop {
        match encoder.advance() {
            EncodingStep.chunk { output.try_push_utf8(encoder.chunk())? }
            EncodingStep.complete { return move output }
            EncodingStep.allocation(failure) { return move failure }
        }
    }
}

blocking func flush_buffer<W>(
    destination: &+W,
    buffer: &String,
): void! where W impl BlockingWriter {
    let text: &str = buffer as &str
    if text.len() == 0 { return }
    destination.write_blocking(text.bytes())?
    return
}

blocking func write_core<W>(
    allocator: &+TryAllocator,
    destination: &+W,
    value: &Value,
): GenerationAttempt where W impl BlockingWriter {
    var buffer = String.try_with_capacity(allocator, OUTPUT_CHUNK_CAPACITY) catch failure {
        return GenerationAttempt.allocation(move failure)
    }
    let construction = try_encoder(allocator, value)
    var encoder = match move construction {
        EncoderConstruction.success(created) { move created }
        EncoderConstruction.allocation(failure) {
            return GenerationAttempt.allocation(move failure)
        }
    }
    loop {
        match encoder.advance() {
            EncodingStep.chunk {
                let chunk = encoder.chunk()
                let buffered: &str = &buffer as &str
                let buffered_len = buffered.len()
                if chunk.len() >= OUTPUT_CHUNK_CAPACITY {
                    flush_buffer(destination, &buffer) catch failure {
                        return GenerationAttempt.sink(move failure)
                    }
                    buffer.clear()
                    destination.write_blocking(chunk) catch failure {
                        return GenerationAttempt.sink(move failure)
                    }
                    continue
                }
                if buffered_len + chunk.len() > OUTPUT_CHUNK_CAPACITY {
                    flush_buffer(destination, &buffer) catch failure {
                        return GenerationAttempt.sink(move failure)
                    }
                    buffer.clear()
                }
                buffer.try_push_utf8(chunk) catch failure {
                    return GenerationAttempt.allocation(move failure)
                }
            }
            EncodingStep.complete {
                flush_buffer(destination, &buffer) catch failure {
                    return GenerationAttempt.sink(move failure)
                }
                return GenerationAttempt.complete
            }
            EncodingStep.allocation(failure) {
                return GenerationAttempt.allocation(move failure)
            }
        }
    }
}

blocking func write<W>(destination: &+W, value: &Value): void! where W impl BlockingWriter {
    var allocator = mem_module.current_try_allocator()
    let attempt = write_core(&+allocator, destination, value)
    match move attempt {
        GenerationAttempt.complete { return }
        GenerationAttempt.sink(failure) { return move failure }
        GenerationAttempt.allocation(_) { return mem.allocation_abort() }
    }
}

blocking func try_write<W>(
    allocator: &+TryAllocator,
    destination: &+W,
    value: &Value,
): void! where W impl BlockingWriter {
    let attempt = write_core(allocator, destination, value)
    match move attempt {
        GenerationAttempt.complete { return }
        GenerationAttempt.sink(failure) { return move failure }
        GenerationAttempt.allocation(failure) { return move failure }
    }
}

func expect_generated(source: &str, expected: &str): void! {
    let value = parse(source)?
    let generated = stringify(&value)
    if generated != expected {
        return error.new("std.json.generation", "generated JSON text changed")
    }
    return
}

test generator_preserves_scalar_and_exact_number_spelling {
    expect_generated("null", "null")?
    expect_generated("true", "true")?
    expect_generated("false", "false")?
    expect_generated("-0", "-0")?
    expect_generated("12.3400E+2", "12.3400E+2")?
    return
}

test generator_uses_one_compact_string_escape_policy {
    expect_generated("\"plain/solidus\"", "\"plain/solidus\"")?
    expect_generated(
        "\"\\u0000\\b\\f\\n\\r\\t\\\"\\\\/\"",
        "\"\\u0000\\b\\f\\n\\r\\t\\\"\\\\/\"",
    )?
    expect_generated(
        "\"\\u0001\\u0007\\u000b\\u001f\"",
        "\"\\u0001\\u0007\\u000B\\u001F\"",
    )?
    expect_generated("\"123456789012345é\"", "\"123456789012345é\"")?
    return
}

test generator_traverses_nested_containers_without_whitespace {
    expect_generated(
        "{\"items\":[null,true,-0,{\"name\":\"ok\"}]}",
        "{\"items\":[null,true,-0,{\"name\":\"ok\"}]}",
    )?
    return
}

test generator_visits_every_object_entry_once {
    let value = parse("{\"left\":1,\"right\":2}")?
    let generated = stringify(&value)
    let reparsed = parse(&generated as &str)?
    match move reparsed {
        Value.object(values) {
            let left = String.copy("left")
            let right = String.copy("right")
            if values.len() != 2 ||
                !values.contains_key(&left) ||
                !values.contains_key(&right) {
                return error.new("std.json.object", "object traversal changed semantic entries")
            }
        }
        _ { return error.new("std.json.object", "generated object changed root variant") }
    }
    return
}

test generator_uses_an_explicit_stack_for_deep_values {
    let source = "[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[[null]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]"
    expect_generated(source, source)?
    return
}

func recoverable_stringify_inside_region(value: &Value): String! {
    var selected = mem_module.page_try_allocator()
    var backing = mem_module.page_allocator()
    region temporary using backing {
        return try_stringify(&+selected, value)?
    }
    loop {}
}

test recoverable_generator_does_not_capture_the_current_region {
    let value = parse("[\"owned\",1]")?
    var generated = recoverable_stringify_inside_region(&value)?
    generated.try_push_str(" 012345678901234567890123456789")?
    if generated != "[\"owned\",1] 012345678901234567890123456789" {
        return error.new("std.json.allocator", "generated text lost selected storage")
    }
    return
}
