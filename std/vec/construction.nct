//! Vec construction from elements, views, and iterators.

see ./index.nct
see ./errors.nct
see ./storage.nct

use /internal/mem
use /internal/ptr as internal_ptr
use /iter.{ExactSizeIterator, Iterator}
use /mem.TryAllocator
use /mem as mem_module
use /ptr

construct Vec<T> {
    literal [](...items: T): Self {
        let item_count: usize = items.len()
        if item_count == 0 {
            return Vec.empty()
        }
        var result: Vec<T> = Vec.with_capacity(item_count)
        for item in items {
            result.push(move item)
        }
        return move result
    }

    func empty(): Self {
        return empty_with_capacity(0)
    }

    func with_capacity(requested_capacity: usize): Self {
        let pointer: *T = internal_ptr.from_addr(1)
        let element_size: usize = internal_ptr.pointee_size(pointer)
        if element_size == 0 {
            return empty_with_capacity(requested_capacity)
        }
        let byte_capacity: usize = mem.checked_multiply(requested_capacity, element_size) otherwise {
            return mem.allocation_abort()
        }
        var allocator = mem_module.current_allocator()
        let storage = allocator.alloc(byte_capacity, internal_ptr.pointee_align(pointer))
        let address: usize = ptr.addr(storage.bytes().ptr())
        return Vec<T> {
            ptr: internal_ptr.from_addr(address),
            storage: move storage,
            len: 0,
            capacity: requested_capacity,
        }
    }

    func try_with_capacity(
        allocator: &+TryAllocator,
        requested_capacity: usize,
    ): Self! {
        let pointer: *T = internal_ptr.from_addr(1)
        let element_size: usize = internal_ptr.pointee_size(pointer)
        if element_size == 0 {
            return empty_with_capacity(requested_capacity)
        }
        let byte_capacity: usize = mem.checked_multiply(requested_capacity, element_size) otherwise {
            return mem.capacity_overflow()
        }
        let storage = allocator.try_alloc(byte_capacity, internal_ptr.pointee_align(pointer))?
        let address: usize = ptr.addr(storage.bytes().ptr())
        return Vec<T> {
            ptr: internal_ptr.from_addr(address),
            storage: move storage,
            len: 0,
            capacity: requested_capacity,
        }
    }

    func from_slice(values: &[T]): Self where copy T {
        var result: Vec<T> = Vec.with_capacity(values.len())
        var index: usize = 0
        while index < values.len() {
            result.push(values[index])
            index += 1
        }
        return move result
    }

    func from_iter<I>(iterator: I): Self where I impl Iterator { .Item = T } {
        var result: Vec<T> = Vec.empty()
        for item in move iterator {
            result.push(move item)
        }
        return move result
    }

    func from_exact_iter<I>(
        iterator: I,
    ): Self where I impl ExactSizeIterator { .Item = T } {
        var source = move iterator
        let initial_len: usize = source.remaining_len()
        var result: Vec<T> = Vec.empty()
        result.reserve(initial_len)
        for item in move source {
            result.push(move item)
        }
        return move result
    }

    func try_from_slice(
        allocator: &+TryAllocator,
        values: &[T],
    ): Self! from allocator | values where copy T {
        var result: Vec<T> = Vec.try_with_capacity(allocator, values.len())?
        var index: usize = 0
        while index < values.len() {
            result.try_push(values[index])?
            index += 1
        }
        return move result
    }
}

func empty_with_capacity<T>(logical_capacity: usize): Vec<T> {
    let pointer: *T = internal_ptr.from_addr(1)
    let element_align: usize = internal_ptr.pointee_align(pointer)
    let storage = mem_module.empty_unbound_buffer(element_align)
    return Vec<T> {
        ptr: internal_ptr.from_addr(1),
        storage: move storage,
        len: 0,
        capacity: logical_capacity,
    }
}
