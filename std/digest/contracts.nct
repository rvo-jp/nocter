//! Shared formatting and hashing implementations for digest values.

see ./index.nct
see ./value.nct

use /hash.HashState
use /hex
use /internal/ptr
use /internal/safety
use /ptr as public_ptr
use /str as text
use /string.String

instance Sha256Digest {
    method &self.try_format_into(output: &+String): void! {
        var encoded: [u8; 64] = [0; 64]
        let input = ptr.slice_from_raw_parts_value(public_ptr.from_ref(&self.bytes_value[0]), 32)
        let encoded_first = public_ptr.from_ref_mut(&+encoded[0])
        let encoded_output = ptr.slice_from_raw_parts_value_mut(encoded_first, 64)
        let written = hex.encode_into(input, encoded_output) catch _ {
            return safety.invariant_abort()
        }
        if written != 64 { return safety.invariant_abort() }
        let view = text.from_utf8(encoded_output) catch _ { return safety.invariant_abort() }
        output.try_push_str(view)?
        return
    }

    noalloc method &self.hash_into(state: &+HashState): void {
        let input = ptr.slice_from_raw_parts_value(public_ptr.from_ref(&self.bytes_value[0]), 32)
        state.write(input)
        return
    }
}
