//! Allocation-free incremental SHA-256 state transition.

see ./index.nct
see ./value.nct

const WORD_MASK: u64 = 0xFFFFFFFF
const REPEATED_WORD: u64 = 0x100000001

static ROUND_CONSTANTS: [u64; 64] = [
    0x428A2F98, 0x71374491, 0xB5C0FBCF, 0xE9B5DBA5,
    0x3956C25B, 0x59F111F1, 0x923F82A4, 0xAB1C5ED5,
    0xD807AA98, 0x12835B01, 0x243185BE, 0x550C7DC3,
    0x72BE5D74, 0x80DEB1FE, 0x9BDC06A7, 0xC19BF174,
    0xE49B69C1, 0xEFBE4786, 0x0FC19DC6, 0x240CA1CC,
    0x2DE92C6F, 0x4A7484AA, 0x5CB0A9DC, 0x76F988DA,
    0x983E5152, 0xA831C66D, 0xB00327C8, 0xBF597FC7,
    0xC6E00BF3, 0xD5A79147, 0x06CA6351, 0x14292967,
    0x27B70A85, 0x2E1B2138, 0x4D2C6DFC, 0x53380D13,
    0x650A7354, 0x766A0ABB, 0x81C2C92E, 0x92722C85,
    0xA2BFE8A1, 0xA81A664B, 0xC24B8B70, 0xC76C51A3,
    0xD192E819, 0xD6990624, 0xF40E3585, 0x106AA070,
    0x19A4C116, 0x1E376C08, 0x2748774C, 0x34B0BCB5,
    0x391C0CB3, 0x4ED8AA4A, 0x5B9CCA4F, 0x682E6FF3,
    0x748F82EE, 0x78A5636F, 0x84C87814, 0x8CC70208,
    0x90BEFFFA, 0xA4506CEB, 0xBEF9A3F7, 0xC67178F2,
]

struct Sha256 {
    words: [u64; 8]
    block: [u8; 64]
    buffered: usize
    total_bytes: u64
}

noalloc func word_add(left: u64, right: u64): u64 {
    return left.wrapping_add(right).bit_and(WORD_MASK)
}

noalloc func word_add_four(first: u64, second: u64, third: u64, fourth: u64): u64 {
    return word_add(word_add(first, second), word_add(third, fourth))
}

noalloc func word_add_five(
    first: u64,
    second: u64,
    third: u64,
    fourth: u64,
    fifth: u64,
): u64 {
    return word_add(word_add_four(first, second, third, fourth), fifth)
}

// Duplicating a 32-bit word into both halves makes a 64-bit rotation equivalent to a 32-bit
// rotation after masking. This keeps the algorithm in checked source without a SHA-specific
// primitive or a second implementation of integer rotation.
noalloc func rotate_word_right(value: u64, amount: u64): u64 {
    let repeated = value.wrapping_mul(REPEATED_WORD)
    return repeated.rotate_right(amount).bit_and(WORD_MASK)
}

noalloc func choose(first: u64, second: u64, third: u64): u64 {
    let selected = first.bit_and(second)
    let rejected = first.bit_xor(WORD_MASK).bit_and(third)
    return selected.bit_xor(rejected)
}

noalloc func majority(first: u64, second: u64, third: u64): u64 {
    return first.bit_and(second).bit_xor(first.bit_and(third)).bit_xor(second.bit_and(third))
}

noalloc func large_sigma_zero(value: u64): u64 {
    let first = rotate_word_right(value, 2).bit_xor(rotate_word_right(value, 13))
    return first.bit_xor(rotate_word_right(value, 22))
}

noalloc func large_sigma_one(value: u64): u64 {
    let first = rotate_word_right(value, 6).bit_xor(rotate_word_right(value, 11))
    return first.bit_xor(rotate_word_right(value, 25))
}

noalloc func small_sigma_zero(value: u64): u64 {
    let first = rotate_word_right(value, 7).bit_xor(rotate_word_right(value, 18))
    return first.bit_xor(value / 8)
}

noalloc func small_sigma_one(value: u64): u64 {
    let first = rotate_word_right(value, 17).bit_xor(rotate_word_right(value, 19))
    return first.bit_xor(value / 1024)
}

noalloc func decode_word(block: &[u8; 64], offset: usize): u64 {
    return (block[offset] as u64) * 16777216
        + (block[offset + 1] as u64) * 65536
        + (block[offset + 2] as u64) * 256
        + block[offset + 3] as u64
}

noalloc func compress(state: &+[u64; 8], block: &[u8; 64]): void {
    var schedule: [u64; 64] = [0; 64]
    var index: usize = 0
    while index < 16 {
        schedule[index] = decode_word(block, index * 4)
        index += 1
    }
    while index < 64 {
        schedule[index] = word_add_four(
            small_sigma_one(schedule[index - 2]),
            schedule[index - 7],
            small_sigma_zero(schedule[index - 15]),
            schedule[index - 16],
        )
        index += 1
    }

    var a = state[0]
    var b = state[1]
    var c = state[2]
    var d = state[3]
    var e = state[4]
    var f = state[5]
    var g = state[6]
    var h = state[7]
    index = 0
    while index < 64 {
        let first = word_add_five(
            h,
            large_sigma_one(e),
            choose(e, f, g),
            ROUND_CONSTANTS[index],
            schedule[index],
        )
        let second = word_add(large_sigma_zero(a), majority(a, b, c))
        h = g
        g = f
        f = e
        e = word_add(d, first)
        d = c
        c = b
        b = a
        a = word_add(first, second)
        index += 1
    }

    state[0] = word_add(state[0], a)
    state[1] = word_add(state[1], b)
    state[2] = word_add(state[2], c)
    state[3] = word_add(state[3], d)
    state[4] = word_add(state[4], e)
    state[5] = word_add(state[5], f)
    state[6] = word_add(state[6], g)
    state[7] = word_add(state[7], h)
    return
}

construct Sha256 {
    noalloc func new(): Self {
        return Sha256 {
            words: [
                0x6A09E667,
                0xBB67AE85,
                0x3C6EF372,
                0xA54FF53A,
                0x510E527F,
                0x9B05688C,
                0x1F83D9AB,
                0x5BE0CD19,
            ],
            block: [0; 64],
            buffered: 0,
            total_bytes: 0,
        }
    }
}

instance Sha256 {
    noalloc method &+self.update_byte(value: u8): void {
        self.block[self.buffered] = value
        self.buffered += 1
        let current_total: u64 = self.total_bytes
        self.total_bytes = current_total.wrapping_add(1)
        if self.buffered == 64 {
            compress(&+self.words, &self.block)
            self.buffered = 0
        }
        return
    }

    noalloc method &+self.update(input: &[u8]): void {
        var index: usize = 0
        while index < input.len() {
            self.update_byte(input[index])
            index += 1
        }
        return
    }

    noalloc method self.finish(): Sha256Digest {
        var final = move self
        let bit_length = final.total_bytes.wrapping_mul(8)
        final.block[final.buffered] = 128
        final.buffered += 1
        if final.buffered > 56 {
            while final.buffered < 64 {
                final.block[final.buffered] = 0
                final.buffered += 1
            }
            compress(&+final.words, &final.block)
            final.buffered = 0
        }
        while final.buffered < 56 {
            final.block[final.buffered] = 0
            final.buffered += 1
        }
        var remaining = bit_length
        var offset: usize = 0
        while offset < 8 {
            final.block[63 - offset] = u8.truncate(remaining)
            remaining = remaining / 256
            offset += 1
        }
        compress(&+final.words, &final.block)

        var bytes: [u8; 32] = [0; 32]
        var word_index: usize = 0
        while word_index < 8 {
            let word = final.words[word_index]
            let byte_index = word_index * 4
            bytes[byte_index] = u8.truncate(word / 16777216)
            bytes[byte_index + 1] = u8.truncate(word / 65536)
            bytes[byte_index + 2] = u8.truncate(word / 256)
            bytes[byte_index + 3] = u8.truncate(word)
            word_index += 1
        }
        return Sha256Digest.from_bytes(bytes)
    }
}

noalloc func sha256(input: &[u8]): Sha256Digest {
    var state = Sha256.new()
    state.update(input)
    return state.finish()
}
