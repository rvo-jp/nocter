//! Recoverable formatting and shared-default contract tests.

see ./index.nct

use /string.String

test standard_values_share_one_recoverable_format_surface {
    var output = String.empty()
    "text".try_format_into(&+output)?
    let owned = String.copy("/owned")
    owned.try_format_into(&+output)?
    true.try_format_into(&+output)?
    '\u{1F600}'.try_format_into(&+output)?
    let minimum: i64 = -9223372036854775808
    minimum.try_format_into(&+output)?
    let maximum: u64 = 18446744073709551615
    maximum.try_format_into(&+output)?
    let decimal: f64 = 0.1
    decimal.try_format_into(&+output)?
    if (&output as &str) != "text/ownedtrue😀-9223372036854775808184467440737095516150.1" {
        return error.new("std.fmt.test", "standard Format spelling diverged")
    }
    return
}

test floating_values_interpolate_through_the_shared_format_contract {
    let value: f64 = 0.1
    let minimum = f32.from_bits(1)
    let message = "value=${value}, minimum=${minimum}"
    if (&message as &str) != "value=0.1, minimum=1e-45" {
        return error.new("std.fmt.test", "floating interpolation diverged from Format")
    }
    return
}
