//! Borrowed UTF-8 view contract tests.

see ./index.nct

use /vec.Vec

test borrowed_utf8_validation_preserves_the_input_storage {
    let bytes: Vec<u8> = Vec [u8.truncate(206), u8.truncate(187)]
    let view = from_utf8(&bytes)?
    if view == "λ" { return }
    return error.new("std.str.test", "borrowed UTF-8 validation changed bytes")
}

test borrowed_utf8_validation_rejects_invalid_encoding {
    let bytes: Vec<u8> = Vec [u8.truncate(255)]
    let _view = from_utf8(&bytes) catch failure {
        if failure.has_code("std.string.invalid_utf8") { return }
        return error.new("std.str.test", "borrowed UTF-8 used the wrong failure")
    }
    return error.new("std.str.test", "invalid borrowed UTF-8 was accepted")
}

test split_once_returns_two_borrowed_positions {
    let (key, value) = "language=Nocter".split_once("=") otherwise {
        return error.new("std.str.test", "split_once missed a present separator")
    }
    if key != "language" {
        return error.new("std.str.test", "split_once returned the wrong prefix")
    }
    if value != "Nocter" {
        return error.new("std.str.test", "split_once returned the wrong suffix")
    }

    let (empty, complete) = "Nocter".split_once("") otherwise {
        return error.new("std.str.test", "split_once rejected an empty separator")
    }
    if !empty.is_empty() || complete != "Nocter" {
        return error.new("std.str.test", "split_once mishandled an empty separator")
    }

    let absent = "Nocter".split_once("=")
    let _ = absent otherwise { return }
    return error.new("std.str.test", "split_once found an absent separator")
}

test borrowed_ranges_validate_text_boundaries_and_slice_bounds {
    let text = "λNocter"
    let complete = text.get_range(0, text.len()) otherwise {
        return error.new("std.str.test", "get_range rejected the complete text")
    }
    if complete != text {
        return error.new("std.str.test", "get_range changed the complete text")
    }

    let _invalid_boundary = text.get_range(1, text.len()) otherwise {
        let bytes = text.bytes()
        let empty = bytes.get_range(bytes.len(), bytes.len()) otherwise {
            return error.new("std.str.test", "slice get_range rejected its terminal empty range")
        }
        if !empty.is_empty() {
            return error.new("std.str.test", "slice get_range returned a nonempty terminal range")
        }

        let _reversed = bytes.get_range(bytes.len(), 0) otherwise { return }
        return error.new("std.str.test", "slice get_range accepted reversed bounds")
    }
    return error.new("std.str.test", "get_range accepted a split UTF-8 encoding")
}
