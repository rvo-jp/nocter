//! Allocation-free byte search for borrowed UTF-8 text.
//!
//! Matching operates on bytes, but every successful match of a non-empty, well-formed UTF-8
//! needle begins at a UTF-8 boundary in the haystack.

noalloc func find_from_bytes(
    text: &str,
    needle: &str,
    start: usize,
): usize? {
    if start > text.len() { return none }
    if needle.len() == 0 { return start }
    if needle.len() > text.len() - start { return none }
    let last_candidate: usize = text.len() - needle.len()
    var candidate: usize = start
    while candidate <= last_candidate {
        var matched: usize = 0
        var equal: bool = true
        while matched < needle.len() {
            let actual: u8 = text[candidate + matched]
            let expected: u8 = needle[matched]
            if actual != expected {
                equal = false
            }
            matched += 1
        }
        if equal { return candidate }
        candidate += 1
    }
    return none
}
