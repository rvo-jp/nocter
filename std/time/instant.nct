//! Opaque monotonic observations and target-independent conversion.

see ./index.nct
see ./duration.nct
use /internal/time

copy struct Instant {
    counter: u64
}

construct Instant {
    noalloc func now(): Self {
        return Instant { counter: time.monotonic_counter() }
    }
}

instance Instant {
    noalloc method &self.elapsed(): Duration {
        let current = time.monotonic_counter()
        let delta = time.monotonic_delta(self.counter, current)
        return duration_from_counter_delta(delta, time.monotonic_frequency())
    }
}
