//! Nonblocking sleep policy over the compiler-owned monotonic deadline computation.

see ./index.nct
see ./duration.nct
use /internal/time

const ASYNC_SLEEP_MAX_STEP_SECONDS: u64 = 86400
const ASYNC_SLEEP_NANOSECONDS_PER_SECOND: u64 = 1000000000

noalloc func async_sleep_step(remaining: &Duration): Duration {
    if remaining.whole_seconds() >= ASYNC_SLEEP_MAX_STEP_SECONDS {
        return Duration.from_seconds(ASYNC_SLEEP_MAX_STEP_SECONDS)
    }
    return normalized_duration(
        remaining.whole_seconds(),
        remaining.subsecond_nanoseconds(),
    )
}

noalloc func async_sleep_ticks(step: &Duration, frequency: u64): u64 {
    let whole = step.whole_seconds() * frequency
    let product = step.subsecond_nanoseconds() * frequency
    var fractional = product / ASYNC_SLEEP_NANOSECONDS_PER_SECOND
    if product % ASYNC_SLEEP_NANOSECONDS_PER_SECOND != 0 {
        fractional += 1
    }
    return whole + fractional
}

async func sleep(duration: Duration): void {
    var remaining = normalized_duration(
        duration.whole_seconds(),
        duration.subsecond_nanoseconds(),
    )
    while !remaining.is_zero() {
        let step = async_sleep_step(&remaining)
        let frequency = time.monotonic_frequency()
        let ticks = async_sleep_ticks(&step, frequency)
        let deadline = time.monotonic_counter().wrapping_add(ticks)
        await time.wait_until(deadline)
        remaining = remaining.checked_sub(&step) otherwise { return }
    }
    return
}
