//! Duration contract tests.

see ./index.nct
see ./async_sleep.nct
use /internal/time
use /testing
use /mem

noalloc func rejects_rfc3339(text: &str): bool {
    let _value = SystemTime.parse_rfc3339(text) catch failure {
        return failure.has_code("std.time.invalid_rfc3339")
    }
    return false
}

test duration_units_share_one_normal_form {
    let second = Duration.from_seconds(1)
    let milliseconds = Duration.from_milliseconds(1000)
    let microseconds = Duration.from_microseconds(1000000)
    let nanoseconds = Duration.from_nanoseconds(1000000000)
    testing.assert_eq(&second, &milliseconds)?
    testing.assert_eq(&second, &microseconds)?
    testing.assert_eq(&second, &nanoseconds)?

    let split = Duration.from_nanoseconds(12345678901)
    testing.assert(split.whole_seconds() == 12)?
    testing.assert(split.subsecond_nanoseconds() == 345678901)?
    testing.assert(!split.is_zero())?
    testing.assert(Duration.from_seconds(0).is_zero())?
    return
}

test asynchronous_sleep_steps_are_bounded_and_round_ticks_up {
    let large = Duration.from_seconds(100000)
    let bounded = async_sleep_step(&large)
    testing.assert(bounded.whole_seconds() == 86400)?
    testing.assert(bounded.subsecond_nanoseconds() == 0)?

    let half_second = Duration.from_nanoseconds(500000000)
    testing.assert(async_sleep_ticks(&half_second, 10) == 5)?
    let sub_tick = Duration.from_nanoseconds(1)
    testing.assert(async_sleep_ticks(&sub_tick, 1) == 1)?
    return
}

test duration_constructors_accept_full_width_inputs {
    let milliseconds = Duration.from_milliseconds(18446744073709551615)
    testing.assert(milliseconds.whole_seconds() == 18446744073709551)?
    testing.assert(milliseconds.subsecond_nanoseconds() == 615000000)?

    let microseconds = Duration.from_microseconds(18446744073709551615)
    testing.assert(microseconds.whole_seconds() == 18446744073709)?
    testing.assert(microseconds.subsecond_nanoseconds() == 551615000)?

    let nanoseconds = Duration.from_nanoseconds(18446744073709551615)
    testing.assert(nanoseconds.whole_seconds() == 18446744073)?
    testing.assert(nanoseconds.subsecond_nanoseconds() == 709551615)?
    return
}

test duration_checked_arithmetic_handles_normalization_boundaries {
    let almost_second = Duration.from_nanoseconds(999999999)
    let two_nanoseconds = Duration.from_nanoseconds(2)
    let sum = almost_second.checked_add(&two_nanoseconds) otherwise {
        return error.new("std.time.test", "representable addition failed")
    }
    testing.assert(sum.whole_seconds() == 1)?
    testing.assert(sum.subsecond_nanoseconds() == 1)?

    let difference = sum.checked_sub(&two_nanoseconds) otherwise {
        return error.new("std.time.test", "representable subtraction failed")
    }
    testing.assert_eq(&difference, &almost_second)?

    let _underflow = almost_second.checked_sub(&sum) otherwise {
        return
    }
    return error.new("std.time.test", "duration subtraction underflow succeeded")
}

test duration_checked_add_rejects_the_single_carry_overflow {
    let maximum = Duration.from_seconds(18446744073709551615)
    let one_second = Duration.from_seconds(1)
    let _overflow = maximum.checked_add(&one_second) otherwise {
        return
    }
    return error.new("std.time.test", "duration addition overflow succeeded")
}

test instant_elapsed_stays_in_the_normalized_duration_domain {
    let start = Instant.now()
    let elapsed = start.elapsed()
    testing.assert(elapsed.subsecond_nanoseconds() < 1000000000)?
    return
}

test system_time_construction_and_order_share_one_normal_form {
    let epoch = SystemTime.from_unix_seconds(0)
    let epoch_parts = SystemTime.from_unix_parts(0, 0)?
    testing.assert(epoch == epoch_parts)?

    let before = SystemTime.from_unix_parts(-1, 999999999)?
    let after = SystemTime.from_unix_parts(0, 1)?
    testing.assert(before < epoch)?
    testing.assert(epoch < after)?
    testing.assert(before.unix_seconds() == -1)?
    testing.assert(before.subsecond_nanoseconds() == 999999999)?
    return
}

test system_time_rejects_non_normalized_subseconds {
    let _invalid = SystemTime.from_unix_parts(0, 1000000000) catch failure {
        testing.assert(failure.has_code("std.time.invalid_system_time"))?
        return
    }
    return error.new("std.time.test", "invalid subsecond component was accepted")
}

test system_wall_clock_produces_a_normalized_observation {
    let observed = SystemTime.now()?
    testing.assert(observed.subsecond_nanoseconds() < 1000000000)?
    return
}

test utc_calendar_converts_the_unix_epoch_and_the_preceding_nanosecond {
    let epoch = SystemTime.from_unix_seconds(0).to_utc()?
    testing.assert(epoch.year() == 1970)?
    testing.assert(epoch.month() == 1)?
    testing.assert(epoch.day() == 1)?
    testing.assert(epoch.hour() == 0)?
    testing.assert(epoch.minute() == 0)?
    testing.assert(epoch.second() == 0)?
    testing.assert(epoch.nanosecond() == 0)?

    let preceding_system_time = SystemTime.from_unix_parts(-1, 999999999)?
    let preceding = preceding_system_time.to_utc()?
    testing.assert(preceding.year() == 1969)?
    testing.assert(preceding.month() == 12)?
    testing.assert(preceding.day() == 31)?
    testing.assert(preceding.hour() == 23)?
    testing.assert(preceding.minute() == 59)?
    testing.assert(preceding.second() == 59)?
    testing.assert(preceding.nanosecond() == 999999999)?
    return
}

test utc_calendar_uses_proleptic_gregorian_leap_years {
    let leap = UtcDateTime.new(2000, 2, 29, 12, 34, 56, 7)?
    testing.assert(leap.to_system_time().unix_seconds() == 951827696)?
    let round_trip = leap.to_system_time().to_utc()?
    testing.assert(leap == round_trip)?

    let _invalid_century = UtcDateTime.new(1900, 2, 29, 0, 0, 0, 0) catch failure {
        testing.assert(failure.has_code("std.time.invalid_utc_datetime"))?
        return
    }
    return error.new("std.time.test", "a non-leap-century date was accepted")
}

test utc_calendar_round_trips_its_supported_year_boundaries {
    let first = UtcDateTime.new(0, 1, 1, 0, 0, 0, 0)?
    let last = UtcDateTime.new(9999, 12, 31, 23, 59, 59, 999999999)?
    testing.assert(first.to_system_time().unix_seconds() == -62167219200)?
    testing.assert(last.to_system_time().unix_seconds() == 253402300799)?
    let first_round_trip = first.to_system_time().to_utc()?
    let last_round_trip = last.to_system_time().to_utc()?
    testing.assert(first == first_round_trip)?
    testing.assert(last == last_round_trip)?
    testing.assert(first < last)?
    return
}

test utc_calendar_rejects_system_times_outside_supported_years {
    let _before = SystemTime.from_unix_seconds(-62167219201).to_utc() catch failure {
        testing.assert(failure.has_code("std.time.utc_datetime_out_of_range"))?
        let _after = SystemTime.from_unix_seconds(253402300800).to_utc() catch later_failure {
            testing.assert(later_failure.has_code("std.time.utc_datetime_out_of_range"))?
            return
        }
        return error.new("std.time.test", "a system time after year 9999 was accepted")
    }
    return error.new("std.time.test", "a system time before year 0000 was accepted")
}

test utc_calendar_rejects_invalid_clock_components {
    let _invalid_hour = UtcDateTime.new(2024, 1, 1, 24, 0, 0, 0) catch failure {
        testing.assert(failure.has_code("std.time.invalid_utc_datetime"))?
        let _invalid_second = UtcDateTime.new(2024, 1, 1, 0, 0, 60, 0) catch later_failure {
            testing.assert(later_failure.has_code("std.time.invalid_utc_datetime"))?
            return
        }
        return error.new("std.time.test", "a leap-second component was accepted")
    }
    return error.new("std.time.test", "an invalid hour was accepted")
}

test utc_calendar_order_is_lexicographic_over_valid_components {
    let morning = UtcDateTime.new(2024, 6, 30, 8, 0, 0, 0)?
    let evening = UtcDateTime.new(2024, 6, 30, 20, 0, 0, 0)?
    let tomorrow = UtcDateTime.new(2024, 7, 1, 0, 0, 0, 0)?
    testing.assert(morning < evening)?
    testing.assert(evening < tomorrow)?
    testing.assert(!(tomorrow < morning))?
    return
}

test rfc3339_round_trips_canonical_utc_text {
    let instant = SystemTime.parse_rfc3339("2024-02-29T12:34:56Z")?
    testing.assert(instant.unix_seconds() == 1709210096)?
    let text = instant.to_rfc3339()?
    testing.assert(text == "2024-02-29T12:34:56Z")?
    return
}

test rfc3339_scales_fractional_seconds_to_nanoseconds {
    let instant = SystemTime.parse_rfc3339("1970-01-01T00:00:00.1Z")?
    testing.assert(instant.unix_seconds() == 0)?
    testing.assert(instant.subsecond_nanoseconds() == 100000000)?
    let text = instant.to_rfc3339()?
    testing.assert(text == "1970-01-01T00:00:00.100000000Z")?
    return
}

test rfc3339_numeric_offsets_normalize_to_utc {
    let east = SystemTime.parse_rfc3339("1970-01-01T02:30:00+02:30")?
    let west = SystemTime.parse_rfc3339("1969-12-31T20:00:00-04:00")?
    let epoch = SystemTime.from_unix_seconds(0)
    testing.assert(east == epoch)?
    testing.assert(west == epoch)?
    return
}

test rfc3339_rejects_spellings_without_an_exact_instant {
    testing.assert(rejects_rfc3339("1970-01-01t00:00:00z"))?
    testing.assert(rejects_rfc3339("2016-12-31T23:59:60Z"))?
    testing.assert(rejects_rfc3339("1970-01-01T00:00:00-00:00"))?
    testing.assert(rejects_rfc3339("1970-01-01T00:00:00.1234567890Z"))?
    testing.assert(rejects_rfc3339("1970-01-01T00:00:00."))?
    testing.assert(rejects_rfc3339("1970-01-01T00:00:00+24:00"))?
    testing.assert(rejects_rfc3339("0000-01-01T00:00:00+00:01"))?
    return
}

test rfc3339_recoverable_generation_uses_the_supplied_allocator {
    let instant = SystemTime.parse_rfc3339("0000-01-01T00:00:00.000000001Z")?
    var allocator = mem.page_try_allocator()
    let text = instant.try_to_rfc3339(&+allocator)?
    testing.assert(text == "0000-01-01T00:00:00.000000001Z")?
    return
}

test target_counter_contract_has_a_bounded_frequency_and_wrapping_delta {
    let frequency = time.monotonic_frequency()
    testing.assert(frequency > 0 && frequency <= 4294967295)?
    testing.assert(time.monotonic_delta(18446744073709551615, 0) == 1)?
    return
}

test sleep_zero_returns_and_positive_wait_does_not_finish_early {
    let zero = Duration.from_seconds(0)
    sleep_blocking(&zero)?

    let requested = Duration.from_milliseconds(2)
    let start = Instant.now()
    sleep_blocking(&requested)?
    if start.elapsed() < requested {
        return error.new("std.time.test", "sleep returned before its requested duration")
    }
    return
}
