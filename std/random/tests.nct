//! Random-output transaction and scalar construction tests.

see ./index.nct

see ./random.nct

use /internal/entropy.EntropyResult
use /vec.Vec

test failed_fill_clears_the_complete_destination {
    var output: Vec<u8> = Vec [
        u8.truncate(1),
        u8.truncate(2),
        u8.truncate(3),
        u8.truncate(4),
        u8.truncate(5),
    ]
    finish_fill(&+output, EntropyResult.unavailable) catch failure {
        if !failure.has_code("std.random.unavailable") {
            return error.new("std.random.test", "failed fill returned the wrong public error")
        }
        var index: usize = 0
        while index < output.len() {
            if output[index] != 0 {
                return error.new("std.random.test", "failed fill retained generated bytes")
            }
            index += 1
        }
        return
    }
    return error.new("std.random.test", "unavailable entropy completed successfully")
}

test completed_fill_preserves_the_generated_destination {
    var output: Vec<u8> = Vec [u8.truncate(1), u8.truncate(2), u8.truncate(3)]
    finish_fill(&+output, EntropyResult.complete)?
    if output[0] != 1 || output[1] != 2 || output[2] != 3 {
        return error.new("std.random.test", "completed fill changed generated bytes")
    }
    return
}

test scalar_construction_uses_the_shared_little_endian_codec {
    let input: Vec<u8> = Vec [
        u8.truncate(1),
        u8.truncate(2),
        u8.truncate(3),
        u8.truncate(4),
        u8.truncate(5),
        u8.truncate(6),
        u8.truncate(7),
        u8.truncate(8),
    ]
    let expected: u64 = 578437695752307201
    if scalar_from_bytes(&input) != expected {
        return error.new("std.random.test", "random scalar byte order diverged from std.bytes")
    }
    return
}

test target_entropy_fills_more_than_one_native_request {
    var output: Vec<u8> = Vec.with_capacity(257)
    var index: usize = 0
    while index < 257 {
        output.push(0)
        index += 1
    }
    fill(&+output)?
    return
}
