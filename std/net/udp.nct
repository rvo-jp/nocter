//! Public UDP ownership and boundary-preserving receive adapters.

see ./index.nct
see ./tcp.nct
see ./errors.nct

use /internal/net
use /internal/net.{
    AddressAttempt,
    DatagramAttempt,
    DescriptorAttempt,
    SocketDescriptor,
    UnitAttempt,
}
use /time.Duration

struct UdpSocket {
    descriptor: SocketDescriptor
}

copy struct DatagramRead {
    source_address: SocketAddress
    copied_count: usize
    truncated: bool
}

construct UdpSocket {
    noalloc func bind(address: SocketAddress): Self! {
        match net.bind_udp(substrate_address(&address)) {
            DescriptorAttempt.ready(descriptor) {
                return UdpSocket { descriptor: move descriptor }
            }
            DescriptorAttempt.failed(failure) { return network_error(move failure) }
        }
    }
}

noalloc func complete_datagram_unit(attempt: UnitAttempt): void! {
    match move attempt {
        UnitAttempt.ready { return }
        UnitAttempt.failed(failure) { return network_error(move failure) }
    }
}

noalloc func complete_datagram_receive(attempt: DatagramAttempt): DatagramRead! {
    match move attempt {
        DatagramAttempt.ready(source, copied_len, truncated) {
            return DatagramRead {
                source_address: public_address(source),
                copied_count: copied_len,
                truncated: truncated,
            }
        }
        DatagramAttempt.failed(failure) { return network_error(move failure) }
    }
}

instance UdpSocket {
    noalloc method &+self.connect(peer: SocketAddress): void! {
        return complete_datagram_unit(
            self.descriptor.connect_udp(substrate_address(&peer)),
        )
    }

    async method &+self.send(bytes: &[u8]): void! {
        return complete_datagram_unit(await self.descriptor.send_datagram_async(bytes))
    }

    async method &+self.send_with_timeout(bytes: &[u8], timeout: Duration): void! {
        return complete_datagram_unit(
            await self.descriptor.send_datagram_async_with_timeout(bytes, timeout),
        )
    }

    async method &+self.send_to(bytes: &[u8], target: SocketAddress): void! {
        return complete_datagram_unit(
            await self.descriptor.send_datagram_to_async(
                bytes,
                substrate_address(&target),
            ),
        )
    }

    async method &+self.send_to_with_timeout(
        bytes: &[u8],
        target: SocketAddress,
        timeout: Duration,
    ): void! {
        return complete_datagram_unit(
            await self.descriptor.send_datagram_to_async_with_timeout(
                bytes,
                substrate_address(&target),
                timeout,
            ),
        )
    }

    async method &+self.receive(buffer: &+[u8]): DatagramRead! {
        return complete_datagram_receive(
            await self.descriptor.receive_datagram_async(buffer),
        )
    }

    async method &+self.receive_with_timeout(
        buffer: &+[u8],
        timeout: Duration,
    ): DatagramRead! {
        return complete_datagram_receive(
            await self.descriptor.receive_datagram_async_with_timeout(buffer, timeout),
        )
    }

    noalloc blocking method &+self.send_blocking(bytes: &[u8]): void! {
        return complete_datagram_unit(self.descriptor.send_datagram(bytes))
    }

    noalloc blocking method &+self.send_to_blocking(
        bytes: &[u8],
        target: SocketAddress,
    ): void! {
        return complete_datagram_unit(
            self.descriptor.send_datagram_to(bytes, substrate_address(&target)),
        )
    }

    noalloc blocking method &+self.receive_blocking(buffer: &+[u8]): DatagramRead! {
        return complete_datagram_receive(self.descriptor.receive_datagram(buffer))
    }

    noalloc method &self.local_address(): SocketAddress! {
        match self.descriptor.local_address() {
            AddressAttempt.ready(address) { return public_address(address) }
            AddressAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &self.peer_address(): SocketAddress! {
        match self.descriptor.peer_address() {
            AddressAttempt.ready(address) { return public_address(address) }
            AddressAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &+self.set_read_timeout(timeout: Duration?): void {
        self.descriptor.set_read_timeout(timeout)
        return
    }

    noalloc method &self.read_timeout(): Duration? {
        return self.descriptor.read_timeout()
    }

    noalloc method &+self.set_write_timeout(timeout: Duration?): void {
        self.descriptor.set_write_timeout(timeout)
        return
    }

    noalloc method &self.write_timeout(): Duration? {
        return self.descriptor.write_timeout()
    }

    noalloc method &+self.close(): void {
        self.descriptor.close()
        return
    }
}

instance DatagramRead {
    noalloc method &self.source(): SocketAddress {
        return self.source_address
    }

    noalloc method &self.copied_len(): usize {
        return self.copied_count
    }

    noalloc method &self.was_truncated(): bool {
        return self.truncated
    }
}

noalloc drop UdpSocket(&+self) {
    self.descriptor.close()
    return
}
