//! One ownership state shared by asynchronous and blocking child-pipe interfaces.

see ./index.nct
see ./pipe_darwin.nct
see ./pipe_readiness_darwin.nct

use /internal/io
use /internal/os/darwin.{DescriptorReadAttempt, DescriptorWriteAttempt}
use /internal/os/darwin
use /internal/task
use /ptr

#target: "arm64-darwin"
struct PipeEndpoint {
    fd: usize
    open: bool
}

#target: "arm64-darwin"
noalloc func take_pipe_read(pipe: &+OwnedPipe): PipeEndpoint? {
    if !pipe.read_open { return none }
    pipe.read_open = false
    return PipeEndpoint { fd: pipe.read_fd, open: true }
}

#target: "arm64-darwin"
noalloc func take_pipe_write(pipe: &+OwnedPipe): PipeEndpoint? {
    if !pipe.write_open { return none }
    pipe.write_open = false
    return PipeEndpoint { fd: pipe.write_fd, open: true }
}

#target: "arm64-darwin"
noalloc func close_pipe_endpoint(endpoint: &+PipeEndpoint): void {
    if endpoint.open {
        close_raw_fd(endpoint.fd)
        endpoint.open = false
    }
    return
}

#target: "arm64-darwin"
noalloc func try_endpoint_read(
    endpoint: &PipeEndpoint,
    buffer: &+[u8],
): DescriptorReadAttempt {
    if buffer.len() == 0 { return DescriptorReadAttempt.ready(0) }
    return darwin.try_read_descriptor(
        endpoint.fd,
        ptr.addr(buffer.ptr()),
        buffer.len(),
    )
}

#target: "arm64-darwin"
noalloc func try_endpoint_write(
    endpoint: &PipeEndpoint,
    value: &[u8],
    offset: usize,
): DescriptorWriteAttempt {
    if offset >= value.len() { return DescriptorWriteAttempt.malformed }
    return darwin.try_write_descriptor(
        endpoint.fd,
        ptr.addr(value.ptr()) + offset,
        value.len() - offset,
    )
}

#target: "arm64-darwin"
noalloc func endpoint_error(errno: i32): error {
    return io.io_error_from_os(darwin.error_from_errno(darwin.errno(errno)))
}

#target: "arm64-darwin"
noalloc func malformed_endpoint_error(): error {
    return error.new("std.io.invalid_progress", "descriptor returned an invalid byte count")
}

#target: "arm64-darwin"
async func read_endpoint(endpoint: &+PipeEndpoint, buffer: &+[u8]): usize! {
    if !endpoint.open { return io.closed_stream_error() }
    loop {
        match try_endpoint_read(endpoint, buffer) {
            DescriptorReadAttempt.ready(count) { return count }
            DescriptorReadAttempt.interrupted {}
            DescriptorReadAttempt.would_block {
                await task.wait_descriptor_ready(endpoint.fd, false)
            }
            DescriptorReadAttempt.failed(errno) { return endpoint_error(errno) }
            DescriptorReadAttempt.malformed { return malformed_endpoint_error() }
        }
    }
}

#target: "arm64-darwin"
noalloc blocking func read_endpoint_blocking(
    endpoint: &+PipeEndpoint,
    buffer: &+[u8],
): usize! {
    if !endpoint.open { return io.closed_stream_error() }
    loop {
        match try_endpoint_read(endpoint, buffer) {
            DescriptorReadAttempt.ready(count) { return count }
            DescriptorReadAttempt.interrupted {}
            DescriptorReadAttempt.would_block {
                match poll_descriptor_once(endpoint.fd, false) {
                    DescriptorPollAttempt.ready {}
                    DescriptorPollAttempt.interrupted {}
                    DescriptorPollAttempt.failed(errno) { return endpoint_error(errno) }
                    DescriptorPollAttempt.malformed { return malformed_endpoint_error() }
                }
            }
            DescriptorReadAttempt.failed(errno) { return endpoint_error(errno) }
            DescriptorReadAttempt.malformed { return malformed_endpoint_error() }
        }
    }
}

#target: "arm64-darwin"
async func write_endpoint(endpoint: &+PipeEndpoint, value: &[u8]): void! {
    if !endpoint.open { return io.closed_stream_error() }
    var offset: usize = 0
    while offset < value.len() {
        match try_endpoint_write(endpoint, value, offset) {
            DescriptorWriteAttempt.ready(count) { offset += count }
            DescriptorWriteAttempt.interrupted {}
            DescriptorWriteAttempt.would_block {
                await task.wait_descriptor_ready(endpoint.fd, true)
            }
            DescriptorWriteAttempt.failed(errno) { return endpoint_error(errno) }
            DescriptorWriteAttempt.malformed { return malformed_endpoint_error() }
        }
    }
    return
}

#target: "arm64-darwin"
noalloc blocking func write_endpoint_blocking(
    endpoint: &+PipeEndpoint,
    value: &[u8],
): void! {
    if !endpoint.open { return io.closed_stream_error() }
    var offset: usize = 0
    while offset < value.len() {
        match try_endpoint_write(endpoint, value, offset) {
            DescriptorWriteAttempt.ready(count) { offset += count }
            DescriptorWriteAttempt.interrupted {}
            DescriptorWriteAttempt.would_block {
                match poll_descriptor_once(endpoint.fd, true) {
                    DescriptorPollAttempt.ready {}
                    DescriptorPollAttempt.interrupted {}
                    DescriptorPollAttempt.failed(errno) { return endpoint_error(errno) }
                    DescriptorPollAttempt.malformed { return malformed_endpoint_error() }
                }
            }
            DescriptorWriteAttempt.failed(errno) { return endpoint_error(errno) }
            DescriptorWriteAttempt.malformed { return malformed_endpoint_error() }
        }
    }
    return
}

noalloc drop PipeEndpoint(&+self) {
    close_pipe_endpoint(self)
    return
}
