//! Shared Darwin command launch and public failure policy.
//!
//! This source is the only command-to-child launch authority. Public spawn and closed operations
//! consume the same `LaunchedChild` fact; only the consumer decides whether a rejected launch is
//! returned immediately or after exact child observation.

see ./index.nct
see ./command.nct
see ./child_owner_darwin.nct
see ./child_darwin.nct
see ./command_child_darwin.nct
see ./darwin.nct
see ./launch_report_darwin.nct
see ./launch_plan_darwin.nct
see ./pipe_darwin.nct
see ./spawn_io_darwin.nct
see ./subprocess_darwin.nct

use /internal/os.OSErrorKind
use /internal/os/darwin

#target: "arm64-darwin"
enum SpawnFork {
    child(prepared: PreparedCommand, report: OwnedPipe, io: SpawnIoSession)
    parent(
        prepared: PreparedCommand,
        child: ChildOwner,
        report: OwnedPipe,
        io: SpawnIoSession,
    )
}

#target: "arm64-darwin"
enum LaunchPreparationFailure {
    input
    output
    process
}

#target: "arm64-darwin"
enum SpawnForkAttempt {
    ready(value: SpawnFork)
    failed(reason: LaunchPreparationFailure)
}

/// One created child paired with the exact close-on-exec observation from that launch.
#target: "arm64-darwin"
struct LaunchedChild {
    child: Child
    launch: LaunchReportAttempt
}

#target: "arm64-darwin"
enum CommandLaunchAttempt {
    launched(value: LaunchedChild)
    failed(reason: LaunchPreparationFailure)
}

#target: "arm64-darwin"
noalloc func spawn_failed(): error {
    return error.new("std.process.spawn_failed", "child process creation failed")
}

#target: "arm64-darwin"
noalloc func wait_failed(): error {
    return error.new("std.process.wait_failed", "child process status could not be observed")
}

#target: "arm64-darwin"
noalloc func capture_failed(): error {
    return error.new("std.process.capture_failed", "child output could not be captured")
}

#target: "arm64-darwin"
noalloc func input_failed(): error {
    return error.new("std.process.input_failed", "child input could not be written")
}

#target: "arm64-darwin"
noalloc func current_directory_failed(): error {
    return error.new(
        "std.process.current_directory_failed",
        "child working directory could not be entered",
    )
}

#target: "arm64-darwin"
noalloc func exec_failed(errno: i32): error {
    let os_error = darwin.error_from_errno(darwin.errno(errno))
    if os_error.kind is OSErrorKind.not_found {
        return error.new("std.process.not_found", "executable was not found")
    }
    if os_error.kind is OSErrorKind.not_directory {
        return error.new("std.process.not_found", "executable was not found")
    }
    if os_error.kind is OSErrorKind.permission_denied {
        return error.new("std.process.permission_denied", "executable permission was denied")
    }
    if os_error.kind is OSErrorKind.invalid_input {
        return error.new("std.process.invalid_input", "executable request was invalid")
    }
    return spawn_failed()
}

#target: "arm64-darwin"
noalloc func status_from_wait(outcome: WaitOutcome): ExitStatus! {
    match move outcome {
        WaitOutcome.exited(code) { return exited_status(code) }
        WaitOutcome.signaled(signal) { return signaled_status(signal) }
        WaitOutcome.failed(_) { return wait_failed() }
        WaitOutcome.invalid(_) { return wait_failed() }
    }
}

#target: "arm64-darwin"
noalloc func require_successful_launch(launch: LaunchReportAttempt): void! {
    match move launch {
        LaunchReportAttempt.executed { return }
        LaunchReportAttempt.input_setup_rejected(_) { return input_failed() }
        LaunchReportAttempt.output_setup_rejected(_) { return capture_failed() }
        LaunchReportAttempt.directory_rejected(_) { return current_directory_failed() }
        LaunchReportAttempt.exec_rejected(errno) { return exec_failed(errno) }
        LaunchReportAttempt.channel_failed(_) { return spawn_failed() }
        LaunchReportAttempt.malformed { return spawn_failed() }
    }
}

#target: "arm64-darwin"
func fork_spawn_command(command: Command, io: ProcessIo): SpawnForkAttempt {
    let prepared = prepare_command(move command)
    let streams = match create_spawn_io(move io) {
        SpawnIoAttempt.ready(session) { move session }
        SpawnIoAttempt.input_failed(_) {
            return SpawnForkAttempt.failed(LaunchPreparationFailure.input)
        }
        SpawnIoAttempt.output_failed(_) {
            return SpawnForkAttempt.failed(LaunchPreparationFailure.output)
        }
    }
    match create_launch_report_pipe() {
        PipeAttempt.failed(_) {
            drop streams
            return SpawnForkAttempt.failed(LaunchPreparationFailure.process)
        }
        PipeAttempt.ready(report) {
            match fork_process() {
                ForkAttempt.failed(_) {
                    drop report
                    drop streams
                    return SpawnForkAttempt.failed(LaunchPreparationFailure.process)
                }
                ForkAttempt.child {
                    return SpawnForkAttempt.ready(
                        SpawnFork.child(move prepared, move report, move streams),
                    )
                }
                ForkAttempt.parent(pid) {
                    return SpawnForkAttempt.ready(SpawnFork.parent(
                        move prepared,
                        own_child(pid),
                        move report,
                        move streams,
                    ))
                }
            }
        }
    }
}

#target: "arm64-darwin"
blocking func launch_command_blocking(command: Command, io: ProcessIo): CommandLaunchAttempt {
    match fork_spawn_command(move command, move io) {
        SpawnForkAttempt.failed(reason) { return CommandLaunchAttempt.failed(reason) }
        SpawnForkAttempt.ready(value) {
            match move value {
                SpawnFork.child(prepared, report, streams) {
                    exec_spawn_child(
                        prepared_path_address(&prepared),
                        prepared_argv_address(&prepared),
                        prepared_environment_address(&prepared),
                        prepared_working_directory_address(&prepared),
                        move report,
                        move streams,
                    )
                }
                SpawnFork.parent(prepared, child, report, streams) {
                    let endpoints = take_spawn_parent_endpoints(move streams)
                    let launch = read_launch_report(move report)
                    drop prepared
                    return CommandLaunchAttempt.launched(LaunchedChild {
                        child: make_child(move child, move endpoints),
                        launch: move launch,
                    })
                }
            }
        }
    }
}

#target: "arm64-darwin"
async func launch_command(command: Command, io: ProcessIo): CommandLaunchAttempt {
    match fork_spawn_command(move command, move io) {
        SpawnForkAttempt.failed(reason) { return CommandLaunchAttempt.failed(reason) }
        SpawnForkAttempt.ready(value) {
            match move value {
                SpawnFork.child(prepared, report, streams) {
                    exec_spawn_child(
                        prepared_path_address(&prepared),
                        prepared_argv_address(&prepared),
                        prepared_environment_address(&prepared),
                        prepared_working_directory_address(&prepared),
                        move report,
                        move streams,
                    )
                }
                SpawnFork.parent(prepared, child, report, streams) {
                    let endpoints = take_spawn_parent_endpoints(move streams)
                    let launch = await read_launch_report_async(move report)
                    drop prepared
                    return CommandLaunchAttempt.launched(LaunchedChild {
                        child: make_child(move child, move endpoints),
                        launch: move launch,
                    })
                }
            }
        }
    }
}

#target: "arm64-darwin"
blocking func spawn_command(command: Command, io: ProcessIo): Child! {
    let launched = match launch_command_blocking(move command, move io) {
        CommandLaunchAttempt.launched(value) { move value }
        CommandLaunchAttempt.failed(_) { return spawn_failed() }
    }
    require_successful_launch(move launched.launch)?
    return move launched.child
}

#target: "arm64-darwin"
async func spawn_command_async(command: Command, io: ProcessIo): Child! {
    let attempt = await launch_command(move command, move io)
    let launched = match move attempt {
        CommandLaunchAttempt.launched(value) { move value }
        CommandLaunchAttempt.failed(_) { return spawn_failed() }
    }
    require_successful_launch(move launched.launch)?
    return move launched.child
}

instance Command {
    async method self.spawn(io: ProcessIo): Child! {
        return await spawn_command_async(move self, move io)?
    }

    blocking method self.spawn_blocking(io: ProcessIo): Child! {
        return spawn_command(move self, move io)?
    }
}
