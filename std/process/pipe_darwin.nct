//! Owning Darwin pipe endpoints.
//!
//! This source is the sole owner of close-on-exec pipe creation, descriptor normalization, and
//! endpoint closure. Consumers receive one owner rather than unrelated raw descriptor integers.

see ./index.nct

use /internal/os/darwin.SyscallPairResult
use /internal/os/darwin.SyscallResult
use /internal/os/darwin

#target: "arm64-darwin"
struct OwnedPipe {
    read_fd: usize
    write_fd: usize
    read_open: bool
    write_open: bool
}

#target: "arm64-darwin"
enum PipeAttempt {
    ready(pipe: OwnedPipe)
    failed(errno: i32)
}

#target: "arm64-darwin"
enum PipeConfigurationAttempt {
    ready
    failed(errno: i32)
}

#target: "arm64-darwin"
enum DescriptorInstallAttempt {
    ready
    failed(errno: i32)
    invalid
}

/// Creates one raw pipe without exposing the target syscall identity.
#target: "arm64-darwin"
noalloc primitive func create_pipe_raw(): SyscallPairResult

/// Duplicates one descriptor into the private close-on-exec range.
#target: "arm64-darwin"
noalloc primitive func duplicate_cloexec_raw(fd: usize): SyscallResult

/// Reads one descriptor's current status flags.
#target: "arm64-darwin"
noalloc primitive func descriptor_status_flags_raw(fd: usize): SyscallResult

/// Replaces one descriptor's status flags.
#target: "arm64-darwin"
noalloc primitive func set_descriptor_status_flags_raw(
    fd: usize,
    flags: usize,
): SyscallResult

/// Prevents a broken pipe from terminating the process while this descriptor is used.
#target: "arm64-darwin"
noalloc primitive func suppress_broken_pipe_raw(fd: usize): SyscallResult

/// Installs one descriptor at an exact child-side destination.
#target: "arm64-darwin"
noalloc primitive func install_descriptor_raw(
    source_fd: usize,
    target_fd: usize,
): SyscallResult

#target: "arm64-darwin"
noalloc func duplicate_cloexec(fd: usize): SyscallResult {
    var result = duplicate_cloexec_raw(fd)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = duplicate_cloexec_raw(fd)
    }
    return result
}

#target: "arm64-darwin"
noalloc func close_raw_fd(fd: usize): void {
    // A failed close is never retried. Darwin may already have consumed the descriptor, and a
    // retry could close an unrelated descriptor allocated in the meantime.
    let _ = darwin.close_descriptor(fd)
    return
}

#target: "arm64-darwin"
noalloc func create_cloexec_pipe(): PipeAttempt {
    let raw = create_pipe_raw()
    if raw.errno != 0 { return PipeAttempt.failed(raw.errno) }

    let normalized_read = duplicate_cloexec(raw.first)
    if normalized_read.errno != 0 {
        close_raw_fd(raw.first)
        close_raw_fd(raw.second)
        return PipeAttempt.failed(normalized_read.errno)
    }

    let normalized_write = duplicate_cloexec(raw.second)
    if normalized_write.errno != 0 {
        close_raw_fd(normalized_read.value)
        close_raw_fd(raw.first)
        close_raw_fd(raw.second)
        return PipeAttempt.failed(normalized_write.errno)
    }

    close_raw_fd(raw.first)
    close_raw_fd(raw.second)
    return PipeAttempt.ready(OwnedPipe {
        read_fd: normalized_read.value,
        write_fd: normalized_write.value,
        read_open: true,
        write_open: true,
    })
}

#target: "arm64-darwin"
noalloc func pipe_read_fd(pipe: &OwnedPipe): usize {
    return pipe.read_fd
}

#target: "arm64-darwin"
noalloc func pipe_write_fd(pipe: &OwnedPipe): usize {
    return pipe.write_fd
}

#target: "arm64-darwin"
noalloc func close_pipe_read(pipe: &+OwnedPipe): void {
    if pipe.read_open {
        close_raw_fd(pipe.read_fd)
        pipe.read_open = false
    }
    return
}

#target: "arm64-darwin"
noalloc func close_pipe_write(pipe: &+OwnedPipe): void {
    if pipe.write_open {
        close_raw_fd(pipe.write_fd)
        pipe.write_open = false
    }
    return
}

#target: "arm64-darwin"
noalloc func configure_descriptor_nonblocking(fd: usize): PipeConfigurationAttempt {
    var flags = descriptor_status_flags_raw(fd)
    while flags.errno == darwin.ERRNO_INTERRUPTED {
        flags = descriptor_status_flags_raw(fd)
    }
    if flags.errno != 0 { return PipeConfigurationAttempt.failed(flags.errno) }
    var configured_flags = flags.value
    if configured_flags / darwin.O_NONBLOCK % 2 == 0 {
        configured_flags += darwin.O_NONBLOCK
    }
    var result = set_descriptor_status_flags_raw(fd, configured_flags)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = set_descriptor_status_flags_raw(fd, configured_flags)
    }
    if result.errno != 0 { return PipeConfigurationAttempt.failed(result.errno) }
    return PipeConfigurationAttempt.ready
}

#target: "arm64-darwin"
noalloc func configure_pipe_reader_for_async_io(pipe: &OwnedPipe): PipeConfigurationAttempt {
    return configure_descriptor_nonblocking(pipe_read_fd(pipe))
}

#target: "arm64-darwin"
noalloc func configure_pipe_writer_for_async_io(pipe: &OwnedPipe): PipeConfigurationAttempt {
    var result = suppress_broken_pipe_raw(pipe_write_fd(pipe))
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = suppress_broken_pipe_raw(pipe_write_fd(pipe))
    }
    if result.errno != 0 { return PipeConfigurationAttempt.failed(result.errno) }
    return configure_descriptor_nonblocking(pipe_write_fd(pipe))
}

#target: "arm64-darwin"
noalloc func install_descriptor(source_fd: usize, target_fd: usize): DescriptorInstallAttempt {
    var result = install_descriptor_raw(source_fd, target_fd)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = install_descriptor_raw(source_fd, target_fd)
    }
    if result.errno != 0 { return DescriptorInstallAttempt.failed(result.errno) }
    if result.value != target_fd { return DescriptorInstallAttempt.invalid }
    return DescriptorInstallAttempt.ready
}

noalloc drop OwnedPipe(&+self) {
    close_pipe_read(self)
    close_pipe_write(self)
    return
}
