//! Built-in error payload construction.

see ./index.nct

noalloc primitive func new_error(code: &str, message: &str): error

noalloc primitive func context_error(value: error, message: &str): error

noalloc primitive func error_code(value: &error): &str from value

noalloc primitive func error_message(value: &error): &str from value

construct error {
    noalloc func new(code: &str, message: &str): Self {
        return new_error(code, message)
    }
}

instance error {
    noalloc method self.context(message: &str): Self {
        return context_error(move self, message)
    }

    noalloc method &self.code(): &str from self {
        return error_code(self)
    }

    noalloc method &self.message(): &str from self {
        return error_message(self)
    }

    noalloc method &self.has_code(code: &str): bool {
        return error_code(self) == code
    }
}
