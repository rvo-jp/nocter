//! File ownership and Darwin descriptor operations.

see ./index.nct
see ./byte_helpers.nct
see ./file_position.nct
see ./file_identity.nct

use /internal/os/darwin.SyscallResult
use /internal/os/darwin
use /internal/io
use /internal/path as internal_path
use /internal/ptr as internal_ptr
use /mem
use /ptr

#target: "arm64-darwin"
blocking func open_read_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_READ_ONLY)?
}

#target: "arm64-darwin"
blocking func create_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_CREATE_TRUNCATE)?
}

#target: "arm64-darwin"
blocking func create_new_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_CREATE_NEW)?
}

#target: "arm64-darwin"
blocking func append_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_CREATE_APPEND)?
}

#target: "arm64-darwin"
blocking func copy_destination_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_COPY_DESTINATION)?
}

#target: "arm64-darwin"
blocking func open_directory_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_DIRECTORY_ONLY)?
}

#target: "arm64-darwin"
blocking func open_fd(path: &str, flags: usize): usize! {
    let argument = internal_path.target_path_argument(path)?

    var result: SyscallResult = darwin.syscall3(
        darwin.SYS_OPEN,
        internal_path.target_path_address(&argument),
        flags,
        darwin.CREATE_MODE,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(
            darwin.SYS_OPEN,
            internal_path.target_path_address(&argument),
            flags,
            darwin.CREATE_MODE,
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return result.value
}

enum ReadProgress {
    retry
    complete(count: usize)
}

#target: "arm64-darwin"
noalloc func classify_read_result(result: SyscallResult, capacity: usize): ReadProgress! {
    if result.errno == darwin.ERRNO_INTERRUPTED {
        return ReadProgress.retry
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return ReadProgress.complete(validate_read_count(result.value, capacity)?)
}

#target: "arm64-darwin"
blocking func read_fd(fd: usize, buffer: &+[u8]): usize! {
    var count: usize = 0
    var complete: bool = false
    while !complete {
        let result = darwin.syscall3(
            darwin.SYS_READ,
            fd,
            ptr.addr(buffer.ptr()),
            buffer.len(),
        )
        match classify_read_result(result, buffer.len())? {
            ReadProgress.retry {}
            ReadProgress.complete(received) {
                count = received
                complete = true
            }
        }
    }
    return count
}

#target: "arm64-darwin"
blocking func read_at_fd(fd: usize, buffer: &+[u8], offset: u64): usize! {
    let target_offset = checked_file_offset(offset)?
    var result = darwin.syscall4(
        darwin.SYS_PREAD,
        fd,
        ptr.addr(buffer.ptr()),
        buffer.len(),
        target_offset,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall4(
            darwin.SYS_PREAD,
            fd,
            ptr.addr(buffer.ptr()),
            buffer.len(),
            target_offset,
        )
    }
    return classify_completed_read(result, buffer.len())?
}

#target: "arm64-darwin"
noalloc func classify_completed_read(result: SyscallResult, capacity: usize): usize! {
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return validate_read_count(result.value, capacity)?
}

noalloc func checked_file_offset(offset: u64): usize! {
    if offset > 9223372036854775807 {
        return error.new("std.io.offset_out_of_range", "file offset is out of range")
    }
    return offset as usize
}

#target: "arm64-darwin"
blocking func seek_fd(fd: usize, from: SeekFrom): usize! {
    match move from {
        SeekFrom.start(position) {
            return seek_fd_from(fd, absolute_file_position(position)?, darwin.SEEK_FROM_START)?
        }
        SeekFrom.end(displacement) {
            return seek_fd_from(fd, displacement, darwin.SEEK_FROM_END)?
        }
        SeekFrom.current(displacement) {
            return seek_fd_from(fd, displacement, darwin.SEEK_FROM_CURRENT)?
        }
    }
}

#target: "arm64-darwin"
noalloc blocking func seek_fd_from(fd: usize, displacement: i64, origin: usize): usize! {
    var result = darwin.syscall3_signed(
        darwin.SYS_LSEEK,
        fd,
        displacement,
        origin,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3_signed(
            darwin.SYS_LSEEK,
            fd,
            displacement,
            origin,
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return result.value
}

#target: "arm64-darwin"
blocking func truncate_fd(fd: usize, length: usize): void! {
    if length > 9223372036854775807 {
        return error.new("std.io.offset_out_of_range", "file length is out of range")
    }
    var result = darwin.syscall2(darwin.SYS_FTRUNCATE, fd, length)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall2(darwin.SYS_FTRUNCATE, fd, length)
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return
}

#target: "arm64-darwin"
func close_fd(fd: usize): void {
    // A failed close is deliberately not retried: Darwin may have consumed the
    // descriptor even when reporting an interruption, and retrying could close
    // an unrelated descriptor that another operation has reused.
    let _ = darwin.close_descriptor(fd)
    return
}

enum BlockingFileState {
    owned_open
    borrowed_open
    closed
}

struct BlockingFile {
    fd: usize
    state: BlockingFileState
}

construct BlockingFile {
    blocking func open(path: &str): Self! {
        let fd = open_read_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }

    blocking func create(path: &str): Self! {
        let fd = create_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }

    blocking func create_new(path: &str): Self! {
        let fd = create_new_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }

    blocking func append(path: &str): Self! {
        let fd = append_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }

    blocking func open_copy_destination(path: &str): Self! {
        let fd = copy_destination_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }

    blocking func open_directory(path: &str): Self! {
        let fd = open_directory_fd(path)?
        return BlockingFile { fd: fd, state: BlockingFileState.owned_open }
    }
}

#target: "arm64-darwin"
blocking func observe_blocking_file_identity(file: &BlockingFile): FileIdentity! {
    require_open(file)?
    var allocator = mem.page_try_allocator()
    var storage = allocator.try_alloc(darwin.STAT_BUFFER_SIZE, 8)?
    var result = darwin.syscall2(
        darwin.SYS_FSTAT64,
        file.fd,
        ptr.addr(storage.bytes().ptr()),
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall2(
            darwin.SYS_FSTAT64,
            file.fd,
            ptr.addr(storage.bytes().ptr()),
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    let device_pointer: *u32 = internal_ptr.from_addr(ptr.addr(storage.bytes().ptr()))
    let inode_pointer: *u64 = internal_ptr.from_addr(ptr.addr(storage.bytes().ptr()))
    let device: u32 = internal_ptr.take_value_at_ptr(device_pointer, darwin.STAT_DEVICE_OFFSET)
    let inode: u64 = internal_ptr.take_value_at_ptr(inode_pointer, darwin.STAT_INODE_OFFSET)
    return file_identity(device as u64, inode)
}

blocking func blocking_files_share_identity(
    left: &BlockingFile,
    right: &BlockingFile,
): bool! {
    let left_identity = observe_blocking_file_identity(left)?
    let right_identity = observe_blocking_file_identity(right)?
    return same_file_identity(left_identity, right_identity)
}

noalloc func require_open(file: &BlockingFile): void! {
    if file.state is BlockingFileState.closed {
        return io.closed_stream_error()
    }
    return
}

blocking func read(file: &+BlockingFile, buffer: &+[u8]): usize! {
    require_open(file)?
    return read_fd(file.fd, buffer)?
}

func close(file: &+BlockingFile): void {
    if file.state is BlockingFileState.owned_open {
        close_fd(file.fd)
    }
    file.state = BlockingFileState.closed
    return
}

instance BlockingFile {
    noalloc method &+self.close(): void {
        close(self)
        return
    }

    blocking method &+self.read_blocking(buffer: &+[u8]): usize! {
        return read(self, buffer)?
    }

    noalloc blocking method &+self.position_blocking(): usize! {
        return self.seek_blocking(SeekFrom.current(0))?
    }

    noalloc blocking method &+self.seek_blocking(from: SeekFrom): usize! {
        require_open(self)?
        return seek_fd(self.fd, move from)?
    }

    noalloc blocking method &+self.truncate_blocking(length: usize): void! {
        require_open(self)?
        truncate_fd(self.fd, length)?
        return
    }

    noalloc blocking method &+self.read_at_blocking(buffer: &+[u8], offset: u64): usize! {
        require_open(self)?
        return read_at_fd(self.fd, buffer, offset)?
    }
}

noalloc drop BlockingFile(&+self) {
    close(self)
    return
}
