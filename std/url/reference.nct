//! Non-owning path, query, and fragment classification for URL references.

see ./failure.nct

struct ReferenceTail {
    path_start: usize
    path_end: usize
    query_start: usize
    query_end: usize
    has_query: bool
    fragment_start: usize
    fragment_end: usize
    has_fragment: bool
}

noalloc func parse_reference_tail(text: &str, start: usize): UrlAttempt<ReferenceTail> {
    if start > text.len() { return invalid_url() }
    var path_end = start
    while path_end < text.len() && text[path_end] != 63 && text[path_end] != 35 {
        path_end += 1
    }

    var query_start = path_end
    var query_end = path_end
    var has_query = false
    var fragment_start = path_end
    if path_end < text.len() && text[path_end] == 63 {
        has_query = true
        query_start = path_end + 1
        query_end = query_start
        while query_end < text.len() && text[query_end] != 35 { query_end += 1 }
        fragment_start = query_end
    }

    var fragment_value_start = fragment_start
    var has_fragment = false
    if fragment_start < text.len() {
        if text[fragment_start] != 35 { return invalid_url() }
        has_fragment = true
        fragment_value_start = fragment_start + 1
    }

    return UrlAttempt.success(ReferenceTail {
        path_start: start,
        path_end: path_end,
        query_start: query_start,
        query_end: query_end,
        has_query: has_query,
        fragment_start: fragment_value_start,
        fragment_end: text.len(),
        has_fragment: has_fragment,
    })
}
