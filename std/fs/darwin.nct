//! Darwin filesystem operations and native metadata decoding.

see ./index.nct
see ./filesystem.nct

use /internal/io
use /internal/os.OSErrorKind
use /internal/os/darwin.SyscallResult
use /internal/os/darwin
use /internal/path as internal_path
use /internal/ptr as internal_ptr
use /mem.RawBuffer
use /mem
use /ptr
use /time.SystemTime

enum CreateDirectoryAttempt {
    created
    already_exists
}

#target: "arm64-darwin"
struct DarwinStatQuery {
    result: SyscallResult
    storage: RawBuffer
}

enum MetadataQuery {
    follow_final_link
    inspect_final_link
}

#target: "arm64-darwin"
blocking func stat_path(path: &str, query: MetadataQuery): DarwinStatQuery! {
    let argument = internal_path.target_path_argument(path)?
    var allocator = mem.page_try_allocator()
    let storage = allocator.try_alloc(darwin.STAT_BUFFER_SIZE, 8)?
    var operation = darwin.SYS_STAT64
    if query is MetadataQuery.inspect_final_link {
        operation = darwin.SYS_LSTAT64
    }
    var result = darwin.syscall2(
        operation,
        internal_path.target_path_address(&argument),
        ptr.addr(storage.bytes().ptr()),
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall2(
            operation,
            internal_path.target_path_address(&argument),
            ptr.addr(storage.bytes().ptr()),
        )
    }
    return DarwinStatQuery { result: result, storage: move storage }
}

#target: "arm64-darwin"
blocking func metadata_target(path: &str): Metadata! {
    let query = stat_path(path, MetadataQuery.follow_final_link)?
    if query.result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(query.result.errno)))
    }

    return metadata_from_query(&query)?
}

#target: "arm64-darwin"
blocking func symlink_metadata_target(path: &str): Metadata! {
    let query = stat_path(path, MetadataQuery.inspect_final_link)?
    if query.result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(query.result.errno)))
    }

    return metadata_from_query(&query)?
}

#target: "arm64-darwin"
blocking func create_symlink_target(target: &str, link: &str): void! {
    let target_argument = internal_path.target_path_argument(target)?
    let link_argument = internal_path.target_path_argument(link)?
    let result = darwin.syscall2(
        darwin.SYS_SYMLINK,
        internal_path.target_path_address(&target_argument),
        internal_path.target_path_address(&link_argument),
    )
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return
}

#target: "arm64-darwin"
blocking func read_link_target(path: &str, destination: &+[u8]): usize! {
    let argument = internal_path.target_path_argument(path)?
    var result = darwin.syscall3(
        darwin.SYS_READLINK,
        internal_path.target_path_address(&argument),
        ptr.addr(destination.ptr()),
        destination.len(),
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(
            darwin.SYS_READLINK,
            internal_path.target_path_address(&argument),
            ptr.addr(destination.ptr()),
            destination.len(),
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    if result.value > destination.len() {
        return error.new(
            "std.io.invalid_target_result",
            "read-link operation exceeded its destination buffer",
        )
    }
    return result.value
}

#target: "arm64-darwin"
blocking func canonicalize_target(path: &str, destination: &+[u8]): usize! {
    if destination.len() < darwin.MAX_PATH_LEN {
        return error.new(
            "std.io.invalid_target_result",
            "canonical-path destination is smaller than the target ABI requires",
        )
    }
    let argument = internal_path.target_path_argument(path)?
    var opened = darwin.syscall3(
        darwin.SYS_OPEN,
        internal_path.target_path_address(&argument),
        darwin.O_EVENT_ONLY_CLOSE_ON_EXEC,
        0,
    )
    while opened.errno == darwin.ERRNO_INTERRUPTED {
        opened = darwin.syscall3(
            darwin.SYS_OPEN,
            internal_path.target_path_address(&argument),
            darwin.O_EVENT_ONLY_CLOSE_ON_EXEC,
            0,
        )
    }
    if opened.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(opened.errno)))
    }
    let fd = opened.value
    var query = darwin.syscall3(
        darwin.SYS_FCNTL,
        fd,
        darwin.F_GETPATH,
        ptr.addr(destination.ptr()),
    )
    while query.errno == darwin.ERRNO_INTERRUPTED {
        query = darwin.syscall3(
            darwin.SYS_FCNTL,
            fd,
            darwin.F_GETPATH,
            ptr.addr(destination.ptr()),
        )
    }
    let closed = darwin.close_descriptor(fd)
    if query.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(query.errno)))
    }
    if closed.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(closed.errno)))
    }
    var index: usize = 0
    while index < destination.len() {
        if destination[index] == 0 { return index }
        index += 1
    }
    return error.new(
        "std.io.invalid_target_result",
        "canonical-path operation did not terminate its result",
    )
}

#target: "arm64-darwin"
func metadata_from_query(query: &DarwinStatQuery): Metadata! {
    let address: usize = ptr.addr(query.storage.bytes().ptr())
    let mode_pointer: *u16 = internal_ptr.from_addr(address)
    let size_pointer: *u64 = internal_ptr.from_addr(address)
    let modified_seconds_pointer: *i64 = internal_ptr.from_addr(address)
    let modified_nanoseconds_pointer: *u64 = internal_ptr.from_addr(address)
    let mode: u16 = internal_ptr.take_value_at_ptr(mode_pointer, darwin.STAT_MODE_OFFSET)
    var file_type = FileType.other
    if mode >= darwin.STAT_MODE_REGULAR && mode < darwin.STAT_MODE_REGULAR + 4096 {
        file_type = FileType.regular
    } else if mode >= darwin.STAT_MODE_DIRECTORY && mode < darwin.STAT_MODE_DIRECTORY + 4096 {
        file_type = FileType.directory
    } else if mode >= darwin.STAT_MODE_SYMBOLIC_LINK
        && mode < darwin.STAT_MODE_SYMBOLIC_LINK + 4096 {
        file_type = FileType.symlink
    }
    let len: u64 = internal_ptr.take_value_at_ptr(size_pointer, darwin.STAT_SIZE_OFFSET)
    let modified_seconds: i64 = internal_ptr.take_value_at_ptr(
        modified_seconds_pointer,
        darwin.STAT_MODIFIED_SECONDS_OFFSET,
    )
    let modified_nanoseconds: u64 = internal_ptr.take_value_at_ptr(
        modified_nanoseconds_pointer,
        darwin.STAT_MODIFIED_NANOSECONDS_OFFSET,
    )
    let modified = SystemTime.from_unix_parts(modified_seconds, modified_nanoseconds) catch _ {
        return error.new("std.fs.invalid_metadata_time", "target metadata contains an invalid time")
    }
    return Metadata { file_type: file_type, len: len, modified: modified }
}

#target: "arm64-darwin"
blocking func existing_path_is_directory_target(path: &str): bool! {
    let query = stat_path(path, MetadataQuery.follow_final_link)?
    if query.result.errno == 0 {
        let details = metadata_from_query(&query)?
        return details.is_directory()
    }

    let os_error = darwin.error_from_errno(darwin.errno(query.result.errno))
    if os_error.kind is OSErrorKind.not_found { return false }
    if os_error.kind is OSErrorKind.not_directory { return false }
    return io.io_error_from_os(os_error)
}

#target: "arm64-darwin"
blocking func exists_target(path: &str): bool! {
    let query = stat_path(path, MetadataQuery.follow_final_link)?
    if query.result.errno == 0 {
        return true
    }
    let os_error = darwin.error_from_errno(darwin.errno(query.result.errno))
    if os_error.kind is OSErrorKind.not_found {
        return false
    }
    if os_error.kind is OSErrorKind.not_directory {
        return false
    }
    return io.io_error_from_os(os_error)
}

#target: "arm64-darwin"
blocking func remove_file_target(path: &str): void! {
    let argument = internal_path.target_path_argument(path)?
    let result = darwin.syscall1(darwin.SYS_UNLINK, internal_path.target_path_address(&argument))
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return
}

#target: "arm64-darwin"
blocking func rename_target(source: &str, destination: &str): void! {
    let source_argument = internal_path.target_path_argument(source)?
    let destination_argument = internal_path.target_path_argument(destination)?
    let result = darwin.syscall2(
        darwin.SYS_RENAME,
        internal_path.target_path_address(&source_argument),
        internal_path.target_path_address(&destination_argument),
    )
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return
}

#target: "arm64-darwin"
blocking func create_directory_target(path: &str): CreateDirectoryAttempt! {
    let argument = internal_path.target_path_argument(path)?
    let result = darwin.syscall2(
        darwin.SYS_MKDIR,
        internal_path.target_path_address(&argument),
        darwin.CREATE_DIRECTORY_MODE,
    )
    if result.errno == 0 {
        return CreateDirectoryAttempt.created
    }
    let os_error = darwin.error_from_errno(darwin.errno(result.errno))
    if os_error.kind is OSErrorKind.already_exists {
        return CreateDirectoryAttempt.already_exists
    }
    return io.io_error_from_os(os_error)
}

#target: "arm64-darwin"
blocking func remove_directory_target(path: &str): void! {
    let argument = internal_path.target_path_argument(path)?
    let result = darwin.syscall1(
        darwin.SYS_RMDIR,
        internal_path.target_path_address(&argument),
    )
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return
}
