//! Directory-stream ownership and shared Darwin record decoding.

see ./index.nct

use /internal/io
use /internal/os/darwin.SyscallResult
use /internal/os/darwin
use /internal/path as internal_path
use /internal/ptr as internal_ptr
use /mem.RawBuffer
use /mem
use /path as path_module
use /path.Utf8Path
use /ptr
use /string.String

#target: "arm64-darwin"
const DIRECTORY_BUFFER_SIZE: usize = 16384

struct DirEntry {
    file_name: String
    path: Utf8Path
    file_type: FileType
}

enum ReadDirOwnership {
    open(owner: io.FileOwner)
    terminal
}

struct DirectoryBuffer {
    base: Utf8Path
    bytes: RawBuffer
    offset: usize
    len: usize
    finished: bool
}

enum DirectoryBufferStep {
    entry(value: DirEntry)
    refill
}

struct ReadDir {
    ownership: ReadDirOwnership
    buffer: DirectoryBuffer
}

struct BlockingReadDir {
    fd: usize
    is_open: bool
    buffer: DirectoryBuffer
}

instance DirEntry {
    method &self.file_name(): &str {
        return &self.file_name
    }

    method &self.path(): &Utf8Path {
        return &self.path
    }

    method &self.file_type(): FileType {
        return directory_entry_file_type(self)
    }
}

noalloc func directory_entry_path(entry: &DirEntry): &str from entry {
    return &entry.path
}

noalloc func directory_entry_file_type(entry: &DirEntry): FileType {
    return entry.file_type
}

noalloc func directory_entry_with_file_type(entry: DirEntry, file_type: FileType): DirEntry {
    var result = move entry
    result.file_type = file_type
    return move result
}

instance ReadDir {
    async method &+self.next(): DirEntry?! {
        return await next_directory_entry(self)
    }

    async method &+self.close(): void! {
        return await close_async_directory(self)
    }
}

instance BlockingReadDir {
    blocking method &+self.next_blocking(): DirEntry?! {
        return next_blocking_directory_entry(self)
    }

    method &+self.close(): void {
        close_blocking_directory(self)
        return
    }
}

async func read_dir(path: &str): ReadDir! {
    path_module.validate(path)?
    let buffer = new_directory_buffer(path)?
    var completion = await io.directory_open(path)
    io.validate_file_completion(&completion)?
    let owner = io.file_completion_take_owner(&+completion)
    return ReadDir {
        ownership: ReadDirOwnership.open(move owner),
        buffer: move buffer,
    }
}

blocking func read_dir_blocking(path: &str): BlockingReadDir! {
    let buffer = new_directory_buffer(path)?
    let fd = open_directory_blocking(path)?
    return BlockingReadDir {
        fd: fd,
        is_open: true,
        buffer: move buffer,
    }
}

func new_directory_buffer(path: &str): DirectoryBuffer! {
    let base = Utf8Path.new(path)?
    var allocator = mem.page_try_allocator()
    let bytes = allocator.try_alloc(DIRECTORY_BUFFER_SIZE, 8)?
    return DirectoryBuffer {
        base: move base,
        bytes: move bytes,
        offset: 0,
        len: 0,
        finished: false,
    }
}

noalloc func take_directory_owner(reader: &+ReadDir): io.FileOwner! {
    let previous = internal_ptr.replace_value(&+reader.ownership, ReadDirOwnership.terminal)
    match move previous {
        ReadDirOwnership.open(owner) { return move owner }
        ReadDirOwnership.terminal { return io.closed_stream_error() }
    }
}

noalloc func restore_directory_owner(
    reader: &+ReadDir,
    completion: &+io.FileCompletion,
): void {
    let owner = io.file_completion_take_owner(completion)
    reader.ownership = ReadDirOwnership.open(move owner)
    return
}

noalloc func terminate_async_directory(reader: &+ReadDir): void {
    let previous = internal_ptr.replace_value(&+reader.ownership, ReadDirOwnership.terminal)
    match move previous {
        ReadDirOwnership.open(owner) { let _ = move owner }
        ReadDirOwnership.terminal {}
    }
    finish_directory_buffer(&+reader.buffer)
    return
}

async func close_async_directory(reader: &+ReadDir): void! {
    let owner = take_directory_owner(reader) catch _ {
        finish_directory_buffer(&+reader.buffer)
        return
    }
    let completion = await io.file_close(move owner)
    finish_directory_buffer(&+reader.buffer)
    io.validate_file_completion(&completion)?
    return
}

async func next_directory_entry(reader: &+ReadDir): DirEntry?! {
    if reader.buffer.finished { return none }

    while true {
        let step = parse_directory_buffer(&+reader.buffer) catch failure {
            terminate_async_directory(reader)
            return move failure
        }
        match move step {
            DirectoryBufferStep.entry(value) { return move value }
            DirectoryBufferStep.refill {
                let owner = take_directory_owner(reader)?
                var completion = await io.directory_read(move owner, reader.buffer.bytes.bytes_mut())
                restore_directory_owner(reader, &+completion)
                io.validate_file_completion(&completion) catch failure {
                    terminate_async_directory(reader)
                    return move failure
                }
                let received = io.file_completion_transferred_byte_count(&completion)
                install_directory_bytes(&+reader.buffer, received) catch failure {
                    terminate_async_directory(reader)
                    return move failure
                }
                if received == 0 {
                    await close_async_directory(reader)?
                    return none
                }
            }
        }
    }
    return none
}

#target: "arm64-darwin"
blocking func open_directory_blocking(path: &str): usize! {
    let argument = internal_path.target_path_argument(path)?
    var result: SyscallResult = darwin.syscall3(
        darwin.SYS_OPEN,
        internal_path.target_path_address(&argument),
        darwin.OPEN_DIRECTORY_ONLY,
        0,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(
            darwin.SYS_OPEN,
            internal_path.target_path_address(&argument),
            darwin.OPEN_DIRECTORY_ONLY,
            0,
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return result.value
}

#target: "arm64-darwin"
blocking func refill_blocking_directory(reader: &+BlockingReadDir): usize! {
    var position: u64 = 0
    let buffer = reader.buffer.bytes.bytes_mut()
    var result: SyscallResult = darwin.read_directory_entries(reader.fd, buffer, &+position)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.read_directory_entries(reader.fd, buffer, &+position)
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    install_directory_bytes(&+reader.buffer, result.value)?
    return result.value
}

blocking func next_blocking_directory_entry(reader: &+BlockingReadDir): DirEntry?! {
    if reader.buffer.finished || !reader.is_open {
        return none
    }

    while true {
        let step = parse_directory_buffer(&+reader.buffer) catch failure {
            close_blocking_directory(reader)
            return move failure
        }
        match move step {
            DirectoryBufferStep.entry(value) { return move value }
            DirectoryBufferStep.refill {
                let received = refill_blocking_directory(reader) catch failure {
                    close_blocking_directory(reader)
                    return move failure
                }
                if received == 0 {
                    close_blocking_directory(reader)
                    return none
                }
            }
        }
    }
    return none
}

func install_directory_bytes(buffer: &+DirectoryBuffer, received: usize): void! {
    if received > buffer.bytes.bytes().len() {
        return invalid_directory_record()
    }
    buffer.offset = 0
    buffer.len = received
    if received == 0 { buffer.finished = true }
    return
}

func parse_directory_buffer(buffer: &+DirectoryBuffer): DirectoryBufferStep! {
    while buffer.offset < buffer.len {
        let record_start = buffer.offset
        let remaining = buffer.len - record_start
        if remaining <= darwin.DIRENT_NAME_OFFSET {
            return invalid_directory_record()
        }

        let record_address = ptr.addr(buffer.bytes.bytes().ptr()) + record_start
        let inode_pointer: *u64 = internal_ptr.from_addr(record_address)
        let length_pointer: *u16 = internal_ptr.from_addr(record_address)
        let type_pointer: *u8 = internal_ptr.from_addr(record_address)
        let inode: u64 = internal_ptr.take_value_at_ptr(inode_pointer, darwin.DIRENT_INODE_OFFSET)
        let record_len: usize = internal_ptr.take_value_at_ptr(
            length_pointer,
            darwin.DIRENT_RECORD_LENGTH_OFFSET,
        ) as usize
        let name_len: usize = internal_ptr.take_value_at_ptr(
            length_pointer,
            darwin.DIRENT_NAME_LENGTH_OFFSET,
        ) as usize
        let entry_type: u8 = internal_ptr.take_value_at_ptr(type_pointer, darwin.DIRENT_TYPE_OFFSET)

        if record_len <= darwin.DIRENT_NAME_OFFSET || record_len > remaining {
            return invalid_directory_record()
        }
        if name_len == 0 || name_len >= record_len - darwin.DIRENT_NAME_OFFSET {
            return invalid_directory_record()
        }

        let name_address = record_address + darwin.DIRENT_NAME_OFFSET
        let name_pointer: *u8 = internal_ptr.from_addr(name_address)
        let terminator: u8 = internal_ptr.take_value_at_ptr(name_pointer, name_len)
        if terminator != 0 {
            return invalid_directory_record()
        }

        buffer.offset += record_len
        if inode == 0 { continue }

        let name_bytes = internal_ptr.slice_from_raw_parts(name_pointer, name_len)
        let name = String.from_utf8(name_bytes) catch _ {
            return invalid_utf8_name()
        }
        if (&name as &str) == "." || (&name as &str) == ".." { continue }

        let path = buffer.base.join(&name)?
        return DirectoryBufferStep.entry(
            DirEntry {
                file_name: move name,
                path: move path,
                file_type: file_type_from_dirent(entry_type),
            },
        )
    }
    return DirectoryBufferStep.refill
}

func file_type_from_dirent(value: u8): FileType {
    if value == darwin.DIRENT_TYPE_REGULAR { return FileType.regular }
    if value == darwin.DIRENT_TYPE_DIRECTORY { return FileType.directory }
    if value == darwin.DIRENT_TYPE_SYMLINK { return FileType.symlink }
    return FileType.other
}

func finish_directory_buffer(buffer: &+DirectoryBuffer): void {
    buffer.finished = true
    buffer.offset = 0
    buffer.len = 0
    return
}

func close_blocking_directory(reader: &+BlockingReadDir): void {
    if reader.is_open {
        let _ = darwin.close_descriptor(reader.fd)
        reader.is_open = false
    }
    finish_directory_buffer(&+reader.buffer)
    return
}

func invalid_utf8_name(): error {
    return error.new("std.fs.invalid_utf8_name", "directory entry name is not valid UTF-8")
}

func invalid_directory_record(): error {
    return error.new("std.fs.invalid_directory_record", "OS returned an invalid directory record")
}

noalloc drop ReadDir(&+self) {
    terminate_async_directory(self)
    return
}

drop BlockingReadDir(&+self) {
    close_blocking_directory(self)
    return
}
