//! Allocation-free in-place slice ordering.

see ./index.nct

use /internal/ptr
use /internal/safety
use /order.TotalOrder

func sift_down<T>(values: &+[T], initial_root: usize, end: usize): void where T impl TotalOrder {
    var root = initial_root
    while root < end / 2 {
        var child = root * 2 + 1
        let right = child + 1
        if right < end && values[child] < values[right] {
            child = right
        }
        if !(values[root] < values[child]) {
            return
        }
        if !ptr.swap_slice_values(values, root, child) { return safety.invariant_abort() }
        root = child
    }
    return
}

instance[T] {
    method &+self.sort(): void where T impl TotalOrder {
        if self.len() < 2 {
            return
        }

        var root = self.len() / 2
        while root != 0 {
            root -= 1
            sift_down(self, root, self.len())
        }

        var end = self.len()
        while end > 1 {
            end -= 1
            if !ptr.swap_slice_values(self, 0, end) { return safety.invariant_abort() }
            sift_down(self, 0, end)
        }
        return
    }
}
