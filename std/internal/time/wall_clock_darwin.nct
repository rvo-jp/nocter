//! Darwin wall-clock result validation over the closed target boundary.

see ./index.nct

#target: "arm64-darwin"
const MICROSECONDS_PER_SECOND: u64 = 1000000

#target: "arm64-darwin"
const NANOSECONDS_PER_MICROSECOND: u64 = 1000

#target: "arm64-darwin"
noalloc func wall_clock_now(): WallClockAttempt {
    let (seconds, microseconds, errno) = wall_clock_raw()
    if errno != 0 || microseconds >= MICROSECONDS_PER_SECOND {
        return WallClockAttempt.failed
    }
    return WallClockAttempt.observed(WallClockValue {
        seconds: seconds,
        nanoseconds: microseconds * NANOSECONDS_PER_MICROSECOND,
    })
}
