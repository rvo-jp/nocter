//! Shared notification ownership above the target-specific descriptor owner.

see ./index.nct
see ./darwin.nct

use /internal/shared.SharedCell
use /internal/safety

struct NotificationHandle {
    notification: SharedCell<Notification>
    wait_descriptor: usize
}

construct NotificationHandle {
    func new(): Self! {
        let notification = Notification.new()?
        let wait_descriptor = notification.wait_descriptor()
        return NotificationHandle {
            notification: SharedCell<Notification>.new(move notification),
            wait_descriptor: wait_descriptor,
        }
    }
}

instance NotificationHandle {
    noalloc method &self.share(): Self {
        return NotificationHandle {
            notification: self.notification.share(),
            wait_descriptor: self.wait_descriptor,
        }
    }

    method &self.signal_best_effort(): void {
        var notification = self.notification.try_write() otherwise {
            return safety.invariant_abort()
        }
        notification.read().signal_best_effort()
        notification.unlock()
        return
    }

    async method &self.wait(): void! {
        await wait(self.wait_descriptor)?
        return
    }
}
