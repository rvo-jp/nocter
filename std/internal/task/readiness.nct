//! Semantic descriptor-readiness adapter over the compiler-owned primitive.

see ./index.nct

#target: "arm64-darwin"
primitive func descriptor_readiness_raw(
    descriptor: usize,
    writable: bool,
): future void

#target: "arm64-darwin"
primitive func descriptor_readiness_or_deadline_raw(
    descriptor: usize,
    writable: bool,
    deadline: u64,
): future void

#target: "arm64-darwin"
primitive func process_completion_raw(process: usize): future void

async func wait_descriptor_ready(descriptor: usize, writable: bool): void {
    await descriptor_readiness_raw(descriptor, writable)
    return
}

async func wait_descriptor_ready_or_deadline(
    descriptor: usize,
    writable: bool,
    deadline: u64,
): void {
    await descriptor_readiness_or_deadline_raw(descriptor, writable, deadline)
    return
}

async func wait_process_complete(process: usize): void {
    await process_completion_raw(process)
    return
}
