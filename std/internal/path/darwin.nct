//! Darwin UTF-8-to-C-path argument encoding.

see ./index.nct

use /mem.RawBuffer
use /mem as mem_module
use /internal/mem
use /path
use /ptr
use /internal/ptr as internal_ptr

#target: "arm64-darwin"
struct TargetPathArgument {
    storage: RawBuffer
}

#target: "arm64-darwin"
func target_path_argument(value: &str): TargetPathArgument! {
    path.validate(value)?
    let allocation_size: usize = mem.checked_add(value.len(), 1) otherwise {
        return error.new("std.io.invalid_input", "path length cannot be represented")
    }
    var allocator = mem_module.page_try_allocator()
    let storage = allocator.try_alloc(allocation_size, 1)?
    internal_ptr.copy_str_to_ptr(storage.bytes().ptr(), 0, value)
    internal_ptr.store_u8_to_ptr(storage.bytes().ptr(), allocation_size - 1, 0)
    return TargetPathArgument { storage: move storage }
}

#target: "arm64-darwin"
func target_path_address(value: &TargetPathArgument): usize {
    return ptr.addr(value.storage.bytes().ptr())
}
