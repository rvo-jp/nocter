//! Canonical Huffman construction and LSB-first symbol decoding.

see ./index.nct
see ./storage.nct

noalloc func build_huffman(lengths: &[u8; 288], symbol_count: usize): HuffmanBuild {
    if symbol_count > 288 { return HuffmanBuild.too_many_symbols }

    var counts: [usize; 16] = [0; 16]
    var symbol: usize = 0
    var max_bits: usize = 0
    while symbol < symbol_count {
        let length = lengths[symbol] as usize
        if length > 15 { return HuffmanBuild.invalid_length }
        counts[length] += 1
        if length > max_bits { max_bits = length }
        symbol += 1
    }

    let used = symbol_count - counts[0]
    if used == 0 { return HuffmanBuild.empty }

    var remaining: usize = 1
    var bits: usize = 1
    while bits <= 15 {
        remaining *= 2
        if counts[bits] > remaining { return HuffmanBuild.oversubscribed }
        remaining -= counts[bits]
        bits += 1
    }
    if remaining != 0 && !(used == 1 && counts[1] == 1) {
        return HuffmanBuild.incomplete
    }

    var offsets: [usize; 16] = [0; 16]
    bits = 1
    while bits < 15 {
        offsets[bits + 1] = offsets[bits] + counts[bits]
        bits += 1
    }

    var symbols: [usize; 288] = [0; 288]
    symbol = 0
    while symbol < symbol_count {
        let length = lengths[symbol] as usize
        if length != 0 {
            let destination = offsets[length]
            symbols[destination] = symbol
            offsets[length] += 1
        }
        symbol += 1
    }

    return HuffmanBuild.ready(HuffmanTable {
        counts: counts,
        symbols: symbols,
        max_bits: max_bits,
    })
}

noalloc func read_huffman(input: &+BitInput, table: &HuffmanTable): HuffmanRead {
    var code: usize = 0
    var first: usize = 0
    var symbol_index: usize = 0
    var bits: usize = 1
    while bits <= table.max_bits {
        let prefix = input.peek(bits as u64) otherwise { return HuffmanRead.needs_input }
        let bit = (prefix >> ((bits - 1) as u64)) as usize
        code += bit
        let count = table.counts[bits]
        if code < first + count {
            let consumed = input.take(bits as u64) otherwise { return HuffmanRead.invalid }
            if consumed != prefix { return HuffmanRead.invalid }
            return HuffmanRead.symbol(table.symbols[symbol_index + code - first])
        }
        symbol_index += count
        first = (first + count) * 2
        code *= 2
        bits += 1
    }
    return HuffmanRead.invalid
}
