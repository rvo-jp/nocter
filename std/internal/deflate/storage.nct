//! Private fixed-capacity DEFLATE state.

see ./index.nct

struct HuffmanTable {
    counts: [usize; 16]
    symbols: [usize; 288]
    max_bits: usize
}

construct HuffmanTable {
    noalloc func empty(): Self {
        return HuffmanTable {
            counts: [0; 16],
            symbols: [0; 288],
            max_bits: 0,
        }
    }
}
