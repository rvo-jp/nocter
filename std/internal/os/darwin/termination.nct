//! Process-owned Darwin termination event observation.

see ./index.nct

#target: "arm64-darwin"
noalloc primitive func process_termination_descriptor_raw(): SyscallResult

#target: "arm64-darwin"
noalloc primitive func process_termination_observe_raw(): SyscallResult

#target: "arm64-darwin"
noalloc func process_termination_descriptor(): SyscallResult {
    return process_termination_descriptor_raw()
}

#target: "arm64-darwin"
noalloc func try_observe_process_termination(): TerminationObservationAttempt {
    let result = process_termination_observe_raw()
    if result.errno == ERRNO_INTERRUPTED { return TerminationObservationAttempt.interrupted }
    if result.errno == ERRNO_WOULD_BLOCK { return TerminationObservationAttempt.pending }
    if result.errno != 0 { return TerminationObservationAttempt.failed(result.errno) }
    if result.value == 2 || result.value == 15 {
        return TerminationObservationAttempt.ready(result.value)
    }
    return TerminationObservationAttempt.malformed
}
