//! Executor-aware stream-listener acceptance over provider events.

see ./index.nct
see ./async_connection.nct
see ./async_wait.nct
see ./connection.nct
see ./connection_events.nct
see ./deadline.nct
see ./listener.nct

use /internal/net/darwin
use /internal/net/model.{NetworkAddress, NetworkListenerEvent, NetworkListenerState, NetworkOwner}
use /time.Duration

async func listen_stream_async(address: NetworkAddress): StreamListenerAttempt {
    var owner = darwin.listener_create(&address) otherwise {
        return StreamListenerAttempt.failed(NetworkFailure.invalid_target_result)
    }
    darwin.listener_start(&+owner)
    let descriptor = darwin.listener_event_descriptor(&owner)
    var listener = stream_listener_from_owner(move owner, descriptor, address)
    let deadline = operation_deadline(none)
    while true {
        let _ = await await_native_descriptor_before(descriptor, false, &deadline)
        let event = match &+listener.ownership {
            StreamListenerOwnership.open(active) {
                darwin.listener_try_next_event(active) otherwise { continue }
            }
            StreamListenerOwnership.closed {
                return StreamListenerAttempt.failed(NetworkFailure.closed)
            }
        }
        match move event {
            NetworkListenerEvent.state(state) {
                match move state {
                    NetworkListenerState.waiting {}
                    NetworkListenerState.ready {
                        let port = match &listener.ownership {
                            StreamListenerOwnership.open(active) { darwin.listener_port(active) }
                            StreamListenerOwnership.closed {
                                return StreamListenerAttempt.failed(NetworkFailure.closed)
                            }
                        }
                        listener.local_address_value = effective_listener_address(address, port)
                        return StreamListenerAttempt.ready(move listener)
                    }
                    NetworkListenerState.failed(failure) {
                        let normalized = provider_failure(move failure)
                        dispose_stream_listener(&+listener)
                        return StreamListenerAttempt.failed(move normalized)
                    }
                    NetworkListenerState.cancelled {
                        dispose_stream_listener(&+listener)
                        return StreamListenerAttempt.failed(NetworkFailure.closed)
                    }
                }
            }
            NetworkListenerEvent.accepted(connection) {
                darwin.connection_dispose(move connection)
            }
            NetworkListenerEvent.adoption_failed(_) {
                dispose_stream_listener(&+listener)
                return StreamListenerAttempt.failed(NetworkFailure.invalid_target_result)
            }
            NetworkListenerEvent.malformed {
                dispose_stream_listener(&+listener)
                return StreamListenerAttempt.failed(NetworkFailure.invalid_target_result)
            }
        }
    }
    dispose_stream_listener(&+listener)
    return StreamListenerAttempt.failed(NetworkFailure.invalid_target_result)
}

async func accepted_stream_async_before(
    owner: NetworkOwner,
    deadline: &OperationDeadline,
): StreamListenerAcceptAttempt {
    match await start_stream_connection_async_before(move owner, deadline) {
        StreamConnectionAttempt.ready(connection) {
            var ready = move connection
            match ready.peer_address() {
                AddressAttempt.ready(peer) {
                    return StreamListenerAcceptAttempt.ready(move ready, peer)
                }
                AddressAttempt.failed(failure) {
                    dispose_stream_connection(&+ready)
                    return StreamListenerAcceptAttempt.failed(move failure)
                }
            }
        }
        StreamConnectionAttempt.failed(failure) {
            return StreamListenerAcceptAttempt.failed(move failure)
        }
    }
}

async func accept_stream_async_before(
    listener: &+StreamListener,
    deadline: &OperationDeadline,
): StreamListenerAcceptAttempt {
    while true {
        if listener.ownership is StreamListenerOwnership.closed {
            return StreamListenerAcceptAttempt.failed(NetworkFailure.closed)
        }
        if !await await_native_descriptor_before(
            listener.event_descriptor,
            false,
            deadline,
        ) {
            return StreamListenerAcceptAttempt.failed(NetworkFailure.timed_out)
        }
        let event = match &+listener.ownership {
            StreamListenerOwnership.open(owner) {
                darwin.listener_try_next_event(owner) otherwise { continue }
            }
            StreamListenerOwnership.closed {
                return StreamListenerAcceptAttempt.failed(NetworkFailure.closed)
            }
        }
        match move event {
            NetworkListenerEvent.state(state) {
                match move state {
                    NetworkListenerState.waiting {}
                    NetworkListenerState.ready {}
                    NetworkListenerState.failed(failure) {
                        let normalized = provider_failure(move failure)
                        dispose_stream_listener(listener)
                        return StreamListenerAcceptAttempt.failed(move normalized)
                    }
                    NetworkListenerState.cancelled {
                        dispose_stream_listener(listener)
                        return StreamListenerAcceptAttempt.failed(NetworkFailure.closed)
                    }
                }
            }
            NetworkListenerEvent.accepted(owner) {
                return await accepted_stream_async_before(move owner, deadline)
            }
            NetworkListenerEvent.adoption_failed(_) {
                return StreamListenerAcceptAttempt.failed(NetworkFailure.invalid_target_result)
            }
            NetworkListenerEvent.malformed {
                return StreamListenerAcceptAttempt.failed(NetworkFailure.invalid_target_result)
            }
        }
    }
    return StreamListenerAcceptAttempt.failed(NetworkFailure.invalid_target_result)
}

instance StreamListener {
    async method &+self.accept_async(): StreamListenerAcceptAttempt {
        let deadline = operation_deadline(self.accept_timeout_value)
        return await accept_stream_async_before(self, &deadline)
    }

    async method &+self.accept_async_with_timeout(
        timeout: Duration,
    ): StreamListenerAcceptAttempt {
        let deadline = operation_deadline(timeout)
        return await accept_stream_async_before(self, &deadline)
    }
}
