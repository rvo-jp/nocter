//! Target-independent socket ownership and synchronous/asynchronous operation policy.
//!
//! This package-private module owns provider-independent connection ownership plus the descriptor
//! state and retry/readiness policy retained for UDP. The selected target adapter owns native
//! records, constants, and syscalls; public network errors remain in `std/net`.

use /internal/os.OSError
use /internal/net/model.{
    NetworkAddress,
    NetworkConnectionEvent,
    NetworkConnectionState,
    NetworkFamily,
    NetworkListenerEvent,
    NetworkListenerState,
    NetworkProviderFailure,
    ResolverFailure,
    ResolverNext,
}
use /time.Duration

see ./descriptor.nct
see ./datagram_attempt.nct
see ./async_datagram.nct
see ./async_wait.nct
see ./deadline.nct
see ./connection.nct
see ./connection_events.nct
see ./async_connection.nct
see ./listener.nct
see ./async_listener.nct
see ./resolver.nct

pub(/) enum NetworkFailure {
    os(value: OSError)
    provider(value: NetworkProviderFailure)
    closed
    timed_out
    tls_application_protocol_mismatch
    invalid_target_result
}

/// One uniquely owned provider-backed byte-stream connection.
pub(/) struct StreamConnection

pub(/) enum StreamConnectionAttempt {
    ready(connection: StreamConnection)
    failed(failure: NetworkFailure)
}

/// One uniquely owned provider-backed stream listener.
pub(/) struct StreamListener

pub(/) enum StreamListenerAttempt {
    ready(listener: StreamListener)
    failed(failure: NetworkFailure)
}

pub(/) enum StreamListenerAcceptAttempt {
    ready(connection: StreamConnection, peer: NetworkAddress)
    failed(failure: NetworkFailure)
}

/// Connects one provider-backed stream with an optional relative timeout.
pub(/) noalloc blocking func connect_stream(
    address: NetworkAddress,
    timeout: Duration?,
): StreamConnectionAttempt

/// Connects synchronously without restarting one shared candidate deadline.
pub(/) noalloc blocking func connect_stream_before(
    address: NetworkAddress,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt

/// Connects one authenticated TLS stream through the shared provider lifecycle.
pub(/) noalloc blocking func connect_tls_stream_before(
    address: NetworkAddress,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt

/// Connects one provider-backed stream without blocking the executor thread.
pub(/) async func connect_stream_async(address: NetworkAddress): StreamConnectionAttempt

/// Connects one provider-backed stream asynchronously until the relative timeout expires.
pub(/) async func connect_stream_async_with_timeout(
    address: NetworkAddress,
    timeout: Duration,
): StreamConnectionAttempt

/// Connects one provider-resolved host endpoint without blocking the executor thread.
pub(/) async func connect_host_stream_async_before(
    host: &str,
    service: &str,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt

/// Resolves and authenticates one TLS host endpoint through the provider event channel.
pub(/) async func connect_tls_host_stream_async_before(
    host: &str,
    service: &str,
    server_name: &str,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt

/// Binds and starts one provider-backed stream listener.
pub(/) noalloc blocking func listen_stream(address: NetworkAddress): StreamListenerAttempt

/// Binds and starts one provider-backed stream listener without blocking the executor thread.
pub(/) async func listen_stream_async(address: NetworkAddress): StreamListenerAttempt

instance StreamConnection {
    /// Reads one provider chunk, returning zero at clean peer completion.
    pub(/) noalloc blocking method &+self.read(buffer: &+[u8]): TransferAttempt

    /// Sends the complete byte view or returns one normalized failure.
    pub(/) noalloc blocking method &+self.write(bytes: &[u8]): UnitAttempt

    /// Reads one provider chunk without blocking the executor thread.
    pub(/) async method &+self.read_async(buffer: &+[u8]): TransferAttempt

    /// Reads asynchronously until the relative timeout expires.
    pub(/) async method &+self.read_async_with_timeout(
        buffer: &+[u8],
        timeout: Duration,
    ): TransferAttempt

    /// Sends the complete byte view without blocking the executor thread.
    pub(/) async method &+self.write_async(bytes: &[u8]): UnitAttempt

    /// Sends asynchronously until the complete view is accepted or the timeout expires.
    pub(/) async method &+self.write_async_with_timeout(
        bytes: &[u8],
        timeout: Duration,
    ): UnitAttempt

    /// Reports the effective logical local address.
    pub(/) noalloc method &self.local_address(): AddressAttempt

    /// Reports the effective logical peer address.
    pub(/) noalloc method &self.peer_address(): AddressAttempt

    /// Replaces the finite read-side operation timeout.
    pub(/) noalloc method &+self.set_read_timeout(timeout: Duration?): void

    /// Returns the configured read-side operation timeout.
    pub(/) noalloc method &self.read_timeout(): Duration?

    /// Replaces the finite write-side operation timeout.
    pub(/) noalloc method &+self.set_write_timeout(timeout: Duration?): void

    /// Returns the configured write-side operation timeout.
    pub(/) noalloc method &self.write_timeout(): Duration?

    /// Shuts down selected local stream directions without releasing ownership.
    pub(/) noalloc blocking method &+self.shutdown(direction: NetworkShutdown): UnitAttempt

    /// Cancels and releases the provider owner at most once.
    pub(/) noalloc method &+self.close(): void
}

instance StreamListener {
    /// Returns the effective local address, including a provider-selected port.
    pub(/) noalloc method &self.local_address(): AddressAttempt

    /// Accepts and starts one provider-backed stream connection.
    pub(/) noalloc blocking method &+self.accept(): StreamListenerAcceptAttempt

    /// Accepts one connection without blocking the executor thread.
    pub(/) async method &+self.accept_async(): StreamListenerAcceptAttempt

    /// Accepts asynchronously until one fixed relative timeout expires.
    pub(/) async method &+self.accept_async_with_timeout(
        timeout: Duration,
    ): StreamListenerAcceptAttempt

    /// Replaces the finite accept timeout; absence permits an unlimited wait.
    pub(/) noalloc method &+self.set_accept_timeout(timeout: Duration?): void

    /// Returns the configured accept timeout.
    pub(/) noalloc method &self.accept_timeout(): Duration?

    /// Cancels and releases the provider listener at most once.
    pub(/) noalloc method &+self.close(): void
}

/// One uniquely owned socket descriptor with explicit terminal state.
pub(/) struct SocketDescriptor

/// One opaque monotonic deadline and candidate-attempt state for a connection operation.
pub(/) struct ConnectionDeadline

pub(/) enum DescriptorAttempt {
    ready(descriptor: SocketDescriptor)
    failed(failure: NetworkFailure)
}

pub(/) enum AddressAttempt {
    ready(address: NetworkAddress)
    failed(failure: NetworkFailure)
}

pub(/) enum TransferAttempt {
    ready(count: usize)
    failed(failure: NetworkFailure)
}

pub(/) enum DatagramAttempt {
    ready(source: NetworkAddress, copied_len: usize, truncated: bool)
    failed(failure: NetworkFailure)
}

pub(/) enum UnitAttempt {
    ready
    failed(failure: NetworkFailure)
}

pub(/) struct ResolverResults

pub(/) enum ResolveAttempt {
    ready(results: ResolverResults)
    failed(failure: ResolverFailure)
}

/// Starts one system resolver query for a validated null-terminated host.
pub(/) noalloc blocking func resolve_host_once(node: *u8): ResolveAttempt

pub(/) enum NetworkShutdown {
    read
    write
    both
}

/// Creates one deadline before a multi-candidate connection operation begins.
pub(/) noalloc func connection_deadline(timeout: Duration?): ConnectionDeadline

instance ResolverResults {
    /// Returns the next usable logical address without exposing a target record.
    pub(/) noalloc method &+self.next(): ResolverNext
}

/// Creates and binds one configured UDP descriptor.
pub(/) noalloc func bind_udp(address: NetworkAddress): DescriptorAttempt

instance SocketDescriptor {
    /// Replaces the finite read-side operation timeout; absence permits an unlimited wait.
    pub(/) noalloc method &+self.set_read_timeout(timeout: Duration?): void

    /// Returns the configured read-side operation timeout.
    pub(/) noalloc method &self.read_timeout(): Duration?

    /// Replaces the finite write-side operation timeout; absence permits an unlimited wait.
    pub(/) noalloc method &+self.set_write_timeout(timeout: Duration?): void

    /// Returns the configured write-side operation timeout.
    pub(/) noalloc method &self.write_timeout(): Duration?

    /// Reports the effective logical local address.
    pub(/) noalloc method &self.local_address(): AddressAttempt

    /// Reports the connected logical peer address.
    pub(/) noalloc method &self.peer_address(): AddressAttempt

    /// Connects this datagram socket to one peer without changing ownership.
    pub(/) noalloc method &+self.connect_udp(address: NetworkAddress): UnitAttempt

    /// Sends one complete datagram to the connected peer.
    pub(/) noalloc blocking method &+self.send_datagram(bytes: &[u8]): UnitAttempt

    /// Sends one complete datagram to an explicit peer.
    pub(/) noalloc blocking method &+self.send_datagram_to(
        bytes: &[u8],
        target: NetworkAddress,
    ): UnitAttempt

    /// Receives exactly one datagram and preserves source and truncation information.
    pub(/) noalloc blocking method &+self.receive_datagram(buffer: &+[u8]): DatagramAttempt

    /// Sends one connected datagram without blocking the executor thread.
    pub(/) async method &+self.send_datagram_async(bytes: &[u8]): UnitAttempt

    /// Sends one connected datagram asynchronously until one fixed relative timeout expires.
    pub(/) async method &+self.send_datagram_async_with_timeout(
        bytes: &[u8],
        timeout: Duration,
    ): UnitAttempt

    /// Sends one addressed datagram without blocking the executor thread.
    pub(/) async method &+self.send_datagram_to_async(
        bytes: &[u8],
        target: NetworkAddress,
    ): UnitAttempt

    /// Sends one addressed datagram asynchronously until one fixed relative timeout expires.
    pub(/) async method &+self.send_datagram_to_async_with_timeout(
        bytes: &[u8],
        target: NetworkAddress,
        timeout: Duration,
    ): UnitAttempt

    /// Receives one datagram without blocking the executor thread.
    pub(/) async method &+self.receive_datagram_async(buffer: &+[u8]): DatagramAttempt

    /// Receives one datagram asynchronously until one fixed relative timeout expires.
    pub(/) async method &+self.receive_datagram_async_with_timeout(
        buffer: &+[u8],
        timeout: Duration,
    ): DatagramAttempt

    /// Makes this owner terminal and releases an open descriptor at most once.
    pub(/) noalloc method &+self.close(): void
}
