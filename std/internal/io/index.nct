noalloc primitive func file_completion_failure_kind_raw(
    completion: &FileCompletion,
): usize

#target: "arm64-darwin"
noalloc primitive func file_completion_failure_errno_raw(
    completion: &FileCompletion,
): i32

#target: "arm64-darwin"
noalloc primitive func file_completion_dispose_raw(completion: &+FileCompletion): void

/// Constructs one generated local-file read-only open computation.
pub(/) func file_open_read(path: &str): future FileCompletion from static

/// Constructs one generated local-file create-or-truncate computation.
pub(/) func file_open_create(path: &str): future FileCompletion from static

/// Constructs one generated local-file exclusive-create computation.
pub(/) func file_open_create_new(path: &str): future FileCompletion from static

/// Constructs one generated local-file append computation.
pub(/) func file_open_append(path: &str): future FileCompletion from static

/// Opens or creates a copy destination without truncating it before identity validation.
pub(/) func file_open_copy_destination(path: &str): future FileCompletion from static

/// Constructs one generated local-directory open computation.
pub(/) func directory_open(path: &str): future FileCompletion from static

pub(/) func file_read(owner: FileOwner, destination: &+[u8]): future FileCompletion from static

pub(/) func directory_read(
    owner: FileOwner,
    destination: &+[u8],
): future FileCompletion from static

pub(/) func file_write(owner: FileOwner, source: &[u8]): future FileCompletion from static

pub(/) func file_flush(owner: FileOwner): future FileCompletion from static

pub(/) func file_seek_start(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static

pub(/) func file_seek_end(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static

pub(/) func file_seek_current(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static

pub(/) func file_truncate(owner: FileOwner, length: usize): future FileCompletion from static

pub(/) func file_read_at(
    owner: FileOwner,
    destination: &+[u8],
    offset: u64,
): future FileCompletion from static

pub(/) func file_write_at(
    owner: FileOwner,
    source: &[u8],
    offset: u64,
): future FileCompletion from static

pub(/) noalloc func file_close(owner: FileOwner): future FileCompletion from static

/// Observes identity from one already-open descriptor and returns its owner in the completion.
pub(/) func file_identity(owner: FileOwner): future FileCompletion from static

/// Constructs one generated non-directory removal computation.
pub(/) func filesystem_remove_file(path: &str): future FileCompletion from static

/// Constructs one generated atomic rename computation.
pub(/) func filesystem_rename(
    source: &str,
    destination: &str,
): future FileCompletion from static

/// Constructs one generated single-directory creation computation.
pub(/) func filesystem_create_directory(path: &str): future FileCompletion from static

/// Constructs one generated empty-directory removal computation.
pub(/) func filesystem_remove_directory(path: &str): future FileCompletion from static

/// Constructs one generated metadata-query computation.
pub(/) func filesystem_metadata(path: &str): future FileCompletion from static

/// Constructs one generated metadata query that does not follow the final symbolic link.
pub(/) func filesystem_symlink_metadata(path: &str): future FileCompletion from static

/// Constructs one generated symbolic-link creation computation.
pub(/) func filesystem_create_symlink(
    target: &str,
    link: &str,
): future FileCompletion from static

/// Constructs one generated symbolic-link target read computation.
pub(/) func filesystem_read_link(
    path: &str,
    destination: &+[u8],
): future FileCompletion from static

/// Constructs one generated canonical-path computation.
pub(/) func filesystem_canonicalize(
    path: &str,
    destination: &+[u8],
): future FileCompletion from static

pub(/) noalloc func file_completion_take_owner(
    completion: &+FileCompletion,
): FileOwner from static

pub(/) noalloc func file_completion_transferred_byte_count(
    completion: &FileCompletion,
): usize

pub(/) noalloc func file_completion_result_position(completion: &FileCompletion): usize

pub(/) noalloc func file_completion_metadata_kind(completion: &FileCompletion): usize

pub(/) noalloc func file_completion_metadata_length(completion: &FileCompletion): u64

pub(/) noalloc func file_completion_metadata_modified_seconds(
    completion: &FileCompletion,
): i64

pub(/) noalloc func file_completion_metadata_modified_nanoseconds(
    completion: &FileCompletion,
): u64

pub(/) noalloc func file_completion_identity_device(completion: &FileCompletion): u64

pub(/) noalloc func file_completion_identity_inode(completion: &FileCompletion): u64

/// Reports whether a failed completion means that the queried path is absent.
pub(/) noalloc func file_completion_is_absent(completion: &FileCompletion): bool

/// Maps one target-independent OS classification to the stable public I/O error family.
pub(/) noalloc func io_error_from_os(os_error: OSError): error

/// Maps one target-independent classification to the stable public I/O error family.
pub(/) noalloc func io_error_from_kind(kind: OSErrorKind): error

/// Reports an operation attempted through a terminal stream wrapper.
pub(/) noalloc func closed_stream_error(): error

/// Validates and maps one generated file completion through the stable public I/O error policy.
pub(/) noalloc func validate_file_completion(completion: &FileCompletion): void!
