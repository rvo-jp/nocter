//! Package-internal raw memory projection primitives.
//!
//! These operations construct views, move values, and copy bytes at addresses whose validity has
//! already been established by their caller. They are not part of the user-facing pointer API.

see ./replacement.nct

pub(/) noalloc notrap primitive func from_addr<T>(address: usize): *T

pub(/) noalloc primitive func pointee_size<T>(pointer: *T): usize

pub(/) noalloc primitive func pointee_align<T>(pointer: *T): usize

pub(/) noalloc primitive func copy_str_to_ptr(destination: *u8, offset: usize, text: &str): void

pub(/) noalloc primitive func copy_ptr_to_ptr(destination: *u8, source: *u8, byte_count: usize): void

pub(/) noalloc primitive func store_u8_to_ptr(destination: *u8, offset: usize, value: u8): void

pub(/) noalloc primitive func store_value_to_ptr<T>(destination: *T, offset: usize, value: T): void

pub(/) primitive func drop_value_at_ptr<T>(pointer: *T, offset: usize): void

pub(/) noalloc primitive func take_value_at_ptr<T>(pointer: *T, offset: usize): T

/// Moves one initialized value whose retained storage is bounded by `owner`.
///
/// The caller must prove that the addressed slot belongs to storage represented by `owner`.
pub(/) noalloc primitive func take_value_at_ptr_from_owner<T, O>(
    pointer: *T,
    offset: usize,
    owner: &O,
): T from owner

/// Replaces one initialized value without exposing an uninitialized place to its caller.
pub(/) noalloc func replace_value<T>(place: &+T, replacement: T): T

/// Exchanges two initialized slice elements, or returns false without mutation for invalid indices.
pub(/) noalloc func swap_slice_values<T>(values: &+[T], left: usize, right: usize): bool

/// Copies one `copy` value through a readonly borrow without exposing its representation.
pub(/) noalloc func copy_value<T>(value: &T): T where copy T

pub(/) noalloc notrap primitive func str_from_raw_parts(pointer: *u8, len: usize): &str

pub(/) noalloc notrap primitive func slice_from_raw_parts(pointer: *u8, len: usize): &[u8]

pub(/) noalloc notrap primitive func slice_from_raw_parts_mut(pointer: *u8, len: usize): &+[u8]

pub(/) noalloc notrap primitive func slice_from_raw_parts_value<T>(pointer: *T, len: usize): &[T]

pub(/) noalloc notrap primitive func slice_from_raw_parts_value_mut<T>(pointer: *T, len: usize): &+[T]
