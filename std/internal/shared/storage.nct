//! Shared allocation layout, immutable and mutable ownership, projection, and destruction.

see ./index.nct

use /internal/mem as internal_mem
use /internal/ptr
use /internal/safety
use /mem

struct SharedHeader {
    owner_count: usize
    write_locked: bool
}

struct SharedStorage<T> {
    mapping_address: usize
    mapping_size: usize
    header: *SharedHeader
    value: *T
    active: bool
}

struct SharedCell<T> {
    storage: SharedStorage<T>
}

struct SharedValue<T> {
    storage: SharedStorage<T>
}

struct SharedWrite<T> {
    header: *SharedHeader
    value: *T
    active: bool
}

struct SharedProbe {
    value: i32
}

noalloc func align_address(address: usize, align: usize): usize {
    let remainder = address % align
    if remainder == 0 { return address }
    return address.checked_add(align - remainder) otherwise {
        return safety.invariant_abort()
    }
}

noalloc func header_view_mut<T>(owner: &SharedStorage<T>): &+SharedHeader {
    return &+ptr.slice_from_raw_parts_value_mut(owner.header, 1)[0]
}

func new_shared_storage<T>(value: T): SharedStorage<T> {
    let header_pointer: *SharedHeader = ptr.from_addr(1)
    let value_pointer: *T = ptr.from_addr(1)
    let header_size = ptr.pointee_size(header_pointer)
    let value_size = ptr.pointee_size(value_pointer)
    let value_align = ptr.pointee_align(value_pointer)
    let header_and_padding: usize = header_size.checked_add(value_align) otherwise {
        return safety.invariant_abort()
    }
    let mapping_size: usize = header_and_padding.checked_add(value_size) otherwise {
        return safety.invariant_abort()
    }
    let mapping_address = mem.alloc_shared_pages(mapping_size) catch allocation_error {
        return internal_mem.allocation_abort()
    }
    let stored_header: *SharedHeader = ptr.from_addr(mapping_address)
    let unaligned_value: usize = mapping_address.checked_add(header_size) otherwise {
        return safety.invariant_abort()
    }
    let stored_value: *T = ptr.from_addr(align_address(unaligned_value, value_align))
    ptr.store_value_to_ptr(stored_header, 0, SharedHeader {
        owner_count: 1,
        write_locked: false,
    })
    ptr.store_value_to_ptr(stored_value, 0, move value)
    return SharedStorage<T> {
        mapping_address: mapping_address,
        mapping_size: mapping_size,
        header: stored_header,
        value: stored_value,
        active: true,
    }
}

noalloc func share_storage<T>(owner: &SharedStorage<T>): SharedStorage<T> {
    if !owner.active { return safety.invariant_abort() }
    let header = header_view_mut(owner)
    header.owner_count = header.owner_count.checked_add(1) otherwise {
        return safety.invariant_abort()
    }
    return SharedStorage<T> {
        mapping_address: owner.mapping_address,
        mapping_size: owner.mapping_size,
        header: owner.header,
        value: owner.value,
        active: true,
    }
}

noalloc func try_write<T>(owner: &SharedStorage<T>): SharedWrite<T>? from owner {
    if !owner.active { return safety.invariant_abort() }
    let header = header_view_mut(owner)
    if header.write_locked { return none }
    header.write_locked = true
    return SharedWrite<T> { header: owner.header, value: owner.value, active: true }
}

noalloc func unlock<T>(write: &+SharedWrite<T>): void {
    if !write.active { return }
    let header = &+ptr.slice_from_raw_parts_value_mut(write.header, 1)[0]
    if !header.write_locked { return safety.invariant_abort() }
    header.write_locked = false
    write.active = false
    return
}

noalloc func read_storage<T>(owner: &SharedStorage<T>): &T from owner {
    if !owner.active { return safety.invariant_abort() }
    return &ptr.slice_from_raw_parts_value(owner.value, 1)[0]
}

func release_storage<T>(owner: &+SharedStorage<T>): void {
    if !owner.active { return }
    owner.active = false
    let header = header_view_mut(owner)
    if header.owner_count == 0 { return safety.invariant_abort() }
    if header.owner_count > 1 {
        header.owner_count -= 1
        return
    }
    if header.write_locked { return safety.invariant_abort() }
    ptr.drop_value_at_ptr(owner.value, 0)
    ptr.drop_value_at_ptr(owner.header, 0)
    mem.free_shared_pages(owner.mapping_address, owner.mapping_size)
    return
}

construct SharedCell<T> {
    func new(value: T): Self {
        return SharedCell<T> { storage: new_shared_storage(move value) }
    }
}

construct SharedValue<T> {
    func new(value: T): Self {
        return SharedValue<T> { storage: new_shared_storage(move value) }
    }
}

instance SharedCell<T> {
    noalloc method &self.share(): Self {
        return SharedCell<T> { storage: share_storage(&self.storage) }
    }

    noalloc method &self.try_write(): SharedWrite<T>? from self {
        return try_write(&self.storage)?
    }
}

instance SharedValue<T> {
    noalloc method &self.share(): Self {
        return SharedValue<T> { storage: share_storage(&self.storage) }
    }

    noalloc method &self.read(): &T from self {
        return read_storage(&self.storage)
    }
}

instance SharedWrite<T> {
    noalloc method &self.read(): &T from self {
        if !self.active { return safety.invariant_abort() }
        return &ptr.slice_from_raw_parts_value(self.value, 1)[0]
    }

    noalloc method &+self.write(): &+T from self {
        if !self.active { return safety.invariant_abort() }
        return &+ptr.slice_from_raw_parts_value_mut(self.value, 1)[0]
    }

    noalloc method &+self.unlock(): void {
        unlock(self)
        return
    }
}

noalloc drop SharedWrite<T>(&+self) {
    unlock(self)
    return
}

drop SharedCell<T>(&+self) {
    release_storage(&+self.storage)
    return
}

drop SharedValue<T>(&+self) {
    release_storage(&+self.storage)
    return
}

test shared_clone_and_write_exclusion {
    var first = SharedCell<SharedProbe>.new(SharedProbe { value: 41 })
    var second = first.share()
    var write = first.try_write() otherwise {
        return error.new("std.internal.shared.test", "first write projection was rejected")
    }
    let blocked = second.try_write()
    let _unexpected = move blocked otherwise {
        let value = write.write()
        value.value += 1
        write.unlock()
        var next = second.try_write() otherwise {
            return error.new("std.internal.shared.test", "released write projection remained locked")
        }
        if next.read().value != 42 {
            return error.new("std.internal.shared.test", "shared mutation was not retained")
        }
        next.unlock()
        return
    }
    return error.new("std.internal.shared.test", "overlapping write projection was accepted")
}

test immutable_shared_values_keep_one_value_alive_across_clones {
    var first = SharedValue<SharedProbe>.new(SharedProbe { value: 41 })
    let second = first.share()
    if first.read().value != 41 || second.read().value != 41 {
        return error.new("std.internal.shared.test", "immutable shared value changed")
    }
    return
}
