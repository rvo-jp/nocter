//! Executor-safe transport projection for the shared gzip read cursor.

see ./index.nct
see ./reader_cursor.nct
see ./reader_storage.nct

use /io.{Reader}
use /io

construct GzipReader<R> {
    func new(source: R): Self where R impl Reader {
        return GzipReader.with_capacity(move source, DEFAULT_GZIP_INPUT_CAPACITY)
    }

    func with_capacity(source: R, requested_capacity: usize): Self where R impl Reader {
        return GzipReader<R> {
            source: move source,
            cursor: new_gzip_cursor(requested_capacity),
        }
    }
}

async func read_async_gzip<R>(reader: &+GzipReader<R>, output: &+[u8]): usize! where R impl Reader {
    loop {
        match advance_gzip_cursor(&+reader.cursor, output) {
            GzipReadAttempt.ready(written) { return written }
            GzipReadAttempt.progress {}
            GzipReadAttempt.finished { return 0 }
            GzipReadAttempt.invalid { return invalid_gzip_error() }
            GzipReadAttempt.failed { return invalid_gzip_progress_error() }
            GzipReadAttempt.input {
                let reported = await reader.source.read(gzip_input_buffer(&+reader.cursor))
                    catch failure {
                        fail_gzip_cursor(&+reader.cursor)
                        return move failure
                    }
                let received = io.validate_read_count(
                    reported,
                    gzip_input_capacity(&reader.cursor),
                ) catch failure {
                    fail_gzip_cursor(&+reader.cursor)
                    return move failure
                }
                commit_gzip_input(&+reader.cursor, received)
            }
        }
    }
}

instance GzipReader<R> where R impl Reader {
    async method &+self.read(output: &+[u8]): usize! {
        return await read_async_gzip(self, output)?
    }
}
