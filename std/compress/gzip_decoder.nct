//! Incremental gzip framing over the raw-DEFLATE decoder.

see ./index.nct
see ./gzip_storage.nct

use /checksum
use /internal/bytes as codec

const GZIP_FLAG_HEADER_CHECKSUM: u8 = 2
const GZIP_FLAG_EXTRA: u8 = 4
const GZIP_FLAG_NAME: u8 = 8
const GZIP_FLAG_COMMENT: u8 = 16
const GZIP_SIZE_MODULUS: u64 = 4294967296

construct GzipDecoder {
    noalloc func new(): Self {
        return GzipDecoder {
            phase: GzipPhase.fixed_header,
            flags: 0,
            header_index: 0,
            field_index: 0,
            field_bytes: [0; 8],
            extra_remaining: 0,
            header_checksum: checksum.Crc32.new(),
            payload_checksum: checksum.Crc32.new(),
            payload_size: 0,
            inflate: InflateDecoder.new(),
            members: 0,
            input_complete: false,
            failure: GzipFailure.invalid_magic,
        }
    }
}

noalloc func gzip_fail(
    decoder: &+GzipDecoder,
    input_consumed: usize,
    output_written: usize,
    failure: GzipFailure,
): GzipStep {
    decoder.phase = GzipPhase.invalid
    decoder.failure = failure
    return GzipStep.invalid(input_consumed, output_written, failure)
}

noalloc func has_flag(flags: u8, flag: u8): bool {
    return ((flags as u64) / (flag as u64)) % 2 == 1
}

noalloc func phase_after_extra(flags: u8): GzipPhase {
    if has_flag(flags, GZIP_FLAG_NAME) { return GzipPhase.name }
    if has_flag(flags, GZIP_FLAG_COMMENT) { return GzipPhase.comment }
    if has_flag(flags, GZIP_FLAG_HEADER_CHECKSUM) { return GzipPhase.header_checksum }
    return GzipPhase.payload
}

noalloc func phase_after_name(flags: u8): GzipPhase {
    if has_flag(flags, GZIP_FLAG_COMMENT) { return GzipPhase.comment }
    if has_flag(flags, GZIP_FLAG_HEADER_CHECKSUM) { return GzipPhase.header_checksum }
    return GzipPhase.payload
}

noalloc func phase_after_comment(flags: u8): GzipPhase {
    if has_flag(flags, GZIP_FLAG_HEADER_CHECKSUM) { return GzipPhase.header_checksum }
    return GzipPhase.payload
}

noalloc func start_payload(decoder: &+GzipDecoder): void {
    decoder.phase = GzipPhase.payload
    decoder.payload_checksum = checksum.Crc32.new()
    decoder.payload_size = 0
    decoder.inflate = InflateDecoder.new()
    return
}

noalloc func enter_optional_phase(decoder: &+GzipDecoder, next: GzipPhase): void {
    match next {
        GzipPhase.payload { start_payload(decoder) }
        GzipPhase.header_checksum {
            decoder.field_index = 0
            decoder.phase = GzipPhase.header_checksum
        }
        _ { decoder.phase = next }
    }
    return
}

noalloc func start_next_member(decoder: &+GzipDecoder): void {
    decoder.phase = GzipPhase.fixed_header
    decoder.flags = 0
    decoder.header_index = 0
    decoder.field_index = 0
    decoder.extra_remaining = 0
    decoder.header_checksum = checksum.Crc32.new()
    decoder.payload_checksum = checksum.Crc32.new()
    decoder.payload_size = 0
    decoder.inflate = InflateDecoder.new()
    return
}

noalloc func truncated_failure(phase: GzipPhase): GzipFailure {
    match phase {
        GzipPhase.payload { return GzipFailure.truncated_payload }
        GzipPhase.trailer { return GzipFailure.truncated_trailer }
        _ { return GzipFailure.truncated_header }
    }
}

noalloc func gzip_input_exhausted(
    decoder: &+GzipDecoder,
    input_consumed: usize,
    output_written: usize,
    input_complete: bool,
): GzipStep {
    if !input_complete { return GzipStep.needs_input(input_consumed, output_written) }
    match decoder.phase {
        GzipPhase.fixed_header {
            if decoder.header_index == 0 && decoder.members != 0 {
                decoder.phase = GzipPhase.finished
                return GzipStep.finished(input_consumed, output_written)
            }
        }
        _ {}
    }
    let failure = truncated_failure(decoder.phase)
    return gzip_fail(decoder, input_consumed, output_written, failure)
}

noalloc func record_payload_output(
    decoder: &+GzipDecoder,
    output: &+[u8],
    written: usize,
): bool {
    let produced = output.get_range(0, written) otherwise { return false }
    decoder.payload_checksum.update(produced)
    decoder.payload_size = (decoder.payload_size + (written as u64)) % GZIP_SIZE_MODULUS
    return true
}

noalloc func advance_gzip(
    decoder: &+GzipDecoder,
    input: &[u8],
    output: &+[u8],
    input_complete: bool,
): GzipStep {
    var input_index: usize = 0
    var output_index: usize = 0

    loop {
        match decoder.phase {
            GzipPhase.finished {
                return GzipStep.finished(input_index, output_index)
            }
            GzipPhase.invalid {
                return GzipStep.invalid(input_index, output_index, decoder.failure)
            }
            GzipPhase.fixed_header {
                while decoder.header_index < 10 {
                    if input_index == input.len() {
                        return gzip_input_exhausted(
                            decoder,
                            input_index,
                            output_index,
                            input_complete,
                        )
                    }
                    let value = input[input_index]
                    if decoder.header_index == 0 && value != 31 {
                        return gzip_fail(
                            decoder,
                            input_index + 1,
                            output_index,
                            GzipFailure.invalid_magic,
                        )
                    }
                    if decoder.header_index == 1 && value != 139 {
                        return gzip_fail(
                            decoder,
                            input_index + 1,
                            output_index,
                            GzipFailure.invalid_magic,
                        )
                    }
                    if decoder.header_index == 2 && value != 8 {
                        return gzip_fail(
                            decoder,
                            input_index + 1,
                            output_index,
                            GzipFailure.unsupported_method,
                        )
                    }
                    if decoder.header_index == 3 {
                        if value > 31 {
                            return gzip_fail(
                                decoder,
                                input_index + 1,
                                output_index,
                                GzipFailure.reserved_flags,
                            )
                        }
                        decoder.flags = value
                    }
                    decoder.header_checksum.update_byte(value)
                    decoder.header_index += 1
                    input_index += 1
                }
                decoder.field_index = 0
                if has_flag(decoder.flags, GZIP_FLAG_EXTRA) {
                    decoder.phase = GzipPhase.extra_length
                } else {
                    let next = phase_after_extra(decoder.flags)
                    enter_optional_phase(decoder, next)
                }
            }
            GzipPhase.extra_length {
                while decoder.field_index < 2 {
                    if input_index == input.len() {
                        return gzip_input_exhausted(
                            decoder,
                            input_index,
                            output_index,
                            input_complete,
                        )
                    }
                    let value = input[input_index]
                    decoder.field_bytes[decoder.field_index] = value
                    decoder.header_checksum.update_byte(value)
                    decoder.field_index += 1
                    input_index += 1
                }
                let length = codec.decode_u16_le_pair(
                    decoder.field_bytes[0],
                    decoder.field_bytes[1],
                )
                decoder.extra_remaining = length as usize
                decoder.phase = GzipPhase.extra_data
            }
            GzipPhase.extra_data {
                while decoder.extra_remaining != 0 {
                    if input_index == input.len() {
                        return gzip_input_exhausted(
                            decoder,
                            input_index,
                            output_index,
                            input_complete,
                        )
                    }
                    decoder.header_checksum.update_byte(input[input_index])
                    decoder.extra_remaining -= 1
                    input_index += 1
                }
                let next = phase_after_extra(decoder.flags)
                enter_optional_phase(decoder, next)
            }
            GzipPhase.name {
                var terminated = false
                while input_index < input.len() && !terminated {
                    let value = input[input_index]
                    decoder.header_checksum.update_byte(value)
                    input_index += 1
                    terminated = value == 0
                }
                if !terminated {
                    return gzip_input_exhausted(
                        decoder,
                        input_index,
                        output_index,
                        input_complete,
                    )
                }
                let next = phase_after_name(decoder.flags)
                enter_optional_phase(decoder, next)
            }
            GzipPhase.comment {
                var terminated = false
                while input_index < input.len() && !terminated {
                    let value = input[input_index]
                    decoder.header_checksum.update_byte(value)
                    input_index += 1
                    terminated = value == 0
                }
                if !terminated {
                    return gzip_input_exhausted(
                        decoder,
                        input_index,
                        output_index,
                        input_complete,
                    )
                }
                let next = phase_after_comment(decoder.flags)
                enter_optional_phase(decoder, next)
            }
            GzipPhase.header_checksum {
                while decoder.field_index < 2 {
                    if input_index == input.len() {
                        return gzip_input_exhausted(
                            decoder,
                            input_index,
                            output_index,
                            input_complete,
                        )
                    }
                    decoder.field_bytes[decoder.field_index] = input[input_index]
                    decoder.field_index += 1
                    input_index += 1
                }
                let expected = codec.decode_u16_le_pair(
                    decoder.field_bytes[0],
                    decoder.field_bytes[1],
                )
                if (expected as u64) != (decoder.header_checksum.value() as u64) % 65536 {
                    return gzip_fail(
                        decoder,
                        input_index,
                        output_index,
                        GzipFailure.header_checksum_mismatch,
                    )
                }
                start_payload(decoder)
            }
            GzipPhase.payload {
                let remaining = input.get_range(input_index, input.len()) otherwise {
                    return gzip_fail(
                        decoder,
                        input_index,
                        output_index,
                        GzipFailure.truncated_payload,
                    )
                }
                let step = decoder.inflate.decode(remaining, output)
                match step {
                    InflateStep.needs_input(consumed, written) {
                        if !record_payload_output(decoder, output, written) {
                            return gzip_fail(
                                decoder,
                                input_index + consumed,
                                written,
                                GzipFailure.truncated_payload,
                            )
                        }
                        input_index += consumed
                        output_index = written
                        if input_complete {
                            return gzip_fail(
                                decoder,
                                input_index,
                                output_index,
                                GzipFailure.truncated_payload,
                            )
                        }
                        return GzipStep.needs_input(input_index, output_index)
                    }
                    InflateStep.needs_output(consumed, written) {
                        if !record_payload_output(decoder, output, written) {
                            return gzip_fail(
                                decoder,
                                input_index + consumed,
                                written,
                                GzipFailure.truncated_payload,
                            )
                        }
                        return GzipStep.needs_output(input_index + consumed, written)
                    }
                    InflateStep.finished(consumed, written) {
                        if !record_payload_output(decoder, output, written) {
                            return gzip_fail(
                                decoder,
                                input_index + consumed,
                                written,
                                GzipFailure.truncated_payload,
                            )
                        }
                        input_index += consumed
                        output_index = written
                        decoder.field_index = 0
                        decoder.phase = GzipPhase.trailer
                    }
                    InflateStep.invalid(consumed, written, _failure) {
                        if !record_payload_output(decoder, output, written) {
                            return gzip_fail(
                                decoder,
                                input_index + consumed,
                                written,
                                GzipFailure.invalid_payload,
                            )
                        }
                        return gzip_fail(
                            decoder,
                            input_index + consumed,
                            written,
                            GzipFailure.invalid_payload,
                        )
                    }
                }
            }
            GzipPhase.trailer {
                while decoder.field_index < 8 {
                    if input_index == input.len() {
                        return gzip_input_exhausted(
                            decoder,
                            input_index,
                            output_index,
                            input_complete,
                        )
                    }
                    decoder.field_bytes[decoder.field_index] = input[input_index]
                    decoder.field_index += 1
                    input_index += 1
                }
                let expected_checksum = codec.decode_u32_le_quad(
                    decoder.field_bytes[0],
                    decoder.field_bytes[1],
                    decoder.field_bytes[2],
                    decoder.field_bytes[3],
                )
                let expected_size = codec.decode_u32_le_quad(
                    decoder.field_bytes[4],
                    decoder.field_bytes[5],
                    decoder.field_bytes[6],
                    decoder.field_bytes[7],
                )
                if expected_checksum != decoder.payload_checksum.value() {
                    return gzip_fail(
                        decoder,
                        input_index,
                        output_index,
                        GzipFailure.checksum_mismatch,
                    )
                }
                if (expected_size as u64) != decoder.payload_size {
                    return gzip_fail(
                        decoder,
                        input_index,
                        output_index,
                        GzipFailure.size_mismatch,
                    )
                }
                decoder.members += 1
                start_next_member(decoder)
                return GzipStep.member_finished(input_index, output_index)
            }
        }
    }
}

instance GzipDecoder {
    noalloc method &+self.decode(input: &[u8], output: &+[u8]): GzipStep {
        if self.input_complete {
            return advance_gzip(self, "".bytes(), output, true)
        }
        return advance_gzip(self, input, output, false)
    }

    noalloc method &+self.finish(output: &+[u8]): GzipStep {
        self.input_complete = true
        return advance_gzip(self, "".bytes(), output, true)
    }
}
