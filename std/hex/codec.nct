//! Hexadecimal sizing, validation, and transformation.

see ./index.nct
see ./errors.nct

use /internal/ascii
use /internal/mem
use /internal/safety
use /string.String
use /vec.Vec

noalloc func encoded_len(byte_len: usize): usize! {
    let result = mem.checked_multiply(byte_len, 2) otherwise { return length_overflow() }
    return result
}

noalloc func validated_decoded_len(text: &str): usize! {
    let bytes = text.bytes()
    if bytes.len() % 2 != 0 { return invalid_length() }
    var index: usize = 0
    while index < bytes.len() {
        let _ = ascii.lowercase_hex_value(bytes[index]) otherwise { return invalid_digit() }
        index += 1
    }
    return bytes.len() / 2
}

noalloc func decoded_len(text: &str): usize! {
    return validated_decoded_len(text)?
}

noalloc func decoded_byte(text: &[u8], offset: usize): u8 {
    let high = ascii.lowercase_hex_value(text[offset]) otherwise {
        return safety.invariant_abort()
    }
    let low = ascii.lowercase_hex_value(text[offset + 1]) otherwise {
        return safety.invariant_abort()
    }
    return high * 16 + low
}

noalloc func write_decoded(text: &[u8], output: &+[u8], output_len: usize): void {
    var index: usize = 0
    while index < output_len {
        output[index] = decoded_byte(text, index * 2)
        index += 1
    }
    return
}

noalloc func encode_into(input: &[u8], output: &+[u8]): usize! {
    let required = encoded_len(input.len())?
    if output.len() < required { return output_too_small() }
    var index: usize = 0
    while index < input.len() {
        let value = input[index]
        output[index * 2] = ascii.lowercase_hex_digit(value / 16)
        output[index * 2 + 1] = ascii.lowercase_hex_digit(value % 16)
        index += 1
    }
    return required
}

func encode(input: &[u8]): String {
    let required = encoded_len(input.len()) catch _ { return mem.allocation_abort() }
    var output = String.with_capacity(required)
    var index: usize = 0
    while index < input.len() {
        let value = input[index]
        let high = ascii.lowercase_hex_digit(value / 16)
        let low = ascii.lowercase_hex_digit(value % 16)
        let high_char = char.from_u32(high as u32) otherwise { return safety.invariant_abort() }
        let low_char = char.from_u32(low as u32) otherwise { return safety.invariant_abort() }
        output.push(high_char)
        output.push(low_char)
        index += 1
    }
    return move output
}

noalloc func decode_into(text: &str, output: &+[u8]): usize! {
    let required = validated_decoded_len(text)?
    if output.len() < required { return output_too_small() }
    write_decoded(text.bytes(), output, required)
    return required
}

func decode(text: &str): Vec<u8>! {
    let required = validated_decoded_len(text)?
    var output: Vec<u8> = Vec.with_capacity(required)
    var index: usize = 0
    while index < required {
        output.push(0)
        index += 1
    }
    write_decoded(text.bytes(), &+output as &+[u8], required)
    return move output
}
