//! Iterator adapter and view representations.

see ./index.nct

struct MapIter<U, I, F> {
    source: I
    transform: F
}

struct FilterIter<I, F> {
    source: I
    predicate: F
}

struct TakeIter<I> {
    source: I
    remaining: usize
}

struct SkipIter<I> {
    source: I
    remaining_to_skip: usize
}

struct ChainIter<L, R> {
    left: L
    right: R
    in_left: bool
}

struct EnumerateIter<I> {
    source: I
    next_index: usize
}

struct EmptyIter<T> {}

struct OnceIter<T> {
    item: T?
    remaining: usize
}

struct ViewIter<T> {
    view: &[T]
    next_index: usize
}

struct MutableViewIter<T> {
    view: &+[T]
    next_index: usize
}

construct ViewIter<T> {
    noalloc func from_view(view: &[T]): Self {
        return ViewIter<T> {
            view: view,
            next_index: 0,
        }
    }
}

instance ViewIter<T> {
    noalloc method &self.remaining_len(): usize {
        return self.view.len() - self.next_index
    }

    noalloc method &+self.next(): &T? {
        if self.next_index >= self.view.len() {
            return none
        }
        let index: usize = self.next_index
        self.next_index = index + 1
        return &self.view[index]
    }
}
