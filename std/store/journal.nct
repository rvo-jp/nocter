//! Executor-safe journal ownership and durable record publication.

see ./index.nct
see ./journal_format.nct

use /fixed.ByteBuffer
use /fs
use /internal/safety
use /io.{File, SeekFrom, Writer}
use /string.String
use /vec.Vec

const JOURNAL_READ_CHUNK_BYTES: usize = 8192

enum JournalCommitPlan {
    committed(sequence: u64)
    checkpoint_required(sequence: u64)
}

struct Journal {
    file: File
    path: String
    limits: JournalLimits
    format: JournalFormat
    next_sequence: u64
    byte_len: usize
    record_count: usize
    usable: bool
}

noalloc func journal_changed(): error {
    return error.new("std.store.journal_changed", "journal changed while it was being recovered")
}

noalloc func journal_unusable(): error {
    return error.new("std.store.journal_unusable", "journal must be reopened after a failed commit")
}

async func read_observed_file(file: &+File, observed_len: usize): Vec<u8>! {
    var result: Vec<u8> = Vec.with_capacity(observed_len)
    var scratch: ByteBuffer<8192> = ByteBuffer<8192>.empty()
    while result.len() < observed_len {
        scratch.clear()
        let received = await file.read_at(scratch.spare_mut(), result.len() as u64)?
        if received == 0 { return journal_changed() }
        if !scratch.commit(received) { return safety.invariant_abort() }
        let remaining = observed_len - result.len()
        var accepted = received
        if accepted > remaining { accepted = remaining }
        let received_bytes: &[u8] = &scratch
        let bounded = received_bytes.get_range(0, accepted) otherwise {
            return safety.invariant_abort()
        }
        result.extend_from_slice(bounded)
    }
    return move result
}

async func recover_journal_file(
    path: &str,
    limits: JournalLimits,
): (JournalRecovery, usize)! {
    await fs.prepare_durable_file(path)?
    var source = await File.open(path)?
    let observed_len = await source.seek(SeekFrom.end(0))?
    if observed_len > limits.maximum_journal_bytes {
        await source.close() catch _ {}
        return journal_too_large()
    }
    let input = await read_observed_file(&+source, observed_len) catch failure {
        await source.close() catch _ {}
        return move failure
    }
    await source.close()?
    return (recover_journal_bytes(&input, limits)?, observed_len)
}

async func open_journal(
    path: &str,
    limits: JournalLimits,
): (Journal, JournalRecovery)! {
    let (recovery, observed_len) = await recover_journal_file(path, limits)?
    if recovery.sequence_exhausted { return sequence_exhausted() }
    let format = recovery.format
    let next_sequence = recovery.next_sequence
    let complete_len = recovery.complete_len
    let record_count = recovery.record_count
    var file = await File.append(path)?
    if complete_len != observed_len { await file.truncate(complete_len)? }
    return (
        Journal {
            file: move file,
            path: String.copy(path),
            limits: limits,
            format: format,
            next_sequence: next_sequence,
            byte_len: complete_len,
            record_count: record_count,
            usable: true,
        },
        move recovery,
    )
}

noalloc func journal_is_current(journal: &Journal): bool {
    return match journal.format {
        JournalFormat.empty { true }
        JournalFormat.current { true }
        JournalFormat.legacy { false }
    }
}

noalloc func advance_journal_sequence(journal: &+Journal, committed: u64): void {
    if committed == 18446744073709551615 {
        journal.usable = false
        return
    }
    journal.next_sequence = committed + 1
    journal.usable = true
    return
}

async func replace_journal_record(
    journal: &+Journal,
    encoded: &[u8],
    sequence: u64,
): void! {
    journal.usable = false
    await journal.file.close()?
    await fs.write_durable(&journal.path, encoded)?
    journal.file = await File.append(&journal.path)?
    journal.format = JournalFormat.current
    journal.byte_len = encoded.len()
    journal.record_count = 1
    advance_journal_sequence(journal, sequence)
    return
}

async func commit_journal_mutations(
    journal: &+Journal,
    body: &[u8],
): JournalCommitPlan! {
    if !journal.usable || !journal_is_current(journal) { return journal_unusable() }
    let sequence = journal.next_sequence
    if body.len() > journal.limits.maximum_record_bytes {
        return JournalCommitPlan.checkpoint_required(sequence)
    }
    let encoded = encode_current_journal_record(
        journal.limits,
        JournalRecordKind.mutations,
        sequence,
        body,
    )?
    if journal.record_count == journal.limits.maximum_records
    || encoded.len() > journal.limits.maximum_journal_bytes - journal.byte_len {
        return JournalCommitPlan.checkpoint_required(sequence)
    }
    journal.usable = false
    await journal.file.write(&encoded) catch failure { return move failure }
    await journal.file.sync() catch failure { return move failure }
    journal.format = JournalFormat.current
    journal.byte_len += encoded.len()
    journal.record_count += 1
    advance_journal_sequence(journal, sequence)
    return JournalCommitPlan.committed(sequence)
}

async func commit_journal_checkpoint(journal: &+Journal, body: &[u8]): u64! {
    if !journal.usable || !journal_is_current(journal) { return journal_unusable() }
    let sequence = journal.next_sequence
    let encoded = encode_current_journal_record(
        journal.limits,
        JournalRecordKind.checkpoint,
        sequence,
        body,
    )?
    await replace_journal_record(journal, &encoded, sequence)?
    return sequence
}

async func normalize_legacy_journal(
    journal: &+Journal,
    snapshot: &[u8],
    committed_sequence: u64,
): void! {
    if !journal.usable { return journal_unusable() }
    let encoded = encode_current_journal_record(
        journal.limits,
        JournalRecordKind.checkpoint,
        committed_sequence,
        snapshot,
    )?
    await replace_journal_record(journal, &encoded, committed_sequence)?
    return
}

async func compact_journal(
    journal: &+Journal,
    body: &[u8],
    committed_sequence: u64,
): void! {
    if !journal.usable || !journal_is_current(journal) { return journal_unusable() }
    let encoded = encode_current_journal_record(
        journal.limits,
        JournalRecordKind.checkpoint,
        committed_sequence,
        body,
    )?
    await replace_journal_record(journal, &encoded, committed_sequence)?
    return
}

async func close_journal(journal: &+Journal): void! {
    journal.usable = false
    await journal.file.close()?
    return
}
