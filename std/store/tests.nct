//! Journal format, recovery, and limit tests.

see ./index.nct

see ./journal.nct

see ./store.nct

see ./state.nct

see ./state_index.nct

see ./iteration.nct

use /fixed.ByteBuffer
use /vec.Vec

func test_limits(): JournalLimits! {
    return JournalLimits.new(128, 1024, 8)?
}

test journal_records_round_trip_with_one_sequence_authority {
    let limits = test_limits()?
    let first = encode_journal_record(limits, 7, "alpha".bytes())?
    let second = encode_journal_record(limits, 8, "beta".bytes())?
    var bytes: Vec<u8> = Vec.empty()
    bytes.extend_from_slice(&first)
    bytes.extend_from_slice(&second)
    var recovery = recover_journal_bytes(&bytes, limits)?
    if recovery.record_count != 2
    || recovery.complete_len != bytes.len()
    || recovery.sequence_exhausted
    || recovery.next_sequence != 9 {
        return error.new("std.store.test", "journal recovery facts changed")
    }
    let last_record = move recovery.last_record otherwise {
        return error.new("std.store.test", "last journal record is absent")
    }
    if journal_record_sequence(&last_record) != 8
    || journal_record_body(&last_record) != "beta".bytes() {
        return error.new("std.store.test", "last journal record changed")
    }
    return
}

test only_an_incomplete_final_record_is_ignored {
    let limits = test_limits()?
    let first = encode_journal_record(limits, 1, "complete".bytes())?
    let second = encode_journal_record(limits, 2, "tail".bytes())?
    var joined: Vec<u8> = Vec.empty()
    joined.extend_from_slice(&first)
    joined.extend_from_slice(&second)
    var retained = first.len()
    while retained < joined.len() {
        let prefix = joined.get_range(0, retained) otherwise {
            return error.new("std.store.test", "valid journal prefix is absent")
        }
        let recovery = recover_journal_bytes(prefix, limits)?
        if recovery.record_count != 1
        || recovery.complete_len != first.len()
        || recovery.sequence_exhausted
        || recovery.next_sequence != 2 {
            return error.new("std.store.test", "incomplete tail changed complete recovery")
        }
        retained += 1
    }
    return
}

test an_incomplete_tail_does_not_consume_the_complete_record_limit {
    let limits = JournalLimits.new(128, 1024, 1)?
    let first = encode_journal_record(limits, 1, "complete".bytes())?
    let second = encode_journal_record(limits, 2, "tail".bytes())?
    let partial_second = second.get_range(0, JOURNAL_HEADER_BYTES) otherwise {
        return error.new("std.store.test", "journal header is absent")
    }
    var joined: Vec<u8> = Vec.empty()
    joined.extend_from_slice(&first)
    joined.extend_from_slice(partial_second)
    let recovery = recover_journal_bytes(&joined, limits)?
    if recovery.record_count != 1
    || recovery.complete_len != first.len()
    || recovery.next_sequence != 2 {
        return error.new("std.store.test", "incomplete tail consumed a record slot")
    }
    return
}

test a_complete_tail_header_must_preserve_sequence_continuity {
    let limits = test_limits()?
    let first = encode_journal_record(limits, 1, "complete".bytes())?
    let wrong = encode_journal_record(limits, 3, "unfinished".bytes())?
    let wrong_header = wrong.get_range(0, JOURNAL_HEADER_BYTES) otherwise {
        return error.new("std.store.test", "journal header is absent")
    }
    var joined: Vec<u8> = Vec.empty()
    joined.extend_from_slice(&first)
    joined.extend_from_slice(wrong_header)
    let _recovery = recover_journal_bytes(&joined, limits) catch failure {
        if failure.has_code("std.store.corrupt_journal") { return }
        return error.new("std.store.test", "sequence discontinuity used the wrong error")
    }
    return error.new("std.store.test", "invalid complete tail header was ignored")
}

test complete_corruption_and_limit_violations_are_rejected {
    let limits = test_limits()?
    var corrupt = encode_journal_record(limits, 1, "value".bytes())?
    corrupt[corrupt.len() - 1] += 1
    let _checksum = recover_journal_bytes(&corrupt, limits) catch failure {
        if !failure.has_code("std.store.corrupt_journal") {
            return error.new("std.store.test", "checksum failure used the wrong error")
        }
        var invalid_magic = encode_journal_record(limits, 1, "value".bytes())?
        invalid_magic[0] = 0
        let _magic = recover_journal_bytes(&invalid_magic, limits) catch magic_failure {
            if !magic_failure.has_code("std.store.corrupt_journal") {
                return error.new("std.store.test", "magic failure used the wrong error")
            }
            let narrow = JournalLimits.new(2, 128, 2)?
            let _large = encode_journal_record(narrow, 1, "abc".bytes()) catch limit_failure {
                if !limit_failure.has_code("std.store.record_too_large") {
                    return error.new("std.store.test", "record limit used the wrong error")
                }
                return
            }
            return error.new("std.store.test", "oversized record was accepted")
        }
        return error.new("std.store.test", "invalid journal magic was accepted")
    }
    return error.new("std.store.test", "invalid journal checksum was accepted")
}

test store_snapshots_round_trip_and_reject_duplicate_keys {
    let limits = StoreLimits.bounded(32, 64, 4, 256, 512, 4)?
    var state = new_store_state(2)
    let first_inserted = insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("first".bytes()),
            value: Vec.from_slice("one".bytes()),
        },
    )
    let second_inserted = insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("second".bytes()),
            value: Vec.from_slice("two".bytes()),
        },
    )
    if !first_inserted || !second_inserted {
        return error.new("std.store.test", "unique test state was rejected")
    }
    let snapshot_bytes = SNAPSHOT_HEADER_BYTES
    + SNAPSHOT_ENTRY_HEADER_BYTES * 2
    + "first".len()
    + "one".len()
    + "second".len()
    + "two".len()
    let encoded = encode_snapshot(&state, snapshot_bytes)
    let (decoded, decoded_bytes) = decode_snapshot(&encoded, limits)?
    let decoded_first = store_state_value(&decoded, "first".bytes()) otherwise {
        return error.new("std.store.test", "decoded first key is absent")
    }
    let decoded_second = store_state_value(&decoded, "second".bytes()) otherwise {
        return error.new("std.store.test", "decoded second key is absent")
    }
    if decoded_bytes != snapshot_bytes
    || store_state_len(&decoded) != 2
    || decoded_first != "one".bytes()
    || decoded_second != "two".bytes() {
        return error.new("std.store.test", "snapshot round trip changed state")
    }

    var duplicate: Vec<u8> = Vec.empty()
    var duplicate_header: ByteBuffer<16> = ByteBuffer<16>.empty()
    append_snapshot_header(&+duplicate_header, 2)
    let duplicate_header_bytes: &[u8] = &duplicate_header
    duplicate.extend_from_slice(duplicate_header_bytes)
    var duplicate_index: usize = 0
    while duplicate_index < 2 {
        var entry_header: ByteBuffer<16> = ByteBuffer<16>.empty()
        append_entry_header(&+entry_header, "first".len(), "one".len())
        let entry_header_bytes: &[u8] = &entry_header
        duplicate.extend_from_slice(entry_header_bytes)
        duplicate.extend_from_slice("first".bytes())
        duplicate.extend_from_slice("one".bytes())
        duplicate_index += 1
    }
    let _decoded_duplicate = decode_snapshot(&duplicate, limits) catch failure {
        if failure.has_code("std.store.corrupt_snapshot") { return }
        return error.new("std.store.test", "duplicate key used the wrong error")
    }
    return error.new("std.store.test", "duplicate snapshot key was accepted")
}

test indexed_state_reuses_slots_without_changing_insertion_order {
    var state = new_store_state(3)
    if !insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("alpha".bytes()),
            value: Vec.from_slice("one".bytes()),
        },
    )
    || !insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("beta".bytes()),
            value: Vec.from_slice("two".bytes()),
        },
    )
    || !insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("gamma".bytes()),
            value: Vec.from_slice("three".bytes()),
        },
    ) {
        return error.new("std.store.test", "initial indexed state was rejected")
    }
    let removed = remove_store_entry(&+state, "beta".bytes()) otherwise {
        return error.new("std.store.test", "indexed removal missed an existing key")
    }
    if removed.value != "two".bytes() {
        return error.new("std.store.test", "indexed removal returned the wrong value")
    }
    if !insert_store_entry(
        &+state,
        StoreEntry {
            key: Vec.from_slice("delta".bytes()),
            value: Vec.from_slice("four".bytes()),
        },
    ) {
        return error.new("std.store.test", "reused indexed slot rejected a new key")
    }
    let previous = replace_store_value(
        &+state,
        "alpha".bytes(),
        Vec.from_slice("updated".bytes()),
    ) otherwise {
        return error.new("std.store.test", "indexed replacement missed an existing key")
    }
    let alpha = store_state_value(&state, "alpha".bytes()) otherwise {
        return error.new("std.store.test", "indexed lookup lost alpha")
    }
    let delta = store_state_value(&state, "delta".bytes()) otherwise {
        return error.new("std.store.test", "indexed lookup lost delta")
    }
    if previous != "one".bytes()
    || alpha != "updated".bytes()
    || store_state_contains(&state, "beta".bytes())
    || delta != "four".bytes() {
        return error.new("std.store.test", "indexed lookup or replacement changed")
    }

    var entries = store_entries(&state)
    if entries.remaining_len() != 3 {
        return error.new("std.store.test", "entry traversal reported the wrong length")
    }
    let first = entries.next() otherwise {
        return error.new("std.store.test", "entry traversal omitted alpha")
    }
    if first.key() != "alpha".bytes() || first.value() != "updated".bytes() {
        return error.new("std.store.test", "entry traversal changed alpha")
    }
    let second = entries.next() otherwise {
        return error.new("std.store.test", "entry traversal omitted gamma")
    }
    if second.key() != "gamma".bytes() || second.value() != "three".bytes() {
        return error.new("std.store.test", "entry traversal changed gamma")
    }
    let third = entries.next() otherwise {
        return error.new("std.store.test", "entry traversal omitted delta")
    }
    if third.key() != "delta".bytes() || third.value() != "four".bytes() {
        return error.new("std.store.test", "slot reuse changed insertion order")
    }
    let _unexpected = entries.next() otherwise {
        if entries.remaining_len() == 0 { return }
        return error.new("std.store.test", "exhausted traversal retained a length")
    }
    return error.new("std.store.test", "entry traversal yielded an extra entry")
}

test store_index_keeps_distinct_slots_for_one_hash {
    var index = new_store_index(0)
    if !index.add(7, 2) || !index.add(7, 9) || index.add(7, 2) {
        return error.new("std.store.test", "collision candidates were not added exactly once")
    }
    let initial = index.candidates(7) otherwise {
        return error.new("std.store.test", "collision bucket is absent")
    }
    if initial.len() != 2 || initial[0] != 2 || initial[1] != 9 {
        return error.new("std.store.test", "collision bucket changed its slot candidates")
    }
    if !index.remove(7, 2) || index.remove(7, 2) {
        return error.new("std.store.test", "collision removal did not report exact membership")
    }
    let retained = index.candidates(7) otherwise {
        return error.new("std.store.test", "collision removal discarded a retained candidate")
    }
    if retained.len() != 1 || retained[0] != 9 {
        return error.new("std.store.test", "collision removal retained the wrong candidate")
    }
    if !index.remove(7, 9) {
        return error.new("std.store.test", "final collision candidate was not removed")
    }
    let _unexpected = index.candidates(7) otherwise {
        if !index.add(11, 4) {
            return error.new("std.store.test", "deleted bucket could not be reused")
        }
        return
    }
    return error.new("std.store.test", "empty collision bucket remained observable")
}

test snapshot_entry_count_must_fit_the_observed_payload {
    let limits = StoreLimits.bounded(32, 64, 4, 256, 512, 4)?
    var impossible: ByteBuffer<16> = ByteBuffer<16>.empty()
    append_snapshot_header(&+impossible, 4)
    let impossible_bytes: &[u8] = &impossible
    let _decoded = decode_snapshot(impossible_bytes, limits) catch failure {
        if failure.has_code("std.store.corrupt_snapshot") { return }
        return error.new("std.store.test", "impossible entry count used the wrong error")
    }
    return error.new("std.store.test", "impossible entry count was accepted")
}
