use std/compress.GzipReader
use std/io.Reader
use std/vec.Vec

struct FragmentedSource {
    bytes: Vec<u8>
    next: usize
}

construct FragmentedSource {
    func new(bytes: Vec<u8>): Self {
        return FragmentedSource { bytes: move bytes, next: 0 }
    }
}

instance FragmentedSource {
    impl Reader

    async method &+self.read(output: &+[u8]): usize! {
        if output.len() == 0 || self.next == self.bytes.len() { return 0 }
        output[0] = self.bytes[self.next]
        self.next += 1
        return 1
    }
}

struct InvalidSource {}

instance InvalidSource {
    impl Reader

    async method &+self.read(output: &+[u8]): usize! {
        return output.len() + 1
    }
}

func compressed(): Vec<u8> {
    return Vec [
        u8.truncate(31), u8.truncate(139), u8.truncate(8), u8.truncate(0),
        u8.truncate(0), u8.truncate(0), u8.truncate(0), u8.truncate(0),
        u8.truncate(0), u8.truncate(255), u8.truncate(43), u8.truncate(78),
        u8.truncate(77), u8.truncate(206), u8.truncate(207), u8.truncate(75),
        u8.truncate(1), u8.truncate(0), u8.truncate(105), u8.truncate(17),
        u8.truncate(31), u8.truncate(182), u8.truncate(6), u8.truncate(0),
        u8.truncate(0), u8.truncate(0),
    ]
}

async func main(): i32 {
    var reader = GzipReader.with_capacity(FragmentedSource.new(compressed()), 1)
    let decoded = await reader.read_to_end() catch _ { return 1 }
    if (&decoded as &[u8]) != "second".bytes() { return 2 }
    var eof: Vec<u8> = Vec [u8.truncate(0)]
    let eof_count = await reader.read(&+eof) catch _ { return 3 }
    if eof_count != 0 { return 4 }

    var invalid = GzipReader.with_capacity(InvalidSource {}, 4)
    let _ = await invalid.read(&+eof) catch failure {
        if !failure.has_code("std.io.invalid_read_count") { return 5 }
        let _ = await invalid.read(&+eof) catch terminal {
            if !terminal.has_code("std.compress.invalid_progress") { return 6 }
            return 0
        }
        return 7
    }
    return 8
}
