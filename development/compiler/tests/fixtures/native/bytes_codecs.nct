use std/bytes
use std/bytes.PrefixDecode
use std/fixed.ByteBuffer
use std/scan.ByteCursor
use std/vec.Vec

func main(): i32 {
    let source: Vec<u8> = Vec [
        u8.truncate(1),
        u8.truncate(35),
        u8.truncate(69),
        u8.truncate(103),
        u8.truncate(137),
        u8.truncate(171),
        u8.truncate(205),
        u8.truncate(239),
    ]
    let big = bytes.decode_u64_be(&source as &[u8]) otherwise { return 1 }
    let little = bytes.decode_u64_le(&source as &[u8]) otherwise { return 2 }

    var encoded_big: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    var encoded_little: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    if !bytes.encode_u64_be(&+encoded_big as &+[u8], big)
    || !bytes.encode_u64_le(&+encoded_little as &+[u8], little) {
        return 3
    }
    if (&encoded_big as &[u8]) != (&source as &[u8])
    || (&encoded_little as &[u8]) != (&source as &[u8]) {
        return 4
    }

    let u16_bytes: Vec<u8> = Vec [u8.truncate(18), u8.truncate(52)]
    let u32_bytes: Vec<u8> = Vec [
        u8.truncate(120),
        u8.truncate(86),
        u8.truncate(52),
        u8.truncate(18),
    ]
    let decoded16 = bytes.decode_u16_be(&u16_bytes as &[u8]) otherwise { return 5 }
    let decoded32 = bytes.decode_u32_le(&u32_bytes as &[u8]) otherwise { return 6 }
    if decoded16 != 4660 || decoded32 != 305419896 { return 7 }

    var short: Vec<u8> = Vec [u8.truncate(9), u8.truncate(8), u8.truncate(7)]
    if bytes.encode_u32_be(&+short as &+[u8], decoded32)
    || short[0] != 9 || short[1] != 8 || short[2] != 7 {
        return 8
    }
    let one: Vec<u8> = Vec [u8.truncate(42)]
    let _unexpected = bytes.decode_u16_be(&one as &[u8]) otherwise { return check_floats() }
    return 9
}

func check_floats(): i32 {
    let value32 = f32.from_bits(2143294004)
    let value64 = f64.from_bits(9223372036854775808)
    var bytes32: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    var bytes64: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    if !bytes.encode_f32_le(&+bytes32 as &+[u8], value32)
    || !bytes.encode_f64_be(&+bytes64 as &+[u8], value64) {
        return 10
    }
    let decoded32 = bytes.decode_f32_le(&bytes32 as &[u8]) otherwise { return 11 }
    let decoded64 = bytes.decode_f64_be(&bytes64 as &[u8]) otherwise { return 12 }
    if decoded32.to_bits() != value32.to_bits() || decoded64.to_bits() != value64.to_bits() {
        return 13
    }
    return check_composition()
}

func check_composition(): i32 {
    var output: ByteBuffer<10> = ByteBuffer.empty()
    if !output.try_push_u16_be(4660) || !output.try_push_u64_le(72623859790382856) {
        return 14
    }
    if output.len() != 10 || output.try_push_u16_be(1) || output.len() != 10 {
        return 15
    }

    var dynamic: Vec<u8> = Vec.empty()
    dynamic.extend_from_slice(&output as &[u8])
    if dynamic.len() != output.len() { return 16 }

    var input = ByteCursor.new(&dynamic as &[u8])
    let first = input.take_u16_be() otherwise { return 17 }
    let second = input.take_u64_le() otherwise { return 18 }
    if first != 4660 || second != 72623859790382856 || !input.is_finished() { return 19 }
    let unchanged_offset = input.offset()
    let _unexpected = input.take_u16_be() otherwise {
        if input.offset() == unchanged_offset { return check_prefix_decode() }
        return 20
    }
    return 21
}

func check_prefix_decode(): i32 {
    let source_value: u64 = 300
    let source_consumed: usize = 2
    let decoded: PrefixDecode<u64> = PrefixDecode.decoded(source_value, source_consumed)
    match move decoded {
        PrefixDecode.decoded(decoded_value, decoded_consumed) {
            if decoded_value != 300 || decoded_consumed != 2 { return 22 }
        }
        _ { return 23 }
    }

    let incomplete: PrefixDecode<u64> = PrefixDecode.incomplete
    match move incomplete {
        PrefixDecode.incomplete {}
        _ { return 24 }
    }
    let overflow: PrefixDecode<u64> = PrefixDecode.overflow
    match move overflow {
        PrefixDecode.overflow {}
        _ { return 25 }
    }
    let non_canonical: PrefixDecode<u64> = PrefixDecode.non_canonical
    match move non_canonical {
        PrefixDecode.non_canonical { return check_variable_codecs() }
        _ { return 26 }
    }
}

func check_variable_codecs(): i32 {
    let signed_bytes: Vec<u8> = Vec [
        u8.truncate(128),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let minimum = bytes.decode_i64_be(&signed_bytes as &[u8]) otherwise { return 27 }
    if minimum.to_bits() != 9223372036854775808 { return 28 }

    var encoded: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let width = bytes.encode_zigzag_uleb128(&+encoded as &+[u8], minimum) otherwise { return 29 }
    if width != 10 { return 30 }
    let decoded = bytes.decode_zigzag_uleb128(&encoded as &[u8])
    match move decoded {
        PrefixDecode.decoded(value, consumed) {
            if value.to_bits() != minimum.to_bits() || consumed != 10 { return 31 }
        }
        _ { return 32 }
    }

    let canonical: Vec<u8> = Vec [u8.truncate(172), u8.truncate(2)]
    let canonical_result = bytes.decode_uleb128(&canonical as &[u8])
    match move canonical_result {
        PrefixDecode.decoded(value, consumed) {
            if value != 300 || consumed != 2 { return 33 }
        }
        _ { return 34 }
    }

    let non_canonical: Vec<u8> = Vec [u8.truncate(128), u8.truncate(0)]
    let non_canonical_result = bytes.decode_uleb128(&non_canonical as &[u8])
    match move non_canonical_result {
        PrefixDecode.non_canonical {}
        _ { return 35 }
    }

    let incomplete: Vec<u8> = Vec [u8.truncate(128)]
    let incomplete_result = bytes.decode_uleb128(&incomplete as &[u8])
    match move incomplete_result {
        PrefixDecode.incomplete {}
        _ { return 36 }
    }

    let overflow: Vec<u8> = Vec [
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(2),
    ]
    let overflow_result = bytes.decode_uleb128(&overflow as &[u8])
    match move overflow_result {
        PrefixDecode.overflow {}
        _ { return 37 }
    }

    var short: Vec<u8> = Vec [u8.truncate(9)]
    let _unexpected = bytes.encode_uleb128(&+short as &+[u8], 300) otherwise {
        if short[0] == 9 { return check_storage_composition() }
        return 38
    }
    return 39
}

func check_storage_composition(): i32 {
    var short: ByteBuffer<1> = ByteBuffer.empty()
    let _unexpected = short.try_push_uleb128(300) otherwise {
        if short.len() != 0 { return 40 }
        return check_fixed_variable_storage()
    }
    return 41
}

func check_fixed_variable_storage(): i32 {
    var output: ByteBuffer<20> = ByteBuffer.empty()
    let unsigned_width = output.try_push_uleb128(300) otherwise { return 42 }
    let signed_width = output.try_push_zigzag_uleb128(-65) otherwise { return 43 }
    if unsigned_width != 2 || signed_width != 2 || output.len() != 4 { return 44 }

    var input = ByteCursor.new(&output as &[u8])
    let unsigned = input.take_uleb128()
    match move unsigned {
        PrefixDecode.decoded(value, consumed) {
            if value != 300 || consumed != 2 || input.offset() != 2 { return 45 }
        }
        _ { return 46 }
    }
    let signed = input.take_zigzag_uleb128()
    match move signed {
        PrefixDecode.decoded(value, consumed) {
            if value != -65 || consumed != 2 || !input.is_finished() { return 47 }
        }
        _ { return 48 }
    }
    return check_cursor_failure_transactions()
}

func check_cursor_failure_transactions(): i32 {
    let incomplete_bytes: Vec<u8> = Vec [u8.truncate(128)]
    var incomplete = ByteCursor.new(&incomplete_bytes as &[u8])
    let incomplete_result = incomplete.take_uleb128()
    match move incomplete_result {
        PrefixDecode.incomplete {
            if incomplete.offset() != 0 { return 49 }
        }
        _ { return 50 }
    }

    let non_canonical_bytes: Vec<u8> = Vec [u8.truncate(128), u8.truncate(0)]
    var non_canonical = ByteCursor.new(&non_canonical_bytes as &[u8])
    let non_canonical_result = non_canonical.take_uleb128()
    match move non_canonical_result {
        PrefixDecode.non_canonical {
            if non_canonical.offset() != 0 { return 51 }
        }
        _ { return 52 }
    }

    let overflow_bytes: Vec<u8> = Vec [
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(2),
    ]
    var overflow = ByteCursor.new(&overflow_bytes as &[u8])
    let overflow_result = overflow.take_uleb128()
    match move overflow_result {
        PrefixDecode.overflow {
            if overflow.offset() != 0 { return 53 }
        }
        _ { return 54 }
    }
    return check_dynamic_variable_storage()
}

func check_dynamic_variable_storage(): i32 {
    var output: Vec<u8> = Vec.empty()
    let first_width = output.append_uleb128(624485)
    let second_width = output.append_zigzag_uleb128(-12345)
    if first_width != 3 || second_width != 3 || output.len() != 6 { return 55 }

    var input = ByteCursor.new(&output as &[u8])
    let first = input.take_uleb128()
    match move first {
        PrefixDecode.decoded(value, consumed) {
            if value != 624485 || consumed != first_width { return 56 }
        }
        _ { return 57 }
    }
    let second = input.take_zigzag_uleb128()
    match move second {
        PrefixDecode.decoded(value, consumed) {
            if value != -12345 || consumed != second_width || !input.is_finished() { return 58 }
        }
        _ { return 59 }
    }

    var signed: ByteBuffer<8> = ByteBuffer.empty()
    if !signed.try_push_i64_le(-2) { return 60 }
    var signed_input = ByteCursor.new(&signed as &[u8])
    let signed_value = signed_input.take_i64_le() otherwise { return 61 }
    if signed_value != -2 || !signed_input.is_finished() { return 62 }
    return 0
}
