struct Item { value: i32 }
struct OptionalRunner { callback: func(take (func(i32): i32)?): i32 }
struct PairRunner { callback: func(take (func(i32): i32, func(i32): i32)): i32 }
struct ArrayRunner { callback: func(take [func(i32): i32; 2]): i32 }
struct EmptyRunner { callback: func(take [func(i32): i32; 0]): i32 }
const func identity(value: i32): i32 { value }
const func make(offset: i32): func(i32): i32 {
    let item = Item { value: offset }
    (item^; value: i32): i32 { item.value + value }
}
const func optional(take value: (func(i32): i32)?): i32 {
    let callback = value^ otherwise { return 42 }
    callback(2)
}
const func pair(take values: (func(i32): i32, func(i32): i32)): i32 { values.0(40) + values.1(1) }
const func array(take values: [func(i32): i32; 2]): i32 { values[0](2) + values[1](1) }
const func empty(take values: [func(i32): i32; 0]): i32 { 42 }
const func calculate(): i32 {
    let optional_runner = OptionalRunner { callback: optional }
    if optional_runner.callback(none) != 42 || optional_runner.callback(make(40)) != 42 { return 0 }
    let pair_runner = PairRunner { callback: pair }
    if pair_runner.callback((identity, make(1))) != 42 { return 0 }
    let array_runner = ArrayRunner { callback: array }
    if array_runner.callback([make(20), make(19)]) != 42 { return 0 }
    let empty_runner = EmptyRunner { callback: empty }
    empty_runner.callback([])
}
const ANSWER: i32 = calculate()
func run(): i32 { calculate() }
