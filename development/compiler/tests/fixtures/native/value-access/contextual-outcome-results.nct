        let absent_owned = forward_owned(false)
        let _ = absent_owned^ otherwise {
            let completed_owned = forward_success()
            let callable = completed_owned^!
            let deep = nested(false)
            let inside = deep^!
            let pair_value = pair(true)
            let paired = pair_value.0^!
            let missing_pair = pair(false)
            let _ = missing_pair.0^ otherwise {
                let _ = inside^ otherwise {
                    if action(42) == 42 && retained(2) == 42 && callable(2) == 42 && paired(2) == 42 && pair_value.1(42) == 42 && missing_pair.1(42) == 42 { return selected(42) }
                    return 0
                }
                return 0
            }
            return 0
        }
        return 0
    }
    0
}
const ANSWER: i32 = calculate()
func run(): i32 { calculate() }
