const func check_storage(): bool {
    let input = BOUNDS
    var values = [record(input); 3]
    values[1].a = 7
    values[1].b += 1
    values[1].c -= 1
    values[1].d += 1
    values[1].e -= 1
    let copied = record(values[1])
