    b: i16
    c: u32
    d: i8
    e: u16
    f: i64
    g: u64
    h: isize
    i: usize }
const func record(value: Narrow): Narrow { value }
const LIMITS: Narrow = Narrow { a: 255, b: -32768, c: 4294967295, d: -128, e: 65535, f: -9223372036854775808, g: 18446744073709551615, h: -9223372036854775808, i: 18446744073709551615 }
