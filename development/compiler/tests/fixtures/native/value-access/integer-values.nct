    values[0].a == 255 && values[2].b == -32768 && tuple.0 == 7 && tuple.1 == -32767 && tuple.2 == 4294967294 && tuple.3 == -127 && tuple.4 == 65534 && tuple.5 == -9223372036854775808 && tuple.6 == 18446744073709551615 && tuple.7 == -9223372036854775808 && tuple.8 == 18446744073709551615
