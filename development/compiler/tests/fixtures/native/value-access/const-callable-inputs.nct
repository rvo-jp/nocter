struct Item { value: i32 }
const func identity(value: i32): i32 { value }
const func increment(value: i32): i32 { value + 1 }
const func apply(action: func(i32): i32, value: i32): i32 { action(value) }
const func forward(action: func(i32): i32, value: i32): i32 { apply(action, value) }
const func edit_twice(edit action: mut(i32): i32, value: i32): i32 {
    let _ = action(value)
    action(value)
}
const func consume(take action: once(i32): i32, value: i32): i32 { action^(value) }
const func relay(take action: once(i32): i32): once(i32): i32 { action^ }
const func descend(action: func(i32): i32, count: i32): i32 {
    if count == 0 { action(41) } else { descend(action, count - 1) }
}
const func reading(): i32 {
    let first = 40
    let left = (first; value: i32): i32 { first + value }
    let second = 41
    let right = (second; value: i32): i32 { second + value }
    if forward(identity, 42) == 42 && forward(left, 2) == 42 && forward(right, 1) == 42
       && descend(increment, 4) == 42 { 42 } else { 0 }
}
const func editing(): i32 {
    let total = 40
    var action = (total; value: i32): i32 { total += value
                                          total }
    if edit_twice(action, 1) == 42 && total == 40 { 42 } else { 0 }
}
const func taking(): i32 {
    let item = Item { value: 41 }
    let action = (item^; value: i32): i32 { let taken = item^
                                          taken.value + value }
    consume(relay(action^), 1)
}
const func anonymous(): i32 {
    let pass = (action: func(i32): i32, value: i32): i32 { forward(action, value) }
    pass(increment, 41)
}
func runtime_trap(value: i32): i32 { value / 0 }
const func stop_read(action: func(i32): i32): i32 {
    action(if true { return 42 } else { return 0 })
}
const func stop_take(take action: once(i32): i32): i32 {
    action^(if true { return 42 } else { return 0 })
}
const func stop_edit(edit action: mut(i32): i32): i32 {
    action(if true { return 42 } else { return 0 })
}
const func interrupted(): i32 {
    let payload = 40
    let read_callback = (payload; value: i32): i32 { runtime_trap(value) + payload }
    var named_update: mut(i32): i32 = runtime_trap
    var edit_callback = (payload; value: i32): i32 {
        payload += runtime_trap(value)
        payload
    }
    let held_item = Item { value: payload }
    let take_callback = (held_item^; value: i32): i32 { runtime_trap(value) + held_item.value }
    if stop_read(runtime_trap) == 42 && stop_take(runtime_trap) == 42
       && stop_read(read_callback) == 42 && stop_take(take_callback^) == 42
       && stop_edit(named_update) == 42 && stop_edit(named_update) == 42
       && stop_edit(edit_callback) == 42 && stop_edit(edit_callback) == 42 { 42 } else { 0 }
}
func unused_alpha(): void {}
func unused_beta(): void {}
func unused_gamma(): void {}
func unused_delta(): void {}
const func permute_unused(a: func(): void, b: func(): void, c: func(): void, d: func(): void, count: i32): i32 {
    if count == 0 { 42 } else {
        let _ = permute_unused(b, a, c, d, count - 1)
        let _ = permute_unused(a, c, b, d, count - 1)
        permute_unused(a, b, d, c, count - 1)
    }
}
const func permuting(): i32 { permute_unused(unused_alpha, unused_beta, unused_gamma, unused_delta, 0) }
const func calculate(): i32 {
    if reading() == 42 && editing() == 42 && taking() == 42 && anonymous() == 42 && interrupted() == 42 && permuting() == 42 { 42 } else { 0 }
}
const PERMUTED: i32 = permuting()
const ANSWER: i32 = calculate()
func run(): i32 { if ANSWER == 42 && PERMUTED == 42 && calculate() == 42 { 42 } else { 0 } }
