const func make(value: i32): func(): i32 { (value;): i32 { value } }
const func captured_components(): i32 {
    var current = make(42)
    let saved = current
    current = make(43)
    var pair = (current, saved)
    if true {
        edit alias = pair
        alias.0 = make(44)
    }
    let action = (pair;): i32 { pair.0() * 100 + pair.1() }
    pair.0 = make(45)
    action()
}
const func nested_creation(): i32 {
    let value = 42
    let outer = (value;): i32 {
        let inner = (value;): i32 { value }
        inner()
    }
    outer()
}
const func dormant_creation(): i32 {
    let value = 42
