struct Receiver { invoke: func(i32, take func(i32): i32, take Data): void }
const func identity(value: i32): i32 { value }
struct Item { value: i32 }
struct Data { values: [i32; size()] }
const func receive(before: i32, take action: func(i32): i32, take value: Data): void {}
const func make(offset: i32): func(i32): i32 {
    let item = Item { value: offset }
    (item^; value: i32): i32 { item.value + value }
}
const func size(): usize {
    let action = make(40)
    let receiver = Receiver { invoke: receive }
    receiver.invoke(1, action^, if true { return 42 } else { loop {} })
    0
}
const SIZE: usize = size()
func run(): i32 { if size() == SIZE && SIZE == 42 { 42 } else { 0 } }
