primitive func create_failure(code: str, message: str): error
primitive func context_error(take value: error, message: str): error

func addition(value: i32): func(i32): i32 {
    let reason = context_error(create_failure("addition", "leaf"), "outer")
    (reason^, value; amount: i32): i32 { value + amount }
}
func wrap(take callback: func(i32): i32): func(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}
func update(edit pair: (func(i32): i32, i32)): i32 {
    pair.1 += 1
    pair.0(pair.1)
}
func forward(edit pair: (func(i32): i32, i32)): i32 { update(pair) }
func calculate(): i32 {
    var pair = (wrap(addition(20)), 21)
    let first = update(pair)
    let seen = pair.0(pair.1)
    let next = forward(pair)
    let after = pair.0(pair.1)
    let observed = pair.1
    let fresh = update((wrap(addition(20)), 21))
    let forwarded = forward((wrap(addition(10)), 31))
    let moved = forward(pair^)
    if first == 42 && seen == 42 && next == 43 && after == 43 && observed == 23 && fresh == 42 && forwarded == 42 && moved == 44 { 42 } else { 0 }
}
func fail(): i32! { throw create_failure("preparation", "interrupted") }
func invoke(edit calls: i32, edit pair: (func(i32): i32, i32), amount: i32): i32 {
    calls += 1
    pair.1 += amount
    pair.0(pair.1)
}
func interrupted(edit calls: i32): i32! {
    invoke(calls, (wrap(addition(20)), 21), fail()?)
}
func run(): i32 {
    var calls = 0
    let failed = interrupted(calls) catch _ { 42 }
    if failed == 42 && calls == 0 { calculate() } else { 0 }
}
