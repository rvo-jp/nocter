struct Item { value: i32 }
const func identity(value: i32): i32 { value }
const func addition(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value + amount }
}
const func subtraction(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value - amount }
}
const func wrap(take callback: func(i32): i32): func(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}
const func receive(take pair: (func(i32): i32, i32)): i32 {
    pair.0(pair.1)
}
const func observe(pair: (func(i32): i32, i32)): i32 { pair.0(pair.1) }
const func forward(take pair: (func(i32): i32, i32)): i32 { receive(pair^) }
const func twins(take pair: (func(i32): i32, func(i32): i32)): i32 {
    pair.0(22) + pair.1(8) - 42
}
const func array(take actions: [func(i32): i32; 1]): i32 { actions[0](22) }
const func empty(take actions: [func(i32): i32; 0]): i32 { 42 }
const func calculate(): i32 {
    let first = (wrap(addition(20)), 22)
    let seen = observe(first)
    let a = receive(first^)
    let again = receive((wrap(addition(10)), 32))
    let b = forward((wrap(subtraction(50)), 8))
    let c = receive((wrap(identity), 42))
    let d = twins((wrap(addition(20)), wrap(subtraction(50))))
    let e = array([wrap(addition(20))])
    let f = empty([wrap(addition(20)); 0])
    if seen == 42 && a == 42 && again == 42 && b == 42 && c == 42 && d == 42 && e == 42 && f == 42 { 42 } else { 0 }
}
const ANSWER: i32 = calculate()
func run(): i32 { if ANSWER == 42 { calculate() } else { 0 } }
