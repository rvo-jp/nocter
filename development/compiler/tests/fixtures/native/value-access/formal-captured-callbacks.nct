struct Item { value: i32 }

const func named(): i32 { 42 }

const func owning(value: i32): func(): i32 {
    let item = Item { value: value }
    (item^;): i32 { item.value }
}

const func wrap(take callback: func(): i32): func(): i32 {
    (callback^;): i32 { callback() }
}

const func changing(seed: i32): mut(i32): i32 {
    var total = seed
    (total; amount: i32): i32 { total += amount
                               total }
}

const func wrap_edit(take callback: mut(i32): i32): mut(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}

const func consuming(value: i32): once(): i32 {
    let item = Item { value: value }
    (item^;): i32 { item.value^ }
}

const func wrap_once(take callback: once(): i32): once(): i32 {
    (callback^;): i32 { callback^() }
}

const func calculate(): i32 {
    let first = wrap(named)
    let held = owning(42)
    let second = wrap(held^)
    let counter = changing(20)
    var edited = wrap_edit(counter^)
    let initial = edited(1)
    let final = edited(21)
    let owned = consuming(42)
    let taken = wrap_once(owned^)
    if first() == 42 && second() == 42 && initial == 21 && final == 42 { taken^() } else { 0 }
}

const ANSWER: i32 = calculate()
func run(): i32 { if ANSWER == 42 { calculate() } else { 0 } }
