primitive func create_failure(code: str, message: str): error
primitive func context_error(take value: error, message: str): error

struct Item {
    value: i32
    failure: error
}
struct Pair {
    first: Item
    second: Item
}
struct Row {
    left: [Item; 3]
    right: Item
}

func build(value: i32): Item {
    Item { value: value, failure: context_error(create_failure("retained", "leaf"), "context") }
}
func consume(take entry: Item): i32 { entry.value }
func observe(entry: Item): i32 { entry.value }
func cancel(take entry: Item, ignored: usize): void {}

func prefix_take(): i32 {
    let items = [build(40), build(2)]
    var index: usize = 0
    var total = 0
    while index < 2 {
        total += consume(items[index]^)
        index += 1
    }
    total
}
func prefix_read(): i32 {
    let items = [build(40), build(2)]
    var index: usize = 0
    var total = 0
    while index < 2 {
        total += observe(items[index]^)
        index += 1
    }
    total
}
func cancellation(early: bool): i32 {
    let items = [build(40), build(2)]
    var index: usize = 0
    var total = 0
    while index < 2 {
        let selected = items[index]^
        total += selected.value
        if early { cancel(items[index + 1]^, if true { return total } else { 0 }) }
        index += 1
    }
    total
}
func fields(left: usize, right: usize): i32 {
    let items = [Pair { first: build(40), second: build(2) },
                 Pair { first: build(50), second: build(3) }]
    var first_index = left
    var second_index = right
    let first = items[first_index].first^
    let second = items[second_index].second^
    first_index = 1 - first_index
    second_index = 1 - second_index
    first.value + second.value - (if left == 0 { 0 } else { 10 }) - (if right == 0 { 0 } else { 1 })
}
func nested(row: usize, column: usize, late: bool): i32 {
    let items = [[Pair { first: build(40), second: build(2) },
                  Pair { first: build(50), second: build(2) }],
                 [Pair { first: build(60), second: build(2) },
                  Pair { first: build(70), second: build(2) }]]
    var outer = row
    var inner = column
    let part = items[outer][if late { outer = 1 - outer
        inner } else { inner }].first^
    outer = 1 - outer
    inner = 1 - inner
    let expected = if row == 0 { if column == 0 { 40 } else { 50 } } else { if column == 0 { 60 } else { 70 } }
    part.value + items[outer][inner].second.value + 40 - expected
}
func mixed(index: usize, count: usize): i32 {
    let rows = [Row { left: [build(20), build(20), build(1)], right: build(2) },
                Row { left: [build(0), build(0), build(0)], right: build(3) }]
    var cursor: usize = 0
    var total = 0
    while cursor < count {
        let part = rows[0].left[cursor]^
        total += part.value
        cursor += 1
    }
    let right = rows[index].right^
    let expected = if count == 0 { 0 } else { if count == 1 { 20 } else { if count == 2 { 40 } else { 41 } } }
    total + right.value + 40 - expected - (if index == 0 { 0 } else { 1 })
}
func restore_missing(input: usize, flag: bool): i32 {
    var items = [build(20), build(22)]
    var index = input
    let position = input
    if flag { let removed = items[index]^ }
    index = if index == 0 { 1 } else { 0 }
    items[position] = build(if input == 0 { 60 } else { 62 })
    let complete = items^
    complete[0].value + complete[1].value - 40
}
func restore_repeated(input: usize): i32 {
    var items = [build(40), build(2)]
    var count: usize = 0
    var index = input
    var total = 0
    while count < 3 {
        let old = items[index]^
        total += old.value
        items[index] = old^
        index = if index == 0 { 1 } else { 0 }
        count += 1
    }
    let complete = items^
    let expected = if input == 0 { 82 } else { 44 }
    if total == expected { complete[0].value + complete[1].value } else { 0 }
}
func restore_branches(input: usize, flag: bool): i32 {
    var items = [build(40), build(2)]
    let old = items[input]^
    if flag { items[input] = old^ } else { items[input] = old^ }
    let complete = items^
    complete[0].value + complete[1].value
}
func replace_loop(): i32 {
    var items = [build(40), build(2)]
    var index: usize = 0
    var total = 0
    while index < 2 {
        let selected = items[index]^
        total += selected.value
        items = [build(40), build(2)]
        index += 1
    }
    total
}
func restored_prefix(input: usize, flag: bool): i32 {
    var items = [build(20), build(22)]
    if flag { let old = items[input]^ }
    items[input] = build(40)
    var index: usize = 0
    var total = 0
    while index < 2 {
        let next = items[index]^
        total += next.value
        index += 1
    }
    if input == 0 { total - 20 } else { total - 18 }
}
func fallible_build(value: i32, fail: bool): Item! {
    if fail { throw context_error(create_failure("replacement", "failed"), "context") }
    build(value)
}
func restored_outcome(input: usize, fail: bool): i32! {
    var items = [build(40), build(2)]
    let old = items[input]^
    items[input] = fallible_build(old.value, fail)?
    let complete = items^
    complete[0].value + complete[1].value
}
func projected_restore(input: usize, repeated: bool): i32 {
    var pairs = [Pair { first: build(20), second: build(22) },
                 Pair { first: build(30), second: build(32) }]
    var index = input
    var count = 0
    let limit = if repeated { 4 } else { 1 }
    while count < limit {
        let position = index
        let old = pairs[index].first^
        index = 1 - index
        pairs[position].first = build(old.value + 1)
        count += 1
    }
    let complete = pairs^
    complete[0].first.value + complete[1].first.value - (if repeated { 12 } else { 9 })
}
func run(): i32 {
    let prefix_checks = prefix_take() == 42 && prefix_read() == 42 && cancellation(false) == 42 && cancellation(true) == 40
    let field_checks = fields(0, 0) == 42 && fields(0, 1) == 42 && fields(1, 0) == 42 && fields(1, 1) == 42
    let early_checks = nested(0, 0, false) == 42 && nested(0, 1, false) == 42 && nested(1, 0, false) == 42 && nested(1, 1, false) == 42
    let late_checks = nested(0, 0, true) == 42 && nested(0, 1, true) == 42 && nested(1, 0, true) == 42 && nested(1, 1, true) == 42
    let first_mixed = mixed(0, 0) == 42 && mixed(1, 0) == 42 && mixed(0, 1) == 42 && mixed(1, 1) == 42
    let last_mixed = mixed(0, 2) == 42 && mixed(1, 2) == 42 && mixed(0, 3) == 42 && mixed(1, 3) == 42
    let restored = restore_missing(0, true) == 42 && restore_missing(1, true) == 42 && restore_missing(0, false) == 42 && restore_missing(1, false) == 42
    let backedges = restore_repeated(0) == 42 && restore_repeated(1) == 42 && replace_loop() == 42
    let branches = restore_branches(0, true) == 42 && restore_branches(1, true) == 42 && restore_branches(0, false) == 42 && restore_branches(1, false) == 42
    let epochs = restored_prefix(0, true) == 42 && restored_prefix(1, true) == 42 && restored_prefix(0, false) == 42 && restored_prefix(1, false) == 42
    let normal_first = restored_outcome(0, false) catch _ { 0 }
    let normal_last = restored_outcome(1, false) catch _ { 0 }
    let failed_first = restored_outcome(0, true) catch _ { 42 }
    let failed_last = restored_outcome(1, true) catch _ { 42 }
    let outcome_checks = normal_first == 42 && normal_last == 42 && failed_first == 42 && failed_last == 42
    let projected = projected_restore(0, false) == 42 && projected_restore(1, false) == 42 && projected_restore(0, true) == 42 && projected_restore(1, true) == 42
    if prefix_checks && field_checks && early_checks && late_checks && first_mixed && last_mixed && restored && backedges && branches && epochs && outcome_checks && projected { 42 } else { 0 }
}
