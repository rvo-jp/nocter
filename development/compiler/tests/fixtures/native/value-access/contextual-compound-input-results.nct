struct Item { value: i32 }

const func addition(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value + amount }
}
const func subtraction(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value - amount }
}
const func wrap(take callback: func(i32): i32): func(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}
const func named_first(value: i32): i32 { value + 3 }
const func named_second(value: i32): i32 { 50 - value }
const func select(take pair: (func(i32): i32, i32)): func(i32): i32 { pair.0^ }
const func forward(take pair: (func(i32): i32, i32)): func(i32): i32 { select(pair^) }
const func select_second(take pair: (func(i32): i32, func(i32): i32)): func(i32): i32 { pair.1^ }
const func recursive(take pair: (func(i32): i32, i32), depth: i32): func(i32): i32 {
    if depth > 0 { return recursive(pair^, depth - 1) }
    select(pair^)
}
const func select_array(take actions: [func(i32): i32; 2], index: usize): func(i32): i32 {
    actions[index]^
}
const func calculate(): i32 {
    let first = select((wrap(addition(20)), 0))
    let second = forward((wrap(subtraction(50)), 0))
    let third = select_array([wrap(addition(20)), wrap(addition(21))], 1)
    let fourth = select_array([wrap(subtraction(50)), wrap(subtraction(60))], 0)
    let fifth = select_second((wrap(addition(3)), wrap(subtraction(50))))
    let sixth = select_second((named_first, named_second))
    let seventh = recursive((wrap(subtraction(50)), 0), 2)
    let extractor = select_array
    let eighth = extractor([wrap(subtraction(50)), wrap(subtraction(60))], 1)
    if first(22) == 42 && second(8) == 42 && third(21) == 42 && fourth(8) == 42 && fifth(8) == 42 && sixth(8) == 42 && seventh(8) == 42 && eighth(18) == 42 { 42 } else { 0 }
}
const ANSWER: i32 = calculate()
func run(): i32 { if ANSWER == 42 { calculate() } else { 0 } }
