primitive func create_failure(code: str, message: str): error
primitive func context_error(take value: error, message: str): error
func identity(value: i32): i32 { value }
func owning(number: i32): func(i32): i32 {
    let reason = context_error(create_failure("captured", "leaf"), "outer")
    (reason^, number; value: i32) { number + value }
}
func wrap(take action: func(i32): i32): func(i32): i32 {
    (action^; value: i32) { action(value) }
}
func failed(): (func(i32): i32)! {
    throw context_error(create_failure("failed", "leaf"), "outer")
}
func choose(fail: bool, take action: func(i32): i32): (func(i32): i32)! {
    if fail {
        drop action
        failed()
    } else { wrap(action^) }
}
func forward(fail: bool, take action: func(i32): i32): (func(i32): i32)! {
    choose(fail, action^)?
}
func outcomes(): i32 {
    let discarded = choose(true, owning(30))
    drop discarded
    let left_value = forward(false, identity)
    let right_value = forward(false, owning(20))
    let left = left_value^!
    let right = right_value^!
    let failure = forward(true, identity)
    let _ = failure^ catch reason { return left(20) + right(2) }
    0
}
func failed_pair(take action: func(i32): i32): (func(i32): i32, (func(i32): i32)!) {
    (wrap(action^), failed())
}
func success_pair(take action: func(i32): i32): (func(i32): i32, (func(i32): i32)!) {
    (wrap(action^), wrap(identity))
}
func choose_pair(fail: bool, take action: func(i32): i32): (func(i32): i32, (func(i32): i32)!) {
    if fail { failed_pair(action^) } else { success_pair(action^) }
}
func carriers(): i32 {
    let discarded = choose_pair(true, owning(30))
    drop discarded
    let first = choose_pair(true, identity)
    let second = choose_pair(true, owning(20))
    let success = choose_pair(false, owning(100))
    let active = success.1^!
    if active(7) != 7 { return 0 }
    let left = first.0^
    let right = second.0^
    let _ = first.1^ catch first_reason {
        let _ = second.1^ catch second_reason { return left(20) + right(2) }
        return 0
    }
    0
}
func run(): i32 { if outcomes() == 42 { carriers() } else { 0 } }
