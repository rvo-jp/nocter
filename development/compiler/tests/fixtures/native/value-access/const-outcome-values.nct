const func success(): i32! { 42 }
const func absent(): error? { none }
const func nested(): (error!)? { none }
const func forward(take value: i32!): i32! { value^? }
const func asserted(): i32 {
    let value = forward(success())
    value^!
}
const func inspect_guarded(value: i32): i32 { value }
const func guarded_optional(): i32 {
    var value: i32? = 41
    let before = inspect_guarded(value!)
    value = 42
    before + inspect_guarded(value!) - 41
}
const func guarded_fallible(): i32 {
    var value: i32! = 41
    let before = inspect_guarded(value!)
    value = 42
    before + inspect_guarded(value!) - 41
}
const VALUE: i32! = success()
const EMPTY: error? = absent()
const NESTED: (error!)? = nested()
const ANSWER: i32 = asserted()
const GUARDED: i32 = guarded_optional() + guarded_fallible() - 42
func absent_value(take value: error?): i32 {
    let reason = value^ otherwise { return ANSWER }
    drop reason
    0
}
func nested_value(take value: (error!)?): i32 {
    let outcome = value^ otherwise { return ANSWER }
    let reason = outcome^!
    drop reason
    0
}
func run(): i32 {
    let value = VALUE
    let first = value^!
    let second = absent_value(EMPTY)
    let third = nested_value(NESTED)
    let computed = forward(VALUE)!
    first + second + third + computed + guarded_optional() + guarded_fallible() - 210
}
