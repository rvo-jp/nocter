primitive func create_failure(code: str, message: str): error
primitive func context_error(take value: error, message: str): error

func changing(seed: i32): mut(i32): i32 {
    let reason = context_error(create_failure("counter", "leaf"), "outer")
    var total = seed
    (reason^, total; amount: i32): i32 { total += amount
                                        total }
}
func wrap_edit(take callback: mut(i32): i32): mut(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}
func decreasing(seed: i32): mut(i32): i32 {
    let reason = context_error(create_failure("decreasing", "leaf"), "outer")
    var total = seed
    (reason^, total; amount: i32): i32 { total -= amount
                                        total }
}
func step_one(edit actions: [mut(i32): i32; 1], amount: i32): i32 { actions[0](amount) }
func step(edit actions: [mut(i32): i32; 2], index: usize, amount: i32): i32 {
    actions[index](amount)
}
func forward(edit actions: [mut(i32): i32; 2], index: usize, amount: i32): i32 {
    step(actions, index, amount)
}
func run(): i32 {
    var actions = [wrap_edit(changing(40)), wrap_edit(changing(60))]
    let first = step(actions, 0, 1)
    let other = forward(actions, 1, 0)
    let next = forward(actions, 0, 1)
    let last = step(actions, 1, -18)
    var single = [wrap_edit(changing(40))]
    let before = step_one(single, 1)
    var saved = single[0]^
    single[0] = wrap_edit(decreasing(60))
    let after = step_one(single, 18)
    let preserved = saved(1)
    let fresh = step_one([wrap_edit(decreasing(60))], 18)
    if first == 41 && other == 60 && next == 42 && last == 42 && before == 41 && after == 42 && preserved == 42 && fresh == 42 { 42 } else { 0 }
}
