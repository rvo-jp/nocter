struct Item { value: i32 }

const func identity(value: i32): i32 { value }

const func addition(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value + amount }
}

const func subtraction(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value - amount }
}

const func wrap(take callback: func(i32): i32): func(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}

const func calculate(index: usize, amount: i32): i32 {
    var pair = (wrap(identity), [(wrap(addition(2)), 2), (wrap(addition(7)), 5)], 3)
    let empty = pair.0(42)
    let saved_sibling = pair.1[index].0^
    pair.0 = wrap(addition(20))
    let small_sibling = pair.1[0].1
    pair.0 = wrap(subtraction(50))
    let saved = pair.0^
    pair.0 = wrap(addition(1))
    pair.0 = wrap(identity)
    let large_sibling = pair.1[0].1
    pair.1[index].0 = saved_sibling^
    let restored = pair.1[index].0(amount)
    if pair.1[0].0(40) == 42 && pair.0(42) == 42 && saved(8) == 42 && restored == 42 && empty == 42 && pair.1[1].0(35) == 42 && pair.1[1].1 == 5 && pair.2 == 3 && small_sibling == 2 && large_sibling == 2 { 42 } else { 0 }
}

const ANSWER: i32 = if calculate(0, 40) == 42 && calculate(1, 35) == 42 { 42 } else { 0 }
func run(): i32 { if ANSWER == 42 && calculate(0, 40) == 42 && calculate(1, 35) == 42 { 42 } else { 0 } }
