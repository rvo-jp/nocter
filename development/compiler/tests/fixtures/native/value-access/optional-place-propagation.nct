struct Pair { first: i32
    second: i32 }
const func inspect(value: Pair): i32 { value.first }
const func borrowed(value: Pair?): i32? { read payload = value?
    payload.first }
const func borrowed_call(value: Pair?): i32? { inspect(value?) }
const func updated(edit value: i32?): void? { edit payload = value?
    payload = 42 }
const func disjoint(edit value: Pair?): i32? {
    edit first = (value?).first
    read second = (value?).second
    first = 21
    first + second
}
const func nested(value: i32??): i32?? { read payload = (value?)?
    payload }
const func move_after_read(): i32? { let value: Pair? = Pair { first: 42, second: 0 }
    let answer = inspect(value?)
    let moved = value^!
    answer + moved.second }
const func indexed(edit values: [i32?; 2], edit index: usize): void? {
    edit payload = values[index]?
    index = 1
    payload += 21
}
const func receive(take value: Pair?, observed: i32, edit counter: i32): i32 {
    counter += 100
    observed
}
const func cancelled(edit counter: i32): i32? { let value = Pair { first: 42, second: 0 }
    let missing: i32? = none
    receive(value^, missing?, counter) }
const func closure_boundary(): i32 { let value: i32? = none
