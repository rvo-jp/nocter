const func calculate(): i32 {
    let value: Pair? = Pair { first: 42, second: 0 }
    var pair: Pair? = Pair { first: 1, second: 21 }
    let separate = disjoint(pair)!
    var scalar: i32? = 1
    let _ = updated(scalar)!
    var values: [i32?; 2] = [21, 7]
    var index: usize = 0
    let _ = indexed(values, index)!
    var missing: [i32?; 2] = [none, 7]
    var untouched: usize = 0
    let absent = indexed(missing, untouched)
    var counter = 42
    let cancelled_result = cancelled(counter)
    let deep: i32?? = 42
