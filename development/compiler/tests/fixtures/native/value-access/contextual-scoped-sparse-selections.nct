struct Item { value: i32 }
const func identity(value: i32): i32 { value }
const func addition(value: i32): func(i32): i32 {
    let item = Item { value: value }
    (item^; amount: i32): i32 { item.value + amount }
}
const func wrap(take callback: func(i32): i32): func(i32): i32 {
    (callback^; amount: i32): i32 { callback(amount) }
}
const func dynamic(index: usize, amount: i32): i32 {
    var pair = (wrap(identity), [(addition(2), 42), (addition(3), 43)])
    var cursor = index
    let saved = pair.1[cursor].0^
    cursor = 1 - index
    edit selected = pair.0
    selected = wrap(addition(1))
    let first = selected(41)
    selected = wrap(identity)
    let second = selected(42)
    if first == 42 && second == 42 && saved(amount) == 42
        && pair.1[0].1 == 42 && pair.1[1].1 == 43 { 42 } else { 0 }
}
const func prefix(count: usize): i32 {
    var pair = (wrap(identity), [addition(2), addition(3)], 42)
    var cursor: usize = 0
    while cursor < count {
        let withdrawn = pair.1[cursor]^
        cursor += 1
    }
    let traversed = cursor
    cursor = 99
    edit selected = pair.0
    selected = wrap(addition(1))
    let first = selected(41)
    selected = wrap(identity)
    let second = selected(42)
    if traversed == count && cursor == 99 && first == 42 && second == 42 && pair.2 == 42 { 42 } else { 0 }
}
const func calculate(): i32 {
    if dynamic(0, 40) == 42 && dynamic(1, 39) == 42 && prefix(0) == 42
        && prefix(1) == 42 && prefix(2) == 42 { 42 } else { 0 }
}
const ANSWER: i32 = calculate()
func run(): i32 { if ANSWER == 42 { calculate() } else { 0 } }
