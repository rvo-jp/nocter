const func addition(number: i32): func(i32): i32 {
    (number; value: i32) { number + value }
}
const func present(number: i32): (func(i32): i32)? { addition(number) }
const func inspect(take values: [((func(i32): i32)?, func(i32): i32, i32); 2], index: usize): i32 {
    let action = values[index].0^ otherwise { return 11 }
    action(values[index].2)
}
const func inspect_read(values: [((func(i32): i32)?, func(i32): i32, i32); 2], index: usize): i32 {
    read action = values[index].0 otherwise { return 11 }
    action(values[index].2)
}
const func inspect_edit(edit values: [((func(i32): i32)?, func(i32): i32, i32); 2], index: usize): i32 {
    edit action = values[index].0 otherwise { return 11 }
    action(values[index].2)
}
const func calculate(): i32 {
    if inspect([(none, addition(100), 2), (none, addition(200), 3)], 0) != 11 { return 0 }
    if inspect([(present(29), addition(100), 2), (present(39), addition(200), 3)], 0) != 31 { return 0 }
    if inspect([(none, addition(100), 2), (none, addition(200), 3)], 1) != 11 { return 0 }
    if inspect([(present(29), addition(100), 2), (present(39), addition(200), 3)], 1) != 42 { return 0 }
    if inspect_read([(none, addition(100), 2), (none, addition(200), 3)], 0) != 11 { return 0 }
    if inspect_read([(present(29), addition(100), 2), (present(39), addition(200), 3)], 0) != 31 { return 0 }
    if inspect_read([(none, addition(100), 2), (none, addition(200), 3)], 1) != 11 { return 0 }
    if inspect_read([(present(29), addition(100), 2), (present(39), addition(200), 3)], 1) != 42 { return 0 }
    if inspect_edit([(none, addition(100), 2), (none, addition(200), 3)], 0) != 11 { return 0 }
    if inspect_edit([(present(29), addition(100), 2), (present(39), addition(200), 3)], 0) != 31 { return 0 }
    if inspect_edit([(none, addition(100), 2), (none, addition(200), 3)], 1) != 11 { return 0 }
    if inspect_edit([(present(29), addition(100), 2), (present(39), addition(200), 3)], 1) != 42 { return 0 }
    42
}
const ANSWER: i32 = calculate()
func run(): i32 { calculate() }
