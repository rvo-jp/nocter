type Pair = (i32, i32)

const func sum(pair: Pair): i32 { pair.0 + pair.1 }

const func use_action(action: func((first, second): Pair): i32, pair: Pair): i32 {
    action(pair)
}

const func calculate(): i32 {
    let named: func((left, right): (i32, i32)): i32 = sum
    let ignored: func(_: Pair): i32 = named
    let ordinary: func((i32, i32)): i32 = ignored
    use_action(ordinary, (19, 23))
}

const ANSWER: i32 = calculate()

func main(): i32 {
    if calculate() == 42 { ANSWER } else { 1 }
}
