use ./error as errors
use ./context as contexts
see ./index.nct

func operation(): i32 { 0 }

func invoke(factory: (func(str, str): error)): error {
    factory("callback", "module message")
}

func run(): i32 {
    let original = errors.operation("direct", "module message")
    let invoke_callback: func(func(str, str): error): error = invoke
    let second = invoke_callback(errors.operation)
    let create = () { errors.operation("inferred", "module message") }
    let third = create()
    let owned = errors.operation("returned", "owned capture")
    let make_returner = (owned^;): once(): error { (owned^;) { owned^ } }
    let returner = make_returner^()
    let fourth = returner^()
    let call = (take action: once(): error) { action^() }
    let pass = (take action: once(): error) { action^ }
    let returned = pass((fourth^;) { fourth^ })
    let fifth = call(returned^)
    let dispose = (take action: once(): error) { () }
    let abandoned = errors.operation("abandoned", "anonymous input cleanup")
    dispose((abandoned^;) { abandoned^ })
    let wrapped = contexts.operation(original^, "module context")
    drop wrapped
    drop second
    drop third
    drop fifth
    42
}
