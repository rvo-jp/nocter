see ./index.nct
use std/error as errors

const func saved(): Packet {
    Packet.pair(5, 6)
}

const SAVED: Packet = saved()
static ARCHIVE: Packet = SAVED

func note(edit steps: i32, digit: i32): i32 {
    steps = steps * 10 + digit
    steps
}

func prepare(edit steps: i32): error {
    steps += 5
    error.new("test.staged", "prepared before early return")
}

func interrupted(stop: bool): i32 {
    var steps = 0
    let packet = Packet.staged(prepare(steps), if stop { return steps } else { 9 })
    drop packet
    0
}

const func score(value: Packet): i32 {
    if value is Packet.pair(first, second) { first + second + 17 } else { 0 }
}

const SCORE: i32 = score(SAVED)

const func adjust(seed: i32): i32 {
    var packet = Packet.grid((seed, 8), true)
    let result = match edit packet {
        Packet.grid((left, right), enabled) {
            left += right
            if enabled { left } else { right }
        }
        _ { 0 }
    }
    if edit packet is Packet.grid((value, _), _) {
        let captured = value
        packet = Packet.empty
        captured + result
    } else {
        0
    }
}

const ADJUSTED: i32 = adjust(13)

const func receive(take packet: Packet): i32 {
    if take packet^ is Packet.grid((left, right), enabled) {
        if enabled { left + right } else { 0 }
    } else {
        match take Packet.pair(12, 9) {
            Packet.pair(first, second) { first + second }
            _ { 0 }
        }
    }
}

const RECEIVED: i32 = receive(Packet.grid((20, 22), true))

copy enum Snapshot {
    stored(value: i32)
}

func snapshot(input: i32): i32 {
    let original = Snapshot.stored(input)
    let taken = match take original { Snapshot.stored(value) { value } }
    let retained = match original { Snapshot.stored(value) { value } }
    taken + retained
}

func record_score(): i32 {
    let packet = Packet.recorded(
        error.new("test.extracted", "transferred to the selected arm"),
        (42, error.new("test.ignored", "discarded from the tuple")),
        error.new("test.trailer", "discarded before the tuple")
    )
    if take packet^ is Packet.recorded(reason, (number, _), _) {
        let enhanced = reason^.context("after transfer")
        if enhanced.has_code("test.extracted") {
            return number
        }
    }
    0
}

struct Ticket { number: i32 }

enum TicketCase {
    empty
    issued(ticket: Ticket)
}

const func redeem(number: i32): i32 {
    match take TicketCase.issued(Ticket { number: number }) {
        TicketCase.issued(ticket) { ticket.number }
        TicketCase.empty { 0 }
    }
}

const TICKET_SCORE: i32 = redeem(42)

func main(): i32 {
    var steps = 0
    let packet = Packet.pair(note(steps, 1), note(steps, 2))
    let selected = score(packet)
    let discarded = match take packet^ {
        Packet.empty { 1 }
        Packet.pair(_, _) { 0 }
        Packet.grid((_, _), _) { 1 }
        Packet.failed(_) { 1 }
        Packet.recorded(_, _, _) { 1 }
        Packet.staged(_, _) { 1 }
    }
    var failure = Packet.failed(error.new("test.active", "active enum payload"))
    if edit failure is Packet.failed(_) {
        failure = Packet.empty
    } else {
        return 98
    }
    drop failure
    if SCORE != 28 || score(ARCHIVE) != SCORE || score(Packet.empty) != 0 || interrupted(true) != 5 {
        return 99
    }
    if ADJUSTED != 42 || adjust(13) != ADJUSTED || adjust(0) != 16 {
        return 97
    }
    let created = if Packet.pair(17, 25) is Packet.pair(first, second) { first + second } else { 0 }
    if created != 42 {
        return 96
    }
    if RECEIVED != 42 || receive(Packet.grid((20, 22), true)) != RECEIVED {
        return 95
    }
    if receive(Packet.empty) != 21 || snapshot(21) != 42 {
        return 94
    }
    if record_score() != 42 {
        return 93
    }
    if TICKET_SCORE != 42 || redeem(29) != 29 {
        return 92
    }
    selected + steps + discarded
}
