see ./index.nct
use std/error as errors

const func saved(): Packet {
    Packet.pair(5, 6)
}

const SAVED: Packet = saved()
static ARCHIVE: Packet = SAVED

func note(edit steps: i32, digit: i32): i32 {
    steps = steps * 10 + digit
    steps
}

func prepare(edit steps: i32): error {
    steps += 5
    error.new("test.staged", "prepared before early return")
}

func interrupted(stop: bool): i32 {
    var steps = 0
    let packet = Packet.staged(prepare(steps), if stop { return steps } else { 9 })
    drop packet
    0
}

const func score(value: Packet): i32 {
    if value is Packet.pair(first, second) { first + second + 17 } else { 0 }
}

const SCORE: i32 = score(SAVED)

const func adjust(seed: i32): i32 {
    var packet = Packet.grid((seed, 8), true)
    let result = match edit packet {
        Packet.grid((left, right), enabled) {
            left += right
            if enabled { left } else { right }
        }
        _ { 0 }
    }
    if edit packet is Packet.grid((value, _), _) {
        let captured = value
        packet = Packet.empty
        captured + result
    } else {
        0
    }
}

const ADJUSTED: i32 = adjust(13)

func main(): i32 {
    var steps = 0
    let packet = Packet.pair(note(steps, 1), note(steps, 2))
    let selected = score(packet)
    let discarded = match take packet^ {
        Packet.empty { 1 }
        Packet.pair(_, _) { 0 }
        Packet.grid((_, _), _) { 1 }
        Packet.failed(_) { 1 }
        Packet.staged(_, _) { 1 }
    }
    var failure = Packet.failed(error.new("test.active", "active enum payload"))
    if edit failure is Packet.failed(_) {
        failure = Packet.empty
    } else {
        return 98
    }
    drop failure
    if SCORE != 28 || score(ARCHIVE) != SCORE || score(Packet.empty) != 0 || interrupted(true) != 5 {
        return 99
    }
    if ADJUSTED != 42 || adjust(13) != ADJUSTED || adjust(0) != 16 {
        return 97
    }
    let created = if Packet.pair(17, 25) is Packet.pair(first, second) { first + second } else { 0 }
    if created != 42 {
        return 96
    }
    selected + steps + discarded
}
