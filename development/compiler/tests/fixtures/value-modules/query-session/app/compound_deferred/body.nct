use std/error as errors
see ./index.nct

struct Packet {
    reason: error
    unused: error?
    words: [i64; 3]
}

func packet(reason: str, present: bool): Packet {
    let extra: error? = if present { errors.operation("discarded", "optional") } else { none }
    Packet {
        reason: errors.operation(reason, "payload"),
        unused: extra^,
        words: [3, 5, 4294967319],
    }
}

async func cancelled(take value: Packet, take divisor: i32): i32 {
    1 / divisor
}

async func scalar(take divisor: i32): i32 {
    1 / divisor
}

async func receive(take value: Packet): error {
    if value.words[2] != 4294967319 {
        return errors.operation("invalid", "storage")
    }
    value.reason^
}

async func inspect(value: Packet): i64 {
    value.words[2]
}

async func replace(edit value: Packet): i64 {
    value.unused = none
    value.reason = errors.operation("discarded", "replacement")
    value = packet("compound", true)
    value.words[2]
}

async func skipped_edit(edit value: Packet): i64 {
    value.words[1] = 0
    value.words[2] / value.words[1]
}

async func main(): i32! {
    var iteration: i32 = 0
    while iteration < 3 {
        let pending = if iteration < 2 {
            cancelled(packet("discarded", iteration == 0), 0)
        } else {
            scalar(0)
        }
        let moved = pending^
        drop moved
        iteration += 1
    }

    let word = await inspect(packet("discarded", true))
    let edited_temporary = await replace(packet("discarded", false))
    if word != 4294967319 || edited_temporary != 4294967319 {
        throw errors.operation("invalid", "temporary")
    }

    var value = packet("discarded", true)
    let skipped = skipped_edit(value)
    drop skipped
    let original = value.words[1]
    let edited = await replace(value)
    let pending = receive(value^)
    let moved = pending^
    let result = await moved^
    if original != 5 || edited != 4294967319 {
        throw errors.operation("invalid", "edit")
    }
    throw result^
}
