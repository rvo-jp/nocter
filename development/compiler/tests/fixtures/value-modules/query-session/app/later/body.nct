see ./index.nct

func tally(take count: i32): i32 {
    var remaining = count
    var result = 0
    loop {
        if remaining == 0 {
            break
        }
        result += 3
        remaining -= 1
    }
    result
}

async func trap_if_driven(): i32 {
    1 / tally(0)
}

async func other_trap_if_driven(): i32 {
    1 / (tally(1) - 3)
}

func choose(edit count: i32, first: bool): bool {
    count += 1
    first
}

func cancel(edit count: i32, first: bool): void {
    let pending = if choose(count, first) {
        trap_if_driven()
    } else {
        other_trap_if_driven()
    }
    let moved = pending^
    drop moved
}

async func child(): i32 {
    tally(9) - 1
}

async func relay(): i32 {
    let pending: future i32 = child()
    await pending^
}

async func first_value(): i32 { 3 }

async func second_value(): i32 { 8 }

async func choose_value(): i32 {
    var iteration = 0
    var choices = 0
    var total = 0
    loop {
        if iteration == 2 {
            break
        }
        let pending = if choose(choices, iteration == 0) {
            first_value()
        } else {
            if choose(choices, iteration == 1) {
                second_value()
            } else {
                trap_if_driven()
            }
        }
        let moved = pending^
        total += await moved^
        iteration += 1
    }
    total + choices
}

async func main(): i32 {
    var count = 0
    cancel(count, true)
    cancel(count, false)
    count + await relay() + await choose_value() - 14
}
