see ./index.nct

func tally(take count: i32): i32 {
    var remaining = count
    var result = 0
    loop {
        if remaining == 0 {
            break
        }
        result += 3
        remaining -= 1
    }
    result
}

async func trap_if_driven(): i32 {
    1 / tally(0)
}

async func other_trap_if_driven(take offset: i32): i32 {
    (offset + 1) / (tally(1) - 3)
}

func choose(edit count: i32, first: bool): bool {
    count += 1
    first
}

func cancel(edit count: i32, first: bool): void {
    let pending = if choose(count, first) {
        trap_if_driven()
    } else {
        other_trap_if_driven(0)
    }
    let moved = pending^
    drop moved
}

async func child(): i32 {
    tally(9) - 1
}

async func relay(): i32 {
    let pending: future i32 = child()
    await pending^
}

async func first_value(take value: i32): i32 { value + 3 }

async func second_value(take wide: i64): i32 {
    if wide == 2147483649 { 8 } else { 88 }
}

async func choose_value(): i32 {
    var iteration = 0
    var choices = 0
    var total = 0
    loop {
        if iteration == 2 {
            break
        }
        let pending = if choose(choices, iteration == 0) {
            first_value(iteration)
        } else {
            if choose(choices, iteration == 1) {
                second_value(2147483649)
            } else {
                trap_if_driven()
            }
        }
        let moved = pending^
        total += await moved^
        iteration += 1
    }
    total + choices
}

func change(edit original: i32): i32 {
    original = 0
    1
}

async func sum_later(take first: i32, take second: i32): i32 {
    first + second
}

async func captured_trap(take value: i32): i32 {
    value / tally(0)
}

async func pair_trap(take first: i32, take second: i32): i32 {
    (first + second) / tally(0)
}

async func snapshot(): i32 {
    var original = 41
    let cancelled = captured_trap(original)
    drop cancelled
    var choices = 0
    let pending: future i32 = if choose(choices, true) {
        sum_later(original, change(original))
    } else {
        pair_trap(original, 0)
    }
    original = 80
    let moved = pending^
    let additional = 3
    let result = await moved^
    result + await sum_later(additional^, 2) + choices - 6
}

async func main(): i32 {
    var count = 0
    cancel(count, true)
    cancel(count, false)
    count + await relay() + await choose_value() + await snapshot() - 56
}
