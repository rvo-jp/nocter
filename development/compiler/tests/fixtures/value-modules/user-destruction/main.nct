see ./index.nct

struct Ticket {
    state: i32
}

impl Ticket {
    drop {
        if self.state != 42 {
            let _ = 1 / 0
        }
        self.state = 0
    }
}

struct Cabinet {
    child: Ticket
    cleaned: bool
}

impl Cabinet {
    drop {
        if self.cleaned {
            let _ = 1 / 0
        }
        self.cleaned = true
        self.child.state = 42
        return
    }
}

enum Parcel {
    empty
    filled(ticket: Ticket, amount: i32)
}

impl Parcel {
    drop {
        if edit self is Parcel.filled(ticket, amount) {
            ticket.state = 42
            amount = 0
        }
    }
}

struct Marker {}

impl Marker {
    drop {
        clean_marker()
    }
}

func clean_marker(): void {}

struct Handler {
    callback: func(i32): void
    marker: i32
}

impl Handler {
    drop {
        self.callback(self.marker)
    }
}

func clean_first(marker: i32): void {
    if marker != 40 { let _ = 1 / 0 }
}

func clean_second(marker: i32): void {
    if marker != 42 { let _ = 1 / 0 }
}

struct PendingTicket {
    state: i32
}

impl PendingTicket {
    drop {
        if self.state != 42 {
            let _ = 1 / 0
        }
    }
}

async func delayed(take ticket: PendingTicket): i32 {
    let _ = 1 / 0
    ticket.state
}

func main(): i32 {
    var cabinet = Cabinet { child: Ticket { state: 42 }, cleaned: false }
    edit selected = cabinet.child
    selected = Ticket { state: 0 }
    drop cabinet

    var restored = Cabinet { child: Ticket { state: 0 }, cleaned: false }
    let original = restored.child^
    restored.child = original^
    drop restored

    let parcel = Parcel.filled(Ticket { state: 0 }, 42)
    if take parcel^ is Parcel.filled(_, amount) {
        if amount != 42 { return 0 }
    } else {
        return 0
    }
    let amount = match take Parcel.filled(Ticket { state: 0 }, 42) {
        Parcel.filled(_, copied) { copied }
        Parcel.empty { 0 }
    }
    if amount != 42 { return 0 }
    let empty = Parcel.empty
    drop empty

    let array = [Ticket { state: 42 }; 1]
    drop array

    let marker = Marker {}
    drop marker

    let first = Handler { callback: clean_first, marker: 40 }
    let second = Handler { callback: clean_second, marker: 42 }
    drop second
    drop first

    let captured_ticket = Ticket { state: 42 }
    let captured = Handler {
        callback: (captured_ticket^; marker: i32): void {
            if marker != 36 || captured_ticket.state > 42 { let _ = 1 / 0 }
        },
        marker: 36,
    }
    drop captured

    let pending = delayed(PendingTicket { state: 42 })
    drop pending
    42
}
