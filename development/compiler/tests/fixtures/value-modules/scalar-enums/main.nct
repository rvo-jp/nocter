see ./index.nct
use ./status

const CURRENT: status.Status = status.in_progress()
static CATALOG: (status.State, status.State) = (CURRENT, status.State.idle)

const func score(value: status.Status): i32 {
    if take value is status.State.active {
        if value is status.State.active { 20 } else { 93 }
    } else {
        0
    }
}

const func bucket(value: status.Status): i32 {
    match take value {
        status.Status.stopped { 70 }
        status.State.active { 20 }
        status.Status.idle { 0 }
    }
}

const SCORE: i32 = score(CURRENT) + bucket(CURRENT) + bucket(status.Status.idle)

func next_index(edit visits: i32): usize {
    visits += 1
    0
}

func receive(take current: status.Status, take secret: status.Secret, take token: status.Token): i32 {
    let copy_of_status = current
    let copy_of_token = token
    if take copy_of_status^ is status.Status.idle { return 97 }
    drop copy_of_token
    let private_score = status.secret_score(secret^)
    if edit [status.Status.active][0] is status.Status.idle { return 94 }
    var writable = current
    if edit writable is status.Status.active {
        writable = status.Status.stopped
    }
    if writable is status.Status.active { return 95 }
    var values = [current, status.State.idle]
    var visits = 0
    let selected = match edit values[next_index(visits)] {
        status.Status.stopped { 70 }
        status.State.active { 0 }
        _ { 71 }
    }
    if values[next_index(visits)] is status.Status.stopped {
        1
    } else if current is status.Status.active {
        SCORE + visits + selected + private_score
    } else {
        2
    }
}

func main(): i32 {
    let hidden = status.secret()
    let closed = status.State.stopped
    let token = status.token()
    drop closed
    let opaque = match take status.secret() { _ { 0 } }
    receive(CATALOG.0, hidden^, token) + opaque
}
