struct Buffer {
    values: [i32; 2]
}

instance Buffer {
    operator (&self[index: usize]): &i32 {
        return &self.values[index]
    }

    operator (&+self[index: usize]): &+i32 {
        return &+self.values[index]
    }
}

func main(): i32 {
    var buffer = Buffer { values: [1, 2] }
    buffer[1] = 3
    return 0
}
