func increment(value: i32): i32 { value + 1 }
func forward(take action: func(i32): i32): func(i32): i32 { action^ }
func invalid(take first: func(i32): i32, take second: func(i32): i32, flag: bool): func(i32): i32 {
if flag { forward(first^) } else { forward(second^) }
}
func run(): i32 { invalid(increment, increment, true)(1) }
