struct Counts {
    first: i32
    second: i32
}
func make(value: i32): Counts { Counts { first: value, second: value } }
func advance(edit value: i32): i32 { value += 1
value }
func combine(a: i32, b: i32): i32 { a + b }
func run(edit value: i32): i32 { combine(make(value).first, advance(value)) }
