enum Maybe<T> {
    some(value: T)
    missing
}

interface Source {
    pub type Item
    pub method &self.next(): Self.Item?
}

construct Maybe<T> {
    pub func empty(): Self {}
}

instance Maybe<T> {
    method &self.item(): &T from self
}

instance Maybe<T> {
    impl Source { .Item = T }
    method &self.next(): Self.Item? {}
}

drop Maybe<T>(&+self) {}
test empty {}
