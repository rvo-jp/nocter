struct Item { value: i32 }
const func consume(take token: i32, other: usize): void {}
const func work(early: bool): i32 {
    let items = [Item { value: 40 }, Item { value: 2 }]
    let token = 7
    var index: usize = 0
    var total = 0
    while index < 2 {
        let selected = items[index]^
        total += selected.value
        if early { consume(token^, if true { return total } else { 0 }) }
        index += 1
    }
    total
}
const func run(): i32 { work(false) + work(true) - 40 }
