struct Item { first: i32
second: i32 }
const func work(index: usize): i32 {
    var items = [Item { first: 40, second: 2 }, Item { first: 7, second: 2 }]
    let first = items[0].first^
    edit second = items[index].second
    second += 1
    first + second - 1
}
const func run(): i32 { work(0) + work(1) - 42 }
