struct Item { value: i32 }
struct Row { left: [Item; 3]
    right: Item }
const func work(index: usize, count: usize): i32 {
    let rows = [Row { left: [Item { value: 20 }, Item { value: 20 }, Item { value: 1 }], right: Item { value: 2 } },
                Row { left: [Item { value: 0 }, Item { value: 0 }, Item { value: 0 }], right: Item { value: 3 } }]
    var cursor: usize = 0
    var total = 0
    while cursor < count {
        let part = rows[0].left[cursor]^
        total += part.value
        cursor += 1
    }
    let right = rows[index].right^
    let expected = if count == 0 { 0 } else { if count == 1 { 20 } else { if count == 2 { 40 } else { 41 } } }
    total + right.value + 40 - expected - (if index == 0 { 0 } else { 1 })
}
copy struct EmptyRow { left: [void; 3]
    right: void }
const func maximum(index: usize): i32 {
    let rows = [EmptyRow { left: [(); 3], right: () }; 18446744073709551615]
    var cursor: usize = 0
    while cursor < 3 {
        let part = rows[0].left[cursor]^
        cursor += 1
    }
    let right = rows[index].right^
    42
}
const func run(): i32 {
    let a = work(0, 0) + work(1, 0) + work(0, 1) + work(1, 1)
    let b = work(0, 2) + work(1, 2) + work(0, 3) + work(1, 3)
    a + b + maximum(0) + maximum(18446744073709551614) - 378
}
