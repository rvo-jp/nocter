//! RawBuffer byte projection and destruction.

see ./index.nct
see ./allocation.nct
see ./layout.nct
see ./storage.nct

use /internal/mem
use /internal/ptr as internal_ptr
use /ptr

noalloc func bytes(buffer: &RawBuffer): &[u8] {
    return internal_ptr.slice_from_raw_parts(buffer.ptr, buffer.len)
}

noalloc func bytes_mut(buffer: &+RawBuffer): &+[u8] {
    return internal_ptr.slice_from_raw_parts_mut(buffer.ptr, buffer.len)
}

noalloc func prefix(buffer: &RawBuffer, len: usize): &[u8]! {
    if len > buffer.len {
        return invalid_argument()
    }
    return internal_ptr.slice_from_raw_parts(buffer.ptr, len)
}

noalloc func prefix_mut(buffer: &+RawBuffer, len: usize): &+[u8]! {
    if len > buffer.len {
        return invalid_argument()
    }
    return internal_ptr.slice_from_raw_parts_mut(buffer.ptr, len)
}

instance RawBuffer {
    noalloc method &self.bytes(): &[u8] {
        return bytes(self)
    }

    noalloc method &+self.bytes_mut(): &+[u8] {
        return bytes_mut(self)
    }

    noalloc method &self.prefix(len: usize): &[u8]! {
        return prefix(self, len)?
    }

    noalloc method &+self.prefix_mut(len: usize): &+[u8]! {
        return prefix_mut(self, len)?
    }
}

noalloc drop RawBuffer(&+self) {
    if self.len != 0 {
        if allocator_kind_is_page(self.allocator_kind) {
            free_pages(ptr.addr(self.ptr), self.len)
        } else if !allocator_kind_is_region(self.allocator_kind) {
            return mem.allocation_abort()
        }
        self.ptr = internal_ptr.from_addr(1)
        self.len = 0
    }
    return
}
