//! Allocator, layout, and raw-buffer representations.

see ./index.nct

use /internal/ptr.from_addr

primitive func current_allocator_state(): usize

primitive func current_allocator_kind(): usize

primitive func allocation_failure_error(): error

const page_allocator_kind: usize = 0

const region_allocator_kind: usize = 1

const unbound_allocator_kind: usize = 2

copy struct Layout {
    size: usize
    align: usize
}

struct RawBuffer {
    ptr: *u8
    len: usize
    align: usize
    allocator_state: usize
    allocator_kind: usize
}

struct Allocator {
    state: usize
    kind: usize
}

struct AllocationContext {
    state: usize
    kind: usize
}

struct TryAllocator {
    state: usize
    kind: usize
}

func current_allocator(): Allocator {
    return Allocator {
        state: current_allocator_state(),
        kind: current_allocator_kind(),
    }
}

func current_try_allocator(): TryAllocator {
    return TryAllocator {
        state: current_allocator_state(),
        kind: current_allocator_kind(),
    }
}

func page_allocator(): Allocator {
    return Allocator { state: 0, kind: page_allocator_kind }
}

func page_try_allocator(): TryAllocator {
    return TryAllocator { state: 0, kind: page_allocator_kind }
}

func empty_unbound_buffer(align: usize): RawBuffer {
    // An unbound empty sentinel owns no storage and therefore
    // carries no allocator origin. The first growth operation binds it to the
    // allocator selected at that operation.
    return RawBuffer {
        ptr: from_addr(1),
        len: 0,
        align: align,
        allocator_state: 0,
        allocator_kind: unbound_allocator_kind,
    }
}

func take_raw_buffer(buffer: &+RawBuffer): RawBuffer {
    let result = RawBuffer {
        ptr: buffer.ptr,
        len: buffer.len,
        align: buffer.align,
        allocator_state: buffer.allocator_state,
        allocator_kind: buffer.allocator_kind,
    }
    buffer.ptr = from_addr(1)
    buffer.len = 0
    buffer.align = 1
    buffer.allocator_state = 0
    buffer.allocator_kind = unbound_allocator_kind
    return move result
}

func allocator_kind_is_page(kind: usize): bool {
    return kind == page_allocator_kind
}

func allocator_kind_is_region(kind: usize): bool {
    return kind == region_allocator_kind
}

func allocator_kind_is_unbound(kind: usize): bool {
    return kind == unbound_allocator_kind
}
