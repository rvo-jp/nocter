//! Public TCP ownership and stream adapters over the shared socket substrate.

see ./index.nct
see ./errors.nct
see ./values.nct

use /internal/net
use /internal/net.{
    AddressAttempt,
    NetworkShutdown,
    StreamConnection,
    StreamConnectionAttempt,
    StreamListener,
    StreamListenerAcceptAttempt,
    StreamListenerAttempt,
    TransferAttempt,
    UnitAttempt,
}
use /internal/net/model.{NetworkAddress, NetworkFamily}
use /time.Duration

struct TcpStream {
    connection: StreamConnection
}

struct TcpListener {
    listener: StreamListener
}

noalloc func substrate_address(address: &SocketAddress): NetworkAddress {
    let ip = address.ip_address
    match ip.address_family {
        IpFamily.ipv4 {
            return NetworkAddress.ipv4(
                [ip.bytes[0], ip.bytes[1], ip.bytes[2], ip.bytes[3]],
                address.port_value,
            )
        }
        IpFamily.ipv6 {
            return NetworkAddress.ipv6(ip.bytes, address.port_value)
        }
    }
}

noalloc func public_address(address: NetworkAddress): SocketAddress {
    let ip = match address.family {
        NetworkFamily.ipv4 {
            IpAddress.from_ipv4(Ipv4Address.from_octets(
                address.bytes[0],
                address.bytes[1],
                address.bytes[2],
                address.bytes[3],
            ))
        }
        NetworkFamily.ipv6 {
            IpAddress.from_ipv6(ipv6_from_bytes(address.bytes))
        }
    }
    return SocketAddress.new(ip, address.port)
}

noalloc func stream_from_connection(connection: StreamConnection): TcpStream {
    return TcpStream { connection: move connection }
}

construct TcpStream {
    noalloc blocking func connect_blocking(address: SocketAddress): Self! {
        match net.connect_stream(substrate_address(&address), none) {
            StreamConnectionAttempt.ready(connection) {
                return stream_from_connection(move connection)
            }
            StreamConnectionAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc blocking func connect_with_timeout_blocking(
        address: SocketAddress,
        timeout: Duration,
    ): Self! {
        match net.connect_stream(substrate_address(&address), timeout) {
            StreamConnectionAttempt.ready(connection) {
                return stream_from_connection(move connection)
            }
            StreamConnectionAttempt.failed(failure) { return network_error(move failure) }
        }
    }
}

instance TcpStream {
    noalloc blocking method &+self.read_blocking(buffer: &+[u8]): usize! {
        match self.connection.read(buffer) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc blocking method &+self.write_blocking(bytes: &[u8]): void! {
        match self.connection.write(bytes) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &self.local_address(): SocketAddress! {
        match self.connection.local_address() {
            AddressAttempt.ready(address) { return public_address(address) }
            AddressAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &self.peer_address(): SocketAddress! {
        match self.connection.peer_address() {
            AddressAttempt.ready(address) { return public_address(address) }
            AddressAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &+self.set_read_timeout(timeout: Duration?): void {
        self.connection.set_read_timeout(timeout)
        return
    }

    noalloc method &self.read_timeout(): Duration? {
        return self.connection.read_timeout()
    }

    noalloc method &+self.set_write_timeout(timeout: Duration?): void {
        self.connection.set_write_timeout(timeout)
        return
    }

    noalloc method &self.write_timeout(): Duration? {
        return self.connection.write_timeout()
    }

    noalloc blocking method &+self.shutdown(direction: TcpShutdown): void! {
        let selected = match direction {
            TcpShutdown.read { NetworkShutdown.read }
            TcpShutdown.write { NetworkShutdown.write }
            TcpShutdown.both { NetworkShutdown.both }
        }
        match self.connection.shutdown(selected) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &+self.close(): void {
        self.connection.close()
        return
    }
}

construct TcpListener {
    noalloc blocking func bind_blocking(address: SocketAddress): Self! {
        match net.listen_stream(substrate_address(&address)) {
            StreamListenerAttempt.ready(listener) {
                return TcpListener { listener: move listener }
            }
            StreamListenerAttempt.failed(failure) { return network_error(move failure) }
        }
    }
}

instance TcpListener {
    noalloc method &self.local_address(): SocketAddress! {
        match self.listener.local_address() {
            AddressAttempt.ready(address) { return public_address(address) }
            AddressAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc blocking method &+self.accept_blocking(): (TcpStream, SocketAddress)! {
        match self.listener.accept() {
            StreamListenerAcceptAttempt.ready(connection, peer) {
                return (stream_from_connection(move connection), public_address(peer))
            }
            StreamListenerAcceptAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    noalloc method &+self.set_accept_timeout(timeout: Duration?): void {
        self.listener.set_accept_timeout(timeout)
        return
    }

    noalloc method &self.accept_timeout(): Duration? {
        return self.listener.accept_timeout()
    }

    noalloc method &+self.close(): void {
        self.listener.close()
        return
    }
}
