//! Public asynchronous TCP adapters over the shared descriptor state.

see ./index.nct
see ./errors.nct
see ./tcp.nct

use /internal/net
use /internal/net.{
    StreamConnectionAttempt,
    StreamListenerAcceptAttempt,
    StreamListenerAttempt,
    TransferAttempt,
    UnitAttempt,
}
use /time.Duration

async func connect_tcp(address: SocketAddress): TcpStream! {
    match await net.connect_stream_async(substrate_address(&address)) {
        StreamConnectionAttempt.ready(connection) {
            return stream_from_connection(move connection)
        }
        StreamConnectionAttempt.failed(failure) { return network_error(move failure) }
    }
}

async func connect_tcp_with_timeout(
    address: SocketAddress,
    timeout: Duration,
): TcpStream! {
    match await net.connect_stream_async_with_timeout(substrate_address(&address), timeout) {
        StreamConnectionAttempt.ready(connection) {
            return stream_from_connection(move connection)
        }
        StreamConnectionAttempt.failed(failure) { return network_error(move failure) }
    }
}

instance TcpStream {
    async method &+self.read(buffer: &+[u8]): usize! {
        match await self.connection.read_async(buffer) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    async method &+self.read_with_timeout(
        buffer: &+[u8],
        timeout: Duration,
    ): usize! {
        match await self.connection.read_async_with_timeout(buffer, timeout) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    async method &+self.write(bytes: &[u8]): void! {
        match await self.connection.write_async(bytes) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    async method &+self.write_with_timeout(
        bytes: &[u8],
        timeout: Duration,
    ): void! {
        match await self.connection.write_async_with_timeout(bytes, timeout) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return network_error(move failure) }
        }
    }
}

async func bind_tcp(address: SocketAddress): TcpListener! {
    match await net.listen_stream_async(substrate_address(&address)) {
        StreamListenerAttempt.ready(listener) {
            return TcpListener { listener: move listener }
        }
        StreamListenerAttempt.failed(failure) { return network_error(move failure) }
    }
}

instance TcpListener {
    async method &+self.accept(): (TcpStream, SocketAddress)! {
        match await self.listener.accept_async() {
            StreamListenerAcceptAttempt.ready(connection, peer) {
                return (stream_from_connection(move connection), public_address(peer))
            }
            StreamListenerAcceptAttempt.failed(failure) { return network_error(move failure) }
        }
    }

    async method &+self.accept_with_timeout(
        timeout: Duration,
    ): (TcpStream, SocketAddress)! {
        match await self.listener.accept_async_with_timeout(timeout) {
            StreamListenerAcceptAttempt.ready(connection, peer) {
                return (stream_from_connection(move connection), public_address(peer))
            }
            StreamListenerAcceptAttempt.failed(failure) { return network_error(move failure) }
        }
    }
}
