//! Address implementations for shared formatting, hashing, and ordering contracts.

see ./index.nct
see ./formatting.nct
see ./values.nct

use /hash.HashState
use /internal/ptr
use /ptr as ptr_module
use /string.String

noalloc func write_four_bytes(state: &+HashState, bytes: &[u8; 4]): void {
    state.write(ptr.slice_from_raw_parts_value(ptr_module.from_ref(&bytes[0]), 4))
    return
}

noalloc func write_sixteen_bytes(state: &+HashState, bytes: &[u8; 16]): void {
    state.write(ptr.slice_from_raw_parts_value(ptr_module.from_ref(&bytes[0]), 16))
    return
}

noalloc func write_two_bytes(state: &+HashState, bytes: &[u8; 2]): void {
    state.write(ptr.slice_from_raw_parts_value(ptr_module.from_ref(&bytes[0]), 2))
    return
}

noalloc func write_one_byte(state: &+HashState, value: u8): void {
    let bytes: [u8; 1] = [value]
    state.write(ptr.slice_from_raw_parts_value(ptr_module.from_ref(&bytes[0]), 1))
    return
}

instance Ipv4Address {
    method &self.try_format_into(output: &+String): void! {
        try_write_ipv4(output, self)?
        return
    }

    noalloc method &self.hash_into(state: &+HashState): void {
        write_four_bytes(state, &self.bytes)
        return
    }
}

instance Ipv6Address {
    method &self.try_format_into(output: &+String): void! {
        try_write_ipv6(output, self)?
        return
    }

    noalloc method &self.hash_into(state: &+HashState): void {
        write_sixteen_bytes(state, &self.bytes)
        return
    }
}

instance IpAddress {
    method &self.try_format_into(output: &+String): void! {
        try_write_ip(output, self)?
        return
    }

    noalloc method &self.hash_into(state: &+HashState): void {
        match self.address_family {
            IpFamily.ipv4 { write_one_byte(state, 4) }
            IpFamily.ipv6 { write_one_byte(state, 6) }
        }
        write_sixteen_bytes(state, &self.bytes)
        return
    }
}

instance SocketAddress {
    method &self.try_format_into(output: &+String): void! {
        try_write_socket(output, self)?
        return
    }

    noalloc method &self.hash_into(state: &+HashState): void {
        self.ip_address.hash_into(state)
        let port_bytes: [u8; 2] = [
            u8.truncate((self.port_value / 256) as u64),
            u8.truncate((self.port_value % 256) as u64),
        ]
        write_two_bytes(state, &port_bytes)
        return
    }
}
