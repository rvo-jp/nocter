//! Directory lifecycle contract tests.

see ./index.nct
see ./directory_prefix.nct

use /testing

test directory_prefix_helpers_reject_invalid_boundaries {
    let _unexpected_end = next_directory_prefix_end("a", 2) otherwise {
        let _unexpected_prefix = directory_prefix("é", 1) otherwise { return }
        return error.new("std.fs.test", "non-boundary prefix was accepted")
    }
    return error.new("std.fs.test", "out-of-range prefix cursor was accepted")
}

test directory_creation_and_removal_preserve_explicit_scope {
    let root = ".nocter-v027-directory-lifecycle"
    let nested = ".nocter-v027-directory-lifecycle/first/second"
    create_dir_all_blocking(nested)?
    let root_metadata = metadata_blocking(root)?
    let nested_metadata = metadata_blocking(nested)?
    testing.assert(root_metadata.is_directory())?
    testing.assert(nested_metadata.is_directory())?

    create_dir_all_blocking(nested)?
    var existing_rejected = false
    create_dir_blocking(root) catch failure {
        existing_rejected = failure.has_code("std.io.already_exists")
    }
    testing.assert(existing_rejected)?

    var nonempty_rejected = false
    remove_dir_blocking(root) catch failure {
        nonempty_rejected = failure.has_code("std.io.directory_not_empty")
    }
    testing.assert(nonempty_rejected)?
    remove_dir_blocking(nested)?
    remove_dir_blocking(".nocter-v027-directory-lifecycle/first")?
    remove_dir_blocking(root)?
    let root_exists = exists_blocking(root)?
    testing.assert(!root_exists)?
    return
}

test recursive_creation_rejects_empty_and_non_directory_prefixes {
    create_dir_all_blocking("///")?

    var empty_rejected = false
    create_dir_all_blocking("") catch failure {
        empty_rejected = failure.has_code("std.io.invalid_input")
    }
    testing.assert(empty_rejected)?

    let root = ".nocter-v027-directory-prefix"
    let file = ".nocter-v027-directory-prefix/file"
    create_dir_blocking(root)?
    write_text_blocking(file, "not a directory")?
    var prefix_rejected = false
    create_dir_all_blocking(".nocter-v027-directory-prefix/file/child") catch failure {
        prefix_rejected = failure.has_code("std.io.not_directory")
    }
    testing.assert(prefix_rejected)?
    remove_file_blocking(file)?
    remove_dir_blocking(root)?
    return
}

test metadata_exposes_a_normalized_modification_instant {
    let path = ".nocter-v036-metadata-time"
    write_text_blocking(path, "timestamp")?
    let details = metadata_blocking(path)?
    let modified = details.modified()
    testing.assert(modified.subsecond_nanoseconds() < 1000000000)?
    let utc = modified.to_utc()?
    testing.assert(utc.year() >= 1970 && utc.year() <= 9999)?
    let text = modified.to_rfc3339()?
    testing.assert(text.len() >= 20)?
    remove_file_blocking(path)?
    return
}
