//! Canonical path resolution through one shared bounded path-output policy.

see ./index.nct
see ./darwin.nct
see ./path_output.nct

use /internal/io
use /path as path_module
use /path.Utf8Path

async func canonicalize(path: &str): Utf8Path! {
    path_module.validate(path)?
    var buffer = new_path_output_buffer()?
    let completion = await io.filesystem_canonicalize(path, path_output_bytes_mut(&+buffer))
    io.validate_file_completion(&completion)?
    let received = io.file_completion_transferred_byte_count(&completion)
    return path_output_path(&buffer, received)?
}

blocking func canonicalize_blocking(path: &str): Utf8Path! {
    var buffer = new_path_output_buffer()?
    let received = canonicalize_target(path, path_output_bytes_mut(&+buffer))?
    return path_output_path(&buffer, received)?
}
