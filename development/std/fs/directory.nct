//! Darwin directory-stream ownership and native record decoding.

see ./index.nct

use /internal/io
use /internal/os/darwin.SyscallResult
use /internal/os/darwin






use /internal/path as internal_path
use /internal/ptr as internal_ptr
use /mem.RawBuffer
use /mem
use /path.Utf8Path
use /ptr
use /string.String

#target: "arm64-darwin"
const DIRECTORY_BUFFER_SIZE: usize = 16384

struct DirEntry {
    file_name: String
    path: Utf8Path
    file_type: FileType
}

struct ReadDir {
    fd: usize
    is_open: bool
    is_finished: bool
    base: Utf8Path
    buffer: RawBuffer
    buffer_offset: usize
    buffer_len: usize
}

instance DirEntry {
    method &self.file_name(): &str {
        return &self.file_name
    }

    method &self.path(): &Utf8Path {
        return &self.path
    }

    method &self.file_type(): FileType {
        return self.file_type
    }
}

instance ReadDir {
    method &+self.next(): DirEntry?! {
        return next_directory_entry(self)
    }

    method &+self.close(): void {
        close_directory(self)
        return
    }
}

func read_dir(path: &str): ReadDir! {
    let base = Utf8Path.new(path)?
    var allocator = mem.page_try_allocator()
    let buffer = allocator.try_alloc(DIRECTORY_BUFFER_SIZE, 8)?
    let fd = open_directory(path)?
    return ReadDir {
        fd: fd,
        is_open: true,
        is_finished: false,
        base: move base,
        buffer: move buffer,
        buffer_offset: 0,
        buffer_len: 0,
    }
}

#target: "arm64-darwin"
func open_directory(path: &str): usize! {
    let argument = internal_path.target_path_argument(path)?
    var result: SyscallResult = darwin.syscall3(
        darwin.SYS_OPEN,
        internal_path.target_path_address(&argument),
        darwin.OPEN_DIRECTORY_ONLY,
        0,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(
            darwin.SYS_OPEN,
            internal_path.target_path_address(&argument),
            darwin.OPEN_DIRECTORY_ONLY,
            0,
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return result.value
}

#target: "arm64-darwin"
func refill_directory(reader: &+ReadDir): usize! {
    var position: u64 = 0
    let buffer = reader.buffer.bytes_mut()
    var result: SyscallResult = darwin.read_directory_entries(reader.fd, buffer, &+position)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.read_directory_entries(reader.fd, buffer, &+position)
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    if result.value > buffer.len() {
        return invalid_directory_record()
    }
    reader.buffer_offset = 0
    reader.buffer_len = result.value
    return result.value
}

func next_directory_entry(reader: &+ReadDir): DirEntry?! {
    if reader.is_finished || !reader.is_open {
        return none
    }

    while true {
        if reader.buffer_offset >= reader.buffer_len {
            let received = refill_directory(reader) catch failure {
                close_directory(reader)
                return move failure
            }
            if received == 0 {
                close_directory(reader)
                return none
            }
        }

        let record_start = reader.buffer_offset
        let remaining = reader.buffer_len - record_start
        if remaining <= darwin.DIRENT_NAME_OFFSET {
            return fail_directory(reader, invalid_directory_record())
        }

        let record_address = ptr.addr(reader.buffer.bytes().ptr()) + record_start
        let inode_pointer: *u64 = internal_ptr.from_addr(record_address)
        let length_pointer: *u16 = internal_ptr.from_addr(record_address)
        let type_pointer: *u8 = internal_ptr.from_addr(record_address)
        let inode: u64 = internal_ptr.take_value_at_ptr(inode_pointer, darwin.DIRENT_INODE_OFFSET)
        let record_len: usize = internal_ptr.take_value_at_ptr(
            length_pointer,
            darwin.DIRENT_RECORD_LENGTH_OFFSET,
        ) as usize
        let name_len: usize = internal_ptr.take_value_at_ptr(
            length_pointer,
            darwin.DIRENT_NAME_LENGTH_OFFSET,
        ) as usize
        let entry_type: u8 = internal_ptr.take_value_at_ptr(type_pointer, darwin.DIRENT_TYPE_OFFSET)

        if record_len <= darwin.DIRENT_NAME_OFFSET || record_len > remaining {
            return fail_directory(reader, invalid_directory_record())
        }
        if name_len == 0 || name_len >= record_len - darwin.DIRENT_NAME_OFFSET {
            return fail_directory(reader, invalid_directory_record())
        }

        let name_address = record_address + darwin.DIRENT_NAME_OFFSET
        let name_pointer: *u8 = internal_ptr.from_addr(name_address)
        let terminator: u8 = internal_ptr.take_value_at_ptr(name_pointer, name_len)
        if terminator != 0 {
            return fail_directory(reader, invalid_directory_record())
        }

        reader.buffer_offset += record_len
        if inode == 0 {
            continue
        }

        let name_bytes = internal_ptr.slice_from_raw_parts(name_pointer, name_len)
        let name = String.from_utf8(name_bytes) catch _ {
            return fail_directory(reader, invalid_utf8_name())
        }
        if (&name as &str) == "." || (&name as &str) == ".." {
            continue
        }

        let path = reader.base.join(&name) catch failure {
            close_directory(reader)
            return move failure
        }
        return DirEntry {
            file_name: move name,
            path: move path,
            file_type: file_type_from_dirent(entry_type),
        }
    }
    return none
}

func file_type_from_dirent(value: u8): FileType {
    if value == darwin.DIRENT_TYPE_REGULAR {
        return FileType.regular
    }
    if value == darwin.DIRENT_TYPE_DIRECTORY {
        return FileType.directory
    }
    if value == darwin.DIRENT_TYPE_SYMLINK {
        return FileType.symlink
    }
    return FileType.other
}

func fail_directory(reader: &+ReadDir, failure: error): error {
    close_directory(reader)
    return move failure
}

func close_directory(reader: &+ReadDir): void {
    if reader.is_open {
        let _ = darwin.syscall1(darwin.SYS_CLOSE, reader.fd)
        reader.is_open = false
    }
    reader.is_finished = true
    reader.buffer_offset = 0
    reader.buffer_len = 0
    return
}

func invalid_utf8_name(): error {
    return error.new("std.fs.invalid_utf8_name", "directory entry name is not valid UTF-8")
}

func invalid_directory_record(): error {
    return error.new("std.fs.invalid_directory_record", "OS returned an invalid directory record")
}

drop ReadDir(&+self) {
    close_directory(self)
    return
}
