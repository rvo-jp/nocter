//! Portable filesystem behavior built on stream and target contracts.

see ./index.nct
see ./darwin.nct

use /io.{File, BlockingFile, Reader, Writer, BlockingReader, BlockingWriter}
use /string.String
use /time.SystemTime
use /vec.Vec

copy struct Metadata {
    file_type: FileType
    len: u64
    modified: SystemTime
}

instance Metadata {
    method &self.file_type(): FileType {
        return self.file_type
    }

    method &self.len(): u64 {
        return self.len
    }

    method &self.modified(): SystemTime {
        return self.modified
    }

    method &self.is_file(): bool {
        if self.file_type is FileType.regular {
            return true
        }
        return false
    }

    method &self.is_directory(): bool {
        if self.file_type is FileType.directory {
            return true
        }
        return false
    }
}

async func read(path: &str): Vec<u8>! {
    var file = await File.open(path)?
    return await file.read_to_end()?
}

async func read_to_string(path: &str): String! {
    var file = await File.open(path)?
    return await file.read_to_string()?
}

async func write(path: &str, value: &[u8]): void! {
    var file = await File.create(path)?
    await file.write(value)?
    return
}

async func write_text(path: &str, text: &str): void! {
    var file = await File.create(path)?
    await file.write_text(text)?
    return
}

blocking func read_blocking(path: &str): Vec<u8>! {
    var file = BlockingFile.open(path)?
    return file.read_to_end_blocking()?
}

blocking func read_to_string_blocking(path: &str): String! {
    var file = BlockingFile.open(path)?
    return file.read_to_string_blocking()?
}

blocking func write_blocking(path: &str, value: &[u8]): void! {
    var file = BlockingFile.create(path)?
    file.write_blocking(value)?
    return
}

blocking func write_text_blocking(path: &str, text: &str): void! {
    var file = BlockingFile.create(path)?
    file.write_text_blocking(text)?
    return
}

blocking func metadata(path: &str): Metadata! {
    return metadata_target(path)?
}

blocking func exists(path: &str): bool! {
    return exists_target(path)?
}

blocking func remove_file(path: &str): void! {
    remove_file_target(path)?
    return
}

blocking func rename(from: &str, to: &str): void! {
    rename_target(from, to)?
    return
}
