//! Contract tests for prefix decoding outcomes.

see ./index.nct

use /vec.Vec

test prefix_decode_variants_keep_exact_semantic_state {
    let source_value: u64 = 300
    let source_consumed: usize = 2
    let decoded: PrefixDecode<u64> = PrefixDecode.decoded(source_value, source_consumed)
    match move decoded {
        PrefixDecode.decoded(decoded_value, decoded_consumed) {
            if decoded_value != 300 || decoded_consumed != 2 {
                return error.new("std.bytes.prefix", "decoded payload changed")
            }
        }
        _ { return error.new("std.bytes.prefix", "decoded variant changed") }
    }

    let incomplete: PrefixDecode<u64> = PrefixDecode.incomplete
    match move incomplete {
        PrefixDecode.incomplete {}
        _ { return error.new("std.bytes.prefix", "incomplete variant changed") }
    }

    let overflow: PrefixDecode<u64> = PrefixDecode.overflow
    match move overflow {
        PrefixDecode.overflow {}
        _ { return error.new("std.bytes.prefix", "overflow variant changed") }
    }

    let non_canonical: PrefixDecode<u64> = PrefixDecode.non_canonical
    match move non_canonical {
        PrefixDecode.non_canonical {}
        _ { return error.new("std.bytes.prefix", "non-canonical variant changed") }
    }
    return
}

noalloc func require_decoded_u64(
    result: PrefixDecode<u64>,
    expected_value: u64,
    expected_consumed: usize,
): bool {
    match move result {
        PrefixDecode.decoded(value, consumed) {
            return value == expected_value && consumed == expected_consumed
        }
        _ { return false }
    }
}

noalloc func require_decoded_i64(
    result: PrefixDecode<i64>,
    expected_value: i64,
    expected_consumed: usize,
): bool {
    match move result {
        PrefixDecode.decoded(value, consumed) {
            return value == expected_value && consumed == expected_consumed
        }
        _ { return false }
    }
}

test signed_fixed_width_codecs_preserve_twos_complement_bits {
    let encoded16: Vec<u8> = Vec [u8.truncate(255), u8.truncate(254)]
    let encoded32: Vec<u8> = Vec [u8.truncate(128), u8.truncate(0), u8.truncate(0), u8.truncate(0)]
    let encoded64: Vec<u8> = Vec [
        u8.truncate(128),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let value16 = decode_i16_be(&encoded16 as &[u8]) otherwise {
        return error.new("std.bytes.signed", "i16 decode failed")
    }
    let value32 = decode_i32_le(&encoded32 as &[u8]) otherwise {
        return error.new("std.bytes.signed", "i32 decode failed")
    }
    let value64 = decode_i64_be(&encoded64 as &[u8]) otherwise {
        return error.new("std.bytes.signed", "i64 decode failed")
    }
    if value16.to_bits() != 65534
        || value32.to_bits() != 128
        || value64.to_bits() != 9223372036854775808 {
        return error.new("std.bytes.signed", "signed representation changed")
    }

    var output: Vec<u8> = Vec [
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
        u8.truncate(7),
    ]
    if !encode_i64_le(&+output as &+[u8], value64)
        || output[0] != 0
        || output[7] != 128 {
        return error.new("std.bytes.signed", "signed encoding changed")
    }
    return
}

test canonical_uleb128_distinguishes_all_prefix_outcomes {
    let canonical: Vec<u8> = Vec [u8.truncate(172), u8.truncate(2)]
    if !require_decoded_u64(decode_uleb128(&canonical as &[u8]), 300, 2) {
        return error.new("std.bytes.uleb128", "canonical value changed")
    }

    let incomplete: Vec<u8> = Vec [u8.truncate(128)]
    let incomplete_result = decode_uleb128(&incomplete as &[u8])
    match move incomplete_result {
        PrefixDecode.incomplete {}
        _ { return error.new("std.bytes.uleb128", "incomplete input changed") }
    }

    let overlong: Vec<u8> = Vec [u8.truncate(128), u8.truncate(0)]
    let overlong_result = decode_uleb128(&overlong as &[u8])
    match move overlong_result {
        PrefixDecode.non_canonical {}
        _ { return error.new("std.bytes.uleb128", "overlong input was accepted") }
    }

    let overflow: Vec<u8> = Vec [
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(255),
        u8.truncate(2),
    ]
    let overflow_result = decode_uleb128(&overflow as &[u8])
    match move overflow_result {
        PrefixDecode.overflow {}
        _ { return error.new("std.bytes.uleb128", "overflowing input was accepted") }
    }
    return
}

test variable_width_encoding_is_transactional_and_canonical {
    var output: Vec<u8> = Vec [
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
        u8.truncate(9),
    ]
    let width = encode_uleb128(&+output as &+[u8], 300) otherwise {
        return error.new("std.bytes.uleb128", "encoding failed")
    }
    if width != 2 || output[0] != 172 || output[1] != 2 {
        return error.new("std.bytes.uleb128", "encoding changed")
    }

    var short: Vec<u8> = Vec [u8.truncate(11)]
    let _unexpected = encode_uleb128(&+short as &+[u8], 300) otherwise {
        if short[0] != 11 {
            return error.new("std.bytes.uleb128", "failed encoding mutated output")
        }
        return
    }
    return error.new("std.bytes.uleb128", "short output was accepted")
}

test zigzag_uleb128_preserves_signed_boundaries {
    var output: Vec<u8> = Vec [
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
        u8.truncate(0),
    ]
    let negative_width = encode_zigzag_uleb128(&+output as &+[u8], -151) otherwise {
        return error.new("std.bytes.zigzag", "negative encoding failed")
    }
    if negative_width != 2 || !require_decoded_i64(decode_zigzag_uleb128(&output as &[u8]), -151, 2) {
        return error.new("std.bytes.zigzag", "negative round trip changed")
    }

    let minimum = i64.from_bits(9223372036854775808)
    let minimum_width = encode_zigzag_uleb128(&+output as &+[u8], minimum) otherwise {
        return error.new("std.bytes.zigzag", "minimum encoding failed")
    }
    if minimum_width != 10
        || !require_decoded_i64(decode_zigzag_uleb128(&output as &[u8]), minimum, 10) {
        return error.new("std.bytes.zigzag", "minimum round trip changed")
    }
    return
}
