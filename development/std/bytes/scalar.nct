//! Canonical fixed-width scalar codecs.

see ./index.nct

noalloc func decode_u16(input: &[u8], little_endian: bool): u16? {
    if input.len() < 2 { return none }
    var result: u16 = 0
    var offset: usize = 0
    let last: usize = 1
    while offset < 2 {
        let index = if little_endian { last - offset } else { offset }
        result = result * 256 + input[index] as u16
        offset += 1
    }
    return result
}

noalloc func decode_u32(input: &[u8], little_endian: bool): u32? {
    if input.len() < 4 { return none }
    var result: u32 = 0
    var offset: usize = 0
    let last: usize = 3
    while offset < 4 {
        let index = if little_endian { last - offset } else { offset }
        result = result * 256 + input[index] as u32
        offset += 1
    }
    return result
}

noalloc func decode_u64(input: &[u8], little_endian: bool): u64? {
    if input.len() < 8 { return none }
    var result: u64 = 0
    var offset: usize = 0
    let last: usize = 7
    while offset < 8 {
        let index = if little_endian { last - offset } else { offset }
        result = result * 256 + input[index] as u64
        offset += 1
    }
    return result
}

noalloc func encode_unsigned(
    output: &+[u8],
    value: u64,
    width: usize,
    little_endian: bool,
): bool {
    if output.len() < width { return false }
    var remaining = value
    var offset: usize = 0
    while offset < width {
        let index = if little_endian { offset } else { width - 1 - offset }
        output[index] = u8.truncate(remaining)
        remaining = remaining / 256
        offset += 1
    }
    return true
}

noalloc func decode_u16_be(input: &[u8]): u16? { return decode_u16(input, false)? }

noalloc func decode_u16_le(input: &[u8]): u16? { return decode_u16(input, true)? }

noalloc func decode_u32_be(input: &[u8]): u32? { return decode_u32(input, false)? }

noalloc func decode_u32_le(input: &[u8]): u32? { return decode_u32(input, true)? }

noalloc func decode_u64_be(input: &[u8]): u64? { return decode_u64(input, false)? }

noalloc func decode_u64_le(input: &[u8]): u64? { return decode_u64(input, true)? }

noalloc func decode_f32_be(input: &[u8]): f32? { return f32.from_bits(decode_u32_be(input)?) }

noalloc func decode_f32_le(input: &[u8]): f32? { return f32.from_bits(decode_u32_le(input)?) }

noalloc func decode_f64_be(input: &[u8]): f64? { return f64.from_bits(decode_u64_be(input)?) }

noalloc func decode_f64_le(input: &[u8]): f64? { return f64.from_bits(decode_u64_le(input)?) }

noalloc func encode_u16_be(output: &+[u8], value: u16): bool {
    return encode_unsigned(output, value as u64, 2, false)
}

noalloc func encode_u16_le(output: &+[u8], value: u16): bool {
    return encode_unsigned(output, value as u64, 2, true)
}

noalloc func encode_u32_be(output: &+[u8], value: u32): bool {
    return encode_unsigned(output, value as u64, 4, false)
}

noalloc func encode_u32_le(output: &+[u8], value: u32): bool {
    return encode_unsigned(output, value as u64, 4, true)
}

noalloc func encode_u64_be(output: &+[u8], value: u64): bool {
    return encode_unsigned(output, value, 8, false)
}

noalloc func encode_u64_le(output: &+[u8], value: u64): bool {
    return encode_unsigned(output, value, 8, true)
}

noalloc func encode_f32_be(output: &+[u8], value: f32): bool {
    return encode_u32_be(output, value.to_bits())
}

noalloc func encode_f32_le(output: &+[u8], value: f32): bool {
    return encode_u32_le(output, value.to_bits())
}

noalloc func encode_f64_be(output: &+[u8], value: f64): bool {
    return encode_u64_be(output, value.to_bits())
}

noalloc func encode_f64_le(output: &+[u8], value: f64): bool {
    return encode_u64_le(output, value.to_bits())
}
