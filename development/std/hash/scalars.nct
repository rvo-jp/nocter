//! Fixed-width Hash implementations for compiler built-in scalar values.

see ./index.nct

use /internal/ptr.{from_addr, pointee_size, slice_from_raw_parts}
use /ptr.{addr, from_ref}

func write_bool(state: &+HashState, value: &bool): void {
    let pointer: *bool = from_ref(value)
    let bytes_pointer: *u8 = from_addr(addr(pointer))
    state.write(slice_from_raw_parts(bytes_pointer, pointee_size(pointer)))
    return
}

func write_i8(state: &+HashState, value: &i8): void {
    let pointer: *i8 = from_ref(value)
    let bytes_pointer: *u8 = from_addr(addr(pointer))
    state.write(slice_from_raw_parts(bytes_pointer, pointee_size(pointer)))
    return
}

