instance bool {
    noalloc method &self.hash_into(state: &+HashState): void {
        write_bool(state, self)
        return
    }
}

instance i8 {
    noalloc method &self.hash_into(state: &+HashState): void {
        write_i8(state, self)
        return
    }
}

instance i16 {
    noalloc method &self.hash_into(state: &+HashState): void {
        write_i16(state, self)
        return
    }
}

instance i32 {
