    state.write(slice_from_raw_parts(bytes_pointer, pointee_size(pointer)))
    return
}

instance bool {
    method &self.hash_into(state: &+HashState): void {
        write_bool(state, self)
        return
    }
}

instance i8 {
    method &self.hash_into(state: &+HashState): void {
        write_i8(state, self)
        return
    }
}

instance i16 {
    method &self.hash_into(state: &+HashState): void {
        write_i16(state, self)
        return
    }
}

instance i32 {
    method &self.hash_into(state: &+HashState): void {
