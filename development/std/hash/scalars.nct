//! Fixed-width Hash implementations for compiler built-in scalar values.

see ./index.nct

use /internal/ptr
use /ptr as ptr_module

func write_bool(state: &+HashState, value: &bool): void {
    let pointer: *bool = ptr_module.from_ref(value)
    let bytes_pointer: *u8 = ptr.from_addr(ptr_module.addr(pointer))
    state.write(ptr.slice_from_raw_parts(bytes_pointer, ptr.pointee_size(pointer)))
    return
}

func write_i8(state: &+HashState, value: &i8): void {
    let pointer: *i8 = ptr_module.from_ref(value)
    let bytes_pointer: *u8 = ptr.from_addr(ptr_module.addr(pointer))
    state.write(ptr.slice_from_raw_parts(bytes_pointer, ptr.pointee_size(pointer)))
    return
}

