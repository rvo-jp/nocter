//! Owned string representation and readonly projection.

see ./index.nct

use std/mem.RawBuffer
use std/internal/ptr.str_from_raw_parts

struct String {
    storage: RawBuffer
    len: usize
}

func view(text: &String): &str {
    return str_from_raw_parts(text.storage.bytes().ptr(), text.len)
}

func capacity(text: &String): usize {
    return text.storage.bytes().len()
}

instance String {
    coerce &self as &str {
        return view(self)
    }

    method &self.capacity(): usize {
        return capacity(self)
    }
}
