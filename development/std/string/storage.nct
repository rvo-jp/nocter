//! Owned string representation and readonly projection.

see ./index.nct

use /mem.RawBuffer
use /internal/ptr

struct String {
    storage: RawBuffer
    len: usize
}

func view(text: &String): &str {
    return ptr.str_from_raw_parts(text.storage.bytes().ptr(), text.len)
}

instance String {
    coerce &self as &str {
        return view(self)
    }

    method &self.capacity(): usize {
        return self.storage.bytes().len()
    }
}
