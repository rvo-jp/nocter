//! Owned string capacity management and mutation.

see ./index.nct
see ./storage.nct

use /internal/mem.{allocation_abort, checked_add, growth_capacity}
use /internal/ptr.{copy_str_to_ptr, store_u8_to_ptr}
use /internal/utf8.validate_utf8
use /mem.try_grow_owned

func try_reserve(text: &+String, additional: usize): usize! {
    let text_len: usize = text.len
    let required_capacity: usize = checked_add(text_len, additional) otherwise {
        return capacity_overflow()
    }
    let current_capacity: usize = text.storage.bytes().len()
    if required_capacity <= current_capacity {
        return required_capacity
    }

    let next_capacity = growth_capacity(current_capacity, required_capacity)
    try_grow_owned(&+text.storage, next_capacity)?
    return required_capacity
}

func reserve(text: &+String, additional: usize): void {
    let _ = try_reserve(text, additional) catch allocation_error {
        return allocation_abort()
    }
    return
}

func clear(text: &+String): void {
    text.len = 0
    return
}

func try_push_str(text: &+String, value: &str): void! {
    let value_len: usize = value.len()
    let old_len: usize = text.len
    let next_len: usize = try_reserve(text, value_len)?
    copy_str_to_ptr(text.storage.bytes().ptr(), old_len, value)
    text.len = next_len
    return
}

func push_str(text: &+String, value: &str): void {
    try_push_str(text, value) catch allocation_error {
        return allocation_abort()
    }
    return
}

func try_push_utf8(text: &+String, value: &[u8]): void! {
    validate_utf8(value)?
    let old_len = text.len
    let next_len: usize = try_reserve(text, value.len())?
    let destination = text.storage.bytes().ptr()
    var index: usize = 0
    while index < value.len() {
        store_u8_to_ptr(destination, old_len + index, value[index])
        index += 1
    }
    text.len = next_len
    return
}

func capacity_overflow(): error {
    return error.new("std.string.capacity_overflow", "string capacity overflow")
}

instance String {
    method &+self.reserve(additional: usize): void {
        reserve(self, additional)
        return
    }

    method &+self.try_reserve(additional: usize): void! {
        let _ = try_reserve(self, additional)?
        return
    }

    method &+self.clear(): void {
        clear(self)
        return
    }

    method &+self.push_str(value: &str): void {
        push_str(self, value)
        return
    }

    method &+self.try_push_str(value: &str): void! {
        try_push_str(self, value)?
        return
    }

    method &+self.try_push_utf8(value: &[u8]): void! {
        try_push_utf8(self, value)?
        return
    }
}
