//! Package-internal UTF-8 validation and stable failure construction.

see ./encoding.nct
see ./decoding.nct
see ./validation.nct

/// One validated Unicode scalar encoded into its initialized UTF-8 prefix.
pub(/) copy struct ScalarEncoding

/// One decoded scalar and its exact UTF-8 byte width.
pub(/) copy struct ScalarDecodeStep {
    pub(/) scalar: u32
    pub(/) width: usize
}

/// Encodes one character whose type already guarantees Unicode scalar validity.
pub(/) noalloc func encode_scalar(value: char): ScalarEncoding

/// Decodes one scalar beginning at `offset`, or returns none for an invalid or absent sequence.
pub(/) noalloc func decode_scalar(
    candidate: &[u8],
    offset: usize,
): ScalarDecodeStep?

instance ScalarEncoding {
    /// Returns exactly the initialized UTF-8 encoding bytes.
    pub(/) noalloc method &self.bytes(): &[u8]
}

/// Returns whether the complete byte view is well-formed UTF-8.
pub(/) noalloc func is_valid_utf8(candidate: &[u8]): bool

/// Accepts well-formed UTF-8 or returns the stable string encoding error.
pub(/) noalloc func validate_utf8(candidate: &[u8]): void!
