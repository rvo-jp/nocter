//! Shared UTF-8 state validation and stable failure policy.

see ./index.nct

noalloc func is_valid_utf8(candidate: &[u8]): bool {
    var offset: usize = 0
    while offset < candidate.len() {
        let step = decode_scalar(candidate, offset) otherwise { return false }
        offset += step.width
    }
    return true
}

noalloc func validate_utf8(candidate: &[u8]): void! {
    if !is_valid_utf8(candidate) {
        return invalid_utf8()
    }
    return
}

noalloc func invalid_utf8(): error {
    return error.new("std.string.invalid_utf8", "invalid UTF-8")
}
