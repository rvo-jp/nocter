//! Package-visible typed operations over private compiler primitives.

see ./index.nct

func file_open_read(path: &str): future FileCompletion from static {
    return file_open_read_raw(path)
}

func file_open_create(path: &str): future FileCompletion from static {
    return file_open_create_raw(path)
}

func file_open_append(path: &str): future FileCompletion from static {
    return file_open_append_raw(path)
}

func directory_open(path: &str): future FileCompletion from static {
    return directory_open_raw(path)
}

func file_read(owner: FileOwner, destination: &+[u8]): future FileCompletion from static {
    return file_read_raw(move owner, destination)
}

func directory_read(
    owner: FileOwner,
    destination: &+[u8],
): future FileCompletion from static {
    return directory_read_raw(move owner, destination)
}

func file_write(owner: FileOwner, source: &[u8]): future FileCompletion from static {
    return file_write_raw(move owner, source)
}

func file_flush(owner: FileOwner): future FileCompletion from static {
    return file_flush_raw(move owner)
}

func file_seek_start(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static {
    return file_seek_start_raw(move owner, displacement)
}

func file_seek_end(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static {
    return file_seek_end_raw(move owner, displacement)
}

func file_seek_current(
    owner: FileOwner,
    displacement: i64,
): future FileCompletion from static {
    return file_seek_current_raw(move owner, displacement)
}

func file_truncate(owner: FileOwner, length: usize): future FileCompletion from static {
    return file_truncate_raw(move owner, length)
}

func file_read_at(
    owner: FileOwner,
    destination: &+[u8],
    offset: u64,
): future FileCompletion from static {
    return file_read_at_raw(move owner, destination, offset)
}

func file_write_at(
    owner: FileOwner,
    source: &[u8],
    offset: u64,
): future FileCompletion from static {
    return file_write_at_raw(move owner, source, offset)
}

noalloc func file_close(owner: FileOwner): future FileCompletion from static {
    return file_close_raw(move owner)
}

func filesystem_remove_file(path: &str): future FileCompletion from static {
    return filesystem_remove_file_raw(path)
}

func filesystem_rename(
    source: &str,
    destination: &str,
): future FileCompletion from static {
    return filesystem_rename_raw(source, destination)
}

func filesystem_create_directory(path: &str): future FileCompletion from static {
    return filesystem_create_directory_raw(path)
}

func filesystem_remove_directory(path: &str): future FileCompletion from static {
    return filesystem_remove_directory_raw(path)
}

func filesystem_metadata(path: &str): future FileCompletion from static {
    return filesystem_metadata_raw(path)
}

func filesystem_symlink_metadata(path: &str): future FileCompletion from static {
    return filesystem_symlink_metadata_raw(path)
}

func filesystem_create_symlink(
    target: &str,
    link: &str,
): future FileCompletion from static {
    return filesystem_create_symlink_raw(target, link)
}

func filesystem_read_link(
    path: &str,
    destination: &+[u8],
): future FileCompletion from static {
    return filesystem_read_link_raw(path, destination)
}

noalloc func file_completion_take_owner(
    completion: &+FileCompletion,
): FileOwner from static {
    return file_completion_take_owner_raw(completion)
}

noalloc func file_completion_transferred_byte_count(
    completion: &FileCompletion,
): usize {
    return file_completion_transferred_byte_count_raw(completion)
}

noalloc func file_completion_result_position(completion: &FileCompletion): usize {
    return file_completion_result_position_raw(completion)
}

noalloc func file_completion_metadata_kind(completion: &FileCompletion): usize {
    return file_completion_metadata_kind_raw(completion)
}

noalloc func file_completion_metadata_length(completion: &FileCompletion): u64 {
    return file_completion_metadata_length_raw(completion)
}

noalloc func file_completion_metadata_modified_seconds(
    completion: &FileCompletion,
): i64 {
    return file_completion_metadata_modified_seconds_raw(completion)
}

noalloc func file_completion_metadata_modified_nanoseconds(
    completion: &FileCompletion,
): u64 {
    return file_completion_metadata_modified_nanoseconds_raw(completion)
}
