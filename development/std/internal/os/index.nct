//! Common internal OS error model.
//!
//! Target-specific boundaries convert raw platform error values into OSError.
//! User-facing modules expose only the built-in `error` payload from fallible
//! APIs; OSError and OSErrorKind stay behind `pub(/)` visibility.

pub(/) enum Platform {
    macos
    linux
    windows
}

pub(/) enum OSErrorKind {
    interrupted
    would_block
    not_found
    permission_denied
    already_exists
    invalid_input
    broken_pipe
    timed_out
    unsupported
    unknown
}

pub(/) copy struct OSError {
    pub platform: Platform
    pub code: i32
    pub kind: OSErrorKind
}

#target: "arm64-darwin"
pub(/) copy struct SyscallResult {
    pub value: usize
    pub errno: i32
}

#target: "arm64-darwin"
pub(/) copy struct Errno {
    pub code: i32
}

#target: "arm64-darwin"
pub(/) func errno(code: i32): Errno {
    return Errno { code: code }
}

#target: "arm64-darwin"
pub(/) func error_from_errno(value: Errno): OSError {
    return OSError {
        platform: Platform.macos,
        code: value.code,
        kind: kind_from_errno(value),
    }
}

#target: "arm64-darwin"
pub(/) func kind_from_errno(value: Errno): OSErrorKind {
    // Darwin errno values used by the std syscall wrappers.
    if value.code == 4 {
        return OSErrorKind.interrupted
    }
    if value.code == 35 {
        return OSErrorKind.would_block
    }
    if value.code == 2 {
        return OSErrorKind.not_found
    }
    if value.code == 20 {
        return OSErrorKind.not_found
    }
    if value.code == 1 {
        return OSErrorKind.permission_denied
    }
    if value.code == 13 {
        return OSErrorKind.permission_denied
    }
    if value.code == 17 {
        return OSErrorKind.already_exists
    }
    if value.code == 9 {
        return OSErrorKind.invalid_input
    }
    if value.code == 14 {
        return OSErrorKind.invalid_input
    }
    if value.code == 21 {
        return OSErrorKind.invalid_input
    }
    if value.code == 22 {
        return OSErrorKind.invalid_input
    }
    if value.code == 32 {
        return OSErrorKind.broken_pipe
    }
    if value.code == 60 {
        return OSErrorKind.timed_out
    }
    if value.code == 45 {
        return OSErrorKind.unsupported
    }
    return OSErrorKind.unknown
}

// Darwin syscall and flag constants belong in this target-gated module rather
// than in public I/O types or the compiler backend.

#target: "arm64-darwin"
pub(/) func darwin_sys_read(): usize {
    return 0x02000003
}

#target: "arm64-darwin"
pub(/) func darwin_sys_write(): usize {
    return 0x02000004
}

#target: "arm64-darwin"
pub(/) func darwin_sys_open(): usize {
    return 0x02000005
}

#target: "arm64-darwin"
pub(/) func darwin_sys_close(): usize {
    return 0x02000006
}

#target: "arm64-darwin"
pub(/) func darwin_open_read_only(): usize {
    return 0
}

#target: "arm64-darwin"
pub(/) func darwin_open_create_truncate(): usize {
    // O_WRONLY | O_CREAT | O_TRUNC
    return 0x0601
}

#target: "arm64-darwin"
pub(/) func darwin_open_create_append(): usize {
    // O_WRONLY | O_CREAT | O_APPEND
    return 0x0209
}

#target: "arm64-darwin"
pub(/) func darwin_create_mode(): usize {
    // 0666, filtered by the process umask.
    return 438
}

#target: "arm64-darwin"
pub(/) func darwin_errno_interrupted(): i32 {
    return 4
}

#target: "arm64-darwin"
pub(/) func darwin_sys_fcntl(): usize {
    return 0x0200005c
}

#target: "arm64-darwin"
pub(/) func darwin_f_getpath(): usize {
    return 50
}

#target: "arm64-darwin"
pub(/) func darwin_max_path_len(): usize {
    return 1024
}

#target: "arm64-darwin"
pub(/) primitive syscall0(number: usize): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall1(
    number: usize,
    a0: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall2(
    number: usize,
    a0: usize,
    a1: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall3(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall4(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall5(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall6(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
    a5: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive trap(): never

#target: "arm64-darwin"
pub(/) primitive unreachable(): never
