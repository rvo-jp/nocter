//! Common internal OS error model.
//!
//! Target-specific boundaries convert raw platform error values into OSError.
//! User-facing modules expose only the built-in `error` payload from fallible
//! APIs; OSError and OSErrorKind stay behind `pub(/)` visibility.

include ./darwin.nct

pub(/) enum Platform {
    macos
    linux
    windows
}

pub(/) enum OSErrorKind {
    interrupted
    would_block
    not_found
    permission_denied
    already_exists
    invalid_input
    broken_pipe
    timed_out
    unsupported
    unknown
}

pub(/) copy struct OSError {
    pub platform: Platform
    pub code: i32
    pub kind: OSErrorKind
}

#target: "arm64-darwin"
pub(/) copy struct SyscallResult {
    pub value: usize
    pub errno: i32
}

#target: "arm64-darwin"
pub(/) copy struct Errno {
    pub code: i32
}

#target: "arm64-darwin"
pub(/) func errno(code: i32): Errno

#target: "arm64-darwin"
pub(/) func error_from_errno(value: Errno): OSError

#target: "arm64-darwin"
pub(/) func kind_from_errno(value: Errno): OSErrorKind

#target: "arm64-darwin"
pub(/) func darwin_sys_read(): usize

#target: "arm64-darwin"
pub(/) func darwin_sys_write(): usize

#target: "arm64-darwin"
pub(/) func darwin_sys_open(): usize

#target: "arm64-darwin"
pub(/) func darwin_sys_close(): usize

#target: "arm64-darwin"
pub(/) func darwin_open_read_only(): usize

#target: "arm64-darwin"
pub(/) func darwin_open_create_truncate(): usize

#target: "arm64-darwin"
pub(/) func darwin_open_create_append(): usize

#target: "arm64-darwin"
pub(/) func darwin_create_mode(): usize

#target: "arm64-darwin"
pub(/) func darwin_errno_interrupted(): i32

#target: "arm64-darwin"
pub(/) func darwin_sys_fcntl(): usize

#target: "arm64-darwin"
pub(/) func darwin_f_getpath(): usize

#target: "arm64-darwin"
pub(/) func darwin_max_path_len(): usize

#target: "arm64-darwin"
pub(/) primitive syscall0(number: usize): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall1(
    number: usize,
    a0: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall2(
    number: usize,
    a0: usize,
    a1: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall3(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall4(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall5(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive syscall6(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
    a5: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) primitive trap(): never

#target: "arm64-darwin"
pub(/) primitive unreachable(): never
