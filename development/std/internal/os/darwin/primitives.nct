//! Compiler-owned Darwin system primitives without authored callers.

see ./index.nct

#target: "arm64-darwin"
noalloc blocking primitive func syscall0(number: usize): SyscallResult

#target: "arm64-darwin"
noalloc blocking primitive func syscall4(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
): SyscallResult

#target: "arm64-darwin"
noalloc primitive func unreachable(): never
