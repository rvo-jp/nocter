#target: "arm64-darwin"
const DIRENT_TYPE_REGULAR: u8 = 8

#target: "arm64-darwin"
const DIRENT_TYPE_SYMLINK: u8 = 10

#target: "arm64-darwin"
copy struct Timeval {
    // Positive i64 seconds have the same 64-bit representation as this validated source value.
    seconds_bits: u64
    // Darwin stores i32 microseconds followed by four padding bytes. A validated value below one
    // million occupies the low 32 bits and leaves the complete padding half zero.
    microseconds_and_padding: u64
}

#target: "arm64-darwin"
noalloc func read_directory_entries(
    fd: usize,
    buffer: &+[u8],
    position: &+u64,
): SyscallResult {
    return syscall4(
        SYS_GETDIRENTRIES64,
        fd,
        ptr.addr(buffer.ptr()),
        buffer.len(),
        ptr.addr(ptr.from_ref_mut(position)),
    )
}

#target: "arm64-darwin"
noalloc func wait_timeout_once(seconds: u64, microseconds: u64): SyscallResult {
    if seconds > MAX_TIMEVAL_SECONDS || microseconds >= TIMEVAL_MICROSECONDS_PER_SECOND {
        return SyscallResult { value: 0, errno: 22 }
    }
    var timeout = Timeval {
        seconds_bits: seconds,
        microseconds_and_padding: microseconds,
    }
    return syscall5(
        SYS_SELECT,
        0,
        0,
        0,
        0,
        ptr.addr(ptr.from_ref_mut(&+timeout)),
    )
}
