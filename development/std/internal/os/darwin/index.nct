//! Darwin ARM64 ABI contract shared by standard-library target adapters.

use /internal/os.{OSError, OSErrorKind, Platform}
see ./implementation.nct
see ./pair_tests.nct

#target: "arm64-darwin"
pub(/) copy struct SyscallResult {
    pub value: usize
    pub errno: i32
}

/// Result of a zero-argument Darwin syscall that owns both successful return registers.
#target: "arm64-darwin"
pub(/) copy struct SyscallPairResult {
    pub first: usize
    pub second: usize
    pub errno: i32
}

#target: "arm64-darwin"
pub(/) copy struct Errno {
    pub code: i32
}

#target: "arm64-darwin"
pub(/) noalloc func errno(code: i32): Errno

#target: "arm64-darwin"
pub(/) noalloc func error_from_errno(value: Errno): OSError

