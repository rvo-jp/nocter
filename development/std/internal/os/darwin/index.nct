#target: "arm64-darwin"
pub(/) noalloc primitive func syscall1(
    number: usize,
    a0: usize,
): SyscallResult

/// Performs a zero-argument syscall whose successful ABI result occupies two words.
#target: "arm64-darwin"
pub(/) noalloc primitive func syscall_pair0(number: usize): SyscallPairResult

#target: "arm64-darwin"
pub(/) noalloc primitive func syscall2(
    number: usize,
    a0: usize,
    a1: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) noalloc primitive func syscall3(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) noalloc func read_directory_entries(
    fd: usize,
    buffer: &+[u8],
    position: &+u64,
): SyscallResult

/// Performs one descriptor-free timeout wait. The caller owns retry and remaining-time policy.
#target: "arm64-darwin"
pub(/) noalloc func wait_timeout_once(seconds: u64, microseconds: u64): SyscallResult

#target: "arm64-darwin"
pub(/) noalloc primitive func syscall6(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
    a5: usize,
): SyscallResult

#target: "arm64-darwin"
pub(/) noalloc primitive func trap(): never
