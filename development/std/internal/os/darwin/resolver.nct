//! Compiler-trusted Darwin resolver service declarations.

see ./index.nct

#target: "arm64-darwin"
noalloc primitive func get_address_info_raw(
    node: *u8,
    service: *u8,
    hints: *u8,
    result: *usize,
): i32

#target: "arm64-darwin"
noalloc primitive func free_address_info_raw(result: *u8): void

#target: "arm64-darwin"
noalloc func call_get_address_info(
    node: *u8,
    service: *u8,
    hints: *u8,
    result: *usize,
): i32 {
    return get_address_info_raw(node, service, hints, result)
}

#target: "arm64-darwin"
noalloc func release_address_info(result: *u8): void {
    free_address_info_raw(result)
    return
}
