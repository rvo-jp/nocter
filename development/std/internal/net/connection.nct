//! Provider-independent synchronous byte-stream policy.

see ./index.nct
see ./deadline.nct
see ./descriptor.nct
see ./connection_events.nct

use /internal/net/darwin
use /internal/net/model.{
    NetworkAddress,
    NetworkConnectionEvent,
    NetworkConnectionState,
    NetworkOwner,
}
use /internal/ptr
use /ptr as public_ptr
use /time.Duration

enum StreamConnectionOwnership {
    open(owner: NetworkOwner)
    closed
}

struct StreamConnection {
    ownership: StreamConnectionOwnership
    event_descriptor: usize
    read_timeout_value: Duration?
    write_timeout_value: Duration?
    read_complete: bool
    write_complete: bool
}

noalloc func stream_connection_from_owner(
    owner: NetworkOwner,
    event_descriptor: usize,
): StreamConnection {
    return StreamConnection {
        ownership: StreamConnectionOwnership.open(move owner),
        event_descriptor: event_descriptor,
        read_timeout_value: none,
        write_timeout_value: none,
        read_complete: false,
        write_complete: false,
    }
}

noalloc func dispose_stream_connection(connection: &+StreamConnection): void {
    let previous = ptr.replace_value(
        &+connection.ownership,
        StreamConnectionOwnership.closed,
    )
    match move previous {
        StreamConnectionOwnership.open(owner) { darwin.connection_dispose(move owner) }
        StreamConnectionOwnership.closed {}
    }
    return
}

noalloc func failed_connection(
    owner: NetworkOwner,
    failure: NetworkFailure,
): StreamConnectionAttempt {
    darwin.connection_dispose(move owner)
    return StreamConnectionAttempt.failed(move failure)
}

noalloc func require_application_protocol(
    attempt: StreamConnectionAttempt,
    application_protocol: *u8,
): StreamConnectionAttempt {
    if public_ptr.addr(application_protocol) == 0 { return move attempt }
    match move attempt {
        StreamConnectionAttempt.ready(connection) {
            var active = move connection
            let matches = match &active.ownership {
                StreamConnectionOwnership.open(owner) {
                    darwin.tls_connection_matches_application_protocol(
                        owner,
                        application_protocol,
                    )
                }
                StreamConnectionOwnership.closed { false }
            }
            if matches { return StreamConnectionAttempt.ready(move active) }
            dispose_stream_connection(&+active)
            return StreamConnectionAttempt.failed(
                NetworkFailure.tls_application_protocol_mismatch,
            )
        }
        StreamConnectionAttempt.failed(failure) {
            return StreamConnectionAttempt.failed(move failure)
        }
    }
}

noalloc blocking func start_stream_connection_before(
    owner: NetworkOwner,
    deadline: &OperationDeadline,
): StreamConnectionAttempt {
    var active = move owner
    darwin.connection_start(&+active)
    let descriptor = darwin.connection_event_descriptor(&active)
    while true {
        match wait_readable(descriptor, deadline) {
            UnitAttempt.failed(failure) {
                return failed_connection(move active, move failure)
            }
            UnitAttempt.ready {}
        }
        match reduce_connect_event(darwin.connection_next_event(
            &+active,
            ptr.from_addr(1),
            0,
        )) {
            StreamConnectProgress.pending {}
            StreamConnectProgress.ready {
                return StreamConnectionAttempt.ready(stream_connection_from_owner(
                    move active,
                    descriptor,
                ))
            }
            StreamConnectProgress.cancelled {
                darwin.connection_dispose(move active)
                return StreamConnectionAttempt.failed(NetworkFailure.closed)
            }
            StreamConnectProgress.failed(failure) {
                return failed_connection(move active, move failure)
            }
        }
    }
    return failed_connection(move active, NetworkFailure.invalid_target_result)
}

noalloc blocking func connect_stream_before(
    address: NetworkAddress,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt {
    if !claim_connection_attempt(deadline) {
        return StreamConnectionAttempt.failed(NetworkFailure.timed_out)
    }
    let owner = darwin.connection_create(&address) otherwise {
        return StreamConnectionAttempt.failed(NetworkFailure.invalid_target_result)
    }
    return start_stream_connection_before(move owner, &deadline.operation)
}

noalloc blocking func connect_tls_stream_before(
    address: NetworkAddress,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
    deadline: &+ConnectionDeadline,
): StreamConnectionAttempt {
    if !claim_connection_attempt(deadline) {
        return StreamConnectionAttempt.failed(NetworkFailure.timed_out)
    }
    let owner = darwin.tls_connection_create(
        &address,
        server_name,
        application_protocol,
        trust_anchor,
        trust_anchor_len,
    ) otherwise {
        return StreamConnectionAttempt.failed(NetworkFailure.invalid_target_result)
    }
    return require_application_protocol(
        start_stream_connection_before(move owner, &deadline.operation),
        application_protocol,
    )
}

noalloc blocking func connect_stream(
    address: NetworkAddress,
    timeout: Duration?,
): StreamConnectionAttempt {
    var deadline = connection_deadline(timeout)
    return connect_stream_before(address, &+deadline)
}

noalloc blocking func read_open_connection(
    owner: &+NetworkOwner,
    event_descriptor: usize,
    timeout: Duration?,
    buffer: &+[u8],
): StreamReadProgress {
    let maximum = u32.from_u64(buffer.len() as u64) otherwise {
        return StreamReadProgress.failed(NetworkFailure.invalid_target_result)
    }
    darwin.connection_begin_receive(owner, maximum)
    let deadline = operation_deadline(timeout)
    while true {
        match wait_readable(event_descriptor, &deadline) {
            UnitAttempt.failed(failure) { return StreamReadProgress.failed(move failure) }
            UnitAttempt.ready {}
        }
        match reduce_read_event(darwin.connection_next_event(
            owner,
            public_ptr.from_ref_mut(&+buffer[0]),
            buffer.len(),
        )) {
            StreamReadProgress.pending {}
            StreamReadProgress.ready(count, complete) {
                return StreamReadProgress.ready(count, complete)
            }
            StreamReadProgress.cancelled { return StreamReadProgress.cancelled }
            StreamReadProgress.failed(failure) {
                return StreamReadProgress.failed(move failure)
            }
        }
    }
    return StreamReadProgress.failed(NetworkFailure.invalid_target_result)
}

noalloc blocking func write_open_connection(
    owner: &+NetworkOwner,
    event_descriptor: usize,
    timeout: Duration?,
    bytes: &[u8],
): StreamWriteProgress {
    if bytes.len() == 0 { return StreamWriteProgress.ready }
    if !darwin.connection_begin_send(
        owner,
        public_ptr.from_ref(&bytes[0]),
        bytes.len(),
        false,
    ) {
        return StreamWriteProgress.failed(NetworkFailure.invalid_target_result)
    }
    let deadline = operation_deadline(timeout)
    return wait_for_stream_write(owner, event_descriptor, &deadline)
}

noalloc blocking func finish_open_connection_write(
    owner: &+NetworkOwner,
    event_descriptor: usize,
    timeout: Duration?,
): StreamWriteProgress {
    if !darwin.connection_begin_final_send(owner) {
        return StreamWriteProgress.failed(NetworkFailure.invalid_target_result)
    }
    let deadline = operation_deadline(timeout)
    return wait_for_stream_write(owner, event_descriptor, &deadline)
}

noalloc blocking func wait_for_stream_write(
    owner: &+NetworkOwner,
    event_descriptor: usize,
    deadline: &OperationDeadline,
): StreamWriteProgress {
    while true {
        match wait_readable(event_descriptor, deadline) {
            UnitAttempt.failed(failure) { return StreamWriteProgress.failed(move failure) }
            UnitAttempt.ready {}
        }
        match reduce_write_event(darwin.connection_next_event(owner, ptr.from_addr(1), 0)) {
            StreamWriteProgress.pending {}
            StreamWriteProgress.ready { return StreamWriteProgress.ready }
            StreamWriteProgress.cancelled { return StreamWriteProgress.cancelled }
            StreamWriteProgress.failed(failure) {
                return StreamWriteProgress.failed(move failure)
            }
        }
    }
    return StreamWriteProgress.failed(NetworkFailure.invalid_target_result)
}

noalloc func complete_stream_write(
    connection: &+StreamConnection,
    progress: StreamWriteProgress,
    final: bool,
): UnitAttempt {
    match move progress {
        StreamWriteProgress.ready {
            if final { connection.write_complete = true }
            return UnitAttempt.ready
        }
        StreamWriteProgress.pending {
            dispose_stream_connection(connection)
            return UnitAttempt.failed(NetworkFailure.invalid_target_result)
        }
        StreamWriteProgress.cancelled {
            dispose_stream_connection(connection)
            return UnitAttempt.failed(NetworkFailure.closed)
        }
        StreamWriteProgress.failed(failure) {
            dispose_stream_connection(connection)
            return UnitAttempt.failed(move failure)
        }
    }
}

noalloc blocking func shutdown_stream_write(connection: &+StreamConnection): UnitAttempt {
    if connection.write_complete { return UnitAttempt.ready }
    let progress = match &+connection.ownership {
        StreamConnectionOwnership.open(owner) {
            finish_open_connection_write(
                owner,
                connection.event_descriptor,
                connection.write_timeout_value,
            )
        }
        StreamConnectionOwnership.closed {
            StreamWriteProgress.failed(NetworkFailure.closed)
        }
    }
    return complete_stream_write(connection, move progress, true)
}

instance StreamConnection {
    noalloc blocking method &+self.read(buffer: &+[u8]): TransferAttempt {
        if self.read_complete { return TransferAttempt.ready(0) }
        if buffer.len() == 0 { return TransferAttempt.ready(0) }
        let operation = match &+self.ownership {
            StreamConnectionOwnership.open(owner) {
                read_open_connection(
                    owner,
                    self.event_descriptor,
                    self.read_timeout_value,
                    buffer,
                )
            }
            StreamConnectionOwnership.closed {
                StreamReadProgress.failed(NetworkFailure.closed)
            }
        }
        match move operation {
            StreamReadProgress.ready(count, complete) {
                if complete { self.read_complete = true }
                return TransferAttempt.ready(count)
            }
            StreamReadProgress.pending {
                dispose_stream_connection(self)
                return TransferAttempt.failed(NetworkFailure.invalid_target_result)
            }
            StreamReadProgress.cancelled {
                dispose_stream_connection(self)
                return TransferAttempt.failed(NetworkFailure.closed)
            }
            StreamReadProgress.failed(failure) {
                dispose_stream_connection(self)
                return TransferAttempt.failed(move failure)
            }
        }
    }

    noalloc blocking method &+self.write(bytes: &[u8]): UnitAttempt {
        if self.write_complete { return UnitAttempt.failed(NetworkFailure.closed) }
        let operation = match &+self.ownership {
            StreamConnectionOwnership.open(owner) {
                write_open_connection(
                    owner,
                    self.event_descriptor,
                    self.write_timeout_value,
                    bytes,
                )
            }
            StreamConnectionOwnership.closed {
                StreamWriteProgress.failed(NetworkFailure.closed)
            }
        }
        return complete_stream_write(self, move operation, false)
    }

    noalloc method &self.local_address(): AddressAttempt {
        match &self.ownership {
            StreamConnectionOwnership.open(owner) {
                let address = darwin.connection_local_address(owner) otherwise {
                    return AddressAttempt.failed(NetworkFailure.invalid_target_result)
                }
                return AddressAttempt.ready(address)
            }
            StreamConnectionOwnership.closed {
                return AddressAttempt.failed(NetworkFailure.closed)
            }
        }
    }

    noalloc method &self.peer_address(): AddressAttempt {
        match &self.ownership {
            StreamConnectionOwnership.open(owner) {
                let address = darwin.connection_remote_address(owner) otherwise {
                    return AddressAttempt.failed(NetworkFailure.invalid_target_result)
                }
                return AddressAttempt.ready(address)
            }
            StreamConnectionOwnership.closed {
                return AddressAttempt.failed(NetworkFailure.closed)
            }
        }
    }

    noalloc method &+self.set_read_timeout(timeout: Duration?): void {
        self.read_timeout_value = timeout
        return
    }

    noalloc method &self.read_timeout(): Duration? {
        return self.read_timeout_value
    }

    noalloc method &+self.set_write_timeout(timeout: Duration?): void {
        self.write_timeout_value = timeout
        return
    }

    noalloc method &self.write_timeout(): Duration? {
        return self.write_timeout_value
    }

    noalloc blocking method &+self.shutdown(direction: NetworkShutdown): UnitAttempt {
        match direction {
            NetworkShutdown.read {
                self.read_complete = true
                return UnitAttempt.ready
            }
            NetworkShutdown.write { return shutdown_stream_write(self) }
            NetworkShutdown.both {
                self.read_complete = true
                return shutdown_stream_write(self)
            }
        }
    }

    noalloc method &+self.close(): void {
        dispose_stream_connection(self)
        return
    }
}

noalloc drop StreamConnection(&+self) {
    dispose_stream_connection(self)
    return
}
