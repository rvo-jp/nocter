//! Shared descriptor ownership, interruption retry, readiness, and stream progress.

see ./index.nct
see ./deadline.nct

use /internal/net/darwin
use /internal/net/darwin.{
    RawAcceptAttempt,
    RawAddressAttempt,
    RawDatagramAttempt,
    RawDescriptorAttempt,
    RawTransferAttempt,
    RawUnitAttempt,
    RawWaitAttempt,
}
use /internal/net/model.NetworkAddress
use /internal/os.OSError
use /time.Duration

enum DescriptorState {
    open
    closed
}

enum DatagramDestination {
    connected
    explicit(address: NetworkAddress)
}

struct SocketDescriptor {
    fd: usize
    state: DescriptorState
    read_timeout_value: Duration?
    write_timeout_value: Duration?
}

noalloc func failure_from_raw(os_error: OSError): NetworkFailure {
    return NetworkFailure.os(os_error)
}

noalloc func descriptor_from_raw(fd: usize): SocketDescriptor {
    return SocketDescriptor {
        fd: fd,
        state: DescriptorState.open,
        read_timeout_value: none,
        write_timeout_value: none,
    }
}

noalloc func close_raw_owner(descriptor: &+SocketDescriptor): void {
    if descriptor.state is DescriptorState.open {
        darwin.close_once(descriptor.fd)
        descriptor.state = DescriptorState.closed
    }
    return
}

noalloc func fail_created(
    descriptor: &+SocketDescriptor,
    failure: NetworkFailure,
): DescriptorAttempt {
    close_raw_owner(descriptor)
    return DescriptorAttempt.failed(move failure)
}

noalloc func invalid_unit(): UnitAttempt {
    return UnitAttempt.failed(NetworkFailure.invalid_target_result)
}

noalloc func timeout_unit(): UnitAttempt {
    return UnitAttempt.failed(NetworkFailure.timed_out)
}

noalloc func wait_readable(fd: usize, deadline: &OperationDeadline): UnitAttempt {
    while true {
        match darwin.wait_readable_once(fd, poll_timeout_milliseconds(deadline)) {
            RawWaitAttempt.ready { return UnitAttempt.ready }
            RawWaitAttempt.interrupted {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawWaitAttempt.timed_out {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawWaitAttempt.failed(value) {
                return UnitAttempt.failed(failure_from_raw(value))
            }
            RawWaitAttempt.malformed { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func wait_writable(fd: usize, deadline: &OperationDeadline): UnitAttempt {
    while true {
        match darwin.wait_writable_once(fd, poll_timeout_milliseconds(deadline)) {
            RawWaitAttempt.ready { return UnitAttempt.ready }
            RawWaitAttempt.interrupted {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawWaitAttempt.timed_out {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawWaitAttempt.failed(value) {
                return UnitAttempt.failed(failure_from_raw(value))
            }
            RawWaitAttempt.malformed { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func finish_connect(fd: usize, deadline: &OperationDeadline): UnitAttempt {
    match wait_writable(fd, deadline) {
        UnitAttempt.ready {}
        UnitAttempt.failed(failure) { return UnitAttempt.failed(move failure) }
    }
    if deadline_expired(deadline) { return timeout_unit() }
    while true {
        match darwin.finish_connect_once(fd) {
            RawUnitAttempt.ready { return UnitAttempt.ready }
            RawUnitAttempt.interrupted {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawUnitAttempt.failed(failure) {
                return UnitAttempt.failed(failure_from_raw(failure))
            }
            RawUnitAttempt.would_block { return invalid_unit() }
            RawUnitAttempt.in_progress { return invalid_unit() }
            RawUnitAttempt.malformed { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func connect_address(
    fd: usize,
    address: &NetworkAddress,
    deadline: &OperationDeadline,
): UnitAttempt {
    while true {
        match darwin.connect_once(fd, address) {
            RawUnitAttempt.ready { return UnitAttempt.ready }
            RawUnitAttempt.interrupted {
                if deadline_expired(deadline) { return timeout_unit() }
            }
            RawUnitAttempt.in_progress { return finish_connect(fd, deadline) }
            RawUnitAttempt.would_block { return finish_connect(fd, deadline) }
            RawUnitAttempt.failed(failure) {
                return UnitAttempt.failed(failure_from_raw(failure))
            }
            RawUnitAttempt.malformed { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func bind_address(fd: usize, address: &NetworkAddress): UnitAttempt {
    while true {
        match darwin.bind_once(fd, address) {
            RawUnitAttempt.ready { return UnitAttempt.ready }
            RawUnitAttempt.interrupted {}
            RawUnitAttempt.failed(failure) {
                return UnitAttempt.failed(failure_from_raw(failure))
            }
            _ { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func connect_tcp(
    address: NetworkAddress,
    timeout: Duration?,
): DescriptorAttempt {
    let deadline = operation_deadline(timeout)
    let fd = match darwin.create_tcp(address.family) {
        RawDescriptorAttempt.ready(value) { value }
        RawDescriptorAttempt.failed(failure) {
            return DescriptorAttempt.failed(failure_from_raw(failure))
        }
        RawDescriptorAttempt.malformed {
            return DescriptorAttempt.failed(NetworkFailure.invalid_target_result)
        }
    }
    var descriptor = descriptor_from_raw(fd)
    match connect_address(descriptor.fd, &address, &deadline) {
        UnitAttempt.ready { return DescriptorAttempt.ready(move descriptor) }
        UnitAttempt.failed(failure) {
            return fail_created(&+descriptor, move failure)
        }
    }
}

noalloc func listen_tcp(address: NetworkAddress): DescriptorAttempt {
    let fd = match darwin.create_tcp(address.family) {
        RawDescriptorAttempt.ready(value) { value }
        RawDescriptorAttempt.failed(failure) {
            return DescriptorAttempt.failed(failure_from_raw(failure))
        }
        RawDescriptorAttempt.malformed {
            return DescriptorAttempt.failed(NetworkFailure.invalid_target_result)
        }
    }
    var descriptor = descriptor_from_raw(fd)
    match bind_address(descriptor.fd, &address) {
        UnitAttempt.ready {}
        UnitAttempt.failed(failure) {
            return fail_created(&+descriptor, move failure)
        }
    }
    while true {
        match darwin.listen_once(descriptor.fd) {
            RawUnitAttempt.ready { return DescriptorAttempt.ready(move descriptor) }
            RawUnitAttempt.interrupted {}
            RawUnitAttempt.failed(failure) {
                return fail_created(&+descriptor, failure_from_raw(failure))
            }
            _ {
                return fail_created(&+descriptor, NetworkFailure.invalid_target_result)
            }
        }
    }
    return fail_created(&+descriptor, NetworkFailure.invalid_target_result)
}

noalloc func bind_udp(address: NetworkAddress): DescriptorAttempt {
    let fd = match darwin.create_udp(address.family) {
        RawDescriptorAttempt.ready(value) { value }
        RawDescriptorAttempt.failed(failure) {
            return DescriptorAttempt.failed(failure_from_raw(failure))
        }
        RawDescriptorAttempt.malformed {
            return DescriptorAttempt.failed(NetworkFailure.invalid_target_result)
        }
    }
    var descriptor = descriptor_from_raw(fd)
    match bind_address(descriptor.fd, &address) {
        UnitAttempt.ready { return DescriptorAttempt.ready(move descriptor) }
        UnitAttempt.failed(failure) {
            return fail_created(&+descriptor, move failure)
        }
    }
}

noalloc func send_datagram_with(
    fd: usize,
    bytes: &[u8],
    destination: DatagramDestination,
    deadline: &OperationDeadline,
): UnitAttempt {
    var first_attempt = true
    while true {
        if !first_attempt && deadline_expired(deadline) { return timeout_unit() }
        first_attempt = false
        let attempt = match destination {
            DatagramDestination.connected { darwin.send_once(fd, bytes) }
            DatagramDestination.explicit(address) { darwin.send_to_once(fd, bytes, &address) }
        }
        match attempt {
            RawUnitAttempt.ready { return UnitAttempt.ready }
            RawUnitAttempt.interrupted {}
            RawUnitAttempt.would_block {
                match wait_writable(fd, deadline) {
                    UnitAttempt.ready {}
                    UnitAttempt.failed(failure) {
                        return UnitAttempt.failed(move failure)
                    }
                }
            }
            RawUnitAttempt.failed(failure) {
                return UnitAttempt.failed(failure_from_raw(failure))
            }
            RawUnitAttempt.in_progress { return invalid_unit() }
            RawUnitAttempt.malformed { return invalid_unit() }
        }
    }
    return invalid_unit()
}

noalloc func descriptor_is_open(descriptor: &SocketDescriptor): bool {
    if descriptor.state is DescriptorState.open { return true }
    return false
}

instance SocketDescriptor {
    noalloc method &self.accept_tcp(): AcceptAttempt {
        if !descriptor_is_open(self) { return AcceptAttempt.failed(NetworkFailure.closed) }
        let deadline = operation_deadline(self.read_timeout_value)
        var first_attempt = true
        while true {
            if !first_attempt && deadline_expired(&deadline) {
                return AcceptAttempt.failed(NetworkFailure.timed_out)
            }
            first_attempt = false
            match darwin.accept_once(self.fd) {
                RawAcceptAttempt.ready(fd, peer) {
                    return AcceptAttempt.ready(descriptor_from_raw(fd), peer)
                }
                RawAcceptAttempt.interrupted {}
                RawAcceptAttempt.would_block {
                    match wait_readable(self.fd, &deadline) {
                        UnitAttempt.ready {}
                        UnitAttempt.failed(value) { return AcceptAttempt.failed(move value) }
                    }
                }
                RawAcceptAttempt.failed(value) {
                    return AcceptAttempt.failed(failure_from_raw(value))
                }
                RawAcceptAttempt.malformed {
                    return AcceptAttempt.failed(NetworkFailure.invalid_target_result)
                }
            }
        }
        return AcceptAttempt.failed(NetworkFailure.invalid_target_result)
    }

    noalloc method &self.read_stream(buffer: &+[u8]): TransferAttempt {
        if !descriptor_is_open(self) { return TransferAttempt.failed(NetworkFailure.closed) }
        if buffer.len() == 0 { return TransferAttempt.ready(0) }
        let deadline = operation_deadline(self.read_timeout_value)
        var first_attempt = true
        while true {
            if !first_attempt && deadline_expired(&deadline) {
                return TransferAttempt.failed(NetworkFailure.timed_out)
            }
            first_attempt = false
            match darwin.read_once(self.fd, buffer) {
                RawTransferAttempt.ready(count) { return TransferAttempt.ready(count) }
                RawTransferAttempt.end { return TransferAttempt.ready(0) }
                RawTransferAttempt.interrupted {}
                RawTransferAttempt.would_block {
                    match wait_readable(self.fd, &deadline) {
                        UnitAttempt.ready {}
                        UnitAttempt.failed(value) { return TransferAttempt.failed(move value) }
                    }
                }
                RawTransferAttempt.failed(value) {
                    return TransferAttempt.failed(failure_from_raw(value))
                }
                RawTransferAttempt.malformed {
                    return TransferAttempt.failed(NetworkFailure.invalid_target_result)
                }
            }
        }
        return TransferAttempt.failed(NetworkFailure.invalid_target_result)
    }

    noalloc method &self.write_stream(bytes: &[u8]): UnitAttempt {
        if !descriptor_is_open(self) { return UnitAttempt.failed(NetworkFailure.closed) }
        if bytes.len() == 0 { return UnitAttempt.ready }
        let deadline = operation_deadline(self.write_timeout_value)
        var first_attempt = true
        var offset: usize = 0
        while offset < bytes.len() {
            if !first_attempt && deadline_expired(&deadline) { return timeout_unit() }
            first_attempt = false
            match darwin.write_once(self.fd, bytes, offset) {
                RawTransferAttempt.ready(count) { offset += count }
                RawTransferAttempt.interrupted {}
                RawTransferAttempt.would_block {
                    match wait_writable(self.fd, &deadline) {
                        UnitAttempt.ready {}
                        UnitAttempt.failed(value) { return UnitAttempt.failed(move value) }
                    }
                }
                RawTransferAttempt.failed(value) {
                    return UnitAttempt.failed(failure_from_raw(value))
                }
                RawTransferAttempt.end { return invalid_unit() }
                RawTransferAttempt.malformed { return invalid_unit() }
            }
        }
        return UnitAttempt.ready
    }

    noalloc method &self.local_address(): AddressAttempt {
        if !descriptor_is_open(self) { return AddressAttempt.failed(NetworkFailure.closed) }
        while true {
            match darwin.local_address_once(self.fd) {
                RawAddressAttempt.ready(address) { return AddressAttempt.ready(address) }
                RawAddressAttempt.interrupted {}
                RawAddressAttempt.failed(value) {
                    return AddressAttempt.failed(failure_from_raw(value))
                }
                RawAddressAttempt.malformed {
                    return AddressAttempt.failed(NetworkFailure.invalid_target_result)
                }
            }
        }
        return AddressAttempt.failed(NetworkFailure.invalid_target_result)
    }

    noalloc method &self.peer_address(): AddressAttempt {
        if !descriptor_is_open(self) { return AddressAttempt.failed(NetworkFailure.closed) }
        while true {
            match darwin.peer_address_once(self.fd) {
                RawAddressAttempt.ready(address) { return AddressAttempt.ready(address) }
                RawAddressAttempt.interrupted {}
                RawAddressAttempt.failed(value) {
                    return AddressAttempt.failed(failure_from_raw(value))
                }
                RawAddressAttempt.malformed {
                    return AddressAttempt.failed(NetworkFailure.invalid_target_result)
                }
            }
        }
        return AddressAttempt.failed(NetworkFailure.invalid_target_result)
    }

    noalloc method &self.shutdown(direction: NetworkShutdown): UnitAttempt {
        if !descriptor_is_open(self) { return UnitAttempt.failed(NetworkFailure.closed) }
        let native: usize = match direction {
            NetworkShutdown.read { 0 }
            NetworkShutdown.write { 1 }
            NetworkShutdown.both { 2 }
        }
        while true {
            match darwin.shutdown_once(self.fd, native) {
                RawUnitAttempt.ready { return UnitAttempt.ready }
                RawUnitAttempt.interrupted {}
                RawUnitAttempt.failed(value) {
                    return UnitAttempt.failed(failure_from_raw(value))
                }
                _ { return invalid_unit() }
            }
        }
        return invalid_unit()
    }

    noalloc method &self.connect_udp(address: NetworkAddress): UnitAttempt {
        if !descriptor_is_open(self) { return UnitAttempt.failed(NetworkFailure.closed) }
        let deadline = operation_deadline(self.write_timeout_value)
        return connect_address(self.fd, &address, &deadline)
    }

    noalloc method &self.send_datagram(bytes: &[u8]): UnitAttempt {
        if !descriptor_is_open(self) { return UnitAttempt.failed(NetworkFailure.closed) }
        let deadline = operation_deadline(self.write_timeout_value)
        return send_datagram_with(self.fd, bytes, DatagramDestination.connected, &deadline)
    }

    noalloc method &self.send_datagram_to(
        bytes: &[u8],
        target: NetworkAddress,
    ): UnitAttempt {
        if !descriptor_is_open(self) { return UnitAttempt.failed(NetworkFailure.closed) }
        let deadline = operation_deadline(self.write_timeout_value)
        return send_datagram_with(
            self.fd,
            bytes,
            DatagramDestination.explicit(target),
            &deadline,
        )
    }

    noalloc method &self.receive_datagram(buffer: &+[u8]): DatagramAttempt {
        if !descriptor_is_open(self) { return DatagramAttempt.failed(NetworkFailure.closed) }
        let deadline = operation_deadline(self.read_timeout_value)
        var first_attempt = true
        while true {
            if !first_attempt && deadline_expired(&deadline) {
                return DatagramAttempt.failed(NetworkFailure.timed_out)
            }
            first_attempt = false
            match darwin.receive_from_once(self.fd, buffer) {
                RawDatagramAttempt.ready(source, copied_len, truncated) {
                    return DatagramAttempt.ready(source, copied_len, truncated)
                }
                RawDatagramAttempt.interrupted {}
                RawDatagramAttempt.would_block {
                    match wait_readable(self.fd, &deadline) {
                        UnitAttempt.ready {}
                        UnitAttempt.failed(failure) {
                            return DatagramAttempt.failed(move failure)
                        }
                    }
                }
                RawDatagramAttempt.failed(failure) {
                    return DatagramAttempt.failed(failure_from_raw(failure))
                }
                RawDatagramAttempt.malformed {
                    return DatagramAttempt.failed(NetworkFailure.invalid_target_result)
                }
            }
        }
        return DatagramAttempt.failed(NetworkFailure.invalid_target_result)
    }

    noalloc method &+self.set_read_timeout(timeout: Duration?): void {
        self.read_timeout_value = timeout
        return
    }

    noalloc method &self.read_timeout(): Duration? {
        return self.read_timeout_value
    }

    noalloc method &+self.set_write_timeout(timeout: Duration?): void {
        self.write_timeout_value = timeout
        return
    }

    noalloc method &self.write_timeout(): Duration? {
        return self.write_timeout_value
    }

    noalloc method &+self.close(): void {
        close_raw_owner(self)
        return
    }
}

noalloc drop SocketDescriptor(&+self) {
    close_raw_owner(self)
    return
}
