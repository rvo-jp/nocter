//! Target-independent values shared by socket policy and target adapters.

see ./address.nct

use /internal/os.OSErrorKind

/// Opaque, uniquely owned storage for one compiler-selected stream or listener provider.
pub(/) primitive type NetworkOwner

pub(/) enum NetworkFamily {
    ipv4
    ipv6
}

/// One provider failure normalized before it crosses into stream policy.
pub(/) enum NetworkProviderFailure {
    os(kind: OSErrorKind, code: usize)
    dns(code: usize)
    tls(code: usize)
    unknown(domain: usize, code: usize)
}

/// Provider-independent progress states for one connection owner.
pub(/) enum NetworkConnectionState {
    preparing
    waiting
    ready
    failed(failure: NetworkProviderFailure?)
    cancelled
}

/// One ownership-free event consumed from a connection's ordered callback channel.
pub(/) enum NetworkConnectionEvent {
    state(value: NetworkConnectionState)
    received(count: usize, complete: bool, failure: NetworkProviderFailure?)
    sent(failure: NetworkProviderFailure?)
    malformed
}

/// One target-independent classification of a system resolver outcome.
pub(/) enum ResolverFailure {
    not_found
    temporary
    memory
    unavailable
    malformed
}

/// One validated step through a system resolver result sequence.
pub(/) enum ResolverNext {
    ready(address: NetworkAddress)
    end
    malformed
}

/// One logical numeric socket address at the target boundary.
pub(/) copy struct NetworkAddress {
    pub family: NetworkFamily
    pub bytes: [u8; 16]
    pub port: u16
}

construct NetworkAddress {
    pub(/) noalloc func ipv4(bytes: [u8; 4], port: u16): Self
    pub(/) noalloc func ipv6(bytes: [u8; 16], port: u16): Self
}
