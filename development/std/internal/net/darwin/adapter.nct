noalloc func connection_local_address(owner: &NetworkOwner): NetworkAddress? {
    var native = empty_native_address()
    let length = network_connection_copy_local_address_raw(
        owner,
        ptr.from_ref_mut(&+native.bytes[0]),
    )
    return logical_address(&native.bytes, length)
}

