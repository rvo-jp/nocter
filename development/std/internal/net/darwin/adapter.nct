#target: "arm64-darwin"
noalloc func listener_create(address: &NetworkAddress): NetworkOwner? {
    let native = native_address(address)
    return network_listener_create_raw(ptr.from_ref(&native.bytes[0]))?
}

#target: "arm64-darwin"
noalloc func listener_start(owner: &+NetworkOwner): void {
    network_listener_start_raw(owner)
    return
}

#target: "arm64-darwin"
noalloc func listener_event_descriptor(owner: &NetworkOwner): usize {
    return network_listener_event_descriptor_raw(owner)
}

#target: "arm64-darwin"
noalloc func listener_event_from_words(
    kind: usize,
    first: usize,
    error_domain: usize,
    error_code: usize,
    accepted_owner: NetworkOwner?,
): NetworkListenerEvent {
    if kind == 3 {
        let failure = connection_provider_failure(error_domain, error_code)
        if first == 1 {
            return NetworkListenerEvent.state(NetworkListenerState.waiting)
        }
        if first == 2 {
            return NetworkListenerEvent.state(NetworkListenerState.ready)
        }
        if first == 3 {
            return NetworkListenerEvent.state(NetworkListenerState.failed(move failure))
        }
        if first == 4 {
            return NetworkListenerEvent.state(NetworkListenerState.cancelled)
        }
        return NetworkListenerEvent.malformed
    }
    if kind == 4 {
        if first != 0 { return NetworkListenerEvent.adoption_failed(first) }
        let accepted = move accepted_owner otherwise { return NetworkListenerEvent.malformed }
        return NetworkListenerEvent.accepted(move accepted)
    }
    return NetworkListenerEvent.malformed
}

#target: "arm64-darwin"
noalloc func listener_next_event(owner: &+NetworkOwner): NetworkListenerEvent {
    let event = network_listener_receive_event_raw(owner)
    return listener_event_from_words(event.0, event.1, event.2, event.3, move event.4)
}

#target: "arm64-darwin"
noalloc func listener_try_next_event(owner: &+NetworkOwner): NetworkListenerEvent? {
    let event = network_listener_try_receive_event_raw(owner)
    if event.0 == 0 { return none }
    return listener_event_from_words(event.1, event.2, event.3, event.4, move event.5)
}

