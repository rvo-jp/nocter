noalloc func listener_port(owner: &NetworkOwner): u16 {
    return network_listener_port_raw(owner)
}

#target: "arm64-darwin"
noalloc func listener_dispose(owner: NetworkOwner): void {
    network_listener_dispose_raw(move owner)
    return
}

#target: "arm64-darwin"
noalloc func configure_descriptor(fd: usize): ConfigureAttempt {
    var flags = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_GETFD, 0)
    while flags.errno == darwin.ERRNO_INTERRUPTED {
        flags = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_GETFD, 0)
    }
    if flags.errno != 0 { return ConfigureAttempt.failed(os_error(flags.errno)) }
    var descriptor_flags = flags.value
    if descriptor_flags / darwin.FD_CLOEXEC % 2 == 0 {
        descriptor_flags += darwin.FD_CLOEXEC
    }
    var result = darwin.syscall3(darwin.SYS_FCNTL, fd, F_SETFD, descriptor_flags)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(darwin.SYS_FCNTL, fd, F_SETFD, descriptor_flags)
    }
    if result.errno != 0 { return ConfigureAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return ConfigureAttempt.malformed }

    result = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_SETNOSIGPIPE, 1)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_SETNOSIGPIPE, 1)
    }
    if result.errno != 0 { return ConfigureAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return ConfigureAttempt.malformed }

    flags = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_GETFL, 0)
    while flags.errno == darwin.ERRNO_INTERRUPTED {
        flags = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_GETFL, 0)
    }
    if flags.errno != 0 { return ConfigureAttempt.failed(os_error(flags.errno)) }
    var status_flags = flags.value
    if status_flags / darwin.O_NONBLOCK % 2 == 0 {
        status_flags += darwin.O_NONBLOCK
    }
    result = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_SETFL, status_flags)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(darwin.SYS_FCNTL, fd, darwin.F_SETFL, status_flags)
    }
    if result.errno != 0 { return ConfigureAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return ConfigureAttempt.malformed }
    return ConfigureAttempt.ready
}

#target: "arm64-darwin"
noalloc func configure_family(fd: usize, family: NetworkFamily): ConfigureAttempt {
    if family is NetworkFamily.ipv4 { return ConfigureAttempt.ready }
    var enabled: i32 = 1
    var result = darwin.syscall5(
        SYS_SETSOCKOPT,
        fd,
        IPV6_LEVEL,
        IPV6_ONLY,
        ptr.addr(ptr.from_ref_mut(&+enabled)),
        4,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall5(
            SYS_SETSOCKOPT,
            fd,
            IPV6_LEVEL,
            IPV6_ONLY,
            ptr.addr(ptr.from_ref_mut(&+enabled)),
            4,
        )
    }
    if result.errno != 0 { return ConfigureAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return ConfigureAttempt.malformed }
    return ConfigureAttempt.ready
}

#target: "arm64-darwin"
noalloc func close_once(fd: usize): void {
    let _ = darwin.close_descriptor(fd)
    return
}

#target: "arm64-darwin"
noalloc func create_socket(family: NetworkFamily, socket_type: usize): RawDescriptorAttempt {
    let native_family = match family {
        NetworkFamily.ipv4 { ADDRESS_FAMILY_IPV4 }
        NetworkFamily.ipv6 { ADDRESS_FAMILY_IPV6 }
    }
    let result = darwin.syscall3(SYS_SOCKET, native_family, socket_type, 0)
    if result.errno != 0 { return RawDescriptorAttempt.failed(os_error(result.errno)) }
    match configure_descriptor(result.value) {
        ConfigureAttempt.ready {}
        ConfigureAttempt.failed(failure) {
            close_once(result.value)
            return RawDescriptorAttempt.failed(failure)
        }
        ConfigureAttempt.malformed {
            close_once(result.value)
            return RawDescriptorAttempt.malformed
        }
    }
    match configure_family(result.value, family) {
        ConfigureAttempt.ready { return RawDescriptorAttempt.ready(result.value) }
        ConfigureAttempt.failed(failure) {
            close_once(result.value)
            return RawDescriptorAttempt.failed(failure)
        }
        ConfigureAttempt.malformed {
            close_once(result.value)
            return RawDescriptorAttempt.malformed
        }
    }
}

#target: "arm64-darwin"
noalloc func create_udp(family: NetworkFamily): RawDescriptorAttempt {
    return create_socket(family, SOCKET_DATAGRAM)
}

#target: "arm64-darwin"
noalloc func classify_unit(result: SyscallResult): RawUnitAttempt {
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawUnitAttempt.interrupted }
    if result.errno == darwin.ERRNO_WOULD_BLOCK { return RawUnitAttempt.would_block }
    if result.errno != 0 { return RawUnitAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return RawUnitAttempt.malformed }
    return RawUnitAttempt.ready
}

#target: "arm64-darwin"
noalloc func select_datagram_peer_once(
    fd: usize,
    address: &NetworkAddress,
): RawUnitAttempt {
    let native = native_address(address)
    let result = darwin.syscall3(
        SYS_CONNECT,
        fd,
        ptr.addr(ptr.from_ref(&native.bytes[0])),
        native.len,
    )
    if result.errno == ERRNO_IN_PROGRESS || result.errno == ERRNO_ALREADY_IN_PROGRESS {
        return RawUnitAttempt.in_progress
    }
    if result.errno == ERRNO_ALREADY_CONNECTED { return RawUnitAttempt.ready }
    return classify_unit(result)
}

#target: "arm64-darwin"
noalloc func finish_datagram_peer_selection_once(fd: usize): RawUnitAttempt {
    var pending_error: i32 = 0
    var length: u32 = 4
    let result = darwin.syscall5(
        SYS_GETSOCKOPT,
        fd,
        SOCKET_LEVEL,
        SOCKET_ERROR,
        ptr.addr(ptr.from_ref_mut(&+pending_error)),
        ptr.addr(ptr.from_ref_mut(&+length)),
    )
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawUnitAttempt.interrupted }
    if result.errno != 0 { return RawUnitAttempt.failed(os_error(result.errno)) }
    if result.value != 0 || length != 4 { return RawUnitAttempt.malformed }
    if pending_error != 0 { return RawUnitAttempt.failed(os_error(pending_error)) }
    return RawUnitAttempt.ready
}

#target: "arm64-darwin"
noalloc func bind_once(fd: usize, address: &NetworkAddress): RawUnitAttempt {
    let native = native_address(address)
    return classify_unit(darwin.syscall3(
        SYS_BIND,
        fd,
        ptr.addr(ptr.from_ref(&native.bytes[0])),
        native.len,
    ))
}

#target: "arm64-darwin"
noalloc func classify_datagram_send(result: SyscallResult, expected: usize): RawUnitAttempt {
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawUnitAttempt.interrupted }
    if result.errno == darwin.ERRNO_WOULD_BLOCK { return RawUnitAttempt.would_block }
    if result.errno != 0 { return RawUnitAttempt.failed(os_error(result.errno)) }
    if result.value != expected { return RawUnitAttempt.malformed }
    return RawUnitAttempt.ready
}

#target: "arm64-darwin"
noalloc func send_once(fd: usize, bytes: &[u8]): RawUnitAttempt {
    return classify_datagram_send(darwin.syscall6(
        SYS_SENDTO,
        fd,
        ptr.addr(bytes.ptr()),
        bytes.len(),
        0,
        0,
        0,
    ), bytes.len())
}

#target: "arm64-darwin"
noalloc func send_to_once(
    fd: usize,
    bytes: &[u8],
    target: &NetworkAddress,
): RawUnitAttempt {
    let native = native_address(target)
    return classify_datagram_send(darwin.syscall6(
        SYS_SENDTO,
        fd,
        ptr.addr(bytes.ptr()),
        bytes.len(),
        0,
        ptr.addr(ptr.from_ref(&native.bytes[0])),
        native.len,
    ), bytes.len())
}

#target: "arm64-darwin"
noalloc func receive_from_once(
    fd: usize,
    buffer: &+[u8],
): RawDatagramAttempt {
    var native = empty_native_address()
    var vector = NativeIoVector { base: ptr.addr(buffer.ptr()), len: buffer.len() }
    var header = NativeMessageHeader {
        name: ptr.addr(ptr.from_ref_mut(&+native.bytes[0])),
        name_len: 28,
        vectors: ptr.addr(ptr.from_ref_mut(&+vector)),
        vector_count: 1,
        control: 0,
        control_len: 0,
        flags: 0,
    }
    let result = darwin.syscall3(
        SYS_RECVMSG,
        fd,
        ptr.addr(ptr.from_ref_mut(&+header)),
        0,
    )
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawDatagramAttempt.interrupted }
    if result.errno == darwin.ERRNO_WOULD_BLOCK { return RawDatagramAttempt.would_block }
    if result.errno != 0 { return RawDatagramAttempt.failed(os_error(result.errno)) }
    if result.value > buffer.len() || header.name_len > 28 {
        return RawDatagramAttempt.malformed
    }
    var known_flags: i32 = 0
    if header.flags / MESSAGE_END_OF_RECORD % 2 == 1 {
        known_flags += MESSAGE_END_OF_RECORD
    }
    let truncated = header.flags / MESSAGE_TRUNCATED % 2 == 1
    if truncated { known_flags += MESSAGE_TRUNCATED }
    if header.flags != known_flags { return RawDatagramAttempt.malformed }
    let source = logical_address(&native.bytes, header.name_len as usize) otherwise {
        return RawDatagramAttempt.malformed
    }
    return RawDatagramAttempt.ready(source, result.value, truncated)
}

#target: "arm64-darwin"
noalloc func poll_once(
    fd: usize,
    events: u16,
    timeout_milliseconds: usize?,
): RawWaitAttempt {
    let descriptor = descriptor_i32(fd) otherwise { return RawWaitAttempt.malformed }
    let native_timeout = timeout_milliseconds otherwise { POLL_INFINITE_TIMEOUT }
    if native_timeout != POLL_INFINITE_TIMEOUT && native_timeout > 2147483647 {
        return RawWaitAttempt.malformed
    }
    var poll_descriptor = PollDescriptor {
        fd: descriptor,
        events: events,
        returned_events: 0,
    }
    let result = darwin.syscall3(
        darwin.SYS_POLL,
        ptr.addr(ptr.from_ref_mut(&+poll_descriptor)),
        1,
        native_timeout,
    )
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawWaitAttempt.interrupted }
    if result.errno != 0 { return RawWaitAttempt.failed(os_error(result.errno)) }
    if result.value == 0 { return RawWaitAttempt.timed_out }
    if result.value != 1 { return RawWaitAttempt.malformed }
    let returned = poll_descriptor.returned_events
    if returned / POLL_INVALID % 2 == 1 { return RawWaitAttempt.malformed }
    var known: u16 = 0
    if returned / POLL_INPUT % 2 == 1 { known += POLL_INPUT }
    if returned / POLL_OUTPUT % 2 == 1 { known += POLL_OUTPUT }
    if returned / POLL_ERROR % 2 == 1 { known += POLL_ERROR }
    if returned / POLL_HANGUP % 2 == 1 { known += POLL_HANGUP }
    if returned == 0 || returned != known { return RawWaitAttempt.malformed }
    if events == POLL_INPUT && returned / POLL_OUTPUT % 2 == 1 {
        return RawWaitAttempt.malformed
    }
    if events == POLL_OUTPUT && returned / POLL_INPUT % 2 == 1 {
        return RawWaitAttempt.malformed
    }
    return RawWaitAttempt.ready
}

#target: "arm64-darwin"
noalloc func wait_readable_once(
    fd: usize,
    timeout_milliseconds: usize?,
): RawWaitAttempt {
    return poll_once(fd, POLL_INPUT, timeout_milliseconds)
}

#target: "arm64-darwin"
noalloc func wait_writable_once(
    fd: usize,
    timeout_milliseconds: usize?,
): RawWaitAttempt {
    return poll_once(fd, POLL_OUTPUT, timeout_milliseconds)
}

#target: "arm64-darwin"
noalloc func address_once(fd: usize, peer: bool): RawAddressAttempt {
    var native = empty_native_address()
    var length: u32 = 28
    let syscall = if peer { SYS_GETPEERNAME } else { SYS_GETSOCKNAME }
    let result = darwin.syscall3(
        syscall,
        fd,
        ptr.addr(ptr.from_ref_mut(&+native.bytes[0])),
        ptr.addr(ptr.from_ref_mut(&+length)),
    )
    if result.errno == darwin.ERRNO_INTERRUPTED { return RawAddressAttempt.interrupted }
    if result.errno != 0 { return RawAddressAttempt.failed(os_error(result.errno)) }
    if result.value != 0 { return RawAddressAttempt.malformed }
    let address = logical_address(&native.bytes, length as usize) otherwise {
        return RawAddressAttempt.malformed
    }
    return RawAddressAttempt.ready(address)
}

#target: "arm64-darwin"
noalloc func local_address_once(fd: usize): RawAddressAttempt {
    return address_once(fd, false)
}

#target: "arm64-darwin"
noalloc func peer_address_once(fd: usize): RawAddressAttempt {
    return address_once(fd, true)
}
