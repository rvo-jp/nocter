#target: "arm64-darwin"
noalloc func connection_provider_failure(domain: usize, code: usize): NetworkProviderFailure? {
    if domain == 0 {
        if code == 0 { return none }
        return NetworkProviderFailure.unknown(domain, code)
    }
    if domain == 1 {
        var kind = OSErrorKind.unknown
        if code == 1 || code == 13 { kind = OSErrorKind.permission_denied }
        if code == 22 { kind = OSErrorKind.invalid_input }
        if code == 32 { kind = OSErrorKind.broken_pipe }
        if code == 39 || code == 57 { kind = OSErrorKind.not_connected }
        if code == 40 { kind = OSErrorKind.message_too_large }
        if code == 48 { kind = OSErrorKind.address_in_use }
        if code == 49 { kind = OSErrorKind.address_not_available }
        if code == 50 || code == 51 { kind = OSErrorKind.network_unreachable }
        if code == 53 { kind = OSErrorKind.connection_aborted }
        if code == 54 { kind = OSErrorKind.connection_reset }
        if code == 60 { kind = OSErrorKind.timed_out }
        if code == 61 { kind = OSErrorKind.connection_refused }
        return NetworkProviderFailure.os(kind, code)
    }
    if domain == 2 { return NetworkProviderFailure.dns(code) }
    if domain == 3 { return NetworkProviderFailure.tls(code) }
    return NetworkProviderFailure.unknown(domain, code)
}

#target: "arm64-darwin"
noalloc func connection_event_from_words(
    kind: usize,
    first: usize,
    second: usize,
    third: usize,
    fourth: usize,
): NetworkConnectionEvent {
    if kind == 0 {
        let failure = connection_provider_failure(second, third)
        if first == 1 {
            return NetworkConnectionEvent.state(NetworkConnectionState.waiting(move failure))
        }
        if first == 2 {
            return NetworkConnectionEvent.state(NetworkConnectionState.preparing)
        }
        if first == 3 {
            return NetworkConnectionEvent.state(NetworkConnectionState.ready)
        }
        if first == 4 {
            return NetworkConnectionEvent.state(NetworkConnectionState.failed(move failure))
        }
        if first == 5 {
            return NetworkConnectionEvent.state(NetworkConnectionState.cancelled)
        }
        return NetworkConnectionEvent.malformed
    }
    if kind == 1 {
        return NetworkConnectionEvent.received(
            first,
            second == 1,
            connection_provider_failure(third, fourth),
        )
    }
    if kind == 2 {
        return NetworkConnectionEvent.sent(connection_provider_failure(first, second))
    }
    return NetworkConnectionEvent.malformed
}

#target: "arm64-darwin"
noalloc func connection_next_event(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): NetworkConnectionEvent {
    let event = network_connection_receive_event_raw(owner, destination, capacity)
    return connection_event_from_words(event.0, event.1, event.2, event.3, event.4)
}

#target: "arm64-darwin"
noalloc func connection_try_next_event(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): NetworkConnectionEvent? {
    let event = network_connection_try_receive_event_raw(owner, destination, capacity)
    if event.0 == 0 { return none }
    return connection_event_from_words(event.1, event.2, event.3, event.4, event.5)
}

