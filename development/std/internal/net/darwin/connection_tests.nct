//! Source-to-native qualification for the plain Network connection primitive family.

see ./adapter.nct
see ./index.nct

use /internal/net/model.{NetworkAddress, NetworkFamily, NetworkOwner}
use /internal/ptr as internal_ptr
use /ptr

noalloc func next_test_connection_event(owner: &+NetworkOwner): (usize, usize, usize, usize, usize) {
    var scratch: [u8; 1] = [0]
    return network_connection_receive_event_raw(owner, ptr.from_ref_mut(&+scratch[0]), 1)
}

noalloc func release_test_connection(owner: NetworkOwner): void {
    var connection = move owner
    network_connection_request_cancel_raw(&+connection)
    var event = next_test_connection_event(&+connection)
    while event.0 != 0 || event.1 != 5 {
        event = next_test_connection_event(&+connection)
    }
    network_connection_release_barrier_raw(&+connection)
    network_connection_release_raw(move connection)
    return
}

test plain_connection_primitives_preserve_one_owner_lifecycle {
    let address = NetworkAddress.ipv4([127, 0, 0, 1], 1)
    let native = native_address(&address)
    var owner = network_connection_create_raw(ptr.from_ref(&native.bytes[0])) otherwise {
        return error.new("std.net.test", "Network connection owner creation failed")
    }

    network_connection_start_raw(&+owner)
    let descriptor = network_connection_event_descriptor_raw(&owner)
    release_test_connection(move owner)
    if descriptor == 0 {
        return error.new("std.net.test", "Network callback descriptor was invalid")
    }
    return
}

test plain_connection_copies_effective_addresses_without_provider_ownership {
    let listener = match create_tcp(NetworkFamily.ipv4) {
        RawDescriptorAttempt.ready(fd) { fd }
        _ { return error.new("std.net.test", "TCP listener creation failed") }
    }
    let requested = NetworkAddress.ipv4([127, 0, 0, 1], 0)
    match bind_once(listener, &requested) {
        RawUnitAttempt.ready {}
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener bind failed")
        }
    }
    match listen_once(listener) {
        RawUnitAttempt.ready {}
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener listen failed")
        }
    }
    let bound = match local_address_once(listener) {
        RawAddressAttempt.ready(address) { address }
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener address was unavailable")
        }
    }
    let native = native_address(&bound)
    var owner = network_connection_create_raw(ptr.from_ref(&native.bytes[0])) otherwise {
        close_once(listener)
        return error.new("std.net.test", "Network connection owner creation failed")
    }
    network_connection_start_raw(&+owner)

    var event = next_test_connection_event(&+owner)
    while event.0 != 0 || (event.1 != 3 && event.1 != 4 && event.1 != 5) {
        event = next_test_connection_event(&+owner)
    }
    if event.1 != 3 {
        release_test_connection(move owner)
        close_once(listener)
        return error.new("std.net.test", "Network connection did not become ready")
    }
    let local = connection_local_address(&owner) otherwise {
        release_test_connection(move owner)
        close_once(listener)
        return error.new("std.net.test", "effective local address was unavailable")
    }
    let remote = connection_remote_address(&owner) otherwise {
        release_test_connection(move owner)
        close_once(listener)
        return error.new("std.net.test", "effective remote address was unavailable")
    }

    release_test_connection(move owner)
    close_once(listener)
    if local.port == 0 || remote.port != bound.port {
        return error.new("std.net.test", "effective connection addresses were malformed")
    }
    return
}

test plain_connection_transfers_bytes_through_one_ordered_event_channel {
    let listener = match create_tcp(NetworkFamily.ipv4) {
        RawDescriptorAttempt.ready(fd) { fd }
        _ { return error.new("std.net.test", "TCP listener creation failed") }
    }
    let requested = NetworkAddress.ipv4([127, 0, 0, 1], 0)
    match bind_once(listener, &requested) {
        RawUnitAttempt.ready {}
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener bind failed")
        }
    }
    match listen_once(listener) {
        RawUnitAttempt.ready {}
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener listen failed")
        }
    }
    let bound = match local_address_once(listener) {
        RawAddressAttempt.ready(address) { address }
        _ {
            close_once(listener)
            return error.new("std.net.test", "TCP listener address was unavailable")
        }
    }
    let native = native_address(&bound)
    var owner = network_connection_create_raw(ptr.from_ref(&native.bytes[0])) otherwise {
        close_once(listener)
        return error.new("std.net.test", "Network connection owner creation failed")
    }
    network_connection_start_raw(&+owner)

    var event = next_test_connection_event(&+owner)
    while event.0 != 0 || (event.1 != 3 && event.1 != 4 && event.1 != 5) {
        event = next_test_connection_event(&+owner)
    }
    if event.1 != 3 {
        release_test_connection(move owner)
        close_once(listener)
        return error.new("std.net.test", "Network connection did not become ready")
    }

    var server: usize = 0
    var accepted = false
    while !accepted {
        match accept_once(listener) {
            RawAcceptAttempt.ready(fd, _) {
                server = fd
                accepted = true
            }
            RawAcceptAttempt.would_block {
                match wait_readable_once(listener, none) {
                    RawWaitAttempt.ready {}
                    _ {
                        release_test_connection(move owner)
                        close_once(listener)
                        return error.new("std.net.test", "TCP listener did not become readable")
                    }
                }
            }
            _ {
                release_test_connection(move owner)
                close_once(listener)
                return error.new("std.net.test", "TCP listener did not accept the connection")
            }
        }
    }

    let request = "ping".bytes()
    if !network_connection_begin_send_raw(
        &+owner,
        ptr.from_ref(&request[0]),
        request.len(),
        false,
    ) {
        release_test_connection(move owner)
        close_once(server)
        close_once(listener)
        return error.new("std.net.test", "Network send storage was unavailable")
    }
    event = next_test_connection_event(&+owner)
    while event.0 != 2 {
        event = next_test_connection_event(&+owner)
    }
    if event.1 != 0 || event.2 != 0 {
        release_test_connection(move owner)
        close_once(server)
        close_once(listener)
        return error.new("std.net.test", "Network send completion failed")
    }

    var received_request: [u8; 4] = [0, 0, 0, 0]
    var request_len: usize = 0
    var request_received = false
    while !request_received {
        match read_once(
            server,
            internal_ptr.slice_from_raw_parts_value_mut(
                ptr.from_ref_mut(&+received_request[0]),
                4,
            ),
        ) {
            RawTransferAttempt.ready(count) {
                request_len = count
                request_received = true
            }
            RawTransferAttempt.would_block {
                match wait_readable_once(server, none) {
                    RawWaitAttempt.ready {}
                    _ {
                        release_test_connection(move owner)
                        close_once(server)
                        close_once(listener)
                        return error.new("std.net.test", "TCP peer did not become readable")
                    }
                }
            }
            _ {
                release_test_connection(move owner)
                close_once(server)
                close_once(listener)
                return error.new("std.net.test", "TCP peer read failed")
            }
        }
    }
    if request_len != 4
        || received_request[0] != 112
        || received_request[1] != 105
        || received_request[2] != 110
        || received_request[3] != 103 {
        release_test_connection(move owner)
        close_once(server)
        close_once(listener)
        return error.new("std.net.test", "Network send bytes were malformed")
    }

    let response = "pong".bytes()
    var written: usize = 0
    while written < response.len() {
        match write_once(server, response, written) {
            RawTransferAttempt.ready(count) { written += count }
            RawTransferAttempt.would_block {
                match wait_writable_once(server, none) {
                    RawWaitAttempt.ready {}
                    _ {
                        release_test_connection(move owner)
                        close_once(server)
                        close_once(listener)
                        return error.new("std.net.test", "TCP peer did not become writable")
                    }
                }
            }
            _ {
                release_test_connection(move owner)
                close_once(server)
                close_once(listener)
                return error.new("std.net.test", "TCP peer write failed")
            }
        }
    }

    var received_response: [u8; 4] = [0, 0, 0, 0]
    network_connection_begin_receive_raw(&+owner, 4)
    event = network_connection_receive_event_raw(
        &+owner,
        ptr.from_ref_mut(&+received_response[0]),
        4,
    )
    while event.0 != 1 {
        event = network_connection_receive_event_raw(
            &+owner,
            ptr.from_ref_mut(&+received_response[0]),
            4,
        )
    }
    release_test_connection(move owner)
    close_once(server)
    close_once(listener)
    if event.1 != 4
        || event.3 != 0
        || event.4 != 0
        || received_response[0] != 112
        || received_response[1] != 111
        || received_response[2] != 110
        || received_response[3] != 103 {
        return error.new("std.net.test", "Network receive completion was malformed")
    }
    return
}
