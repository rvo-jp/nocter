//! Darwin ARM64 socket ABI adapter.
//!
//! Native address and poll layouts, socket constants, byte order, and raw syscall classification
//! are confined to this module. Consumers receive closed logical attempts.

use /internal/net/model.{
    NetworkAddress,
    NetworkConnectionEvent,
    NetworkFamily,
    NetworkListenerEvent,
    NetworkOwner,
    ResolverFailure,
    ResolverNext,
}
use /internal/os.OSError
use /internal/os/darwin.SyscallResult

see ./adapter.nct
see ./connection_tests.nct
see ./resolver.nct
see ./resolver_tests.nct

/// Creates one unstarted provider connection from a logical numeric address.
#target: "arm64-darwin"
pub(/) noalloc func connection_create(address: &NetworkAddress): NetworkOwner?

/// Creates one unstarted provider connection from validated NUL-terminated host and service text.
#target: "arm64-darwin"
pub(/) noalloc func connection_create_host(
    host: *u8,
    service: *u8,
): NetworkOwner?

/// Creates one unstarted authenticated TLS connection from a numeric address and validated
/// NUL-terminated server-name and optional ALPN pointers.
#target: "arm64-darwin"
pub(/) noalloc func tls_connection_create(
    address: &NetworkAddress,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
): NetworkOwner?

/// Creates one unstarted authenticated TLS connection from a provider-resolved host endpoint.
#target: "arm64-darwin"
pub(/) noalloc func tls_connection_create_host(
    host: *u8,
    service: *u8,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
): NetworkOwner?

/// Returns whether an established TLS connection negotiated the required application protocol.
#target: "arm64-darwin"
pub(/) noalloc func tls_connection_matches_application_protocol(
    owner: &NetworkOwner,
    application_protocol: *u8,
): bool

/// Starts callbacks and provider progress for a connection owner.
#target: "arm64-darwin"
pub(/) noalloc func connection_start(owner: &+NetworkOwner): void

/// Returns the descriptor that becomes readable for each ordered callback event.
#target: "arm64-darwin"
pub(/) noalloc func connection_event_descriptor(owner: &NetworkOwner): usize

/// Starts one receive operation whose completion enters the ordered event channel.
#target: "arm64-darwin"
pub(/) noalloc func connection_begin_receive(
    owner: &+NetworkOwner,
    maximum_length: u32,
): void

/// Starts one send after copying the source bytes into provider-owned storage.
#target: "arm64-darwin"
pub(/) noalloc func connection_begin_send(
    owner: &+NetworkOwner,
    bytes: *u8,
    len: usize,
    final: bool,
): bool

/// Submits an empty final message to close the provider write side.
#target: "arm64-darwin"
pub(/) noalloc func connection_begin_final_send(owner: &+NetworkOwner): bool

/// Consumes and normalizes one ordered callback event.
#target: "arm64-darwin"
pub(/) noalloc blocking func connection_next_event(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): NetworkConnectionEvent

/// Attempts to consume one ordered callback event without waiting for an empty channel.
#target: "arm64-darwin"
pub(/) noalloc func connection_try_next_event(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): NetworkConnectionEvent?

/// Returns the effective local address without exposing a provider endpoint.
#target: "arm64-darwin"
pub(/) noalloc func connection_local_address(owner: &NetworkOwner): NetworkAddress?

/// Returns the effective remote address without exposing a provider endpoint.
#target: "arm64-darwin"
pub(/) noalloc func connection_remote_address(owner: &NetworkOwner): NetworkAddress?

/// Transfers an owner to nonblocking asynchronous terminal cleanup.
#target: "arm64-darwin"
pub(/) noalloc func connection_dispose(owner: NetworkOwner): void

/// Creates one provider listener for a logical local address.
#target: "arm64-darwin"
pub(/) noalloc func listener_create(address: &NetworkAddress): NetworkOwner?

/// Starts one fully initialized provider listener.
#target: "arm64-darwin"
pub(/) noalloc func listener_start(owner: &+NetworkOwner): void

/// Returns the descriptor for a listener's ordered callback channel.
#target: "arm64-darwin"
pub(/) noalloc func listener_event_descriptor(owner: &NetworkOwner): usize

/// Consumes and normalizes one ordered listener event.
#target: "arm64-darwin"
pub(/) noalloc blocking func listener_next_event(owner: &+NetworkOwner): NetworkListenerEvent

/// Attempts to consume one ordered listener event without waiting for an empty channel.
#target: "arm64-darwin"
pub(/) noalloc func listener_try_next_event(owner: &+NetworkOwner): NetworkListenerEvent?

/// Returns the effective local port of a running listener.
#target: "arm64-darwin"
pub(/) noalloc func listener_port(owner: &NetworkOwner): u16

/// Transfers a listener owner to nonblocking asynchronous terminal cleanup.
#target: "arm64-darwin"
pub(/) noalloc func listener_dispose(owner: NetworkOwner): void

/// Opens one datagram descriptor for IPv4 or IPv6 without exposing Darwin socket constants.
#target: "arm64-darwin"
noalloc primitive func datagram_socket_open_raw(ipv6: bool): SyscallResult

/// Applies the required close-on-exec, no-SIGPIPE, nonblocking, and IPv6-only policy.
#target: "arm64-darwin"
noalloc primitive func datagram_socket_configure_raw(
    fd: usize,
    ipv6: bool,
    enabled: *i32,
): SyscallResult from static

/// Performs one nonblocking bind attempt over a complete native socket address.
#target: "arm64-darwin"
noalloc primitive func datagram_bind_raw(
    fd: usize,
    address: *u8,
    address_len: usize,
): SyscallResult from static

/// Performs one nonblocking connected-peer selection attempt.
#target: "arm64-darwin"
noalloc primitive func datagram_connect_raw(
    fd: usize,
    address: *u8,
    address_len: usize,
): SyscallResult from static

/// Reads the pending socket error after writable peer selection.
#target: "arm64-darwin"
noalloc primitive func datagram_connect_status_raw(
    fd: usize,
    pending_error: *i32,
    length: *u32,
): SyscallResult from static

/// Performs one connected datagram send attempt with fixed target flags.
#target: "arm64-darwin"
noalloc primitive func datagram_send_raw(
    fd: usize,
    bytes: *u8,
    len: usize,
): SyscallResult from static

/// Performs one addressed datagram send attempt with fixed target flags.
#target: "arm64-darwin"
noalloc primitive func datagram_send_to_raw(
    fd: usize,
    bytes: *u8,
    len: usize,
    address: *u8,
    address_len: usize,
): SyscallResult from static

/// Performs one receive attempt through a caller-owned Darwin message header.
#target: "arm64-darwin"
noalloc primitive func datagram_receive_raw(fd: usize, header: *u8): SyscallResult from static

/// Copies the local native address of one datagram descriptor.
#target: "arm64-darwin"
noalloc primitive func datagram_local_address_raw(
    fd: usize,
    address: *u8,
    address_len: *u32,
): SyscallResult from static

/// Copies the selected peer native address of one datagram descriptor.
#target: "arm64-darwin"
noalloc primitive func datagram_peer_address_raw(
    fd: usize,
    address: *u8,
    address_len: *u32,
): SyscallResult from static

/// Creates an unstarted plain connection over one complete native socket address.
#target: "arm64-darwin"
noalloc primitive func network_connection_create_raw(address: *u8): NetworkOwner? from static

/// Creates an unstarted plain connection from NUL-terminated host and service text.
#target: "arm64-darwin"
noalloc primitive func network_connection_create_host_raw(
    host: *u8,
    service: *u8,
): NetworkOwner? from static

/// Creates an unstarted TLS connection with system trust and hostname authentication.
#target: "arm64-darwin"
noalloc primitive func network_tls_connection_create_raw(
    address: *u8,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
): NetworkOwner? from static

/// Creates an unstarted TLS connection from NUL-terminated host and service text.
#target: "arm64-darwin"
noalloc primitive func network_tls_connection_create_host_raw(
    host: *u8,
    service: *u8,
    server_name: *u8,
    application_protocol: *u8,
    trust_anchor: *u8,
    trust_anchor_len: usize,
): NetworkOwner? from static

/// Compares one established connection's negotiated TLS protocol without exposing metadata.
#target: "arm64-darwin"
noalloc primitive func network_tls_connection_matches_application_protocol_raw(
    owner: &NetworkOwner,
    application_protocol: *u8,
): bool

/// Starts callbacks and provider progress for an initialized connection owner.
#target: "arm64-darwin"
noalloc primitive func network_connection_start_raw(owner: &+NetworkOwner): void

/// Returns the reactor-readable callback-channel descriptor.
#target: "arm64-darwin"
noalloc primitive func network_connection_event_descriptor_raw(
    owner: &NetworkOwner,
): usize

/// Starts one provider receive whose completion enters the ordered connection event channel.
#target: "arm64-darwin"
noalloc primitive func network_connection_begin_receive_raw(
    owner: &+NetworkOwner,
    maximum_length: u32,
): void

/// Starts one provider send after copying the source bytes into system-owned storage.
#target: "arm64-darwin"
noalloc primitive func network_connection_begin_send_raw(
    owner: &+NetworkOwner,
    bytes: *u8,
    len: usize,
    final: bool,
): bool

/// Receives one ordered connection event and consumes all provider ownership carried by it.
#target: "arm64-darwin"
noalloc blocking primitive func network_connection_receive_event_raw(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): (usize, usize, usize, usize, usize)

/// Attempts one event receive and prefixes the observation with an availability word.
#target: "arm64-darwin"
noalloc primitive func network_connection_try_receive_event_raw(
    owner: &+NetworkOwner,
    destination: *u8,
    capacity: usize,
): (usize, usize, usize, usize, usize, usize)

/// Copies the current effective local address into a 28-byte caller-owned native record.
#target: "arm64-darwin"
noalloc primitive func network_connection_copy_local_address_raw(
    owner: &NetworkOwner,
    destination: *u8,
): usize

/// Copies the current effective remote address into a 28-byte caller-owned native record.
#target: "arm64-darwin"
noalloc primitive func network_connection_copy_remote_address_raw(
    owner: &NetworkOwner,
    destination: *u8,
): usize

/// Requests idempotent provider cancellation.
#target: "arm64-darwin"
noalloc primitive func network_connection_request_cancel_raw(owner: &+NetworkOwner): void

/// Waits until the final callback has returned and advances the release fence.
#target: "arm64-darwin"
noalloc blocking primitive func network_connection_release_barrier_raw(owner: &+NetworkOwner): void

/// Releases a quiesced connection owner and all of its native resources.
#target: "arm64-darwin"
noalloc primitive func network_connection_release_raw(owner: NetworkOwner): void

/// Consumes an owner and submits terminal cleanup without waiting for provider progress.
#target: "arm64-darwin"
noalloc primitive func network_connection_dispose_raw(owner: NetworkOwner): void

/// Creates one provider listener for a native socket address.
#target: "arm64-darwin"
noalloc primitive func network_listener_create_raw(address: *u8): NetworkOwner? from static

/// Starts a fully initialized provider listener.
#target: "arm64-darwin"
noalloc primitive func network_listener_start_raw(owner: &+NetworkOwner): void

/// Returns the descriptor for the listener's ordered callback channel.
#target: "arm64-darwin"
noalloc primitive func network_listener_event_descriptor_raw(owner: &NetworkOwner): usize

/// Consumes one ordered listener event and adopts accepted connections before returning.
#target: "arm64-darwin"
noalloc blocking primitive func network_listener_receive_event_raw(
    owner: &+NetworkOwner,
): (usize, usize, usize, usize, NetworkOwner?) from static

/// Attempts one listener event receive and prefixes the observation with availability.
#target: "arm64-darwin"
noalloc primitive func network_listener_try_receive_event_raw(
    owner: &+NetworkOwner,
): (usize, usize, usize, usize, usize, NetworkOwner?) from static

/// Returns the effective local port assigned to a running provider listener.
#target: "arm64-darwin"
noalloc primitive func network_listener_port_raw(owner: &NetworkOwner): u16

/// Requests idempotent provider listener cancellation.
#target: "arm64-darwin"
noalloc primitive func network_listener_request_cancel_raw(owner: &+NetworkOwner): void

/// Waits until every listener callback has returned after final cancellation.
#target: "arm64-darwin"
noalloc blocking primitive func network_listener_release_barrier_raw(owner: &+NetworkOwner): void

/// Releases one quiesced provider listener owner.
#target: "arm64-darwin"
noalloc primitive func network_listener_release_raw(owner: NetworkOwner): void

/// Consumes a listener owner and submits terminal cleanup without waiting for provider progress.
#target: "arm64-darwin"
noalloc primitive func network_listener_dispose_raw(owner: NetworkOwner): void

#target: "arm64-darwin"
pub(/) enum RawDescriptorAttempt {
    ready(fd: usize)
    failed(error: OSError)
    malformed
}

#target: "arm64-darwin"
pub(/) enum RawUnitAttempt {
    ready
    interrupted
    would_block
    in_progress
    failed(error: OSError)
    malformed
}

#target: "arm64-darwin"
pub(/) enum RawWaitAttempt {
    ready
    timed_out
    interrupted
    failed(error: OSError)
    malformed
}

#target: "arm64-darwin"
pub(/) enum RawAddressAttempt {
    ready(address: NetworkAddress)
    interrupted
    failed(error: OSError)
    malformed
}

#target: "arm64-darwin"
pub(/) enum RawDatagramAttempt {
    ready(source: NetworkAddress, copied_len: usize, truncated: bool)
    interrupted
    would_block
    failed(error: OSError)
    malformed
}

#target: "arm64-darwin"
pub(/) struct RawResolverResults

#target: "arm64-darwin"
pub(/) enum RawResolveAttempt {
    ready(results: RawResolverResults)
    failed(failure: ResolverFailure)
}

/// Starts one system resolver query for a validated null-terminated host.
#target: "arm64-darwin"
pub(/) noalloc blocking func resolve_host_once(node: *u8): RawResolveAttempt

instance RawResolverResults {
    /// Returns the next usable logical address without exposing a native record.
    pub(/) noalloc method &+self.next(): ResolverNext
}

#target: "arm64-darwin"
pub(/) noalloc func create_udp(family: NetworkFamily): RawDescriptorAttempt

#target: "arm64-darwin"
pub(/) noalloc func select_datagram_peer_once(
    fd: usize,
    address: &NetworkAddress,
): RawUnitAttempt

#target: "arm64-darwin"
pub(/) noalloc func finish_datagram_peer_selection_once(fd: usize): RawUnitAttempt

#target: "arm64-darwin"
pub(/) noalloc func bind_once(fd: usize, address: &NetworkAddress): RawUnitAttempt

#target: "arm64-darwin"
pub(/) noalloc func send_once(fd: usize, bytes: &[u8]): RawUnitAttempt

#target: "arm64-darwin"
pub(/) noalloc func send_to_once(
    fd: usize,
    bytes: &[u8],
    target: &NetworkAddress,
): RawUnitAttempt

#target: "arm64-darwin"
pub(/) noalloc func receive_from_once(
    fd: usize,
    buffer: &+[u8],
): RawDatagramAttempt

#target: "arm64-darwin"
pub(/) noalloc blocking func wait_readable_once(
    fd: usize,
    timeout_milliseconds: usize?,
): RawWaitAttempt

#target: "arm64-darwin"
pub(/) noalloc blocking func wait_writable_once(
    fd: usize,
    timeout_milliseconds: usize?,
): RawWaitAttempt

#target: "arm64-darwin"
pub(/) noalloc func local_address_once(fd: usize): RawAddressAttempt

#target: "arm64-darwin"
pub(/) noalloc func peer_address_once(fd: usize): RawAddressAttempt

#target: "arm64-darwin"
pub(/) noalloc func close_once(fd: usize): void
