//! Shared checked arithmetic and geometric storage growth.

see ./index.nct

const MAXIMUM_USIZE: usize = 18446744073709551615

noalloc func checked_add(left: usize, right: usize): usize? {
    if right > MAXIMUM_USIZE - left {
        return none
    }
    return left + right
}

noalloc func checked_multiply(left: usize, right: usize): usize? {
    if left == 0 || right == 0 {
        return 0
    }
    if left > MAXIMUM_USIZE / right {
        return none
    }
    return left * right
}

noalloc func growth_capacity(current: usize, required: usize): usize {
    if required <= current {
        return current
    }
    let doubled: usize = checked_add(current, current) otherwise {
        return MAXIMUM_USIZE
    }
    if doubled < required {
        return required
    }
    return doubled
}

noalloc func capacity_overflow(): error {
    return error.new("std.mem.capacity_overflow", "storage capacity overflow")
}
