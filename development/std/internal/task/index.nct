//! Compiler-owned asynchronous task services.

see ./readiness.nct

/// Suspends until one descriptor may make progress in the requested direction.
pub(/) async func wait_descriptor_ready(descriptor: usize, writable: bool): void

/// Suspends until descriptor progress or the fixed monotonic deadline is observed.
pub(/) async func wait_descriptor_ready_or_deadline(
    descriptor: usize,
    writable: bool,
    deadline: u64,
): void

/// Suspends until the target reports that one exact process may be observed without waiting.
pub(/) async func wait_process_complete(process: usize): void
