//! Text operations that materialize independently owned results.

see ./index.nct
see ./views.nct

use /string.String
use /vec.Vec

func split(text: &str, separator: &str): Vec<String>! {
    var parts = split_views(text, separator)?
    var result: Vec<String> = Vec.empty()
    for part in move parts {
        result.push(String.copy(part))
    }
    return move result
}
