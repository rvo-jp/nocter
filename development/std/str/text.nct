//! Borrowed UTF-8 text operations.

see ./index.nct
see ./search.nct
see ./views.nct
see ./owned.nct

use /iter.{Iterator, ViewIter}
use /internal/ptr
use /string.String
use /vec.Vec

noalloc primitive func str_len_raw(value: &str): usize

noalloc primitive func str_ptr_addr_raw(value: &str): usize

instance str {
    noalloc operator (&self == other: &Self): bool {
        let left = bytes_from_str(self)
        let right = bytes_from_str(other)
        if left.len() != right.len() {
            return false
        }
        var index: usize = 0
        while index < left.len() {
            if left[index] != right[index] {
                return false
            }
            index += 1
        }
        return true
    }

    noalloc operator (&self < other: &Self): bool {
        let left = bytes_from_str(self)
        let right = bytes_from_str(other)
        let shared_len: usize = if left.len() < right.len() { left.len() } else { right.len() }
        var index: usize = 0
        while index < shared_len {
            if left[index] < right[index] { return true }
            if right[index] < left[index] { return false }
            index += 1
        }
        return left.len() < right.len()
    }

    noalloc method &self.len(): usize {
        return str_len_raw(self)
    }

    noalloc method &self.is_empty(): bool {
        return str_len_raw(self) == 0
    }

    noalloc method &self.ptr(): *u8 {
        return ptr.from_addr(str_ptr_addr_raw(self))
    }

    noalloc method &self.bytes(): &[u8] {
        return bytes_from_str(self)
    }

    noalloc method &self.is_char_boundary(index: usize): bool {
        return is_char_boundary(self, index)
    }

    noalloc method &self.get_range(start: usize, end: usize): &str? {
        return get_range(self, start, end)?
    }

    noalloc method &self.find_from(needle: &str, start: usize): usize? {
        return find_from(self, needle, start)?
    }

    noalloc method &self.find(needle: &str): usize? {
        return find(self, needle)?
    }

    noalloc method &self.contains(needle: &str): bool {
        return contains(self, needle)
    }

    noalloc method &self.starts_with(prefix: &str): bool {
        return starts_with(self, prefix)
    }

    noalloc method &self.ends_with(suffix: &str): bool {
        return ends_with(self, suffix)
    }

    noalloc method &self.strip_prefix(prefix: &str): &str? from self {
        return strip_prefix(self, prefix)?
    }

    noalloc method &self.strip_suffix(suffix: &str): &str? from self {
        return strip_suffix(self, suffix)?
    }

    method &self.split(separator: &str): Vec<String>! {
        return split(self, separator)?
    }

    noalloc method &self.split_views(separator: &str): SplitIter! from self | separator {
        return split_views(self, separator)?
    }

    noalloc method &self.lines(): some Iterator { .Item = &str } {
        return lines(self)
    }

    noalloc method &self.bytes_iter(): ViewIter<u8> {
        return ViewIter.from_view(bytes_from_str(self))
    }
}
