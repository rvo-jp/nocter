//! Construction for the compiler built-in failure payload.
//!
//! Error codes are open UTF-8 strings. Standard-library and user-library code
//! use dotted codes such as "std.io.not_found" or "app.config.missing_key".

see ./construction.nct

construct error {
    pub func new(code: &str, message: &str): Self
}

instance error {
    pub method self.context(message: &str): Self

    pub method &self.code(): &str from self

    pub method &self.message(): &str from self

    pub method &self.has_code(code: &str): bool
}
