instance TlsStream {
    async method &+self.read_async(buffer: &+[u8]): usize! {
        match await self.connection.read_async(buffer) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    async method &+self.read_async_with_timeout(
        buffer: &+[u8],
        timeout: Duration,
    ): usize! {
        match await self.connection.read_async_with_timeout(buffer, timeout) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    async method &+self.write_async(bytes: &[u8]): void! {
        match await self.connection.write_async(bytes) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    async method &+self.write_async_with_timeout(
        bytes: &[u8],
        timeout: Duration,
    ): void! {
        match await self.connection.write_async_with_timeout(bytes, timeout) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }
}
