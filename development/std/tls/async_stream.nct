//! Asynchronous TLS establishment and transfer over the common provider event channel.

see ./index.nct
see ./stream.nct

use /internal/net as substrate
use /internal/net.{
    StreamConnectionAttempt,
    TransferAttempt,
    UnitAttempt,
}
use /internal/ptr
use /net as net
use /ptr as public_ptr
use /string.String
use /time.Duration
use /vec.Vec

async func connect_endpoint_async(
    endpoint: net.HostEndpoint,
    application_protocol: String,
    trust_anchor: Vec<u8>,
    timeout: Duration?,
): TlsStream! {
    let owned_endpoint = move endpoint
    var owned_application_protocol = move application_protocol
    var owned_trust_anchor = move trust_anchor
    var deadline = substrate.connection_deadline(timeout)
    let application_protocol_pointer: *u8 = if owned_application_protocol.len() == 0 {
        ptr.from_addr(0)
    } else {
        owned_application_protocol.ptr()
    }
    let trust_anchor_pointer: *u8 = if owned_trust_anchor.len() == 0 {
        ptr.from_addr(0)
    } else {
        public_ptr.from_ref(&owned_trust_anchor[0])
    }
    match await substrate.connect_tls_host_stream_async_before(
        owned_endpoint.nul_host(),
        owned_endpoint.nul_service(),
        owned_endpoint.nul_host(),
        application_protocol_pointer,
        trust_anchor_pointer,
        owned_trust_anchor.len(),
        &+deadline,
    ) {
        StreamConnectionAttempt.ready(connection) {
            return TlsStream { connection: move connection }
        }
        StreamConnectionAttempt.failed(failure) {
            return net.network_error(move failure)
        }
    }
}

func begin_connect_async(
    host: &str,
    port: u16,
    application_protocol: String,
    trust_anchor: Vec<u8>,
    timeout: Duration?,
): (future TlsStream!)! {
    let endpoint = net.host_endpoint(host, port)?
    return connect_endpoint_async(
        move endpoint,
        move application_protocol,
        move trust_anchor,
        timeout,
    )
}

func connect_async(host: &str, port: u16): (future TlsStream!)! {
    return begin_connect_async(
        host,
        port,
        String.empty(),
        Vec.empty(),
        none,
    )
}

func connect_async_with_timeout(
    host: &str,
    port: u16,
    timeout: Duration,
): (future TlsStream!)! {
    return begin_connect_async(
        host,
        port,
        String.empty(),
        Vec.empty(),
        timeout,
    )
}

func connect_async_with_trust_anchor(
    host: &str,
    port: u16,
    trust_anchor: &TrustAnchor,
): (future TlsStream!)! {
    return begin_connect_async(
        host,
        port,
        String.empty(),
        Vec.from_slice(trust_anchor.bytes()),
        none,
    )
}

func connect_async_with_trust_anchor_and_timeout(
    host: &str,
    port: u16,
    trust_anchor: &TrustAnchor,
    timeout: Duration,
): (future TlsStream!)! {
    return begin_connect_async(
        host,
        port,
        String.empty(),
        Vec.from_slice(trust_anchor.bytes()),
        timeout,
    )
}

func connect_http1_async(host: &str, port: u16): (future TlsStream!)! {
    let application_protocol = http1_application_protocol()
    return begin_connect_async(
        host,
        port,
        move application_protocol,
        Vec.empty(),
        none,
    )
}

func connect_http1_async_with_timeout(
    host: &str,
    port: u16,
    timeout: Duration,
): (future TlsStream!)! {
    let application_protocol = http1_application_protocol()
    return begin_connect_async(
