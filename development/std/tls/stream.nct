//! Synchronous authenticated TLS ownership over the common provider stream policy.

see ./index.nct

use /internal/net as substrate
use /internal/net.{
    AddressAttempt,
    NetworkShutdown,
    StreamConnection,
    StreamConnectionAttempt,
    TransferAttempt,
    UnitAttempt,
}
use /internal/ptr
use /io.{Reader, Writer}
use /net as net
use /net.{SocketAddress, TcpShutdown}
use /string.String
use /time.Duration

struct TlsStream {
    connection: StreamConnection
}

func connect_candidates(
    host: &str,
    addresses: &[SocketAddress],
    timeout: Duration?,
): TlsStream! {
    var server_name = String.copy(host)
    server_name.push('\u{0}')
    let server_text: &str = &server_name
    let no_application_protocol: *u8 = ptr.from_addr(0)
    var deadline = substrate.connection_deadline(timeout)
    var offset: usize = 0
    var last_failure = error.new("std.net.no_addresses", "host has no connection candidates")
    while offset < addresses.len() {
        let address = addresses[offset]
        match substrate.connect_tls_stream_before(
            net.substrate_address(&address),
            server_text.ptr(),
            no_application_protocol,
            &+deadline,
        ) {
            StreamConnectionAttempt.ready(connection) {
                return TlsStream { connection: move connection }
            }
            StreamConnectionAttempt.failed(failure) {
                last_failure = net.network_error(move failure)
            }
        }
        offset += 1
    }
    return last_failure.context("every resolved address failed TLS authentication")
}

construct TlsStream {
    func connect(host: &str, port: u16): Self! {
        let addresses = net.resolve(host, port)?
        return connect_candidates(host, &addresses, none)
    }

    func connect_with_timeout(host: &str, port: u16, timeout: Duration): Self! {
        let addresses = net.resolve(host, port)?
        return connect_candidates(host, &addresses, timeout)
    }
}

instance TlsStream {
    noalloc method &+self.read(buffer: &+[u8]): usize! {
        match self.connection.read(buffer) {
            TransferAttempt.ready(count) { return count }
            TransferAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    noalloc method &+self.write(bytes: &[u8]): void! {
        match self.connection.write(bytes) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    noalloc method &self.local_address(): SocketAddress! {
        match self.connection.local_address() {
            AddressAttempt.ready(address) { return net.public_address(address) }
            AddressAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    noalloc method &self.peer_address(): SocketAddress! {
        match self.connection.peer_address() {
            AddressAttempt.ready(address) { return net.public_address(address) }
            AddressAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    noalloc method &+self.set_read_timeout(timeout: Duration?): void {
        self.connection.set_read_timeout(timeout)
        return
    }

    noalloc method &self.read_timeout(): Duration? {
        return self.connection.read_timeout()
    }

    noalloc method &+self.set_write_timeout(timeout: Duration?): void {
        self.connection.set_write_timeout(timeout)
        return
    }

    noalloc method &self.write_timeout(): Duration? {
        return self.connection.write_timeout()
    }

    noalloc method &+self.shutdown(direction: TcpShutdown): void! {
        let selected = match direction {
            TcpShutdown.read { NetworkShutdown.read }
            TcpShutdown.write { NetworkShutdown.write }
            TcpShutdown.both { NetworkShutdown.both }
        }
        match self.connection.shutdown(selected) {
            UnitAttempt.ready { return }
            UnitAttempt.failed(failure) { return net.network_error(move failure) }
        }
    }

    noalloc method &+self.close(): void {
        self.connection.close()
        return
    }
}

noalloc drop TlsStream(&+self) {
    self.connection.close()
    return
}
