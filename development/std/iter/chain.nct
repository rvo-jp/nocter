//! Sequential composition of two owning iterators.

use std/iter.{ExactSizeIterator, Iterator}

/// Yields every left item before every right item.
pub struct ChainIter<T, L, R> {
    left: L
    right: R
    in_left: bool
}

/// Constructs an owning sequential adapter.
pub func chain<T, L: Iterator<T>, R: Iterator<T>>(
    left: L,
    right: R,
): ChainIter<T, L, R> {
    return ChainIter<T, L, R> {
        left: move left,
        right: move right,
        in_left: true,
    }
}

impl<T, L: Iterator<T>, R: Iterator<T>> ChainIter<T, L, R> {
    /// Advances the left iterator to exhaustion, then advances the right.
    pub method &+self.next(): T? {
        while self.in_left {
            let item = self.left.next() otherwise {
                self.in_left = false
                continue
            }
            return move item
        }
        return self.right.next() otherwise { return none }
    }
}

impl<T, L: ExactSizeIterator<T>, R: ExactSizeIterator<T>> ChainIter<T, L, R> {
    /// Returns the checked sum of both exact remainders.
    pub method &self.remaining_len(): usize {
        return self.left.remaining_len() + self.right.remaining_len()
    }
}

impl<T, L: Iterator<T>, R: Iterator<T>> Iterator<T> for ChainIter<T, L, R>
impl<T, L: ExactSizeIterator<T>, R: ExactSizeIterator<T>> ExactSizeIterator<T> for ChainIter<T, L, R>
