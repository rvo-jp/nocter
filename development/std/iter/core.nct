//! Iterator adapter implementations.

/// Constructs a lazy mapping adapter without allocating.
func map<U, I: Iterator, F: &+func(I.Item): U>(
    source: I,
    transform: F,
): MapIter<U, I, F> from source | transform {
    return MapIter<U, I, F> {
        source: move source,
        transform: move transform,
    }
}

impl<U, I: Iterator, F: &+func(I.Item): U> Iterator for MapIter<U, I, F> {
    type Item = U

    /// Advances the source once and transforms the yielded item once.
    method &+self.next(): U? {
        let item = self.source.next()?
        return self.transform(move item)
    }
}

impl<U, I: Iterator + ExactSizeIterator, F: &+func(I.Item): U> ExactSizeIterator for MapIter<U, I, F> {
    /// Mapping preserves the source iterator's exact cardinality.
    method &self.remaining_len(): usize {
        return self.source.remaining_len()
    }
}

/// Constructs a lazy filtering adapter without allocating.
func filter<I: Iterator, F: &+func(&I.Item): bool>(
    source: I,
    predicate: F,
): FilterIter<I, F> from source | predicate {
    return FilterIter<I, F> {
        source: move source,
        predicate: move predicate,
    }
}

impl<I: Iterator, F: &+func(&I.Item): bool> Iterator for FilterIter<I, F> {
    type Item = I.Item

    /// Advances until the predicate accepts an item or the source is exhausted.
    method &+self.next(): I.Item? {
        while true {
            let item = self.source.next()?
            if self.predicate(&item) {
                return move item
            }
        }
        return none
    }
}

/// Constructs an owning prefix-limiting adapter.
func take<I: Iterator>(source: I, limit: usize): TakeIter<I> {
    return TakeIter<I> {
        source: move source,
        remaining: limit,
    }
}

impl<I: Iterator> Iterator for TakeIter<I> {
    type Item = I.Item

    method &+self.next(): I.Item? {
        if self.remaining == 0 {
            return none
        }
        let item = self.source.next() otherwise {
            self.remaining = 0
            return none
        }
        self.remaining = self.remaining - 1
        return move item
    }
}

impl<I: Iterator + ExactSizeIterator> ExactSizeIterator for TakeIter<I> {
    method &self.remaining_len(): usize {
        let source_remaining: usize = self.source.remaining_len()
        if source_remaining < self.remaining {
            return source_remaining
        }
        return self.remaining
    }
}

/// Constructs an owning prefix-skipping adapter.
func skip<I: Iterator>(source: I, amount: usize): SkipIter<I> {
    return SkipIter<I> {
        source: move source,
        remaining_to_skip: amount,
    }
}

impl<I: Iterator> Iterator for SkipIter<I> {
    type Item = I.Item

    method &+self.next(): I.Item? {
        while self.remaining_to_skip != 0 {
            let skipped = self.source.next() otherwise {
                self.remaining_to_skip = 0
                return none
            }
            self.remaining_to_skip = self.remaining_to_skip - 1
        }
        return self.source.next()?
    }
}

impl<I: Iterator + ExactSizeIterator> ExactSizeIterator for SkipIter<I> {
    method &self.remaining_len(): usize {
        let source_remaining: usize = self.source.remaining_len()
        if source_remaining <= self.remaining_to_skip {
            return 0
        }
        return source_remaining - self.remaining_to_skip
    }
}

/// Constructs an owning sequential adapter.
func chain<L: Iterator, R: Iterator>(
    left: L,
    right: R,
): ChainIter<L, R> from left | right where R.Item = L.Item {
    return ChainIter<L, R> {
        left: move left,
        right: move right,
        in_left: true,
    }
}

impl<L: Iterator, R: Iterator> Iterator for ChainIter<L, R> where R.Item = L.Item {
    type Item = L.Item

    method &+self.next(): L.Item? {
        while self.in_left {
            let item = self.left.next() otherwise {
                self.in_left = false
                continue
            }
            return move item
        }
        return self.right.next()?
    }
}

impl<L: Iterator + ExactSizeIterator, R: Iterator + ExactSizeIterator> ExactSizeIterator for ChainIter<L, R> where R.Item = L.Item {
    method &self.remaining_len(): usize {
        return self.left.remaining_len() + self.right.remaining_len()
    }
}

/// Constructs an indexed owning adapter.
func enumerate<I: Iterator>(source: I): EnumerateIter<I> {
    return EnumerateIter<I> {
        source: move source,
        next_index: 0,
    }
}

impl<I: Iterator> Iterator for EnumerateIter<I> {
    type Item = Indexed<I.Item>

    method &+self.next(): Indexed<I.Item>? {
        let item = self.source.next()?
        let index: usize = self.next_index
        self.next_index = index + 1
        return Indexed<I.Item> {
            index: index,
            item: move item,
        }
    }
}

impl<I: Iterator + ExactSizeIterator> ExactSizeIterator for EnumerateIter<I> {
    method &self.remaining_len(): usize {
        return self.source.remaining_len()
    }
}
