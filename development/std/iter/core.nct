//! Iterator adapter implementations.

conform Iterator for MapIter<U, I, F> where I: Iterator, F: &+func(item: I.Item): U {
    type Item = U

    /// Advances the source once and transforms the yielded item once.
    method &+self.next(): U? {
        let item = self.source.next()?
        return self.transform(move item)
    }
}

conform ExactSizeIterator for MapIter<U, I, F> where I: Iterator + ExactSizeIterator, F: &+func(item: I.Item): U {
    /// Mapping preserves the source iterator's exact cardinality.
    method &self.remaining_len(): usize {
        return self.source.remaining_len()
    }
}

conform Iterator for FilterIter<I, F> where I: Iterator, F: &+func(&I.Item): bool {
    type Item = I.Item

    /// Advances until the predicate accepts an item or the source is exhausted.
    method &+self.next(): I.Item? {
        while true {
            let item = self.source.next()?
            if self.predicate(&item) {
                return move item
            }
        }
        return none
    }
}

conform Iterator for TakeIter<I> where I: Iterator {
    type Item = I.Item

    method &+self.next(): I.Item? {
        if self.remaining == 0 {
            return none
        }
        let item = self.source.next() otherwise {
            self.remaining = 0
            return none
        }
        self.remaining = self.remaining - 1
        return move item
    }
}

conform ExactSizeIterator for TakeIter<I> where I: Iterator + ExactSizeIterator {
    method &self.remaining_len(): usize {
        let source_remaining: usize = self.source.remaining_len()
        if source_remaining < self.remaining {
            return source_remaining
        }
        return self.remaining
    }
}

conform Iterator for SkipIter<I> where I: Iterator {
    type Item = I.Item

    method &+self.next(): I.Item? {
        while self.remaining_to_skip != 0 {
            let skipped = self.source.next() otherwise {
                self.remaining_to_skip = 0
                return none
            }
            self.remaining_to_skip = self.remaining_to_skip - 1
        }
        return self.source.next()?
    }
}

conform ExactSizeIterator for SkipIter<I> where I: Iterator + ExactSizeIterator {
    method &self.remaining_len(): usize {
        let source_remaining: usize = self.source.remaining_len()
        if source_remaining <= self.remaining_to_skip {
            return 0
        }
        return source_remaining - self.remaining_to_skip
    }
}

conform Iterator for ChainIter<L, R> where L: Iterator, R: Iterator, R.Item = L.Item {
    type Item = L.Item

    method &+self.next(): L.Item? {
        while self.in_left {
            let item = self.left.next() otherwise {
                self.in_left = false
                continue
            }
            return move item
        }
        return self.right.next()?
    }
}

conform ExactSizeIterator for ChainIter<L, R> where L: Iterator + ExactSizeIterator, R: Iterator + ExactSizeIterator, R.Item = L.Item {
    method &self.remaining_len(): usize {
        return self.left.remaining_len() + self.right.remaining_len()
    }
}

conform Iterator for EnumerateIter<I> where I: Iterator {
    type Item = Indexed<I.Item>

    method &+self.next(): Indexed<I.Item>? {
        let item = self.source.next()?
        let index: usize = self.next_index
        self.next_index = index + 1
        return Indexed<I.Item> {
            index: index,
            item: move item,
        }
    }
}

conform ExactSizeIterator for EnumerateIter<I> where I: Iterator + ExactSizeIterator {
    method &self.remaining_len(): usize {
        return self.source.remaining_len()
    }
}
