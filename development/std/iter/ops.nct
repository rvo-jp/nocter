//! Consuming terminal iterator operations.

func count<I>(source: I): usize where I: Iterator {
    var iterator = move source
    var total: usize = 0
    while true {
        let item = iterator.next() otherwise { return total }
        total = total + 1
    }
    return 0
}

func last<I>(source: I): I.Item? from source where I: Iterator {
    var iterator = move source
    var result: I.Item? = none
    while true {
        let item = iterator.next() otherwise { return move result }
        result = move item
    }
    return none
}
