//! Zero- and one-element owning iterators.

use /ptr.from_ref_mut
use /internal/ptr.{store_value_to_ptr, take_value_at_ptr}

/// Constructs an empty iterator.
func empty<T>(): EmptyIter<T> {
    return EmptyIter<T> {}
}

instance EmptyIter<T> {
    /// Returns zero because no item can be yielded.
    method &self.remaining_len(): usize {
        return 0
    }

    /// Returns `none` for every call.
    method &+self.next(): T? {
        return none
    }
}

/// Constructs an iterator that yields `item` once.
func once<T>(item: T): OnceIter<T> {
    return OnceIter<T> {
        item: move item,
        remaining: 1,
    }
}

instance OnceIter<T> {
    /// Returns one while the item remains and zero after it is yielded.
    method &self.remaining_len(): usize {
        return self.remaining
    }

    /// Transfers the owned item once, then returns `none`.
    method &+self.next(): T? {
        if self.remaining == 0 {
            return none
        }
        let empty_value: T? = none
        let pointer = from_ref_mut(&+self.item)
        let previous: T? = take_value_at_ptr(pointer, 0)
        store_value_to_ptr(pointer, 0, move empty_value)
        self.remaining = 0
        let item = move previous?
        return move item
    }
}
