//! Stable zero-based indexing of an owning iterator.

use std/iter.{ExactSizeIterator, Iterator}

/// One indexed item yielded by `EnumerateIter`.
pub struct Indexed<T> {
    pub index: usize
    pub item: T
}

/// An owning iterator that pairs every item with its zero-based index.
pub struct EnumerateIter<T, I> {
    source: I
    next_index: usize
}

/// Constructs an indexed owning adapter.
pub func enumerate<T, I: Iterator<T>>(source: I): EnumerateIter<T, I> {
    return EnumerateIter<T, I> {
        source: move source,
        next_index: 0,
    }
}

impl<T, I: Iterator<T>> EnumerateIter<T, I> {
    /// Transfers the next item with the current index.
    pub method &+self.next(): Indexed<T>? {
        let item = self.source.next() otherwise { return none }
        let index: usize = self.next_index
        self.next_index = index + 1
        return Indexed<T> {
            index: index,
            item: move item,
        }
    }
}

impl<T, I: ExactSizeIterator<T>> EnumerateIter<T, I> {
    /// Preserves the source iterator's exact remaining count.
    pub method &self.remaining_len(): usize {
        return self.source.remaining_len()
    }
}

impl<T, I: Iterator<T>> Iterator<Indexed<T>> for EnumerateIter<T, I>
impl<T, I: ExactSizeIterator<T>> ExactSizeIterator<Indexed<T>> for EnumerateIter<T, I>
