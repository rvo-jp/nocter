//! Stateful, incremental HTTP/1.1 response-head decoding.

see ./body.nct
see ./errors.nct
see ./field_codec.nct
see ./index.nct
see ./storage.nct
see ./values.nct
see ./wire.nct

use /vec.Vec

enum ResponseHeadPhase {
    status
    fields(status: Status)
}

struct ResponseHeadState {
    phase: ResponseHeadPhase
    field_block: FieldBlockState
    informational_count: usize
}

struct ResponseHeadDecoder {
    input: Vec<u8>
    state: ResponseHeadState
}

enum ResponseHeadAttempt {
    incomplete(decoder: ResponseHeadDecoder)
    informational(status: Status, decoder: ResponseHeadDecoder)
    ready(parsed: ParsedResponseHead)
    failed(failure: error)
}

struct ParsedResponseHead {
    head: ResponseHead
    decoder: BodyDecoder
    pending: Vec<u8>
    consumed: usize
}

noalloc func response_head_decoder(limits: Limits): ResponseHeadDecoder {
    return ResponseHeadDecoder {
        input: Vec.empty(),
        state: ResponseHeadState {
            phase: ResponseHeadPhase.status,
            field_block: field_block_state(0, 0, limits),
            informational_count: 0,
        },
    }
}

func append_response_head_input_range(
    decoder: &+ResponseHeadDecoder,
    input: &[u8],
    start: usize,
    end: usize,
): void! {
    if start > end || end > input.len() { return invalid_syntax() }
    var offset = start
    while offset < end {
        decoder.input.push(input[offset])
        offset += 1
    }
    return
}

noalloc func status_from_line(input: &[u8], start: usize, end: usize): Status! {
    if end - start < 13
        || input[start] != 72
        || input[start + 1] != 84
        || input[start + 2] != 84
        || input[start + 3] != 80
        || input[start + 4] != 47
        || input[start + 5] != 49
        || input[start + 6] != 46
        || input[start + 7] != 49
        || input[start + 8] != 32
        || input[start + 9] < 48
        || input[start + 9] > 57
        || input[start + 10] < 48
        || input[start + 10] > 57
        || input[start + 11] < 48
        || input[start + 11] > 57
        || input[start + 12] != 32 {
        return invalid_syntax()
    }
    var reason_offset = start + 13
    while reason_offset < end {
        if !valid_header_value_byte(input[reason_offset]) { return invalid_syntax() }
        reason_offset += 1
    }
    let code = ((input[start + 9] - 48) as u16) * 100
        + ((input[start + 10] - 48) as u16) * 10
        + ((input[start + 11] - 48) as u16)
    return Status.new(code)?
}

noalloc func selected_body_framing(
    decoder: &ResponseHeadState,
    request_method: &Method,
    status: Status,
): BodyFraming! {
    return response_body_framing(
        &decoder.field_block.fields,
        request_method,
        status,
        decoder.field_block.limits,
    )?
}

func advance_response_head(
    decoder: ResponseHeadDecoder,
    request_method: &Method,
): ResponseHeadAttempt {
    var owner = move decoder
    let input: &[u8] = &owner.input
    loop {
        match owner.state.phase {
            ResponseHeadPhase.status {
                let line_end = match advance_line(
                    input,
                    owner.state.field_block.line_start,
                    owner.state.field_block.scan_offset,
                    owner.state.field_block.limits.start_line_bytes,
                ) {
                    LineAdvance.incomplete(next) {
                        owner.state.field_block.scan_offset = next
                        return ResponseHeadAttempt.incomplete(move owner)
                    }
                    LineAdvance.ready(end) { end }
                    LineAdvance.malformed {
                        return ResponseHeadAttempt.failed(invalid_syntax())
                    }
                    LineAdvance.too_long {
                        return ResponseHeadAttempt.failed(syntax_limit())
                    }
                }
                if line_end + 2 - owner.state.field_block.head_start
                    > owner.state.field_block.limits.header_bytes {
                    return ResponseHeadAttempt.failed(syntax_limit())
                }
                let status = status_from_line(
                    input,
                    owner.state.field_block.line_start,
                    line_end,
                ) catch failure {
                    return ResponseHeadAttempt.failed(move failure)
                }
                owner.state.field_block.line_start = line_end + 2
                owner.state.field_block.scan_offset = owner.state.field_block.line_start
                owner.state.phase = ResponseHeadPhase.fields(status)
            }
            ResponseHeadPhase.fields(status) {
                let consumed = match advance_field_block(&+owner.state.field_block, input) {
                    FieldBlockAttempt.incomplete {
                        return ResponseHeadAttempt.incomplete(move owner)
                    }
                    FieldBlockAttempt.ready(value) { value }
                    FieldBlockAttempt.failed(failure) {
                        return ResponseHeadAttempt.failed(move failure)
                    }
                }
                let framing = selected_body_framing(
                    &owner.state,
                    request_method,
                    status,
                ) catch failure {
                    return ResponseHeadAttempt.failed(move failure)
                }
                if status.is_informational() {
                    if owner.state.informational_count
                        == owner.state.field_block.limits.informational_responses {
                        return ResponseHeadAttempt.failed(syntax_limit())
                    }
                    owner.state.phase = ResponseHeadPhase.status
                    owner.state.field_block = field_block_state(
                        consumed,
                        consumed,
                        owner.state.field_block.limits,
                    )
                    owner.state.informational_count += 1
                    return ResponseHeadAttempt.informational(status, move owner)
                }
                return ResponseHeadAttempt.ready(ParsedResponseHead {
                    head: response_head_from_parts(
                        status,
                        move owner.state.field_block.fields.headers,
                    ),
                    decoder: body_decoder(move framing, owner.state.field_block.limits),
                    pending: move owner.input,
                    consumed: consumed,
                })
            }
        }
    }
}
