//! Shared, allocation-free HTTP/1.1 wire syntax.

see ./values.nct

enum LineScan {
    incomplete
    ready(end: usize)
    malformed
    too_long
}

enum LineAdvance {
    incomplete(next: usize)
    ready(end: usize)
    malformed
    too_long
}

noalloc func advance_line(
    input: &[u8],
    start: usize,
    next: usize,
    limit: usize,
): LineAdvance {
    if start > input.len() || next < start || next > input.len() {
        return LineAdvance.malformed
    }
    var offset = next
    while offset < input.len() {
        if offset - start > limit { return LineAdvance.too_long }
        let value = input[offset]
        if value == 10 { return LineAdvance.malformed }
        if value == 13 {
            if offset + 1 == input.len() { return LineAdvance.incomplete(offset) }
            if input[offset + 1] != 10 { return LineAdvance.malformed }
            return LineAdvance.ready(offset)
        }
        offset += 1
    }
    if input.len() - start > limit { return LineAdvance.too_long }
    return LineAdvance.incomplete(input.len())
}

noalloc func scan_line(input: &[u8], start: usize, limit: usize): LineScan {
    match advance_line(input, start, start, limit) {
        LineAdvance.incomplete(_) { return LineScan.incomplete }
        LineAdvance.ready(end) { return LineScan.ready(end) }
        LineAdvance.malformed { return LineScan.malformed }
        LineAdvance.too_long { return LineScan.too_long }
    }
}

noalloc func range_ascii_equal(
    bytes: &[u8],
    start: usize,
    end: usize,
    expected: &str,
): bool {
    if end - start != expected.len() { return false }
    let expected_bytes = expected.bytes()
    var offset: usize = 0
    while offset < expected_bytes.len() {
        if ascii_lower(bytes[start + offset]) != ascii_lower(expected_bytes[offset]) {
            return false
        }
        offset += 1
    }
    return true
}
