//! Sole ownership layout for HTTP requests, clients, and transport-owning responses.

see ./body.nct
see ./client_transport.nct
see ./index.nct
see ./storage.nct
see ./transport_buffer.nct

use /tls.TrustAnchor
use /url.Url
use /vec.Vec

enum ClientTrust {
    system
    additional(anchor: TrustAnchor)
}

struct Request {
    url_value: Url
    head_value: RequestHead
    body_value: Vec<u8>
}

struct Client {
    limits_value: Limits
    trust: ClientTrust
}

struct Response {
    stream: ClientTransport
    head: ResponseHead
    decoder: BodyDecoder
    pending: Vec<u8>
    pending_start: usize
    scratch: Vec<u8>
    complete: bool
}

noalloc func client_from_limits(limits: Limits): Client {
    return Client { limits_value: limits, trust: ClientTrust.system }
}

func request_from_parts(url: Url, head: RequestHead): Request {
    return Request {
        url_value: move url,
        head_value: move head,
        body_value: Vec.empty(),
    }
}

func response_from_parts(
    stream: ClientTransport,
    head: ResponseHead,
    decoder: BodyDecoder,
    pending: Vec<u8>,
    pending_start: usize,
): Response {
    return Response {
        stream: move stream,
        head: move head,
        decoder: move decoder,
        pending: move pending,
        pending_start: pending_start,
        scratch: initialized_bytes(CLIENT_BUFFER_BYTES),
        complete: false,
    }
}
