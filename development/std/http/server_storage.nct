//! Sole ownership layout for HTTP server listeners and connection states.

see ./body_cursor.nct
see ./index.nct
see ./storage.nct

use /net.{SocketAddress, TcpListener, TcpStream}

struct Server {
    listener: TcpListener
    limits: Limits
}

struct ServerConnection {
    stream: TcpStream
    peer: SocketAddress
    limits: Limits
}

struct IncomingRequest {
    stream: TcpStream
    peer: SocketAddress
    head_value: RequestHead
    body: BodyCursor
    suppress_body: bool
    limits: Limits
}

struct Responder {
    stream: TcpStream
    peer: SocketAddress
    request_body: BodyCursor
    suppress_body: bool
    limits: Limits
}
