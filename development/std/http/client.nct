//! Synchronous request policy and the uniquely owned response lifecycle.

see ./body.nct
see ./body_cursor.nct
see ./client_storage.nct
see ./client_transport.nct
see ./errors.nct
see ./exchange.nct
see ./index.nct
see ./request.nct
see ./response_head.nct
see ./storage.nct
see ./transport_buffer.nct
see ./values.nct

use /time.Duration
use /tls.TrustAnchor
use /url.Url
use /vec.Vec

blocking func read_response_head(
    stream: &+ClientTransport,
    request_method: &Method,
    limits: Limits,
): ReceivedResponseHead! {
    var scratch = initialized_bytes(HTTP_BUFFER_BYTES)
    var decoder = response_head_decoder(limits)
    loop {
        match advance_final_response_head(move decoder, request_method) {
            FinalResponseHeadAttempt.ready(parsed) { return move parsed }
            FinalResponseHeadAttempt.failed(failure) { return move failure }
            FinalResponseHeadAttempt.incomplete(next) {
                decoder = move next
                let received = stream.read_blocking(&+scratch) catch failure {
                    return failure.context("while reading the HTTP response head")
                }
                if received == 0 { return premature_eof() }
                append_response_head_input_range(&+decoder, &scratch, 0, received)?
            }
        }
    }
}

blocking func send_over_transport(
    prepared: PreparedRequest,
    stream: ClientTransport,
): Response! {
    var owned = move prepared
    var connection = move stream
    connection.write_blocking(&owned.encoded) catch failure {
        return failure.context("while writing the HTTP request head")
    }
    if owned.request.body_value.len() != 0 {
        let body: &[u8] = &owned.request.body_value
        connection.write_blocking(body) catch failure {
            return failure.context("while writing the HTTP request body")
        }
    }
    let parsed = read_response_head(
        &+connection,
        owned.request.head_value.request_method(),
        owned.limits,
    )?
    return response_from_parts(
        move connection,
        move parsed.head,
        move parsed.body,
    )
}

construct Request {
    func new(request_method: Method, url: Url): Self! {
        let target = url.request_target()
        let head = RequestHead.new(move request_method, &target)?
        return request_from_parts(move url, move head)
    }
}

instance Request {
    noalloc method &self.url(): &Url from self {
        return &self.url_value
    }

    noalloc method &self.request_method(): &Method from self {
        return self.head_value.request_method()
    }

    noalloc method &self.headers(): &Headers from self {
        return self.head_value.headers()
    }

    noalloc method &self.body(): &[u8] from self {
        let body: &[u8] = &self.body_value
        return body
    }

    method &+self.append_header(header: Header): void {
        self.head_value.append_header(move header)
        return
    }

    method &+self.set_body(body: Vec<u8>): void {
        self.body_value = move body
        return
    }
}

construct Client {
    noalloc func new(): Self {
        return client_from_limits(Limits.standard())
    }

    noalloc func with_limits(limits: Limits): Self {
        return client_from_limits(limits)
    }
}

instance Client {
    method self.with_trust_anchor(trust_anchor: TrustAnchor): Self {
        return Client {
            limits_value: self.limits_value,
            trust: ClientTrust.additional(move trust_anchor),
        }
    }

    blocking method &self.send_blocking(request: Request): Response! {
        let prepared = prepare_request(move request, self.limits_value)?
        let stream = connect_client_transport(
            &prepared.request.url_value,
            &self.trust,
            none,
        ) catch failure {
            return failure.context("while connecting the HTTP request")
        }
        return send_over_transport(move prepared, move stream)?
    }

    blocking method &self.send_with_timeout_blocking(
        request: Request,
        timeout: Duration,
    ): Response! {
        let prepared = prepare_request(move request, self.limits_value)?
        let stream = connect_client_transport(
            &prepared.request.url_value,
            &self.trust,
            timeout,
        ) catch failure {
            return failure.context("while connecting the HTTP request")
        }
        return send_over_transport(move prepared, move stream)?
    }
}

instance Response {
    noalloc method &self.status(): Status {
        return self.head.status()
    }

    noalloc method &self.headers(): &Headers from self {
        return self.head.headers()
    }

    blocking method &+self.read_blocking(output: &+[u8]): usize! {
        if body_cursor_complete(&self.body) || output.len() == 0 { return 0 }
        loop {
            match advance_body_cursor(&+self.body, output, false) {
                BodyCursorAttempt.ready(written) { return written }
                BodyCursorAttempt.complete(written) {
                    self.stream.close()
                    return written
                }
                BodyCursorAttempt.failed(failure) {
                    self.stream.close()
                    return failure.context("while decoding the HTTP response body")
                }
                BodyCursorAttempt.input {
                    let received = self.stream.read_blocking(
                        &+self.body.transport_scratch,
                    ) catch failure {
                        self.stream.close()
                        fail_body_cursor(&+self.body)
                        return failure.context("while reading the HTTP response body")
                    }
                    if received == 0 {
                        match advance_body_cursor(&+self.body, output, true) {
                            BodyCursorAttempt.complete(written) {
                                self.stream.close()
                                return written
                            }
                            BodyCursorAttempt.failed(failure) {
                                self.stream.close()
                                return failure.context("at the end of the HTTP response body")
                            }
                            BodyCursorAttempt.ready(written) {
                                self.stream.close()
                                return written
                            }
                            BodyCursorAttempt.input {
                                self.stream.close()
                                fail_body_cursor(&+self.body)
                                return premature_eof()
                            }
                        }
                    }
                    append_body_cursor_scratch(&+self.body, received)
                }
            }
        }
    }

    noalloc method &+self.close(): void {
        self.stream.close()
        terminate_body_cursor(&+self.body)
        return
    }
}
