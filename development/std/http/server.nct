//! Asynchronous one-request HTTP server lifecycle over public TCP contracts.

see ./body.nct
see ./body_cursor.nct
see ./errors.nct
see ./index.nct
see ./request_head.nct
see ./server_codec.nct
see ./server_storage.nct
see ./server_values.nct
see ./storage.nct
see ./transport_buffer.nct
see ./values.nct

use /net
use /net.SocketAddress
use /task
use /task.Timeout
use /time.Duration

async func read_server_request_head(
    stream: &+net.TcpStream,
    limits: Limits,
): ParsedRequestHead! {
    var scratch = initialized_bytes(HTTP_BUFFER_BYTES)
    var decoder = request_head_decoder(limits)
    loop {
        match advance_request_head(move decoder) {
            RequestHeadAttempt.ready(parsed) { return move parsed }
            RequestHeadAttempt.failed(failure) { return move failure }
            RequestHeadAttempt.incomplete(next) {
                decoder = move next
                let received = await stream.read(&+scratch) catch failure {
                    return failure.context("while reading the HTTP request head")
                }
                if received == 0 { return premature_eof() }
                append_request_head_input_range(&+decoder, &scratch, 0, received)?
            }
        }
    }
}

async func read_server_transport(
    stream: &+net.TcpStream,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    let finite = timeout otherwise { return await stream.read(output)? }
    return await stream.read_with_timeout(output, finite)?
}

async func read_server_request_body(
    request: &+IncomingRequest,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    if body_cursor_complete(&request.body) || output.len() == 0 { return 0 }
    loop {
        match advance_body_cursor(&+request.body, output, false) {
            BodyCursorAttempt.ready(written) { return written }
            BodyCursorAttempt.complete(written) { return written }
            BodyCursorAttempt.failed(failure) {
                request.stream.close()
                return failure.context("while decoding the HTTP request body")
            }
            BodyCursorAttempt.input {
                let received = await read_server_transport(
                    &+request.stream,
                    &+request.body.transport_scratch,
                    timeout,
                ) catch failure {
                    request.stream.close()
                    fail_body_cursor(&+request.body)
                    return failure.context("while reading the HTTP request body")
                }
                if received == 0 {
                    match advance_body_cursor(&+request.body, output, true) {
                        BodyCursorAttempt.complete(written) { return written }
                        BodyCursorAttempt.failed(failure) {
                            request.stream.close()
                            return failure.context("at the end of the HTTP request body")
                        }
                        BodyCursorAttempt.ready(written) { return written }
                        BodyCursorAttempt.input {
                            request.stream.close()
                            fail_body_cursor(&+request.body)
                            return premature_eof()
                        }
                    }
                }
                append_body_cursor_scratch(&+request.body, received)
            }
        }
    }
}

async func finish_server_request(request: IncomingRequest): Responder! {
    var owner = move request
    if !body_cursor_complete(&owner.body) {
        var discard = initialized_bytes(HTTP_BUFFER_BYTES)
        while !body_cursor_complete(&owner.body) {
            let _ = await read_server_request_body(&+owner, &+discard, none)?
        }
    }
    return Responder {
        stream: move owner.stream,
        peer: owner.peer,
        request_body: move owner.body,
        suppress_body: owner.suppress_body,
        limits: owner.limits,
    }
}

construct Server {
    async func bind(address: SocketAddress): Self! {
        return await Server.bind_with_limits(address, Limits.standard())?
    }

    async func bind_with_limits(address: SocketAddress, limits: Limits): Self! {
        let listener = await net.bind_tcp(address)?
        return Server { listener: move listener, limits: limits }
    }
}

async func accept_server(server: &+Server): ServerConnection! {
    let accepted = await server.listener.accept()?
    return ServerConnection {
        stream: move accepted.0,
        peer: accepted.1,
        limits: server.limits,
    }
}

async func read_server_connection(
    connection: ServerConnection,
): IncomingRequest! {
    var owner = move connection
    var parsed = await read_server_request_head(&+owner.stream, owner.limits)?
    let suppress_body = ascii_case_equal(parsed.head.request_method().text(), "HEAD")
    let body = body_cursor(
        move parsed.decoder,
        move parsed.pending,
        parsed.consumed,
    )
    return IncomingRequest {
        stream: move owner.stream,
        peer: owner.peer,
        head_value: move parsed.head,
        body: move body,
        suppress_body: suppress_body,
        limits: owner.limits,
    }
}

async func send_server_response(
    responder: Responder,
    response: OutgoingResponse,
): void! {
    var owner = move responder
    let head = encode_server_response_head(&response, owner.limits)?
    await owner.stream.write(&head) catch failure {
        return failure.context("while writing the HTTP response head")
    }
    if send_response_body(&response, owner.suppress_body) {
        await owner.stream.write(response.body()) catch failure {
            return failure.context("while writing the HTTP response body")
        }
    }
    owner.stream.close()
    return
}

instance Server {
    noalloc method &self.local_address(): SocketAddress! {
        return self.listener.local_address()?
    }

    async method &+self.accept(): ServerConnection! {
        return await accept_server(self)?
    }

    async method &+self.accept_with_timeout(timeout: Duration): ServerConnection! {
        match await task.with_timeout(accept_server(self), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    noalloc method &+self.close(): void {
        self.listener.close()
        return
    }
}

instance ServerConnection {
    noalloc method &self.peer_address(): SocketAddress {
        return self.peer
    }

    async method self.read_request(): IncomingRequest! {
        return await read_server_connection(move self)?
    }

    async method self.read_request_with_timeout(
        timeout: Duration,
    ): IncomingRequest! {
        match await task.with_timeout(read_server_connection(move self), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    noalloc method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}

instance IncomingRequest {
    async method &+self.read(output: &+[u8]): usize! {
        return await read_server_request_body(self, output, none)?
    }

    async method &+self.read_with_timeout(
        output: &+[u8],
        timeout: Duration,
    ): usize! {
        return await read_server_request_body(self, output, timeout)?
    }

    async method self.finish_body(): Responder! {
        return await finish_server_request(move self)?
    }

    async method self.finish_body_with_timeout(timeout: Duration): Responder! {
        match await task.with_timeout(finish_server_request(move self), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}

instance Responder {
    async method self.respond(response: OutgoingResponse): void! {
        return await send_server_response(move self, move response)?
    }

    async method self.respond_with_timeout(
        response: OutgoingResponse,
        timeout: Duration,
    ): void! {
        match await task.with_timeout(send_server_response(move self, move response), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}
