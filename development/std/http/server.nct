//! Asynchronous sequential HTTP server lifecycle over public TCP contracts.

see ./body.nct
see ./body_cursor.nct
see ./connection_input.nct
see ./connection_policy.nct
see ./errors.nct
see ./index.nct
see ./request_head.nct
see ./response_plan.nct
see ./response_writer.nct
see ./server_storage.nct
see ./server_values.nct
see ./storage.nct
see ./transport_buffer.nct
see ./values.nct

use /net
use /net.SocketAddress
use /task
use /task.Timeout
use /time.{Duration, Instant}

async func read_server_transport(
    stream: &+net.TcpStream,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    let finite = timeout otherwise { return await stream.read(output)? }
    return await stream.read_with_timeout(output, finite)?
}

async func read_server_head_transport(
    stream: &+net.TcpStream,
    output: &+[u8],
    started: Instant,
    timeout: Duration?,
): usize! {
    let finite = timeout otherwise { return await stream.read(output)? }
    let elapsed = started.elapsed()
    let remaining: Duration = finite.checked_sub(&elapsed) otherwise {
        return server_operation_timed_out()
    }
    match await task.with_timeout(stream.read(output), remaining) {
        Timeout.completed(result) { return move result? }
        Timeout.elapsed { return server_operation_timed_out() }
    }
}

async func read_server_request_body(
    request: &+IncomingRequest,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    if body_cursor_complete(&request.body) || output.len() == 0 { return 0 }
    loop {
        match advance_body_cursor(&+request.body, output, false) {
            BodyCursorAttempt.ready(written) { return written }
            BodyCursorAttempt.complete(written) { return written }
            BodyCursorAttempt.failed(failure) {
                request.stream.close()
                return failure.context("while decoding the HTTP request body")
            }
            BodyCursorAttempt.input {
                let received = await read_server_transport(
                    &+request.stream,
                    &+request.body.transport_scratch,
                    timeout,
                ) catch failure {
                    request.stream.close()
                    fail_body_cursor(&+request.body)
                    return failure.context("while reading the HTTP request body")
                }
                if received == 0 {
                    match advance_body_cursor(&+request.body, output, true) {
                        BodyCursorAttempt.complete(written) { return written }
                        BodyCursorAttempt.failed(failure) {
                            request.stream.close()
                            return failure.context("at the end of the HTTP request body")
                        }
                        BodyCursorAttempt.ready(written) { return written }
                        BodyCursorAttempt.input {
                            request.stream.close()
                            fail_body_cursor(&+request.body)
                            return premature_eof()
                        }
                    }
                }
                append_body_cursor_scratch(&+request.body, received)
            }
        }
    }
}

async func finish_server_request(request: IncomingRequest): Responder! {
    var owner = move request
    if !body_cursor_complete(&owner.body) {
        var discard = initialized_bytes(HTTP_BUFFER_BYTES)
        while !body_cursor_complete(&owner.body) {
            let _ = await read_server_request_body(&+owner, &+discard, none)?
        }
    }
    return Responder {
        stream: move owner.stream,
        peer: owner.peer,
        request_body: move owner.body,
        suppress_body: owner.suppress_body,
        disposition: owner.disposition,
        limits: owner.limits,
    }
}

construct Server {
    async func bind(address: SocketAddress): Self! {
        return await Server.bind_with_limits(address, Limits.standard())?
    }

    async func bind_with_limits(address: SocketAddress, limits: Limits): Self! {
        let listener = await net.bind_tcp(address)?
        return Server { listener: move listener, limits: limits }
    }
}

async func accept_server(server: &+Server): ServerConnection! {
    let accepted = await server.listener.accept()?
    return server_connection_from_transport(move accepted, server.limits)
}

async func accept_server_with_timeout(
    server: &+Server,
    timeout: Duration,
): ServerConnection! {
    let accepted = await server.listener.accept_with_timeout(timeout) catch failure {
        if failure.has_code("std.net.timed_out") {
            return server_operation_timed_out()
        }
        return move failure
    }
    return server_connection_from_transport(move accepted, server.limits)
}

func server_connection_from_transport(
    accepted: (net.TcpStream, SocketAddress),
    limits: Limits,
): ServerConnection {
    var owner = move accepted
    let peer = owner.1
    let stream = move owner.0
    return ServerConnection {
        stream: move stream,
        peer: peer,
        input: empty_connection_input(),
        limits: limits,
    }
}

async func read_server_connection(
    connection: ServerConnection,
    timeout: Duration?,
): IncomingRequest! {
    var owner = move connection
    let peer = owner.peer
    let limits = owner.limits
    let prepared = request_head_decoder_from_connection_input(limits, move owner.input)
    var decoder = move prepared.0
    var transport_scratch = move prepared.1
    let started = Instant.now()
    loop {
        match advance_request_head(move decoder) {
            RequestHeadAttempt.incomplete(next) {
                decoder = move next
                let received = await read_server_head_transport(
                    &+owner.stream,
                    &+transport_scratch,
                    started,
                    timeout,
                )
                    catch failure {
                        owner.stream.close()
                        return failure.context("while reading the HTTP request head")
                    }
                if received == 0 {
                    owner.stream.close()
                    return premature_eof()
                }
                append_request_head_input_range(
                    &+decoder,
                    &transport_scratch,
                    0,
                    received,
                )?
            }
            RequestHeadAttempt.failed(failure) {
                owner.stream.close()
                return move failure
            }
            RequestHeadAttempt.ready(parsed) {
                let request = body_cursor_from_connection_input(
                    move parsed,
                    move transport_scratch,
                )
                let suppress_body = ascii_case_equal(
                    request.0.request_method().text(),
                    "HEAD",
                )
                return IncomingRequest {
                    stream: move owner.stream,
                    peer: peer,
                    head_value: move request.0,
                    body: move request.1,
                    suppress_body: suppress_body,
                    disposition: request.2,
                    limits: limits,
                }
            }
        }
    }
}

async func send_server_response(
    responder: Responder,
    response: OutgoingResponse,
): ServerConnection?! {
    var owned_response = move response
    let body = move owned_response.body_value
    var writer = await begin_response_writer(
        move responder,
        move owned_response.head_value,
        ResponseFraming.fixed(body.len()),
    )?
    await writer.write(&body)?
    return await writer.finish()?
}

instance Server {
    noalloc method &self.local_address(): SocketAddress! {
        return self.listener.local_address()?
    }

    async method &+self.accept(): ServerConnection! {
        return await accept_server(self)?
    }

    async method &+self.accept_with_timeout(timeout: Duration): ServerConnection! {
        return await accept_server_with_timeout(self, timeout)?
    }

    noalloc method &+self.close(): void {
        self.listener.close()
        return
    }
}

instance ServerConnection {
    noalloc method &self.peer_address(): SocketAddress {
        return self.peer
    }

    async method self.read_request(): IncomingRequest! {
        return await read_server_connection(move self, none)?
    }

    async method self.read_request_with_timeout(
        timeout: Duration,
    ): IncomingRequest! {
        return await read_server_connection(move self, timeout)?
    }

    method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}

instance IncomingRequest {
    async method &+self.read(output: &+[u8]): usize! {
        return await read_server_request_body(self, output, none)?
    }

    async method &+self.read_with_timeout(
        output: &+[u8],
        timeout: Duration,
    ): usize! {
        return await read_server_request_body(self, output, timeout)?
    }

    async method self.finish_body(): Responder! {
        return await finish_server_request(move self)?
    }

    async method self.finish_body_with_timeout(timeout: Duration): Responder! {
        match await task.with_timeout(finish_server_request(move self), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}

instance Responder {
    noalloc method &+self.close_after_response(): void {
        self.disposition = ConnectionDisposition.close
        return
    }

    async method self.begin_fixed(
        head: ResponseHead,
        content_length: usize,
    ): ResponseWriter! {
        return await begin_response_writer(
            move self,
            move head,
            ResponseFraming.fixed(content_length),
        )?
    }

    async method self.begin_fixed_with_timeout(
        head: ResponseHead,
        content_length: usize,
        timeout: Duration,
    ): ResponseWriter! {
        match await task.with_timeout(
            begin_response_writer(
                move self,
                move head,
                ResponseFraming.fixed(content_length),
            ),
            timeout,
        ) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    async method self.begin_chunked(head: ResponseHead): ResponseWriter! {
        return await begin_response_writer(
            move self,
            move head,
            ResponseFraming.chunked,
        )?
    }

    async method self.begin_chunked_with_timeout(
        head: ResponseHead,
        timeout: Duration,
    ): ResponseWriter! {
        match await task.with_timeout(
            begin_response_writer(move self, move head, ResponseFraming.chunked),
            timeout,
        ) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    async method self.respond(response: OutgoingResponse): ServerConnection?! {
        return await send_server_response(move self, move response)?
    }

    async method self.respond_with_timeout(
        response: OutgoingResponse,
        timeout: Duration,
    ): ServerConnection?! {
        match await task.with_timeout(send_server_response(move self, move response), timeout) {
            Timeout.completed(result) { return move result? }
            Timeout.elapsed { return server_operation_timed_out() }
        }
    }

    method self.close(): void {
        var owner = move self
        owner.stream.close()
        return
    }
}
