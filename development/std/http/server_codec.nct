//! Bounded HTTP/1.1 server response-head encoding.

see ./encoding.nct
see ./errors.nct
see ./index.nct
see ./storage.nct

use /vec.Vec

noalloc func status_forbids_body(status: Status): bool {
    return status.code() == 204 || status.code() == 205 || status.code() == 304
}

noalloc func status_omits_content_length(status: Status): bool {
    return status.code() == 204 || status.code() == 304
}

func encode_server_response_head(
    response: &OutgoingResponse,
    limits: Limits,
): Vec<u8>! {
    let body_length = response.body().len()
    if body_length > limits.body_bytes { return body_limit() }
    if status_forbids_body(response.status()) && body_length != 0 {
        return invalid_response_body()
    }
    let omit_length = status_omits_content_length(response.status())
    let connection_bytes: usize = 17
    var generated_count: usize = 1
    var generated_section_bytes = connection_bytes + 2
    if !omit_length {
        let length_bytes = content_length_field_bytes(body_length)
        if length_bytes > limits.field_bytes { return syntax_limit() }
        generated_count += 1
        generated_section_bytes += length_bytes + 2
    }
    if connection_bytes > limits.field_bytes { return syntax_limit() }
    let start_line_bytes: usize = 13
    let estimate = checked_head_capacity(
        start_line_bytes,
        response.headers(),
        generated_count,
        generated_section_bytes,
        limits,
        ReservedFieldPolicy.server_response,
    )?
    var output: Vec<u8> = Vec.with_capacity(estimate)
    append_text(&+output, "HTTP/1.1 ")
    append_decimal(&+output, response.status().code() as usize)
    append_text(&+output, " \r\n")
    append_fields(&+output, response.headers())?
    if !omit_length { append_content_length(&+output, body_length) }
    append_connection_close(&+output)
    append_text(&+output, "\r\n")
    return move output
}

noalloc func send_response_body(response: &OutgoingResponse, suppress_body: bool): bool {
    return !suppress_body && !status_forbids_body(response.status()) && response.body().len() != 0
}
