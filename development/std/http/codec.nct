//! Shared HTTP/1.1 response-field and body-framing rules.

see ./index.nct
see ./values.nct
see ./wire.nct

enum DecimalList {
    valid(value: usize)
    invalid
}

noalloc func parse_decimal_list(bytes: &[u8]): DecimalList {
    var offset: usize = 0
    var selected: usize = 0
    var has_selected = false
    loop {
        while offset < bytes.len() && (bytes[offset] == 32 || bytes[offset] == 9) { offset += 1 }
        if offset == bytes.len() { return DecimalList.invalid }
        var value: usize = 0
        var digits: usize = 0
        while offset < bytes.len() && bytes[offset] >= 48 && bytes[offset] <= 57 {
            let digit = (bytes[offset] - 48) as usize
            if value > (18446744073709551615 - digit) / 10 { return DecimalList.invalid }
            value = value * 10 + digit
            digits += 1
            offset += 1
        }
        if digits == 0 { return DecimalList.invalid }
        while offset < bytes.len() && (bytes[offset] == 32 || bytes[offset] == 9) { offset += 1 }
        if has_selected && selected != value { return DecimalList.invalid }
        selected = value
        has_selected = true
        if offset == bytes.len() { return DecimalList.valid(selected) }
        if bytes[offset] != 44 { return DecimalList.invalid }
        offset += 1
    }
}

noalloc func transfer_coding_kind(bytes: &[u8]): u8 {
    var offset: usize = 0
    var count: usize = 0
    loop {
        while offset < bytes.len() && (bytes[offset] == 32 || bytes[offset] == 9) { offset += 1 }
        if offset == bytes.len() { return 2 }
        let start = offset
        while offset < bytes.len() && bytes[offset] != 44 {
            if bytes[offset] == 59 { return 1 }
            offset += 1
        }
        var end = offset
        while end > start && (bytes[end - 1] == 32 || bytes[end - 1] == 9) { end -= 1 }
        if !range_ascii_equal(bytes, start, end, "chunked") { return 1 }
        count += 1
        if count != 1 { return 2 }
        if offset == bytes.len() { return 0 }
        offset += 1
    }
}

noalloc func bodyless_response(request_method: &Method, status: Status): bool {
    let code = status.code()
    return ascii_case_equal(request_method.text(), "HEAD")
        || (code >= 100 && code < 200)
        || code == 204
        || code == 304
}
