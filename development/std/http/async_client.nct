//! Asynchronous HTTP transport orchestration over the shared exchange state.

see ./client_storage.nct
see ./body_cursor.nct
see ./client_transport.nct
see ./errors.nct
see ./exchange.nct
see ./index.nct
see ./response_head.nct
see ./storage.nct
see ./transport_buffer.nct
see ./values.nct

use /time.Duration

async func read_http_transport_async(
    stream: &+ClientTransport,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    return await stream.read(output, timeout)?
}

async func write_http_transport_async(
    stream: &+ClientTransport,
    bytes: &[u8],
    timeout: Duration?,
): void! {
    await stream.write(bytes, timeout)?
    return
}

async func read_response_head_async(
    stream: &+ClientTransport,
    request_method: &Method,
    limits: Limits,
    timeout: Duration?,
): ReceivedResponseHead! {
    var scratch = initialized_bytes(HTTP_BUFFER_BYTES)
    var decoder = response_head_decoder(limits)
    loop {
        match advance_final_response_head(move decoder, request_method) {
            FinalResponseHeadAttempt.ready(parsed) { return move parsed }
            FinalResponseHeadAttempt.failed(failure) { return move failure }
            FinalResponseHeadAttempt.incomplete(next) {
                decoder = move next
                let received = await read_http_transport_async(
                    stream,
                    &+scratch,
                    timeout,
                ) catch failure {
                    return failure.context("while reading the HTTP response head")
                }
                if received == 0 { return premature_eof() }
                append_response_head_input_range(&+decoder, &scratch, 0, received)?
            }
        }
    }
}

async func send_prepared_request_async(
    prepared: PreparedRequest,
    connection: ClientTransport,
    timeout: Duration?,
): Response! {
    var owned = move prepared
    var stream = move connection
    await write_http_transport_async(&+stream, &owned.encoded, timeout) catch failure {
        return failure.context("while writing the HTTP request head")
    }
    if owned.request.body_value.len() != 0 {
        let body: &[u8] = &owned.request.body_value
        await write_http_transport_async(&+stream, body, timeout) catch failure {
            return failure.context("while writing the HTTP request body")
        }
    }
    let parsed = await read_response_head_async(
        &+stream,
        owned.request.head_value.request_method(),
        owned.limits,
        timeout,
    )?
    return response_from_parts(
        move stream,
        move parsed.head,
        move parsed.body,
    )
}

async func send_request_async(
    limits: Limits,
    trust: &ClientTrust,
    request: Request,
    timeout: Duration?,
): Response! {
    let prepared = prepare_request(move request, limits)?
    let connection = await connect_client_transport_async(
        &prepared.request.url_value,
        trust,
        timeout,
    ) catch failure {
        return failure.context("while resolving the HTTP request host")
    }
    return await send_prepared_request_async(move prepared, move connection, timeout)?
}

async func read_response_body_async(
    response: &+Response,
    output: &+[u8],
    timeout: Duration?,
): usize! {
    if body_cursor_complete(&response.body) || output.len() == 0 { return 0 }
    loop {
        match advance_body_cursor(&+response.body, output, false) {
            BodyCursorAttempt.ready(written) { return written }
            BodyCursorAttempt.complete(written) {
                response.stream.close()
                return written
            }
            BodyCursorAttempt.failed(failure) {
                response.stream.close()
                return failure.context("while decoding the HTTP response body")
            }
            BodyCursorAttempt.input {
                let received = await read_http_transport_async(
                    &+response.stream,
                    &+response.body.transport_scratch,
                    timeout,
                ) catch failure {
                    response.stream.close()
                    fail_body_cursor(&+response.body)
                    return failure.context("while reading the HTTP response body")
                }
                if received == 0 {
                    match advance_body_cursor(&+response.body, output, true) {
                        BodyCursorAttempt.complete(written) {
                            response.stream.close()
                            return written
                        }
                        BodyCursorAttempt.failed(failure) {
                            response.stream.close()
                            return failure.context("at the end of the HTTP response body")
                        }
                        BodyCursorAttempt.ready(written) {
                            response.stream.close()
                            return written
                        }
                        BodyCursorAttempt.input {
                            response.stream.close()
                            fail_body_cursor(&+response.body)
                            return premature_eof()
                        }
                    }
                }
                append_body_cursor_scratch(&+response.body, received)
            }
        }
    }
}

instance Client {
    async method &self.send(request: Request): Response! {
        return await send_request_async(self.limits_value, &self.trust, move request, none)?
    }

    async method &self.send_with_timeout(
        request: Request,
        timeout: Duration,
    ): Response! {
        return await send_request_async(self.limits_value, &self.trust, move request, timeout)?
    }
}

instance Response {
    async method &+self.read(output: &+[u8]): usize! {
        return await read_response_body_async(self, output, none)?
    }

    async method &+self.read_with_timeout(
        output: &+[u8],
        timeout: Duration,
    ): usize! {
        return await read_response_body_async(self, output, timeout)?
    }
}
