//! Asynchronous HTTP transport orchestration over the shared exchange state.

see ./client_storage.nct
see ./errors.nct
see ./exchange.nct
see ./index.nct
see ./response_head.nct
see ./response_progress.nct
see ./storage.nct
see ./values.nct

use /net
use /net.TcpStream

func read_response_head_async(
    stream: &+TcpStream,
    request_method: &Method,
    limits: Limits,
): async ReceivedResponseHead! {
    var scratch = initialized_bytes(CLIENT_BUFFER_BYTES)
    var decoder = response_head_decoder(limits)
    loop {
        match advance_final_response_head(move decoder, request_method) {
            FinalResponseHeadAttempt.ready(parsed) { return move parsed }
            FinalResponseHeadAttempt.failed(failure) { return move failure }
            FinalResponseHeadAttempt.incomplete(next) {
                decoder = move next
                let received = await stream.read_async(&+scratch) catch failure {
                    return failure.context("while reading the HTTP response head")
                }
                if received == 0 { return premature_eof() }
                append_response_head_input_range(&+decoder, &scratch, 0, received)?
            }
        }
    }
}

func send_after_connect(
    prepared: PreparedRequest,
    pending_connection: async TcpStream!,
): async Response! {
    var owned = move prepared
    var connection = await pending_connection catch failure {
        return failure.context("while connecting the HTTP request")
    }
    await connection.write_async(&owned.encoded) catch failure {
        return failure.context("while writing the HTTP request head")
    }
    if owned.request.body_value.len() != 0 {
        let body: &[u8] = &owned.request.body_value
        await connection.write_async(body) catch failure {
            return failure.context("while writing the HTTP request body")
        }
    }
    let parsed = await read_response_head_async(
        &+connection,
        owned.request.head_value.request_method(),
        owned.limits,
    )?
    return response_from_parts(
        move connection,
        move parsed.head,
        move parsed.decoder,
        move parsed.pending,
        parsed.pending_start,
    )
}

instance Client {
    method &self.send_async(request: Request): (async Response!)! {
        let prepared = prepare_request(move request, self.limits_value)?
        let pending_connection = net.connect_host_async(
            prepared.request.url_value.host(),
            prepared.request.url_value.port(),
        ) catch failure {
            return failure.context("while resolving the HTTP request host")
        }
        return send_after_connect(move prepared, move pending_connection)
    }
}

instance Response {
    method &+self.read_async(output: &+[u8]): async usize! {
        if self.complete || output.len() == 0 { return 0 }
        loop {
            match advance_response_body(self, output, false) {
                ResponseBodyAttempt.ready(written) { return written }
                ResponseBodyAttempt.complete(written) {
                    self.stream.close()
                    return written
                }
                ResponseBodyAttempt.failed(failure) {
                    self.stream.close()
                    self.complete = true
                    return failure.context("while decoding the HTTP response body")
                }
                ResponseBodyAttempt.input {
                    let received = await self.stream.read_async(&+self.scratch) catch failure {
                        self.stream.close()
                        self.complete = true
                        return failure.context("while reading the HTTP response body")
                    }
                    if received == 0 {
                        match advance_response_body(self, output, true) {
                            ResponseBodyAttempt.complete(written) {
                                self.stream.close()
                                return written
                            }
                            ResponseBodyAttempt.failed(failure) {
                                self.stream.close()
                                self.complete = true
                                return failure.context("at the end of the HTTP response body")
                            }
                            ResponseBodyAttempt.ready(written) {
                                self.stream.close()
                                return written
                            }
                            ResponseBodyAttempt.input {
                                self.stream.close()
                                self.complete = true
                                return premature_eof()
                            }
                        }
                    }
                    append_prefix(&+self.pending, &self.scratch, received)
                }
            }
        }
    }
}
