//! Sole validation and wire-head planning authority for server responses.

see ./encoding.nct
see ./connection_policy.nct
see ./errors.nct
see ./index.nct
see ./storage.nct

use /vec.Vec

enum ResponseFraming {
    fixed(length: usize)
    chunked
}

enum ResponseOutputState {
    fixed(remaining: usize)
    chunked(written: usize)
    failed
}

struct ResponsePlan {
    head: Vec<u8>
    state: ResponseOutputState
}

noalloc func status_forbids_body(status: Status): bool {
    return status.code() == 204 || status.code() == 205 || status.code() == 304
}

noalloc func status_omits_content_length(status: Status): bool {
    return status.code() == 204 || status.code() == 304
}

func plan_server_response(
    head: &ResponseHead,
    framing: ResponseFraming,
    disposition: ConnectionDisposition,
    limits: Limits,
): ResponsePlan! {
    if head.status().code() < 200 || head.status().code() > 599 {
        return invalid_response_status()
    }
    let connection_bytes: usize = 17
    let close_connection = match disposition {
        ConnectionDisposition.reuse { false }
        ConnectionDisposition.close { true }
    }
    var generated_count: usize = if close_connection { 1 } else { 0 }
    var generated_section_bytes: usize = if close_connection { connection_bytes + 2 } else { 0 }
    let state = match framing {
        ResponseFraming.fixed(length) {
            if length > limits.body_bytes { return body_limit() }
            if status_forbids_body(head.status()) && length != 0 {
                return invalid_response_body()
            }
            if !status_omits_content_length(head.status()) {
                let length_bytes = content_length_field_bytes(length)
                if length_bytes > limits.field_bytes { return syntax_limit() }
                generated_count += 1
                generated_section_bytes += length_bytes + 2
            }
            ResponseOutputState.fixed(length)
        }
        ResponseFraming.chunked {
            if status_forbids_body(head.status()) { return invalid_response_body() }
            let transfer_encoding_bytes: usize = 26
            if transfer_encoding_bytes > limits.field_bytes { return syntax_limit() }
            generated_count += 1
            generated_section_bytes += transfer_encoding_bytes + 2
            ResponseOutputState.chunked(0)
        }
    }
    if close_connection && connection_bytes > limits.field_bytes { return syntax_limit() }
    let estimate = checked_head_capacity(
        13,
        head.headers(),
        generated_count,
        generated_section_bytes,
        limits,
        ReservedFieldPolicy.server_response,
    )?
    var output: Vec<u8> = Vec.with_capacity(estimate)
    append_text(&+output, "HTTP/1.1 ")
    append_decimal(&+output, head.status().code() as usize)
    append_text(&+output, " \r\n")
    append_fields(&+output, head.headers())?
    match framing {
        ResponseFraming.fixed(length) {
            if !status_omits_content_length(head.status()) {
                append_content_length(&+output, length)
            }
        }
        ResponseFraming.chunked { append_transfer_encoding_chunked(&+output) }
    }
    if close_connection { append_connection_close(&+output) }
    append_text(&+output, "\r\n")
    return ResponsePlan { head: move output, state: move state }
}

noalloc func plan_fixed_response_fragment(
    remaining: usize,
    length: usize,
): usize! {
    if length > remaining { return response_body_overflow() }
    return remaining - length
}

noalloc func plan_chunked_response_fragment(
    written: usize,
    length: usize,
    limits: Limits,
): usize! {
    if written > limits.body_bytes || length > limits.body_bytes - written {
        return body_limit()
    }
    return written + length
}

noalloc func validate_fixed_response_finish(remaining: usize): void! {
    if remaining != 0 { return incomplete_response_body() }
    return
}
