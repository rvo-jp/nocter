//! Unique ownership and terminal cleanup for one unreaped Darwin child.
//!
//! A child PID cannot be reused while its exit status remains unreaped. This private owner keeps
//! that kernel identity live until explicit observation disarms it or destruction transfers it to
//! the compiler-owned abandonment service.

see ./subprocess_darwin.nct

use /internal/os/darwin.SyscallResult
use /internal/os/darwin
use /internal/task
use /ptr

#target: "arm64-darwin"
noalloc primitive func abandon_process_raw(pid: usize): void

#target: "arm64-darwin"
noalloc primitive func observe_process_raw(pid: usize, status: *i32): SyscallResult from static

/// Requests graceful termination without observing or transferring the child.
#target: "arm64-darwin"
noalloc primitive func terminate_process_raw(pid: usize): SyscallResult

/// Requests forced termination without observing or transferring the child.
#target: "arm64-darwin"
noalloc primitive func kill_process_raw(pid: usize): SyscallResult

#target: "arm64-darwin"
enum ChildOwnerState {
    pending
    exited
    signaled
}

#target: "arm64-darwin"
struct ChildOwner {
    pid: usize
    state: ChildOwnerState
    status: i32
}

#target: "arm64-darwin"
noalloc func own_child(pid: usize): ChildOwner {
    return ChildOwner {
        pid: pid,
        state: ChildOwnerState.pending,
        status: 0,
    }
}

#target: "arm64-darwin"
noalloc func completed_child_outcome(owner: &ChildOwner): WaitOutcome? {
    if owner.state is ChildOwnerState.pending { return none }
    if owner.state is ChildOwnerState.signaled { return WaitOutcome.signaled(owner.status) }
    return WaitOutcome.exited(owner.status)
}

#target: "arm64-darwin"
noalloc func record_child_exit(owner: &+ChildOwner, code: i32): void {
    owner.status = code
    owner.state = ChildOwnerState.exited
    return
}

#target: "arm64-darwin"
noalloc func record_child_signal(owner: &+ChildOwner, signal: i32): void {
    owner.status = signal
    owner.state = ChildOwnerState.signaled
    return
}

#target: "arm64-darwin"
noalloc blocking func observe_child(owner: ChildOwner): WaitOutcome {
    var child = move owner
    let completed = completed_child_outcome(&child)
    let existing = move completed otherwise {
        let observed = wait_for_child(child.pid)
        match move observed {
            WaitOutcome.exited(code) {
                record_child_exit(&+child, code)
                return WaitOutcome.exited(code)
            }
            WaitOutcome.signaled(signal) {
                record_child_signal(&+child, signal)
                return WaitOutcome.signaled(signal)
            }
            WaitOutcome.failed(errno) { return WaitOutcome.failed(errno) }
            WaitOutcome.invalid(status) { return WaitOutcome.invalid(status) }
        }
    }
    return move existing
}

#target: "arm64-darwin"
noalloc func try_observe_child(owner: &+ChildOwner): WaitOutcome? {
    let completed = completed_child_outcome(owner)
    let existing = move completed otherwise {
        loop {
            var status: i32 = 0
            let result = observe_process_raw(owner.pid, ptr.from_ref_mut(&+status))
            match classify_wait_attempt(result, status, owner.pid) {
                WaitAttempt.pending { return none }
                WaitAttempt.interrupted {}
                WaitAttempt.exited(code) {
                    record_child_exit(owner, code)
                    return WaitOutcome.exited(code)
                }
                WaitAttempt.signaled(signal) {
                    record_child_signal(owner, signal)
                    return WaitOutcome.signaled(signal)
                }
                WaitAttempt.failed(errno) { return WaitOutcome.failed(errno) }
                WaitAttempt.invalid(raw) { return WaitOutcome.invalid(raw) }
            }
        }
    }
    return move existing
}

#target: "arm64-darwin"
async func observe_child_async(owner: ChildOwner): WaitOutcome {
    var child = move owner
    let completed = completed_child_outcome(&child)
    let existing = move completed otherwise {
        loop {
            await task.wait_process_complete(child.pid)
            let outcome = try_observe_child(&+child) otherwise { continue }
            return move outcome
        }
    }
    return move existing
}

#target: "arm64-darwin"
noalloc func signal_request_result(result: SyscallResult): void! {
    if result.errno == 0 && result.value == 0 { return }
    if result.errno == darwin.ERRNO_MISSING_PROCESS { return }
    return error.new("std.process.termination_failed", "child termination could not be requested")
}

#target: "arm64-darwin"
noalloc func terminate_child(owner: &ChildOwner): void! {
    if owner.state is ChildOwnerState.exited { return }
    if owner.state is ChildOwnerState.signaled { return }
    var result = terminate_process_raw(owner.pid)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = terminate_process_raw(owner.pid)
    }
    return signal_request_result(result)?
}

#target: "arm64-darwin"
noalloc func kill_child(owner: &ChildOwner): void! {
    if owner.state is ChildOwnerState.exited { return }
    if owner.state is ChildOwnerState.signaled { return }
    var result = kill_process_raw(owner.pid)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = kill_process_raw(owner.pid)
    }
    return signal_request_result(result)?
}

noalloc drop ChildOwner(&+self) {
    if self.state is ChildOwnerState.pending { abandon_process_raw(self.pid) }
    return
}
