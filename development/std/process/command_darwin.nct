//! Darwin command orchestration and public failure selection.
//!
//! Raw target transitions expose typed facts. This layer is their only public-policy consumer: it
//! prepares all storage, creates one I/O session, reaps every child, and applies failure precedence.

see ./index.nct
see ./command.nct
see ./command_child_darwin.nct
see ./command_io_session_darwin.nct
see ./darwin.nct
see ./launch_report_darwin.nct
see ./launch_plan_darwin.nct
see ./pipe_darwin.nct
see ./subprocess_darwin.nct

use /internal/os.{OSErrorKind}
use /internal/os/darwin

#target: "arm64-darwin"
enum CommandFork {
    child(prepared: PreparedCommand, report: OwnedPipe, io: CommandIoSession)
    parent(prepared: PreparedCommand, pid: usize, report: OwnedPipe, io: CommandIoSession)
}

#target: "arm64-darwin"
struct CommandObservation {
    status: ExitStatus
    launch: LaunchReportAttempt
    io: CommandIoResult
}

#target: "arm64-darwin"
enum CommandOutputMode {
    inherited
    captured
}

#target: "arm64-darwin"
enum CompletedCommand {
    status(value: ExitStatus)
    output(value: Output)
}

#target: "arm64-darwin"
noalloc func captures_command_output(mode: &CommandOutputMode): bool {
    match mode {
        CommandOutputMode.inherited { return false }
        CommandOutputMode.captured { return true }
    }
}

#target: "arm64-darwin"
noalloc func spawn_failed(): error {
    return error.new("std.process.spawn_failed", "child process creation failed")
}

#target: "arm64-darwin"
noalloc func wait_failed(): error {
    return error.new("std.process.wait_failed", "child process status could not be observed")
}

#target: "arm64-darwin"
noalloc func capture_failed(): error {
    return error.new("std.process.capture_failed", "child output could not be captured")
}

#target: "arm64-darwin"
noalloc func input_failed(): error {
    return error.new("std.process.input_failed", "child input could not be written")
}

#target: "arm64-darwin"
noalloc func current_directory_failed(): error {
    return error.new(
        "std.process.current_directory_failed",
        "child working directory could not be entered",
    )
}

#target: "arm64-darwin"
noalloc func exec_failed(errno: i32): error {
    let os_error = darwin.error_from_errno(darwin.errno(errno))
    if os_error.kind is OSErrorKind.not_found {
        return error.new("std.process.not_found", "executable was not found")
    }
    if os_error.kind is OSErrorKind.not_directory {
        return error.new("std.process.not_found", "executable was not found")
    }
    if os_error.kind is OSErrorKind.permission_denied {
        return error.new("std.process.permission_denied", "executable permission was denied")
    }
    if os_error.kind is OSErrorKind.invalid_input {
        return error.new("std.process.invalid_input", "executable request was invalid")
    }
    return spawn_failed()
}

#target: "arm64-darwin"
noalloc func status_from_wait(outcome: WaitOutcome): ExitStatus! {
    match move outcome {
        WaitOutcome.exited(code) { return exited_status(code) }
        WaitOutcome.signaled(signal) { return signaled_status(signal) }
        WaitOutcome.failed(_) { return wait_failed() }
        WaitOutcome.invalid(_) { return wait_failed() }
    }
}

#target: "arm64-darwin"
noalloc func require_successful_launch(launch: LaunchReportAttempt): void! {
    match move launch {
        LaunchReportAttempt.executed { return }
        LaunchReportAttempt.input_setup_rejected(_) { return input_failed() }
        LaunchReportAttempt.output_setup_rejected(_) { return capture_failed() }
        LaunchReportAttempt.directory_rejected(_) { return current_directory_failed() }
        LaunchReportAttempt.exec_rejected(errno) { return exec_failed(errno) }
        LaunchReportAttempt.channel_failed(_) { return spawn_failed() }
        LaunchReportAttempt.malformed { return spawn_failed() }
    }
}

#target: "arm64-darwin"
func observe_command_parent(
    prepared: PreparedCommand,
    pid: usize,
    report: OwnedPipe,
    io: CommandIoSession,
): CommandObservation! {
    var command = move prepared
    let launch = read_launch_report(move report)
    let transferred = drain_command_io(move io, prepared_input(&command))

    // Exact-child observation is the last fallible lifecycle transition and therefore has highest
    // public precedence over launch, capture, and input transport facts.
    let status = status_from_wait(wait_for_child(pid))?
    drop command
    return CommandObservation {
        status: status,
        launch: move launch,
        io: move transferred,
    }
}

#target: "arm64-darwin"
func fork_prepared_command(command: Command, captures_output: bool): CommandFork! {
    let prepared = prepare_command(move command)
    let io = match create_command_io_session(prepared_has_input(&prepared), captures_output) {
        CommandIoPreparationAttempt.ready(session) { move session }
        CommandIoPreparationAttempt.input_failed(_) { return input_failed() }
        CommandIoPreparationAttempt.capture_failed(_) { return capture_failed() }
    }
    match create_cloexec_pipe() {
        PipeAttempt.failed(_) {
            drop io
            return spawn_failed()
        }
        PipeAttempt.ready(report) {
            match fork_process() {
                ForkAttempt.failed(_) {
                    drop report
                    drop io
                    return spawn_failed()
                }
                ForkAttempt.child {
                    return CommandFork.child(move prepared, move report, move io)
                }
                ForkAttempt.parent(pid) {
                    return CommandFork.parent(move prepared, pid, move report, move io)
                }
            }
        }
    }
}

#target: "arm64-darwin"
func complete_command_observation(
    observation: CommandObservation,
    mode: CommandOutputMode,
): CompletedCommand! {
    let result = move observation
    require_successful_launch(move result.launch)?
    if result.io.capture_failed { return capture_failed() }
    if result.io.input_failed { return input_failed() }
    match move result.io.output {
        CapturedCommandOutput.inherited {
            match mode {
                CommandOutputMode.inherited {
                    return CompletedCommand.status(result.status)
                }
                CommandOutputMode.captured { return capture_failed() }
            }
        }
        CapturedCommandOutput.captured(stdout, stderr) {
            match mode {
                CommandOutputMode.inherited { return capture_failed() }
                CommandOutputMode.captured {
                    return CompletedCommand.output(Output {
                        status: result.status,
                        stdout: move stdout,
                        stderr: move stderr,
                    })
                }
            }
        }
    }
}

#target: "arm64-darwin"
func execute_command(command: Command, mode: CommandOutputMode): CompletedCommand! {
    match fork_prepared_command(move command, captures_command_output(&mode))? {
        CommandFork.child(prepared, report, io) {
            exec_command_child(
                prepared_path_address(&prepared),
                prepared_argv_address(&prepared),
                prepared_environment_address(&prepared),
                prepared_working_directory_address(&prepared),
                move report,
                move io,
            )
        }
        CommandFork.parent(prepared, pid, report, io) {
            let observation = observe_command_parent(
                move prepared,
                pid,
                move report,
                move io,
            )?
            return complete_command_observation(move observation, mode)?
        }
    }
}

#target: "arm64-darwin"
func run_command(command: Command): ExitStatus! {
    match execute_command(move command, CommandOutputMode.inherited)? {
        CompletedCommand.status(status) { return status }
        CompletedCommand.output(_) { return capture_failed() }
    }
}

#target: "arm64-darwin"
func output_command(command: Command): Output! {
    match execute_command(move command, CommandOutputMode.captured)? {
        CompletedCommand.status(_) { return capture_failed() }
        CompletedCommand.output(output) { return move output }
    }
}

instance Command {
    method self.status(): ExitStatus! {
        return run_command(move self)?
    }

    method self.output(): Output! {
        return output_command(move self)?
    }
}
