//! User-facing `std/process` API.
//!
//! exit is a standard-library API, not a compiler primitive. The target-specific
//! implementation calls the active target boundary.

use std/mem.TryAllocator
use std/string.String
use std/vec.Vec
include ./darwin.nct

#target: "arm64-darwin"
pub(/) primitive exit_raw(code: i32): never

#target: "arm64-darwin"
pub(/) primitive arg_count_raw(): usize

#target: "arm64-darwin"
pub(/) primitive arg_raw(index: usize): &str from static

#target: "arm64-darwin"
pub(/) primitive env_count_raw(): usize

#target: "arm64-darwin"
pub(/) primitive env_name_raw(index: usize): &str from static

#target: "arm64-darwin"
pub(/) primitive env_value_raw(index: usize): &str from static

pub copy struct EnvironmentEntry {
    pub name: &str
    pub value: &str
}

pub func args(): Vec<&str>!

pub func arg_count(): usize

pub func arg(index: usize): &str?!

pub func environment_count(): usize

pub func environment(index: usize): EnvironmentEntry?!

pub func env(name: &str): &str?!

pub func cwd(): String!

pub func try_cwd(allocator: &+TryAllocator): String!

pub func exit(code: i32): never

pub func abort(): never
