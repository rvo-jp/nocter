//! Darwin child-side standard-descriptor, directory, and executable setup.
//!
//! The child consumes only a prepared launch plan, one owning I/O session, and one close-on-exec
//! report. Every rejected transition is reported before raw child exit.

see ./launch_report_darwin.nct
see ./pipe_darwin.nct
see ./spawn_io_darwin.nct

use /internal/os/darwin.SyscallResult
use /internal/os/darwin

/// Enters one prepared working directory without exposing a raw syscall identity.
#target: "arm64-darwin"
noalloc primitive func change_directory_raw(path_address: usize): SyscallResult

#target: "arm64-darwin"
noalloc func reject_command_setup(
    report: &+OwnedPipe,
    stage: i32,
    errno: i32,
): never {
    write_launch_failure_and_exit(report, stage, errno)
}

#target: "arm64-darwin"
noalloc func reject_malformed_command_setup(
    report: &+OwnedPipe,
): never {
    write_launch_failure_and_exit(report, 0, 1)
}

#target: "arm64-darwin"
noalloc func enter_child_directory(
    path_address: usize,
    report: &+OwnedPipe,
): void {
    if path_address == 0 { return }
    var result = change_directory_raw(path_address)
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = change_directory_raw(path_address)
    }
    if result.errno != 0 {
        reject_command_setup(report, LAUNCH_STAGE_DIRECTORY, result.errno)
    }
    return
}

#target: "arm64-darwin"
noalloc func exec_spawn_child(
    path_address: usize,
    argv_address: usize,
    environment_address: usize,
    working_directory_address: usize,
    report: OwnedPipe,
    session: SpawnIoSession,
): never {
    var launch_report = move report
    var process_io = move session
    close_pipe_read(&+launch_report)
    match install_input_channel(&+process_io.stdin) {
        DescriptorInstallAttempt.ready {}
        DescriptorInstallAttempt.failed(errno) {
            reject_command_setup(&+launch_report, LAUNCH_STAGE_INPUT_SETUP, errno)
        }
        DescriptorInstallAttempt.invalid { reject_malformed_command_setup(&+launch_report) }
    }
    match install_output_channel(&+process_io.stdout, darwin.STDOUT_FD) {
        DescriptorInstallAttempt.ready {}
        DescriptorInstallAttempt.failed(errno) {
            reject_command_setup(&+launch_report, LAUNCH_STAGE_OUTPUT_SETUP, errno)
        }
        DescriptorInstallAttempt.invalid { reject_malformed_command_setup(&+launch_report) }
    }
    match install_output_channel(&+process_io.stderr, darwin.STDERR_FD) {
        DescriptorInstallAttempt.ready {}
        DescriptorInstallAttempt.failed(errno) {
            reject_command_setup(&+launch_report, LAUNCH_STAGE_OUTPUT_SETUP, errno)
        }
        DescriptorInstallAttempt.invalid { reject_malformed_command_setup(&+launch_report) }
    }
    enter_child_directory(working_directory_address, &+launch_report)
    exec_child_after_setup(
        path_address,
        argv_address,
        environment_address,
        &+launch_report,
    )
}
