//! Decimal integer parsing and text conversion.

use std/mem.TryAllocator
use std/string.String
include ./scalar.nct

pub func parse_usize(text: &str): usize?

pub func parse_u8(text: &str): u8?

pub func parse_i32(text: &str): i32?

pub func usize_to_string(value: usize): String

pub func i32_to_string(value: i32): String

pub func u8_to_string(value: u8): String

pub func try_usize_to_string(
    allocator: &+TryAllocator,
    value: usize,
): String!

pub func try_i32_to_string(
    allocator: &+TryAllocator,
    value: i32,
): String!

pub func try_u8_to_string(
    allocator: &+TryAllocator,
    value: u8,
): String!
