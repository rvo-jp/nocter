//! Public-surface numeric text contract tests.

see ./index.nct

use /mem
use /order.Ordering
use /string.String

func require(condition: bool, message: &str): void! {
    if !condition { return error.new("std.num.contract", message) }
    return
}

func is_none<T>(value: T?): bool {
    let _present = move value otherwise { return true }
    return false
}

func require_text(actual: String, expected: &str): void! {
    if ((&actual) as &str) != expected {
        return error.new("std.num.text", "decimal spelling changed")
    }
    return
}

func ordering_is_less(value: Ordering): bool {
    if value is Ordering.less { return true }
    return false
}

func ordering_is_equal(value: Ordering): bool {
    if value is Ordering.equal { return true }
    return false
}

func require_f64_round_trip(value: f64): void! {
    let text = value.to_string()
    let parsed = f64.parse(&text) otherwise {
        return error.new("std.num.round_trip", "generated f64 text was rejected")
    }
    if parsed.to_bits() != value.to_bits() {
        return error.new("std.num.round_trip", "generated f64 text changed its IEEE value")
    }
    return
}

func require_f32_round_trip(value: f32): void! {
    let text = value.to_string()
    let parsed = f32.parse(&text) otherwise {
        return error.new("std.num.round_trip", "generated f32 text was rejected")
    }
    if parsed.to_bits() != value.to_bits() {
        return error.new("std.num.round_trip", "generated f32 text changed its IEEE value")
    }
    return
}

test every_integer_type_owns_the_same_decimal_surface {
    let signed8 = i8.parse("-128") otherwise {
        return error.new("std.num.parse", "i8 parse failed")
    }
    let signed16 = i16.parse("-32768") otherwise {
        return error.new("std.num.parse", "i16 parse failed")
    }
    let signed32 = i32.parse("-2147483648") otherwise {
        return error.new("std.num.parse", "i32 parse failed")
    }
    let signed64 = i64.parse("-9223372036854775808") otherwise {
        return error.new("std.num.parse", "i64 parse failed")
    }
    let signed_size = isize.parse("-9223372036854775808") otherwise {
        return error.new("std.num.parse", "isize parse failed")
    }
    let unsigned8 = u8.parse("255") otherwise {
        return error.new("std.num.parse", "u8 parse failed")
    }
    let unsigned16 = u16.parse("65535") otherwise {
        return error.new("std.num.parse", "u16 parse failed")
    }
    let unsigned32 = u32.parse("4294967295") otherwise {
        return error.new("std.num.parse", "u32 parse failed")
    }
    let unsigned64 = u64.parse("18446744073709551615") otherwise {
        return error.new("std.num.parse", "u64 parse failed")
    }
    let unsigned_size = usize.parse("18446744073709551615") otherwise {
        return error.new("std.num.parse", "usize parse failed")
    }

    require_text(signed8.to_string(), "-128")?
    require_text(signed16.to_string(), "-32768")?
    require_text(signed32.to_string(), "-2147483648")?
    require_text(signed64.to_string(), "-9223372036854775808")?
    require_text(signed_size.to_string(), "-9223372036854775808")?
    require_text(unsigned8.to_string(), "255")?
    require_text(unsigned16.to_string(), "65535")?
    require_text(unsigned32.to_string(), "4294967295")?
    require_text(unsigned64.to_string(), "18446744073709551615")?
    require_text(unsigned_size.to_string(), "18446744073709551615")?
    return
}

test decimal_grammar_is_exact_and_complete_input {
    let leading_zeroes = u64.parse("00012") otherwise {
        return error.new("std.num.grammar", "leading zeroes were rejected")
    }
    let negative_zero = i64.parse("-0") otherwise {
        return error.new("std.num.grammar", "negative zero was rejected")
    }
    let zero: i64 = 0
    require(leading_zeroes == 12, "leading zero value changed")?
    require(negative_zero == 0, "negative zero value changed")?
    require_text(zero.to_string(), "0")?
    require(is_none(u64.parse("")), "empty unsigned input was accepted")?
    require(is_none(i64.parse("")), "empty signed input was accepted")?
    require(is_none(i64.parse("-")), "bare minus was accepted")?
    require(is_none(i64.parse("+1")), "leading plus was accepted")?
    require(is_none(u64.parse("-1")), "unsigned minus was accepted")?
    require(is_none(i64.parse("--1")), "repeated minus was accepted")?
    require(is_none(i64.parse(" 1")), "leading space was accepted")?
    require(is_none(i64.parse("1 ")), "trailing space was accepted")?
    require(is_none(i64.parse("1a")), "trailing character was accepted")?
    require(is_none(i64.parse("١")), "non-ASCII digit was accepted")?
    return
}

test every_integer_range_rejects_adjacent_values {
    require(is_none(i8.parse("-129")), "i8 lower overflow was accepted")?
    require(is_none(i8.parse("128")), "i8 upper overflow was accepted")?
    require(is_none(i16.parse("-32769")), "i16 lower overflow was accepted")?
    require(is_none(i16.parse("32768")), "i16 upper overflow was accepted")?
    require(is_none(i32.parse("-2147483649")), "i32 lower overflow was accepted")?
    require(is_none(i32.parse("2147483648")), "i32 upper overflow was accepted")?
    require(
        is_none(i64.parse("-9223372036854775809")),
        "i64 lower overflow was accepted",
    )?
    require(
        is_none(i64.parse("9223372036854775808")),
        "i64 upper overflow was accepted",
    )?
    require(
        is_none(isize.parse("-9223372036854775809")),
        "isize lower overflow was accepted",
    )?
    require(
        is_none(isize.parse("9223372036854775808")),
        "isize upper overflow was accepted",
    )?
    require(is_none(u8.parse("256")), "u8 overflow was accepted")?
    require(is_none(u16.parse("65536")), "u16 overflow was accepted")?
    require(is_none(u32.parse("4294967296")), "u32 overflow was accepted")?
    require(
        is_none(u64.parse("18446744073709551616")),
        "u64 overflow was accepted",
    )?
    require(
        is_none(usize.parse("18446744073709551616")),
        "usize overflow was accepted",
    )?

    let signed8 = i8.parse("127") otherwise {
        return error.new("std.num.range", "i8 maximum was rejected")
    }
    let signed16 = i16.parse("32767") otherwise {
        return error.new("std.num.range", "i16 maximum was rejected")
    }
    let signed32 = i32.parse("2147483647") otherwise {
        return error.new("std.num.range", "i32 maximum was rejected")
    }
    let signed64 = i64.parse("9223372036854775807") otherwise {
        return error.new("std.num.range", "i64 maximum was rejected")
    }
    let signed_size = isize.parse("9223372036854775807") otherwise {
        return error.new("std.num.range", "isize maximum was rejected")
    }
    require(signed8 == 127, "i8 maximum changed")?
    require(signed16 == 32767, "i16 maximum changed")?
    require(signed32 == 2147483647, "i32 maximum changed")?
    require(signed64 == 9223372036854775807, "i64 maximum changed")?
    require(signed_size == 9223372036854775807, "isize maximum changed")?
    return
}

test every_integer_round_trips_through_its_owned_text {
    let signed8: i8 = -128
    let signed16: i16 = -32768
    let signed32: i32 = -2147483648
    let signed64: i64 = -9223372036854775808
    let signed_size: isize = -9223372036854775808
    let unsigned8: u8 = 255
    let unsigned16: u16 = 65535
    let unsigned32: u32 = 4294967295
    let unsigned64: u64 = 18446744073709551615
    let unsigned_size: usize = 18446744073709551615

    let signed8_text = signed8.to_string()
    let signed16_text = signed16.to_string()
    let signed32_text = signed32.to_string()
    let signed64_text = signed64.to_string()
    let signed_size_text = signed_size.to_string()
    let unsigned8_text = unsigned8.to_string()
    let unsigned16_text = unsigned16.to_string()
    let unsigned32_text = unsigned32.to_string()
    let unsigned64_text = unsigned64.to_string()
    let unsigned_size_text = unsigned_size.to_string()

    let reparsed_i8 = i8.parse(&signed8_text) otherwise {
        return error.new("std.num.round_trip", "i8 text was rejected")
    }
    let reparsed_i16 = i16.parse(&signed16_text) otherwise {
        return error.new("std.num.round_trip", "i16 text was rejected")
    }
    let reparsed_i32 = i32.parse(&signed32_text) otherwise {
        return error.new("std.num.round_trip", "i32 text was rejected")
    }
    let reparsed_i64 = i64.parse(&signed64_text) otherwise {
        return error.new("std.num.round_trip", "i64 text was rejected")
    }
    let reparsed_isize = isize.parse(&signed_size_text) otherwise {
        return error.new("std.num.round_trip", "isize text was rejected")
    }
    let reparsed_u8 = u8.parse(&unsigned8_text) otherwise {
        return error.new("std.num.round_trip", "u8 text was rejected")
    }
    let reparsed_u16 = u16.parse(&unsigned16_text) otherwise {
        return error.new("std.num.round_trip", "u16 text was rejected")
    }
    let reparsed_u32 = u32.parse(&unsigned32_text) otherwise {
        return error.new("std.num.round_trip", "u32 text was rejected")
    }
    let reparsed_u64 = u64.parse(&unsigned64_text) otherwise {
        return error.new("std.num.round_trip", "u64 text was rejected")
    }
    let reparsed_usize = usize.parse(&unsigned_size_text) otherwise {
        return error.new("std.num.round_trip", "usize text was rejected")
    }
    require(reparsed_i8 == signed8, "i8 round trip failed")?
    require(reparsed_i16 == signed16, "i16 round trip failed")?
    require(reparsed_i32 == signed32, "i32 round trip failed")?
    require(reparsed_i64 == signed64, "i64 round trip failed")?
    require(reparsed_isize == signed_size, "isize round trip failed")?
    require(reparsed_u8 == unsigned8, "u8 round trip failed")?
    require(reparsed_u16 == unsigned16, "u16 round trip failed")?
    require(reparsed_u32 == unsigned32, "u32 round trip failed")?
    require(reparsed_u64 == unsigned64, "u64 round trip failed")?
    require(reparsed_usize == unsigned_size, "usize round trip failed")?
    return
}

test recoverable_integer_text_uses_the_supplied_allocator {
    var allocator = mem.page_try_allocator()
    let signed8: i8 = -128
    let signed16: i16 = -32768
    let signed32: i32 = -2147483648
    let signed64: i64 = -9223372036854775808
    let signed_size: isize = -9223372036854775808
    let unsigned8: u8 = 255
    let unsigned16: u16 = 65535
    let unsigned32: u32 = 4294967295
    let unsigned64: u64 = 18446744073709551615
    let unsigned_size: usize = 18446744073709551615

    require_text(signed8.try_to_string(&+allocator)?, "-128")?
    require_text(signed16.try_to_string(&+allocator)?, "-32768")?
    require_text(signed32.try_to_string(&+allocator)?, "-2147483648")?
    require_text(
        signed64.try_to_string(&+allocator)?,
        "-9223372036854775808",
    )?
    require_text(
        signed_size.try_to_string(&+allocator)?,
        "-9223372036854775808",
    )?
    require_text(unsigned8.try_to_string(&+allocator)?, "255")?
    require_text(unsigned16.try_to_string(&+allocator)?, "65535")?
    require_text(unsigned32.try_to_string(&+allocator)?, "4294967295")?
    require_text(
        unsigned64.try_to_string(&+allocator)?,
        "18446744073709551615",
    )?
    require_text(
        unsigned_size.try_to_string(&+allocator)?,
        "18446744073709551615",
    )?
    return
}

test floating_bits_and_classification_preserve_ieee_identity {
    let nan32 = f32.from_bits(2143294004)
    require(nan32.to_bits() == 2143294004, "f32 NaN payload changed")?
    require(nan32.is_nan(), "f32 NaN was not classified")?
    require(!nan32.is_finite(), "f32 NaN was classified as finite")?
    require(!nan32.is_infinite(), "f32 NaN was classified as infinity")?

    let negative_zero32 = f32.from_bits(2147483648)
    require(negative_zero32.is_zero(), "negative f32 zero was not zero")?
    require(negative_zero32.is_sign_negative(), "negative f32 zero lost its sign")?
    require(!negative_zero32.is_sign_positive(), "negative f32 zero had both signs")?
    require(negative_zero32.abs().to_bits() == 0, "f32 abs did not clear the sign")?
    require(f32.from_bits(1).is_subnormal(), "minimum f32 was not subnormal")?
    require(1.0f32.is_normal(), "ordinary f32 was not normal")?

    let negative_nan64 = f64.from_bits(18444492273895871028)
    require(negative_nan64.is_nan(), "negative f64 NaN was not classified")?
    require(negative_nan64.is_sign_negative(), "negative f64 NaN lost its sign")?
    require(
        negative_nan64.abs().to_bits() == 9221120237041095220,
        "f64 abs changed the NaN payload",
    )?
    require(f64.from_bits(1).is_subnormal(), "minimum f64 was not subnormal")?
    require(f64.from_bits(9218868437227405312).is_infinite(), "f64 infinity changed")?
    require(F32_INFINITY.is_infinite(), "public f32 infinity changed")?
    require(F32_NEG_INFINITY.is_sign_negative(), "public negative f32 infinity changed")?
    require(F32_NAN.is_nan(), "public f32 NaN changed")?
    require(F64_INFINITY.is_infinite(), "public f64 infinity changed")?
    require(F64_NEG_INFINITY.is_sign_negative(), "public negative f64 infinity changed")?
    require(F64_NAN.is_nan(), "public f64 NaN changed")?

    require(
        ordering_is_less(f32.from_bits(4290772993).total_compare(F32_NEG_INFINITY)),
        "negative f32 NaN did not precede negative infinity",
    )?
    require(
        ordering_is_less(F32_NEG_INFINITY.total_compare(negative_zero32)),
        "negative f32 infinity did not precede negative zero",
    )?
    require(
        ordering_is_less(negative_zero32.total_compare(0.0f32)),
        "signed f32 zeroes collapsed in total order",
    )?
    require(
        ordering_is_less(0.0f32.total_compare(F32_INFINITY)),
        "positive f32 infinity was not ordered after finite values",
    )?
    require(
        ordering_is_less(F32_INFINITY.total_compare(nan32)),
        "positive f32 NaN did not follow infinity",
    )?
    require(
        ordering_is_equal(F64_NAN.total_compare(F64_NAN)),
        "identical f64 NaN representations were not total-order equal",
    )?
    require(1.75f32.floor() == 1.0f32, "f32 floor rounded incorrectly")?
    require(1.25f32.ceil() == 2.0f32, "f32 ceil rounded incorrectly")?
    require((-1.75f32).trunc() == -1.0f32, "f32 trunc rounded incorrectly")?
    require(2.5f32.round_ties_even() == 2.0f32, "f32 even tie rounded up")?
    require(3.5f32.round_ties_even() == 4.0f32, "f32 odd tie rounded down")?
    require((-1.25).floor() == -2.0, "f64 floor rounded incorrectly")?
    require((-1.75).ceil() == -1.0, "f64 ceil rounded incorrectly")?
    require((-1.75).trunc() == -1.0, "f64 trunc rounded incorrectly")?
    require(2.5.round_ties_even() == 2.0, "f64 even tie rounded up")?
    require(3.5.round_ties_even() == 4.0, "f64 odd tie rounded down")?
    require(
        negative_zero32.round_ties_even().to_bits() == 2147483648,
        "rounding did not preserve negative f32 zero",
    )?
    require(F64_INFINITY.floor().is_infinite(), "rounding changed f64 infinity")?
    require(F64_NAN.ceil().is_nan(), "rounding made f64 NaN finite")?
    return
}

test floating_checked_conversions_enforce_range_and_integrality {
    let signed = i64.from_f64(-9223372036854775808.0) otherwise {
        return error.new("std.num.convert", "i64 minimum was rejected")
    }
    let unsigned = u64.from_f64(18446744073709549568.0) otherwise {
        return error.new("std.num.convert", "largest representable u64 below 2^64 was rejected")
    }
    let small = i8.from_f64(127.0) otherwise {
        return error.new("std.num.convert", "i8 maximum was rejected")
    }
    if signed != -9223372036854775808 || unsigned != 18446744073709549568 || small != 127 {
        return error.new("std.num.convert", "an exact integer conversion changed its value")
    }
    if !is_none(i64.from_f64(1.5)) || !is_none(u64.from_f64(-0.5)) {
        return error.new("std.num.convert", "a fractional conversion succeeded")
    }
    if !is_none(i64.from_f64(F64_INFINITY)) || !is_none(u64.from_f64(F64_NAN)) {
        return error.new("std.num.convert", "a non-finite integer conversion succeeded")
    }
    if !is_none(i64.from_f64(9223372036854775808.0))
        || !is_none(u64.from_f64(18446744073709551616.0))
        || !is_none(i8.from_f64(128.0)) {
        return error.new("std.num.convert", "an out-of-range integer conversion succeeded")
    }

    let narrowed = f32.from_f64(1.5) otherwise {
        return error.new("std.num.convert", "finite f32 narrowing was rejected")
    }
    if narrowed.to_bits() != 1069547520 {
        return error.new("std.num.convert", "f32 narrowing did not round predictably")
    }
    if !is_none(f32.from_f64(1.0e300)) || !is_none(f32.from_f64(1.0e-300)) {
        return error.new("std.num.convert", "range-losing f32 narrowing succeeded")
    }
    let infinity = f32.from_f64(F64_INFINITY) otherwise {
        return error.new("std.num.convert", "infinity narrowing was rejected")
    }
    let nan = f32.from_f64(F64_NAN) otherwise {
        return error.new("std.num.convert", "NaN narrowing was rejected")
    }
    let negative_zero = f32.from_f64(f64.from_bits(9223372036854775808)) otherwise {
        return error.new("std.num.convert", "negative zero narrowing was rejected")
    }
    if !infinity.is_infinite() || !nan.is_nan() || negative_zero.to_bits() != 2147483648 {
        return error.new("std.num.convert", "narrowing changed an IEEE classification")
    }
    return
}

test floating_decimal_parsing_rounds_exactly {
    var allocator = mem.page_try_allocator()
    let recovered = f64.try_parse(&+allocator, "0.1")?
        otherwise { return error.new("std.num.parse", "recoverable f64 tenth was rejected") }
    if recovered.to_bits() != 4591870180066957722 {
        return error.new("std.num.parse", "recoverable decimal parsing rounded differently")
    }

    let tenth64 = f64.parse("0.1") otherwise {
        return error.new("std.num.parse", "f64 tenth was rejected")
    }
    let tenth32 = f32.parse("0.1") otherwise {
        return error.new("std.num.parse", "f32 tenth was rejected")
    }
    if tenth64.to_bits() != 4591870180066957722 || tenth32.to_bits() != 1036831949 {
        return error.new("std.num.parse", "decimal tenth rounded incorrectly")
    }

    let even = f64.parse("1.00000000000000011102230246251565404236316680908203125")
        otherwise { return error.new("std.num.parse", "exact midpoint was rejected") }
    let above = f64.parse("1.00000000000000011102230246251565404236316680908203126")
        otherwise { return error.new("std.num.parse", "above-midpoint value was rejected") }
    if even.to_bits() != 4607182418800017408 || above.to_bits() != 4607182418800017409 {
        return error.new("std.num.parse", "ties-to-even decimal rounding changed")
    }

    let subnormal = f64.parse("5e-324") otherwise {
        return error.new("std.num.parse", "minimum subnormal spelling was rejected")
    }
    if subnormal.to_bits() != 1 {
        return error.new("std.num.parse", "subnormal decimal rounded incorrectly")
    }
    if !is_none(f64.parse("1e-324")) || !is_none(f64.parse("1e309")) {
        return error.new("std.num.parse", "range-losing decimal was accepted")
    }

    let maximum64 = f64.parse("1.7976931348623157e308") otherwise {
        return error.new("std.num.parse", "maximum finite f64 was rejected")
    }
    let minimum_normal64 = f64.parse("2.2250738585072014e-308") otherwise {
        return error.new("std.num.parse", "minimum normal f64 was rejected")
    }
    let maximum32 = f32.parse("3.4028235e38") otherwise {
        return error.new("std.num.parse", "maximum finite f32 was rejected")
    }
    let minimum32 = f32.parse("1.40129846e-45") otherwise {
        return error.new("std.num.parse", "minimum subnormal f32 was rejected")
    }
    if maximum64.to_bits() != 9218868437227405311
        || minimum_normal64.to_bits() != 4503599627370496
        || maximum32.to_bits() != 2139095039
        || minimum32.to_bits() != 1 {
        return error.new("std.num.parse", "an IEEE range boundary rounded incorrectly")
    }
    if !is_none(f64.parse("1.7976931348623159e308")) {
        return error.new("std.num.parse", "f64 overflow boundary was accepted")
    }

    let scaled_one = f64.parse("0001.0000e+0") otherwise {
        return error.new("std.num.parse", "redundant decimal zeroes were rejected")
    }
    if scaled_one.to_bits() != 4607182418800017408 {
        return error.new("std.num.parse", "redundant decimal zeroes changed the value")
    }
    let long_fraction = f64.parse("1.2345678901234567") otherwise {
        return error.new("std.num.parse", "long decimal fraction was rejected")
    }
    let integer_rounding = f64.parse("9007199254740993") otherwise {
        return error.new("std.num.parse", "integer rounding input was rejected")
    }
    let tiny_scaled = f64.parse("123456789e-100") otherwise {
        return error.new("std.num.parse", "negative decimal scale was rejected")
    }
    let pi = f64.parse("-3.1415926535897932384626") otherwise {
        return error.new("std.num.parse", "negative long fraction was rejected")
    }
    if long_fraction.to_bits() != 4608238818662570491
        || integer_rounding.to_bits() != 4845873199050653696
        || tiny_scaled.to_bits() != 3231825921349750740
        || pi.to_bits() != 13837628693406821656 {
        return error.new("std.num.parse", "a general decimal rounded incorrectly")
    }

    let negative_zero = f64.parse("-0.0") otherwise {
        return error.new("std.num.parse", "negative zero was rejected")
    }
    let infinity = f32.parse("inf") otherwise {
        return error.new("std.num.parse", "infinity was rejected")
    }
    let nan = f64.parse("NaN") otherwise {
        return error.new("std.num.parse", "NaN was rejected")
    }
    if negative_zero.to_bits() != 9223372036854775808 || !infinity.is_infinite() || !nan.is_nan() {
        return error.new("std.num.parse", "canonical special spelling changed")
    }
    if !is_none(f64.parse("1."))
        || !is_none(f64.parse(".1"))
        || !is_none(f64.parse("+1.0"))
        || !is_none(f64.parse("1.0x")) {
        return error.new("std.num.parse", "invalid decimal grammar was accepted")
    }
    return
}

test floating_decimal_generation_has_one_canonical_surface {
    require_text(0.0.to_string(), "0")?
    require_text(f64.from_bits(9223372036854775808).to_string(), "-0")?
    require_text(0.1.to_string(), "0.1")?
    require_text((-1.5).to_string(), "-1.5")?
    require_text(0.000001.to_string(), "0.000001")?
    require_text(0.0000001.to_string(), "1e-7")?
    require_text(100000000000000000000.0.to_string(), "100000000000000000000")?
    require_text(1.0e21.to_string(), "1e+21")?
    require_text(f64.from_bits(1).to_string(), "5e-324")?
    require_text(f64.from_bits(4503599627370496).to_string(), "2.2250738585072014e-308")?
    require_text(f64.from_bits(9218868437227405311).to_string(), "1.7976931348623157e+308")?
    require_text(F64_INFINITY.to_string(), "inf")?
    require_text(F64_NEG_INFINITY.to_string(), "-inf")?
    require_text(F64_NAN.to_string(), "NaN")?
    return
}

test floating_decimal_generation_round_trips_ieee_boundaries {
    require_f64_round_trip(f64.from_bits(1))?
    require_f64_round_trip(f64.from_bits(2))?
    require_f64_round_trip(f64.from_bits(4503599627370495))?
    require_f64_round_trip(f64.from_bits(4503599627370496))?
    require_f64_round_trip(f64.from_bits(4607182418800017407))?
    require_f64_round_trip(f64.from_bits(4607182418800017408))?
    require_f64_round_trip(f64.from_bits(4607182418800017409))?
    require_f64_round_trip(f64.from_bits(9218868437227405311))?
    require_f64_round_trip(f64.from_bits(13837628693406821656))?
    require_f32_round_trip(f32.from_bits(1))?
    require_f32_round_trip(f32.from_bits(8388607))?
    require_f32_round_trip(f32.from_bits(8388608))?
    require_f32_round_trip(f32.from_bits(1065353215))?
    require_f32_round_trip(f32.from_bits(1065353216))?
    require_f32_round_trip(f32.from_bits(1065353217))?
    require_f32_round_trip(f32.from_bits(2139095039))?
    var allocator = mem.page_try_allocator()
    require_text(0.1.try_to_string(&+allocator)?, "0.1")?
    return
}

test floating_decimal_generation_round_trips_a_deterministic_bit_sample {
    var bits: u64 = 11400714819323198485
    var checked: usize = 0
    while checked < 512 {
        bits = bits.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
        let value = f64.from_bits(bits)
        if value.is_finite() { require_f64_round_trip(value)? }
        checked += 1
    }
    return
}
