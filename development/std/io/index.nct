//! Common user-facing I/O API.
//!
//! `std/io` exposes ordinary file and text APIs. Fallible functions return `T!`
//! and fail with the compiler built-in `error` payload. Target-specific syscall
//! results and errno wrappers stay behind `#target`-gated std internals.

include ./core.nct
use std/internal/os.OSError
use std/string.String
use std/vec.Vec
include ./file.nct

/// A source that initializes at most `buffer.len()` bytes per read.
pub interface Reader {
    pub method &+self.read(buffer: &+[u8]): usize!

    /// Reads until end of stream into independently owned byte storage.
    pub default method &+self.read_to_end(): Vec<u8>!

    /// Reads until end of stream and validates the complete input as UTF-8.
    pub default method &+self.read_to_string(): String!
}

/// A destination that accepts the complete byte view or returns an error.
pub interface Writer {
    pub method &+self.write(value: &[u8]): void!

    pub default method &+self.flush(): void!

    /// Writes the UTF-8 encoding bytes through the shared byte contract.
    pub default method &+self.write_text(text: &str): void!
}

pub func invalid_read_count(): error

#target: "arm64-darwin"
pub(/) func stdout_fd(): usize

#target: "arm64-darwin"
pub(/) func stderr_fd(): usize

#target: "arm64-darwin"
pub(/) func open_read_fd(path: &str): usize!

#target: "arm64-darwin"
pub(/) func create_fd(path: &str): usize!

#target: "arm64-darwin"
pub(/) func append_fd(path: &str): usize!

#target: "arm64-darwin"
pub(/) func read_fd(fd: usize, buffer: &+[u8]): usize!

#target: "arm64-darwin"
pub(/) func write_fd(fd: usize, bytes: &[u8]): void!

#target: "arm64-darwin"
pub(/) func write_text_fd(fd: usize, text: &str): void!

#target: "arm64-darwin"
pub(/) func close_fd(fd: usize): void

pub(/) enum IOError {
    interrupted(error: OSError)
    would_block(error: OSError)
    not_found(error: OSError)
    permission_denied(error: OSError)
    already_exists(error: OSError)
    invalid_input(error: OSError)
    broken_pipe(error: OSError)
    timed_out(error: OSError)
    unsupported(error: OSError)
    unexpected_os_error(error: OSError)
}

pub struct File

pub(/) func from_os_error(os_error: OSError): error

pub func stdout(): File

pub func stderr(): File

construct File {
    pub default func open(path: &str): Self!

    pub func create(path: &str): Self!

    pub func append(path: &str): Self!
}

pub(/) func read(file: &+File, buffer: &+[u8]): usize!

pub(/) func write(file: &+File, bytes: &[u8]): void!

instance File {
    pub method &+self.close(): void
}

conform Reader for File {
    method &+self.read(buffer: &+[u8]): usize!
}

conform Writer for File {
    method &+self.write(bytes: &[u8]): void!

    method &+self.flush(): void!
}

pub func print(text: &str): void!
