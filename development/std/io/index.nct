//! Common user-facing I/O API.
//!
//! `std/io` exposes ordinary file and text APIs. Fallible functions return `T!`
//! and fail with the compiler built-in `error` payload. Target-specific syscall
//! results and errno wrappers stay behind `#target`-gated std internals.

see ./core.nct
see ./async_core.nct
see ./byte_helpers.nct
see ./transfer.nct
use /string.String
use /vec.Vec
see ./file.nct
see ./async_file.nct
see ./input.nct
see ./input_tests.nct
see ./output.nct
see ./output_tests.nct

/// A source that initializes at most `buffer.len()` bytes per read.
pub interface BlockingReader {
    /// Initializes at most the supplied buffer length and returns zero at end of stream.
    pub blocking method &+self.read_blocking(buffer: &+[u8]): usize!

    /// Reads until end of stream into independently owned byte storage.
    pub blocking default method &+self.read_to_end_blocking(): Vec<u8>!

    /// Reads until end of stream and validates the complete input as UTF-8.
    pub blocking default method &+self.read_to_string_blocking(): String!
}

/// A destination that accepts the complete byte view or returns an error.
pub interface BlockingWriter {
    /// Writes the complete byte view or reports an error after an observable prefix.
    pub blocking method &+self.write_blocking(value: &[u8]): void!

    /// Publishes any retained output; the default implementation has no retained state.
    pub blocking default method &+self.flush_blocking(): void!

    /// Writes the UTF-8 encoding bytes through the shared byte contract.
    pub blocking default method &+self.write_text_blocking(text: &str): void!

    /// Writes UTF-8 text followed by exactly one LF byte.
    pub blocking default method &+self.write_line_blocking(text: &str): void!
}

/// An executor-safe source that initializes at most `buffer.len()` bytes per read.
pub interface Reader {
    /// Initializes at most the supplied buffer length and returns zero at end of stream.
    pub async method &+self.read(buffer: &+[u8]): usize!

    /// Reads until end of stream into independently owned byte storage.
    pub async default method &+self.read_to_end(): Vec<u8>!

    /// Reads until end of stream and validates the complete input as UTF-8.
    pub async default method &+self.read_to_string(): String!
}

/// An executor-safe destination that accepts complete byte views.
pub interface Writer {
    /// Writes the complete byte view or reports an error after an observable prefix.
    pub async method &+self.write(value: &[u8]): void!

    /// Publishes retained output; the default implementation has no retained state.
    pub async default method &+self.flush(): void!

    /// Writes the UTF-8 encoding bytes through the shared byte contract.
    pub async default method &+self.write_text(text: &str): void!

    /// Writes UTF-8 text followed by exactly one LF byte.
    pub async default method &+self.write_line(text: &str): void!
}

/// Transfers bytes from one executor-safe source to one destination until end of stream.
pub async func copy<R, W>(
    reader: &+R,
    writer: &+W,
): usize! where R impl Reader, W impl Writer

/// Transfers bytes from one blocking source to one destination until end of stream.
pub blocking func copy_blocking<R, W>(
    reader: &+R,
    writer: &+W,
): usize! where R impl BlockingReader, W impl BlockingWriter

/// Validates one implementation-reported read count against its supplied capacity.
pub(/) noalloc func validate_read_count(received: usize, capacity: usize): usize!

/// Base and signed displacement for one cursor-changing file operation.
pub enum SeekFrom {
    start(position: i64)
    end(displacement: i64)
    current(displacement: i64)
}

/// An executor-safe owner for one local file.
pub struct File

/// An explicit synchronous owner or borrowed wrapper for one local file descriptor.
pub struct BlockingFile

/// Returns the process standard-input stream without taking ownership of the descriptor.
pub noalloc func stdin(): BlockingFile

/// Returns the process standard-output stream without taking ownership of the descriptor.
pub noalloc func stdout(): BlockingFile

/// Returns the process standard-error stream without taking ownership of the descriptor.
pub noalloc func stderr(): BlockingFile

construct File {
    /// Opens an existing file for reading.
    pub async func open(path: &str): Self!

    /// Creates or truncates a file for writing.
    pub async func create(path: &str): Self!

    /// Opens or creates a file and positions writes at its end.
    pub async func append(path: &str): Self!
}

construct BlockingFile {
    /// Opens an existing file for synchronous reading.
    pub blocking func open(path: &str): Self!

    /// Creates or truncates a file for synchronous writing.
    pub blocking func create(path: &str): Self!

    /// Opens or creates a file for synchronous append.
    pub blocking func append(path: &str): Self!
}

instance File {
    /// Makes this owner terminal and waits for its descriptor retirement.
    pub async method &+self.close(): void!
    /// Returns the current shared cursor position.
    pub async method &+self.position(): usize!
    /// Changes and returns the shared cursor position.
    pub async method &+self.seek(from: SeekFrom): usize!
    /// Changes the file length without changing the shared cursor.
    pub async method &+self.truncate(length: usize): void!
    /// Reads without changing the shared cursor.
    pub async method &+self.read_at(buffer: &+[u8], offset: u64): usize!
    /// Writes the complete view without changing the shared cursor.
    pub async method &+self.write_at(value: &[u8], offset: u64): void!
    impl Reader
    impl Writer
}

instance BlockingFile {
    /// Makes this wrapper terminal and closes its descriptor only when it owns it.
    pub noalloc method &+self.close(): void
    /// Returns the current shared cursor position.
    pub noalloc blocking method &+self.position_blocking(): usize!
    /// Changes and returns the shared cursor position.
    pub noalloc blocking method &+self.seek_blocking(from: SeekFrom): usize!
    /// Changes the file length without changing the shared cursor.
    pub noalloc blocking method &+self.truncate_blocking(length: usize): void!
    /// Reads without changing the shared cursor.
    pub noalloc blocking method &+self.read_at_blocking(buffer: &+[u8], offset: u64): usize!
    /// Writes the complete view without changing the shared cursor.
    pub noalloc blocking method &+self.write_at_blocking(value: &[u8], offset: u64): void!
    impl BlockingReader
    impl BlockingWriter
}

/// Writes UTF-8 text to standard output without adding a newline.
pub noalloc blocking func print(text: &str): void!

/// Writes UTF-8 text and one LF byte to standard output.
pub noalloc blocking func println(text: &str): void!

/// Writes UTF-8 text to standard error without adding a newline.
pub noalloc blocking func eprint(text: &str): void!

/// Writes UTF-8 text and one LF byte to standard error.
pub noalloc blocking func eprintln(text: &str): void!
