see ./index.nct
see ./byte_helpers.nct
use /string.String
use /vec.Vec

//! Portable byte-stream implementation bodies.

interface BlockingReader {
    blocking default method &+self.read_to_end_blocking(): Vec<u8>! {
        return collect_bytes_blocking(self)?
    }

    blocking default method &+self.read_to_string_blocking(): String! {
        let collected = collect_bytes_blocking(self)?
        return String.from_utf8(&collected)?
    }
}

interface BlockingWriter {
    blocking default method &+self.flush_blocking(): void! {
        return
    }

    blocking default method &+self.write_text_blocking(text: &str): void! {
        write_text_blocking_to(self, text)?
        return
    }

    blocking default method &+self.write_line_blocking(text: &str): void! {
        write_line_blocking_to(self, text)?
        return
    }
}

blocking func collect_bytes_blocking<R>(reader: &+R): Vec<u8>! where R impl BlockingReader {
    var result: Vec<u8> = Vec.empty()
    var scratch: Vec<u8> = byte_scratch(8192)
    while true {
        let received = validate_read_count(reader.read_blocking(&+scratch)?, scratch.len())?
        if received == 0 {
            break
        }
        result.reserve(received)
        let initialized: &[u8] = &scratch
        var offset: usize = 0
        while offset < received {
            result.push(initialized[offset])
            offset += 1
        }
    }
    return move result
}

blocking func write_text_blocking_to<W>(writer: &+W, text: &str): void! where W impl BlockingWriter {
    let encoded: &[u8] = text.bytes()
    writer.write_blocking(encoded)?
    return
}

blocking func write_line_blocking_to<W>(writer: &+W, text: &str): void! where W impl BlockingWriter {
    writer.write_text_blocking(text)?
    writer.write_text_blocking("\n")?
    return
}
