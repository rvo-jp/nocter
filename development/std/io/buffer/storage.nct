//! Pure storage policy shared by blocking and asynchronous buffers.

use /string.String
use /vec.Vec

func normalized_capacity(requested: usize): usize {
    if requested == 0 {
        return 1
    }
    return requested
}

func initialized_byte_storage(capacity: usize): Vec<u8> {
    var storage: Vec<u8> = Vec.with_capacity(capacity)
    while storage.len() < capacity {
        storage.push(0)
    }
    return move storage
}

func discard_byte_prefix(storage: &+Vec<u8>, consumed: usize): void {
    if consumed == 0 {
        return
    }
    if consumed >= storage.len() {
        storage.clear()
        return
    }
    var source = consumed
    var destination: usize = 0
    while source < storage.len() {
        storage[destination] = storage[source]
        destination += 1
        source += 1
    }
    storage.truncate(destination)
    return
}

func write_validated_line(line: &Vec<u8>, destination: &+String): void! {
    let bytes: &[u8] = line
    destination.try_push_utf8(bytes)?
    return
}
