//! Buffered reader and writer state machines.

see ./index.nct
see ./storage.nct

use /io.{BlockingReader, BlockingWriter}
use /io
use /internal/io as internal_io
use /string.String
use /vec.Vec

struct BlockingBufReader<R> {
    source: R
    buffer: Vec<u8>
    next: usize
    valid_len: usize
    line_buffer: Vec<u8>
    is_finished: bool
}

construct BlockingBufReader<R> {
    func new(source: R): Self where R impl BlockingReader {
        return BlockingBufReader.with_capacity(move source, 8192)
    }

    func with_capacity(source: R, requested_capacity: usize): Self where R impl BlockingReader {
        let capacity = normalized_capacity(requested_capacity)
        return BlockingBufReader<R> {
            source: move source,
            buffer: initialized_byte_storage(capacity),
            next: 0,
            valid_len: 0,
            line_buffer: Vec.empty(),
            is_finished: false,
        }
    }
}

blocking func read<R>(reader: &+BlockingBufReader<R>, destination: &+[u8]): usize! where R impl BlockingReader {
    if reader.is_finished {
        return 0
    }
    var written: usize = 0
    while written < destination.len() {
        if reader.next == reader.valid_len {
            let received = refill(reader)?
            if received == 0 {
                break
            }
        }
        let available: &[u8] = &reader.buffer
        destination[written] = available[reader.next]
        written += 1
        reader.next += 1
    }
    return written
}

blocking func refill<R>(reader: &+BlockingBufReader<R>): usize! where R impl BlockingReader {
    if reader.is_finished {
        return 0
    }
    let reported = reader.source.read_blocking(&+reader.buffer) catch failure {
        terminate_reader(reader)
        return move failure
    }
    let received = io.validate_read_count(reported, reader.buffer.len()) catch failure {
        terminate_reader(reader)
        return move failure
    }
    reader.next = 0
    reader.valid_len = received
    if received == 0 {
        end_reader(reader)
    }
    return received
}

blocking func read_line<R>(reader: &+BlockingBufReader<R>): String?! where R impl BlockingReader {
    var result = String.empty()
    let present = read_line_into(reader, &+result)?
    if !present {
        return none
    }
    return move result
}

blocking func read_line_into<R>(
    reader: &+BlockingBufReader<R>,
    destination: &+String,
): bool! where R impl BlockingReader {
    destination.clear()
    if reader.is_finished {
        return false
    }
    while true {
        if reader.next == reader.valid_len {
            let received = refill(reader)?
            if received == 0 {
                if reader.line_buffer.len() == 0 {
                    return false
                }
                return commit_line(reader, destination)?
            }
        }

        let available: &[u8] = &reader.buffer
        let byte = available[reader.next]
        reader.next += 1
        if byte == 10 {
            let line: &[u8] = &reader.line_buffer
            let ends_with_cr = line.len() != 0 && line[line.len() - 1] == 13
            if ends_with_cr {
                let _ = reader.line_buffer.pop()
            }
            return commit_line(reader, destination)?
        }
        reader.line_buffer.try_push(byte) catch failure {
            terminate_reader(reader)
            return move failure
        }
    }
    return false
}

func commit_line<R>(reader: &+BlockingBufReader<R>, destination: &+String): bool! {
    write_validated_line(&reader.line_buffer, destination) catch failure {
        terminate_reader(reader)
        return move failure
    }
    reader.line_buffer.clear()
    return true
}

func end_reader<R>(reader: &+BlockingBufReader<R>): void {
    if !reader.is_finished {
        reader.is_finished = true
    }
    reader.buffer.clear()
    reader.next = 0
    reader.valid_len = 0
    return
}

func terminate_reader<R>(reader: &+BlockingBufReader<R>): void {
    end_reader(reader)
    reader.line_buffer.clear()
    return
}

instance BlockingBufReader<R> where R impl BlockingReader {
    blocking method &+self.read_line_blocking(): String?! {
        return read_line(self)
    }

    blocking method &+self.read_line_into_blocking(destination: &+String): bool! {
        return read_line_into(self, destination)?
    }

    method self.finish(): R {
        return move self.source
    }

    blocking method &+self.read_blocking(destination: &+[u8]): usize! {
        return read(self, destination)?
    }
}

struct BlockingBufWriter<W> {
    destination: W
    buffer: Vec<u8>
    limit: usize
    is_open: bool
}

construct BlockingBufWriter<W> {
    func new(destination: W): Self where W impl BlockingWriter {
        return BlockingBufWriter.with_capacity(move destination, 8192)
    }

    func with_capacity(
        destination: W,
        requested_capacity: usize,
    ): Self where W impl BlockingWriter {
        let capacity = normalized_capacity(requested_capacity)
        let storage: Vec<u8> = Vec.with_capacity(capacity)
        return BlockingBufWriter<W> {
            destination: move destination,
            buffer: move storage,
            limit: capacity,
            is_open: true,
        }
    }
}

blocking func write<W>(writer: &+BlockingBufWriter<W>, bytes: &[u8]): void! where W impl BlockingWriter {
    if !writer.is_open {
        return internal_io.closed_stream_error()
    }
    var offset: usize = 0
    while offset < bytes.len() {
        if writer.buffer.len() == writer.limit {
            flush(writer)?
        }
        writer.buffer.push(bytes[offset])
        offset += 1
    }
    return
}

blocking func flush<W>(writer: &+BlockingBufWriter<W>): void! where W impl BlockingWriter {
    if !writer.is_open {
        return internal_io.closed_stream_error()
    }
    if writer.buffer.len() != 0 {
        writer.destination.write_blocking(&writer.buffer) catch failure {
            terminate_writer(writer)
            return move failure
        }
        writer.buffer.clear()
    }
    writer.destination.flush_blocking() catch failure {
        terminate_writer(writer)
        return move failure
    }
    return
}

func terminate_writer<W>(writer: &+BlockingBufWriter<W>): void {
    writer.buffer.clear()
    writer.is_open = false
    return
}

instance BlockingBufWriter<W> where W impl BlockingWriter {
    blocking method self.finish(): W! {
        var writer = move self
        flush(&+writer)?
        writer.is_open = false
        return move writer.destination
    }

    blocking method &+self.write_blocking(bytes: &[u8]): void! {
        write(self, bytes)?
        return
    }

    blocking method &+self.flush_blocking(): void! {
        flush(self)?
        return
    }
}
