//! File ownership and Darwin descriptor operations.

see ./index.nct
see ./core.nct

use /internal/os/darwin.SyscallResult
use /internal/os/darwin
use /internal/io
use /internal/path as internal_path
use /ptr

#target: "arm64-darwin"
func open_read_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_READ_ONLY)?
}

#target: "arm64-darwin"
func create_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_CREATE_TRUNCATE)?
}

#target: "arm64-darwin"
func append_fd(path: &str): usize! {
    return open_fd(path, darwin.OPEN_CREATE_APPEND)?
}

#target: "arm64-darwin"
func open_fd(path: &str, flags: usize): usize! {
    let argument = internal_path.target_path_argument(path)?

    var result: SyscallResult = darwin.syscall3(
        darwin.SYS_OPEN,
        internal_path.target_path_address(&argument),
        flags,
        darwin.CREATE_MODE,
    )
    while result.errno == darwin.ERRNO_INTERRUPTED {
        result = darwin.syscall3(
            darwin.SYS_OPEN,
            internal_path.target_path_address(&argument),
            flags,
            darwin.CREATE_MODE,
        )
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    return result.value
}

enum ReadProgress {
    retry
    complete(count: usize)
}

#target: "arm64-darwin"
noalloc func classify_read_result(result: SyscallResult, capacity: usize): ReadProgress! {
    if result.errno == darwin.ERRNO_INTERRUPTED {
        return ReadProgress.retry
    }
    if result.errno != 0 {
        return io.io_error_from_os(darwin.error_from_errno(darwin.errno(result.errno)))
    }
    if result.value > capacity {
        return invalid_read_count()
    }
    return ReadProgress.complete(result.value)
}

#target: "arm64-darwin"
func read_fd(fd: usize, buffer: &+[u8]): usize! {
    var count: usize = 0
    var complete: bool = false
    while !complete {
        let result = darwin.syscall3(
            darwin.SYS_READ,
            fd,
            ptr.addr(buffer.ptr()),
            buffer.len(),
        )
        match classify_read_result(result, buffer.len())? {
            ReadProgress.retry {}
            ReadProgress.complete(received) {
                count = received
                complete = true
            }
        }
    }
    return count
}

#target: "arm64-darwin"
func close_fd(fd: usize): void {
    // A failed close is deliberately not retried: Darwin may have consumed the
    // descriptor even when reporting an interruption, and retrying could close
    // an unrelated descriptor that another operation has reused.
    let _ = darwin.syscall1(darwin.SYS_CLOSE, fd)
    return
}

enum FileState {
    owned_open
    borrowed_open
    closed
}

struct File {
    fd: usize
    state: FileState
}

construct File {
    func open(path: &str): Self! {
        let fd = open_read_fd(path)?
        return File { fd: fd, state: FileState.owned_open }
    }

    func create(path: &str): Self! {
        let fd = create_fd(path)?
        return File { fd: fd, state: FileState.owned_open }
    }

    func append(path: &str): Self! {
        let fd = append_fd(path)?
        return File { fd: fd, state: FileState.owned_open }
    }
}

noalloc func require_open(file: &File): void! {
    if file.state is FileState.closed {
        return io.closed_stream_error()
    }
    return
}

func read(file: &+File, buffer: &+[u8]): usize! {
    require_open(file)?
    return read_fd(file.fd, buffer)?
}

func close(file: &+File): void {
    if file.state is FileState.owned_open {
        close_fd(file.fd)
    }
    file.state = FileState.closed
    return
}

instance File {
    method &+self.close(): void {
        close(self)
        return
    }

    method &+self.read(buffer: &+[u8]): usize! {
        return read(self, buffer)?
    }
}

drop File(&+self) {
    close(self)
    return
}
