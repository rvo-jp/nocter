//! Recoverable formatting and shared-default contract tests.

see ./index.nct

use /string.String

test standard_values_share_one_recoverable_format_surface {
    var output = String.empty()
    "text".try_format_into(&+output)?
    let owned = String.copy("/owned")
    owned.try_format_into(&+output)?
    true.try_format_into(&+output)?
    let minimum: i64 = -9223372036854775808
    minimum.try_format_into(&+output)?
    let maximum: u64 = 18446744073709551615
    maximum.try_format_into(&+output)?
    if (&output as &str) != "text/ownedtrue-922337203685477580818446744073709551615" {
        return error.new("std.fmt.test", "standard Format spelling diverged")
    }
    return
}
