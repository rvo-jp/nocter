        return
    }
}

instance u64 {
    method &self.format_into(output: &+String): void {
        append_u64(output, ptr.copy_value(self))
        return
    }
}

instance usize {
    method &self.format_into(output: &+String): void {
        append_usize(output, ptr.copy_value(self))
