see ./index.nct
see ./formatting.nct
use /internal/ptr
use /string.String

//! Standard Format implementations for compiler built-in and owned text types.

instance str {
    method &self.format_into(output: &+String): void {
        append_str(output, self)
        return
    }
}

instance String {
    method &self.format_into(output: &+String): void {
        append_string(output, self)
        return
    }
}

instance bool {
    method &self.format_into(output: &+String): void {
        append_bool(output, ptr.copy_value(self))
        return
    }
}

instance i8 {
    method &self.format_into(output: &+String): void {
        append_i8(output, ptr.copy_value(self))
        return
    }
}

instance i16 {
    method &self.format_into(output: &+String): void {
        append_i16(output, ptr.copy_value(self))
        return
    }
}

instance i32 {
    method &self.format_into(output: &+String): void {
