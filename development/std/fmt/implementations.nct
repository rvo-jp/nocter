//! Standard Format implementations for compiler built-in and owned text types.

see ./index.nct
see ./scalar.nct
use /internal/ptr
use /string.String

instance str {
    method &self.try_format_into(output: &+String): void! {
        output.try_push_str(self)?
        return
    }
}

instance String {
    method &self.try_format_into(output: &+String): void! {
        output.try_push_str(self)?
        return
    }
}

instance bool {
    method &self.try_format_into(output: &+String): void! {
        if ptr.copy_value(self) {
            output.try_push_str("true")?
            return
        }
        output.try_push_str("false")?
        return
    }
}

instance i8 {
    method &self.try_format_into(output: &+String): void! {
        try_format_signed(output, ptr.copy_value(self) as i64)?
        return
    }
}

instance i16 {
    method &self.try_format_into(output: &+String): void! {
        try_format_signed(output, ptr.copy_value(self) as i64)?
        return
    }
}

instance i32 {
    method &self.try_format_into(output: &+String): void! {
        try_format_signed(output, ptr.copy_value(self) as i64)?
        return
    }
}

instance i64 {
    method &self.try_format_into(output: &+String): void! {
        try_format_signed(output, ptr.copy_value(self))?
        return
    }
}

instance isize {
    method &self.try_format_into(output: &+String): void! {
        try_format_signed(output, ptr.copy_value(self) as i64)?
        return
    }
}

instance u8 {
    method &self.try_format_into(output: &+String): void! {
        try_format_unsigned(output, ptr.copy_value(self) as u64)?
        return
    }
}

instance u16 {
    method &self.try_format_into(output: &+String): void! {
        try_format_unsigned(output, ptr.copy_value(self) as u64)?
        return
    }
}

instance u32 {
    method &self.try_format_into(output: &+String): void! {
        try_format_unsigned(output, ptr.copy_value(self) as u64)?
        return
    }
}

instance u64 {
    method &self.try_format_into(output: &+String): void! {
        try_format_unsigned(output, ptr.copy_value(self))?
        return
    }
}

instance usize {
    method &self.try_format_into(output: &+String): void! {
        try_format_unsigned(output, ptr.copy_value(self) as u64)?
        return
    }
}
