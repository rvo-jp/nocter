        return
    }
}

instance i64 {
    method &self.format_into(output: &+String): void {
        append_i64(output, ptr.copy_value(self))
        return
    }
}

instance isize {
    method &self.format_into(output: &+String): void {
        append_isize(output, ptr.copy_value(self))
        return
    }
}

instance u8 {
    method &self.format_into(output: &+String): void {
