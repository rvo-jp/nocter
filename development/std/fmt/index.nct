//! Formatting append API for owned strings.
//!
//! Normal operations abort on allocation failure. Explicit `try_*` operations
//! return allocation errors. Both surfaces share the same formatting core.

use std/string.String
include ./conformances.nct
include ./formatting.nct

/// Appends the ordinary textual representation of a value.
pub interface Format {
    pub method &self.format_into(output: &+String): void
}

conform Format for str {
    method &self.format_into(output: &+String): void
}

conform Format for String {
    method &self.format_into(output: &+String): void
}

conform Format for bool {
    method &self.format_into(output: &+String): void
}

conform Format for i8 {
    method &self.format_into(output: &+String): void
}

conform Format for i16 {
    method &self.format_into(output: &+String): void
}

conform Format for i32 {
    method &self.format_into(output: &+String): void
}

conform Format for i64 {
    method &self.format_into(output: &+String): void
}

conform Format for isize {
    method &self.format_into(output: &+String): void
}

conform Format for u8 {
    method &self.format_into(output: &+String): void
}

conform Format for u16 {
    method &self.format_into(output: &+String): void
}

conform Format for u32 {
    method &self.format_into(output: &+String): void
}

conform Format for u64 {
    method &self.format_into(output: &+String): void
}

conform Format for usize {
    method &self.format_into(output: &+String): void
}

pub func try_append_str(out: &+String, value: &str): void!

pub(/) func append_str(out: &+String, value: &str): void

pub func try_append_string(out: &+String, value: &String): void!

pub(/) func append_string(out: &+String, value: &String): void

pub func try_append_i32(out: &+String, value: i32): void!

pub(/) func append_i32(out: &+String, value: i32): void

pub func try_append_i8(out: &+String, value: i8): void!

pub(/) func append_i8(out: &+String, value: i8): void

pub func try_append_i16(out: &+String, value: i16): void!

pub(/) func append_i16(out: &+String, value: i16): void

pub func try_append_i64(out: &+String, value: i64): void!

pub(/) func append_i64(out: &+String, value: i64): void

pub func try_append_isize(out: &+String, value: isize): void!

pub(/) func append_isize(out: &+String, value: isize): void

pub func try_append_u8(out: &+String, value: u8): void!

pub(/) func append_u8(out: &+String, value: u8): void

pub func try_append_u16(out: &+String, value: u16): void!

pub(/) func append_u16(out: &+String, value: u16): void

pub func try_append_u32(out: &+String, value: u32): void!

pub(/) func append_u32(out: &+String, value: u32): void

pub func try_append_u64(out: &+String, value: u64): void!

pub(/) func append_u64(out: &+String, value: u64): void

pub func try_append_usize(out: &+String, value: usize): void!

pub(/) func append_usize(out: &+String, value: usize): void

pub func try_append_bool(out: &+String, value: bool): void!

pub(/) func append_bool(out: &+String, value: bool): void
