//! Value formatting into owned strings.
//!
//! Implementations expose one recoverable operation. The shared default used
//! by interpolation converts destination growth failure to allocation abort.

use /string.String
see ./default.nct
see ./implementations.nct
see ./scalar.nct
see ./tests.nct

/// Appends the ordinary textual representation of a value.
pub interface Format {
    /// Appends with recoverable destination growth.
    pub method &self.try_format_into(output: &+String): void!

    /// Appends under the ordinary aborting allocation policy.
    pub default method &self.format_into(output: &+String): void
}

instance str {
    impl Format
}

instance String {
    impl Format
}

instance bool {
    impl Format
}

instance i8 {
    impl Format
}

instance i16 {
    impl Format
}

instance i32 {
    impl Format
}

instance i64 {
    impl Format
}

instance isize {
    impl Format
}

instance u8 {
    impl Format
}

instance u16 {
    impl Format
}

instance u32 {
    impl Format
}

instance u64 {
    impl Format
}

instance usize {
    impl Format
}
