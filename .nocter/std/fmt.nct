//! Formatting append API for owned strings.
//!
//! Functions in this module append formatted values into an existing
//! `std/string.String`. They are ordinary fallible standard-library functions,
//! not compiler formatting primitives.

from std/error import Error
from std/string import String

pub func append_str(out: &+String, value: &str): void! {
    return
}

pub func append_string(out: &+String, value: &String): void! {
    return
}

pub func append_i32(out: &+String, value: i32): void! {
    return
}

pub func append_bool(out: &+String, value: bool): void! {
    return
}

pub func unsupported(): error {
    return Error.new("std.fmt.unsupported", "value cannot be formatted")
}
