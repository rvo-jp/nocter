//! Nocter standard library memory API.
//!
//! This file is the initial public surface for `std/mem`. The compiler must not
//! special-case the names Allocator, Layout, RawBuffer, alloc, free, or
//! page_allocator. Region-specific behavior is tracked through allocator
//! provenance from the `region ... using ...` language construct.
//!
//! The public functions below are ordinary standard-library APIs. Allocation is
//! not part of the compiler primitive set in v0; target-gated std internals
//! provide the OS boundary behind this common API.

use std/error.Error
use std/os.{syscall2, syscall6}
use std/ptr.addr
use std/ptr.from_addr
use std/ptr.slice_from_raw_parts
use std/ptr.slice_from_raw_parts_mut

pub copy struct Layout {
    pub size: usize
    pub align: usize
}

pub struct RawBuffer {
    pub ptr: *u8
    pub len: usize
    pub align: usize
}

pub struct Allocator {
    state: usize
    kind: u64
}

pub func page_allocator(): Allocator {
    return Allocator { state: 0, kind: 0 }
}

#target("arm64-darwin")
pub(nocter) func alloc_pages(size: usize): usize! {
    let result = syscall6(0x020000c5, 0, size, 3, 0x1002, 0xffffffffffffffff, 0)
    if result.errno != 0 {
        return Error.new("std.mem.out_of_memory", "allocation failed")
    }
    return result.value
}

#target("arm64-darwin")
pub(nocter) func free_pages(address: usize, size: usize): void {
    let result = syscall2(0x02000049, address, size)
    return
}

pub func alloc(
    allocator: &+Allocator,
    size: usize,
    align: usize,
): RawBuffer! {
    if size == 0 {
        return invalid_argument()
    }
    if align == 0 {
        return invalid_argument()
    }
    if align > 16384 {
        return invalid_argument()
    }

    let address: usize = alloc_pages(size)?
    return RawBuffer {
        ptr: from_addr(address),
        len: size,
        align: align,
    }
}

pub func free(allocator: &+Allocator, buffer: RawBuffer): void {
    free_pages(addr(buffer.ptr), buffer.len)
    return
}

pub func bytes(buffer: &RawBuffer): &[u8] {
    return slice_from_raw_parts(buffer.ptr, buffer.len)
}

pub func bytes_mut(buffer: &+RawBuffer): &+[u8] {
    return slice_from_raw_parts_mut(buffer.ptr, buffer.len)
}

pub func prefix(buffer: &RawBuffer, len: usize): &[u8]! {
    if len > buffer.len {
        return invalid_argument()
    }
    return slice_from_raw_parts(buffer.ptr, len)
}

pub func prefix_mut(buffer: &+RawBuffer, len: usize): &+[u8]! {
    if len > buffer.len {
        return invalid_argument()
    }
    return slice_from_raw_parts_mut(buffer.ptr, len)
}

impl Allocator {
    pub method &+self.alloc(size: usize, align: usize): RawBuffer! {
        return alloc(self, size, align)?
    }

    pub method &+self.free(buffer: RawBuffer): void {
        free(self, move buffer)
        return
    }
}

impl RawBuffer {
    pub method &self.bytes(): &[u8] {
        return bytes(self)
    }

    pub method &+self.bytes_mut(): &+[u8] {
        return bytes_mut(self)
    }

    pub method &self.prefix(len: usize): &[u8]! {
        return prefix(self, len)?
    }

    pub method &+self.prefix_mut(len: usize): &+[u8]! {
        return prefix_mut(self, len)?
    }
}

pub func out_of_memory(): error {
    return Error.new("std.mem.out_of_memory", "allocation failed")
}

pub func invalid_argument(): error {
    return Error.new("std.mem.invalid_argument", "invalid allocation request")
}
