// Nocter standard library memory API.
//
// This file is the initial public surface for std.mem. The compiler must not
// special-case the names Allocator, Layout, RawBuffer, alloc, free, or
// page_allocator. Region-specific behavior is tracked through
// allocator provenance from the `region ... using ...` language construct.
//
// The public functions below are ordinary standard-library APIs. Allocation is
// not part of the compiler primitive set in v0. The initial bodies are Parser
// v0 placeholders until target-backed allocation wrappers are implemented.

from std/error import make_error

pub copy struct Layout {
    pub size: usize
    pub align: usize
}

pub struct RawBuffer {
    pub ptr: *u8
    pub len: usize
    pub align: usize
}

pub struct Allocator {
    state: usize
    kind: u64
}

pub func page_allocator(): Allocator {
    return Allocator.placeholder()
}

pub func alloc(
    allocator: &+Allocator,
    size: usize,
    align: usize,
): RawBuffer! {
    return RawBuffer.placeholder()
}

pub func free(allocator: &+Allocator, buffer: RawBuffer): void {
    return
}

pub func out_of_memory(): error {
    return make_error("std.mem.out_of_memory", "allocation failed")
}

pub func invalid_argument(): error {
    return make_error("std.mem.invalid_argument", "invalid allocation request")
}
