//! Common owning string type.
//!
//! `str` is the compiler built-in unsized UTF-8 data type. `&str` is the
//! non-owning UTF-8 string slice type and the type of string literals. String is
//! the owning string type. Its storage details are intentionally not exposed
//! outside `std/string`.
//!
//! The public functions are ordinary standard-library APIs. Empty strings,
//! copying from `&str`, capacity reservation, growth, UTF-8 view construction,
//! byte-slice view construction, and release are implemented in Nocter code
//! through restricted runtime pointer primitives.

from std/error import Error
from std/mem import Allocator
from std/mem import alloc_pages as alloc_pages_impl
from std/mem import free_pages as free_pages_impl
from std/ptr import addr
from std/ptr import copy_str_to_ptr
from std/ptr import from_addr
from std/ptr import str_from_raw_parts

pub(nocter) primitive bytes_from_str(value: &str): &[u8]

pub struct String {
    ptr: *u8
    len: usize
    capacity: usize
}

pub func String.empty(): String {
    // Empty strings never dereference the raw pointer.
    return String {
        ptr: from_addr(1),
        len: 0,
        capacity: 0,
    }
}

pub func empty(): String {
    return String.empty()
}

pub func String.with_capacity(allocator: &+Allocator, requested_capacity: usize): String! {
    if requested_capacity == 0 {
        return String.empty()
    }

    let address: usize = alloc_pages_impl(requested_capacity)?
    return String {
        ptr: from_addr(address),
        len: 0,
        capacity: requested_capacity,
    }
}

pub func with_capacity(allocator: &+Allocator, requested_capacity: usize): String! {
    return String.with_capacity(allocator, requested_capacity)?
}

pub func String.from_str(allocator: &+Allocator, value: &str): String! {
    let value_len: usize = value.len()
    if value_len == 0 {
        return String.empty()
    }

    let address: usize = alloc_pages_impl(value_len)?
    copy_str_to_ptr(from_addr(address), 0, value)
    return String {
        ptr: from_addr(address),
        len: value_len,
        capacity: value_len,
    }
}

pub func from_str(allocator: &+Allocator, value: &str): String! {
    return String.from_str(allocator, value)?
}

pub func String.copy(allocator: &+Allocator, value: &str): String! {
    return String.from_str(allocator, value)?
}

pub func String.view(text: &String): &str {
    return str_from_raw_parts(text.ptr, text.len)
}

pub func view(text: &String): &str {
    return String.view(text)
}

pub func String.len(text: &String): usize {
    let text_len: usize = text.len
    return text_len
}

pub func len(text: &String): usize {
    return String.len(text)
}

pub func String.capacity(text: &String): usize {
    let text_capacity: usize = text.capacity
    return text_capacity
}

pub func capacity(text: &String): usize {
    return String.capacity(text)
}

pub func String.is_empty(text: &String): bool {
    let text_len: usize = text.len
    return text_len == 0
}

pub func is_empty(text: &String): bool {
    return String.is_empty(text)
}

pub func bytes(value: &str): &[u8] {
    return bytes_from_str(value)
}

pub func String.bytes(text: &String): &[u8] {
    return bytes_from_str(String.view(text))
}

pub func String.push_str(text: &+String, value: &str): void! {
    let value_len: usize = value.len()
    if value_len > 18446744073709551615 - text.len {
        return capacity_overflow()
    }

    let new_len: usize = text.len + value_len
    if new_len <= text.capacity {
        copy_str_to_ptr(text.ptr, text.len, value)
        text.len = new_len
        return
    }

    let address: usize = alloc_pages_impl(new_len)?
    copy_str_to_ptr(from_addr(address), 0, str_from_raw_parts(text.ptr, text.len))
    copy_str_to_ptr(from_addr(address), text.len, value)
    if text.capacity != 0 {
        free_pages_impl(addr(text.ptr), text.capacity)
    }
    text.ptr = from_addr(address)
    text.len = new_len
    text.capacity = new_len
    return
}

pub func push_str(text: &+String, value: &str): void! {
    String.push_str(text, value)?
    return
}

pub func capacity_overflow(): error {
    return Error.new("std.string.capacity_overflow", "string capacity overflow")
}

impl String {
    drop text: &+Self {
        if text.capacity == 0 {
            return
        }
        free_pages_impl(addr(text.ptr), text.capacity)
        return
    }
}
