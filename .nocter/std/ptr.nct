//! Nocter raw pointer and address conversion API.
//!
//! Raw pointers are address-carrying values. They do not own memory, do not
//! extend lifetimes, and do not grant dereference permission. These declarations
//! are target-independent core primitives, separate from OS target primitives
//! such as `std/os/macos.syscall0`.

pub primitive addr<T>(pointer: *T): usize

pub primitive from_ref<T>(value: &T): *T

pub primitive from_ref_mut<T>(value: &+T): *T

// Restricted API: callable only from modules inside the active Nocter home std/.
// User project modules must not call these functions.
pub(nocter) primitive from_addr<T>(address: usize): *T

pub(nocter) primitive copy_str_to_ptr(destination: *u8, offset: usize, text: &str): void

pub(nocter) primitive str_from_raw_parts(pointer: *u8, len: usize): &str
