//! Common owning variable-length array type.
//!
//! `[T]` is the compiler built-in unsized array data type. `&[T]` and `&+[T]`
//! are non-owning array slice types. Vec<T> is the owning variable-length array
//! type. Its storage details are intentionally not exposed outside `std/vec`.
//!
//! v0 fixes the public contract before promoting generic collection lowering.
//! Empty vectors, capacity allocation, read-only shape operations, scalar
//! pushes, and release are ordinary std functions. Copying operations and
//! non-scalar element moves return `std.vec.unsupported` or fail buildability
//! until element drop glue is wired into vector storage.

use std/error.Error
use std/mem.Allocator
use std/mem.alloc_pages as alloc_pages_impl
use std/mem.free_pages as free_pages_impl
use std/ptr.addr
use std/ptr.copy_ptr_to_ptr
use std/ptr.from_addr
use std/ptr.pointee_size
use std/ptr.slice_from_raw_parts_value
use std/ptr.slice_from_raw_parts_value_mut
use std/ptr.store_value_to_ptr

pub struct Vec<T> {
    ptr: *T
    len: usize
    capacity: usize
    byte_capacity: usize
}

pub func Vec.empty<T>(): Vec<T> {
    return Vec<T> {
        ptr: from_addr(1),
        len: 0,
        capacity: 0,
        byte_capacity: 0,
    }
}

pub func empty<T>(): Vec<T> {
    return Vec.empty()
}

pub func Vec.with_capacity<T>(allocator: &+Allocator, requested_capacity: usize): Vec<T>! {
    if requested_capacity == 0 {
        return Vec.empty()
    }

    let seed: Vec<T> = Vec.empty()
    let element_size: usize = pointee_size(seed.ptr)
    if element_size == 0 {
        return unsupported()
    }
    if requested_capacity > 18446744073709551615 / element_size {
        return capacity_overflow()
    }

    let byte_capacity: usize = requested_capacity * element_size
    let address: usize = alloc_pages_impl(byte_capacity)?
    return Vec<T> {
        ptr: from_addr(address),
        len: 0,
        capacity: requested_capacity,
        byte_capacity: byte_capacity,
    }
}

pub func with_capacity<T>(allocator: &+Allocator, requested_capacity: usize): Vec<T>! {
    return Vec.with_capacity(allocator, requested_capacity)?
}

pub func Vec.from_slice<T>(allocator: &+Allocator, values: &[T]): Vec<T>! {
    if values.len() == 0 {
        return Vec.empty()
    }

    return unsupported()
}

pub func from_slice<T>(allocator: &+Allocator, values: &[T]): Vec<T>! {
    return Vec.from_slice(allocator, values)?
}

pub func len<T>(values: &Vec<T>): usize {
    let values_len: usize = values.len
    return values_len
}

pub func capacity<T>(values: &Vec<T>): usize {
    let values_capacity: usize = values.capacity
    return values_capacity
}

pub func is_empty<T>(values: &Vec<T>): bool {
    let values_len: usize = values.len
    return values_len == 0
}

pub func view<T>(values: &Vec<T>): &[T] {
    return slice_from_raw_parts_value(values.ptr, values.len)
}

pub func view_mut<T>(values: &+Vec<T>): &+[T] {
    return slice_from_raw_parts_value_mut(values.ptr, values.len)
}

pub func reserve<T>(values: &+Vec<T>, additional: usize): void! {
    if additional == 0 {
        return
    }

    let values_len: usize = values.len
    if additional > 18446744073709551615 - values_len {
        return capacity_overflow()
    }

    let required_capacity: usize = values_len + additional
    let values_capacity: usize = values.capacity
    if values_capacity >= values_len {
        let spare_capacity: usize = values_capacity - values_len
        if additional <= spare_capacity {
            return
        }
    }

    let element_size: usize = pointee_size(values.ptr)
    if element_size == 0 {
        return unsupported()
    }
    if required_capacity > 18446744073709551615 / element_size {
        return capacity_overflow()
    }
    if values_len > 18446744073709551615 / element_size {
        return capacity_overflow()
    }

    let old_address: usize = addr(values.ptr)
    let old_byte_len: usize = values_len * element_size
    let old_byte_capacity: usize = values.byte_capacity
    let byte_capacity: usize = required_capacity * element_size
    let address: usize = alloc_pages_impl(byte_capacity)?
    if old_byte_len != 0 {
        copy_ptr_to_ptr(from_addr(address), from_addr(old_address), old_byte_len)
    }
    if old_byte_capacity != 0 {
        free_pages_impl(old_address, old_byte_capacity)
    }
    values.ptr = from_addr(address)
    values.capacity = required_capacity
    values.byte_capacity = byte_capacity
    return
}

pub func clear<T>(values: &+Vec<T>): void {
    values.len = 0
    return
}

pub func push<T>(values: &+Vec<T>, value: T): void! {
    let old_len: usize = values.len
    reserve(values, 1)?
    let element_size: usize = pointee_size(values.ptr)
    let byte_offset: usize = old_len * element_size
    store_value_to_ptr(values.ptr, byte_offset, value)
    values.len = old_len + 1
    return
}

func unsupported(): error {
    return Error.new("std.vec.unsupported", "Vec storage is not implemented")
}

pub func capacity_overflow(): error {
    return Error.new("std.vec.capacity_overflow", "Vec capacity overflow")
}

impl<T> Vec<T> {
    pub method &self.len(): usize {
        return len(self)
    }

    pub method &self.capacity(): usize {
        return capacity(self)
    }

    pub method &self.is_empty(): bool {
        return is_empty(self)
    }

    pub method &self.view(): &[T] {
        return view(self)
    }

    pub method &+self.view_mut(): &+[T] {
        return view_mut(self)
    }

    pub method &+self.reserve(additional: usize): void! {
        reserve(self, additional)?
        return
    }

    pub method &+self.clear(): void {
        clear(self)
        return
    }

    pub method &+self.push(value: T): void! {
        push(self, value)?
        return
    }

    drop &+self {
        let vec_byte_capacity: usize = self.byte_capacity
        if vec_byte_capacity != 0 {
            free_pages_impl(addr(self.ptr), vec_byte_capacity)
        }
        self.len = 0
        self.capacity = 0
        self.byte_capacity = 0
        return
    }
}
