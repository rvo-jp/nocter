//! macOS-specific primitive boundary for Nocter's initial arm64-macos target.
//!
//! This file lives in the common standard library:
//! `.nocter/std/os/macos.nct`
//!
//! These declarations are the narrow low-level bridge used by the standard
//! library. Primitive declarations are target-gated with `#target`; ordinary
//! wrappers remain normal standard-library functions.

from std/os import OSError, OSErrorKind, Platform

pub(nocter) copy struct SyscallResult {
    pub value: usize
    pub errno: i32
}

pub(nocter) copy struct Errno {
    pub code: i32
}

pub(nocter) func errno(code: i32): Errno {
    return Errno { code: code }
}

pub(nocter) func error_from_errno(error: Errno): OSError {
    return OSError {
        platform: Platform.macos,
        code: error.code,
        kind: kind_from_errno(error),
    }
}

pub(nocter) func kind_from_errno(error: Errno): OSErrorKind {
    // Darwin errno values used by the std syscall wrappers.
    if error.code == 4 {
        return OSErrorKind.interrupted
    }
    if error.code == 11 {
        return OSErrorKind.would_block
    }
    if error.code == 2 {
        return OSErrorKind.not_found
    }
    if error.code == 1 {
        return OSErrorKind.permission_denied
    }
    if error.code == 13 {
        return OSErrorKind.permission_denied
    }
    if error.code == 17 {
        return OSErrorKind.already_exists
    }
    if error.code == 22 {
        return OSErrorKind.invalid_input
    }
    if error.code == 32 {
        return OSErrorKind.broken_pipe
    }
    if error.code == 60 {
        return OSErrorKind.timed_out
    }
    if error.code == 45 {
        return OSErrorKind.unsupported
    }
    return OSErrorKind.unknown
}

// macOS syscall number constants belong in this module. The exact constant
// list is filled in as each wrapper is implemented.

#target("arm64-darwin")
pub(nocter) primitive syscall0(number: usize): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall1(
    number: usize,
    a0: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall2(
    number: usize,
    a0: usize,
    a1: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall3(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall4(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall5(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive syscall6(
    number: usize,
    a0: usize,
    a1: usize,
    a2: usize,
    a3: usize,
    a4: usize,
    a5: usize,
): SyscallResult

#target("arm64-darwin")
pub(nocter) primitive trap(): never

#target("arm64-darwin")
pub(nocter) primitive unreachable(): never
