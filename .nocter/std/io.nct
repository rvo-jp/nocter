// Common user-facing I/O API.
//
// std.io exposes ordinary file and text APIs. Fallible functions return `T!`
// and fail with the compiler built-in `error` payload. Target-specific syscall
// results and errno wrappers stay inside target overlays.

from std/error import Error
from std/io_impl import FileDescriptor
from std/io_impl import open_read as open_read_impl
from std/io_impl import stderr as stderr_impl
from std/io_impl import stdout as stdout_impl
from std/os import OSError

// Compatibility classification type. It is an ordinary enum, not the fallible
// payload type.
pub enum IOError {
    interrupted(error: OSError)
    would_block(error: OSError)
    not_found(error: OSError)
    permission_denied(error: OSError)
    already_exists(error: OSError)
    invalid_input(error: OSError)
    broken_pipe(error: OSError)
    timed_out(error: OSError)
    unsupported(error: OSError)
    unexpected_os_error(error: OSError)
}

pub struct File {
    fd: FileDescriptor
    close_on_drop: bool
}

pub func from_os_error(error: OSError): error {
    return Error.new("std.io.os_error", "OS operation failed")
}

pub func stdout(): File {
    return File { fd: stdout_impl(), close_on_drop: false }
}

pub func stderr(): File {
    return File { fd: stderr_impl(), close_on_drop: false }
}

impl File {
    pub func open(path: str): File! {
        let fd = open_read_impl(path)?
        return File { fd: fd, close_on_drop: true }
    }

    pub method (file: &+Self).read(buffer: [+u8]): usize! {
        return unsupported()
    }

    pub method (file: &+Self).write(bytes: [u8]): void! {
        return
    }

    pub method (file: &+Self).write_text(text: str): void! {
        return
    }
}

pub func print(text: str): void! {
    var out = stdout()
    out.write_text(text)?
    return
}

pub func write_text(file: &+File, text: str): void! {
    return
}

pub func unsupported(): error {
    return Error.new("std.io.unsupported", "unsupported I/O operation")
}
