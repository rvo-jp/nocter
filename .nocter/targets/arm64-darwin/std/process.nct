// macOS implementation of the user-facing std.process API.
//
// exit is a user-facing standard-library API, not a compiler primitive. The
// target-specific implementation will call the active target overlay and trap
// if the platform exit operation unexpectedly returns.

from std/error import Error
from std/os/macos import trap

pub func args(): [str]! {
    return Error.new("std.process.unsupported", "process arguments are not implemented")
}

pub func env(name: str): (str?)! {
    return none
}

pub func cwd(): str! {
    return Error.new("std.process.unsupported", "current working directory is not implemented")
}

pub func exit(code: i32): never {
    // TODO: call macOS SYS_exit after syscall number constants are specified.
    return trap()
}

pub func abort(): never {
    return trap()
}
