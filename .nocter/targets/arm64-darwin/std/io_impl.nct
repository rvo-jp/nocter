//! macOS raw file-descriptor helpers behind the user-facing `std/io` API.
//!
//! These helpers are target-overlay standard-library functions, not compiler
//! primitives. `std/io` owns the public File API and keeps this module internal
//! to the active Nocter home with `pub(nocter)`.

from std/error import Error

pub(nocter) primitive write_text_raw(fd: i32, text: &str): void!

pub(nocter) func stdout(): i32 {
    return 1
}

pub(nocter) func stderr(): i32 {
    return 2
}

pub(nocter) func open_read(path: &str): i32! {
    return Error.new("std.io.unsupported", "file open is not implemented")
}

pub(nocter) func read(fd: i32, buffer: &+[u8]): usize! {
    return Error.new("std.io.unsupported", "file read is not implemented")
}

pub(nocter) func write(fd: i32, bytes: &[u8]): void! {
    return
}

pub(nocter) func write_text(fd: i32, text: &str): void! {
    write_text_raw(fd, text)?
    return
}

pub(nocter) func close(fd: i32): void {
    return
}
