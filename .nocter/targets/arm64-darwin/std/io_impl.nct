// macOS raw file-descriptor helpers behind the user-facing std/io API.
//
// These helpers are target-overlay standard-library functions, not compiler
// primitives. std/io owns the public File API and keeps this module internal to
// the active Nocter home with pub(nocter).

from std/error import Error

pub(nocter) copy struct FileDescriptor {
    raw: i32
}

pub(nocter) primitive write_text_raw(fd: i32, text: &str): void!

pub(nocter) func stdout(): FileDescriptor {
    return FileDescriptor { raw: 1 }
}

pub(nocter) func stderr(): FileDescriptor {
    return FileDescriptor { raw: 2 }
}

pub(nocter) func open_read(path: &str): FileDescriptor! {
    return Error.new("std.io.unsupported", "file open is not implemented")
}

pub(nocter) func read(fd: FileDescriptor, buffer: &+[u8]): usize! {
    return Error.new("std.io.unsupported", "file read is not implemented")
}

pub(nocter) func write(fd: FileDescriptor, bytes: &[u8]): void! {
    return
}

pub(nocter) func close(fd: FileDescriptor): void {
    return
}
