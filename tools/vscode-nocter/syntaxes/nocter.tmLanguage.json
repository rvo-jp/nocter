{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nocter",
  "scopeName": "source.nocter",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.nocter",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.documentation.nocter",
          "begin": "/\\*!",
          "end": "\\*/"
        },
        {
          "name": "comment.line.documentation.nocter",
          "match": "///.*$"
        },
        {
          "name": "comment.line.documentation.nocter",
          "match": "//!.*$"
        },
        {
          "name": "comment.block.nocter",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.nocter",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.nocter",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nocter",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.byte.nocter",
          "begin": "\\bb'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nocter",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nocter",
          "match": "\\b(return|if|else|for|in|while|loop|break|continue|match|is|catch)\\b"
        },
        {
          "name": "keyword.declaration.nocter",
          "match": "\\b(from|import|use|func|pub|type|copy|struct|enum|trait|impl|method|let|var|primitive)\\b"
        },
        {
          "name": "keyword.operator.nocter",
          "match": "\\b(move|drop|as|using|region)\\b"
        },
        {
          "name": "constant.language.nocter",
          "match": "\\b(true|false|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.nocter",
          "match": "\\b(void|never|i32|bool|str|error|Self)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.nocter",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.integer.binary.nocter",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.nocter",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.nocter",
          "match": "\\b(func|method)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.nocter"
            },
            "2": {
              "name": "entity.name.function.nocter"
            }
          }
        },
        {
          "name": "entity.name.type.nocter",
          "match": "\\b(type|struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.nocter"
            },
            "2": {
              "name": "entity.name.type.nocter"
            }
          }
        }
      ]
    }
  }
}
