enum AppError {
    missing_path
    open_failed(path: str)
}

func main(): i32 {
    return describe(AppError.missing_path)
}

func describe(error: AppError): i32 {
    switch error {
        is AppError.missing_path {
            return 0
        }

        is AppError.open_failed(path) {
            use_path(path)
            return 1
        }
    }

    return 2
}

func use_path(path: str): void {
    return
}
