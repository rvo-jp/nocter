// Nocter syntax sketch.
//
// This file is not a minimal program. It is a design sample that shows the
// language direction: static typing, value-centered data, path-derived modules,
// fallible types, ownership, borrowing, regions, and a small standard-library surface.

use std/prelude

from std/io import File, stderr, stdout
from std/mem import Allocator
from std/process import args, exit

import std/mem as mem

pub copy struct WordStats {
    pub bytes: u64
    pub lines: u64
    pub words: u64
}

pub func WordStats.empty(): WordStats {
    return WordStats{
        bytes: 0,
        lines: 0,
        words: 0,
    }
}

impl WordStats {
    pub method (stats: &+Self).add_byte(byte: u8): void {
        stats.bytes += 1

        if byte == b'\n' {
            stats.lines += 1
        }
    }

    pub method (stats: &+Self).add_word(): void {
        stats.words += 1
    }
}

enum ScanState {
    outside_word
    inside_word
}

pub func scan_words(text: str): WordStats {
    var stats = WordStats.empty()
    var state = ScanState.outside_word
    let bytes = text.bytes()

    for i in 0..<bytes.len() {
        let byte = bytes[i]
        stats.add_byte(byte)

        if byte.is_ascii_space() {
            state = ScanState.outside_word
        } else if state == ScanState.outside_word {
            stats.add_word()
            state = ScanState.inside_word
        }
    }

    return stats
}

func print_stats(
    out: &+File,
    path: str,
    stats: WordStats,
): void! {
    out.write_text(path)?
    out.write_text(": ")?
    out.write_u64(stats.lines)?
    out.write_text(" lines, ")?
    out.write_u64(stats.words)?
    out.write_text(" words, ")?
    out.write_u64(stats.bytes)?
    out.write_text(" bytes\n")?

    return
}

func read_all(
    allocator: &+Allocator,
    path: str,
): String! {
    var file = File.open(path) catch error {
        fail Error.new("std.io.open_failed", error.message)
    }

    // String owns its allocation. It is dropped automatically when ownership
    // does not move to the caller.
    let text = file.read_to_string(allocator) catch error {
        fail Error.new("std.io.read_failed", error.message)
    }

    return move text
}

func run(allocator: &+Allocator): void! {
    let argv = args()?

    if argv.len() < 2 {
        fail Error.new("app.invalid_argument", "missing path")
    }

    if argv.len() > 2 {
        fail Error.new("app.invalid_argument", "expected exactly one path")
    }

    let path = argv[1]

    // A region is useful for temporary allocations whose lifetime is bounded
    // by this block. References into scratch cannot escape the region.
    region scratch using allocator {
        let text = read_all(scratch.allocator(), path)?
        let stats = scan_words(text.view())

        var out = stdout()
        print_stats(&+out, path, stats)?
    }

    return
}

func report_error(error: error): void {
    var err = stderr()
    err.write_text("error: ").ignore()
    err.write_text(error.message).ignore()
    err.write_text("\n").ignore()
}

func fatal(error: error): never {
    report_error(error)
    exit(1)
}

program(): i32! {
    var allocator = mem.page_allocator()
    run(&+allocator)?
    return 0
}
